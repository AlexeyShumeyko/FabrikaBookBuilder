<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--  Application-wide resources.                                          -->
    <!--                                                                       -->
    <!--  Theme.xaml     - design system (palette, typography, control styles) -->
    <!--  Converters.xaml- every IValueConverter / IMultiValueConverter       -->
    <!--                                                                       -->
    <!--  This file stays as the single merge point because App.xaml already   -->
    <!--  references Styles/AppStyles.xaml.                                    -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.xaml" />
        <ResourceDictionary Source="Converters.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
