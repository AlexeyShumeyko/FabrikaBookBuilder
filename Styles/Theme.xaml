    <Style x:Key="SecondaryButtonStyle"  TargetType="Button" BasedOn="{StaticResource SecondaryButton}" />
    <Style x:Key="IconButtonStyle"       TargetType="Button" BasedOn="{StaticResource IconButton}" />
    <!--
      Compact numeric field for the project panels. The implicit TextBox is sized for a
      form (Padding 12,8, FontSize 12), so two of them side by side made the combined
      panel both taller and wider than the identical panel in the unique mode. Same
      template, smaller box - so the two panels match to the pixel.
    -->
    <Style x:Key="NumberField" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Width" Value="64" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      Loading veil. It used to be a flat #CC0F172A wash over the whole window, which read
      as a rendering glitch rather than as work in progress - the owner kept reporting it
      as "a grey background leaks in". It was on screen at the worst possible moments too:
      while the Windows file picker was open, and while the export dialog was open showing
      a progress bar of its own.

      Now it is a light wash with a small card in the middle, so the screen underneath
      stays readable and the state looks deliberate. The timing is fixed in the view
      models: do not raise IsLoading while a dialog of ours owns the progress.
    -->
    <Style x:Key="LoadingVeil" TargetType="Border">
        <Setter Property="Background" Value="#B8FFFFFF" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="LoadingVeilCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Effect" Value="{StaticResource ShadowSubtle}" />
    </Style>

