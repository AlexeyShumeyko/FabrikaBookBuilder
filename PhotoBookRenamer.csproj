<!--
  The shell: windows, dialogs, view models, converters - and the composition root in App.xaml.cs.

  This project is the only one that knows WPF exists. It references the two layers below it
  and nothing above, so a rule that belongs in PhotoBook.Application or
  PhotoBook.Infrastructure cannot be quietly implemented here.

  The project sits in the repository root and the SDK globs every .cs file below it, which is
  why src\ and tests\ are excluded below: without that the shell would start compiling the
  other projects' sources. When the shell moves into src\ of its own (roadmap step 1.5b)
  those exclusions become unnecessary and can go.

  AssemblyName stays PhotoBookRenamer. The installer, the shortcut, the auto-updater and the
  published layout all refer to that name; RootNamespace stays with it so the generated
  Application class still matches x:Class="PhotoBookRenamer.App" in App.xaml.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>PhotoBookRenamer</AssemblyName>
    <RootNamespace>PhotoBookRenamer</RootNamespace>
    <Version>1.1.1</Version>
    <Authors>PhotoBook Renamer</Authors>
    <Description>Professional photo book renaming application</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The project sits in the repository root, and the SDK globs every .cs file below it.
      tests\ and src\ are therefore excluded from the shell and reached through project
      references instead. Without this the shell starts compiling other projects' sources -
      which is how a test project once ended up in the shipped build.
    -->
    <Compile Remove="tests\**" />
    <Compile Remove="src\**" />
    <Page Remove="tests\**" />
    <Resource Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src\PhotoBook.Application\PhotoBook.Application.csproj" />
    <ProjectReference Include="src\PhotoBook.Core\PhotoBook.Core.csproj" />
    <ProjectReference Include="src\PhotoBook.Infrastructure\PhotoBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!--
    Inter is the typeface the design specifies. It does not ship with Windows, and
    referencing it by name only silently falls back to Segoe UI on every machine that
    lacks it, which is why the UI did not match the mockup. The four static weights are
    embedded as WPF resources and resolved through the folder pack URI
    "pack://application:,,,/Resources/Fonts/#Inter", so WPF sees one family with all
    weights and honours FontWeight (500 Medium, 600 SemiBold, 700 Bold).
    Source: https://github.com/rsms/inter (SIL Open Font License 1.1)
  -->
  <ItemGroup>
    <Resource Include="Resources\Fonts\Inter-Regular.ttf" />
    <Resource Include="Resources\Fonts\Inter-Medium.ttf" />
    <Resource Include="Resources\Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\Inter-Bold.ttf" />
  </ItemGroup>

  <!--
    Company logo, 160x160 PNG with a transparent background, shown in the header in
    place of the placeholder glyph. Kept in Resources/ next to the fonts so the header
    can load it through a pack URI: pack://application:,,,/Resources/logo.png
  -->
  <ItemGroup>
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

</Project>