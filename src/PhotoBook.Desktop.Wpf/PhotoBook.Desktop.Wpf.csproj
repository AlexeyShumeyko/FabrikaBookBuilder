<!--
  The shell: windows, dialogs, view models, converters - and the composition root in App.xaml.cs.

  This project is the only one that knows WPF exists. It references the layers below it and
  nothing above, so a rule that belongs in PhotoBook.Application or PhotoBook.Infrastructure
  cannot be quietly implemented here. When the Avalonia shell arrives it replaces this
  project rather than adding to it, and the two layers below must not change to allow that.

  AssemblyName stays PhotoBookRenamer. The installer, the desktop and quick-launch
  shortcuts, the auto-updater and the published layout all refer to that name, and so do the
  verification scripts in scripts\ - which is why they carry the path to this project rather
  than a path of their own.

  RootNamespace stays with it so the generated Application class still matches
  x:Class="PhotoBookRenamer.App" in App.xaml. Changing either of the two is a change to the
  shipped layout, not a rename.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <AssemblyName>PhotoBookRenamer</AssemblyName>
    <RootNamespace>PhotoBookRenamer</RootNamespace>
    <Version>1.1.1</Version>
    <Authors>PhotoBook Renamer</Authors>
    <Description>Professional photo book renaming application</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoBook.Application\PhotoBook.Application.csproj" />
    <ProjectReference Include="..\PhotoBook.Core\PhotoBook.Core.csproj" />
    <ProjectReference Include="..\PhotoBook.Infrastructure\PhotoBook.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="icon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Resource Include="icon.ico" />
  </ItemGroup>

  <!--
    Inter is the typeface the design specifies. It does not ship with Windows, and
    referencing it by name only silently falls back to Segoe UI on every machine that
    lacks it, which is why the UI did not match the mockup. The four static weights are
    embedded as WPF resources and resolved through the folder pack URI
    "pack://application:,,,/Resources/Fonts/#Inter", so WPF sees one family with all
    weights and honours FontWeight (500 Medium, 600 SemiBold, 700 Bold).
    Source: https://github.com/rsms/inter (SIL Open Font License 1.1)
  -->
  <ItemGroup>
    <Resource Include="Resources\Fonts\Inter-Regular.ttf" />
    <Resource Include="Resources\Fonts\Inter-Medium.ttf" />
    <Resource Include="Resources\Fonts\Inter-SemiBold.ttf" />
    <Resource Include="Resources\Fonts\Inter-Bold.ttf" />
  </ItemGroup>

  <!--
    Company logo, 160x160 PNG with a transparent background, shown in the header in
    place of the placeholder glyph. Kept in Resources/ next to the fonts so the header
    can load it through a pack URI: pack://application:,,,/Resources/logo.png
  -->
  <ItemGroup>
    <Resource Include="Resources\logo.png" />
  </ItemGroup>

</Project>