<UserControl x:Class="PhotoBookRenamer.Presentation.Views.StartScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!--
            The card outline. 2px slate-200 was the mockup's markup and it read as a raw
            form field rather than a choice: a thick grey frame around a whole screen-sized
            block, with no fill of its own. A 1px hairline plus a hover frame in the mode's
            own colour says "this is a card you can open", and the shadow does the lifting.
        -->
        <Style x:Key="ModeCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brand500}" />
                    <Setter Property="Effect" Value="{StaticResource ShadowHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- w-12 h-12 (48) rounded-2xl (16), icon text-xl (20) -->
        <Style x:Key="ModeIconBox" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="ModeIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- li: flex items-center gap-2 (8) -->
        <!-- A Grid, not a horizontal StackPanel: inside one, a TextBlock is measured
             with infinite width, TextWrapping does nothing and the sentence is cut
             off at the card edge. -->
        <Style x:Key="FeatureRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CheckIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- mt-8 pt-4 border-t border-slate-100 flex justify-between text-xs font-semibold -->
        <Style x:Key="ModeFooter" TargetType="Grid">
            <Setter Property="Margin" Value="0,32,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- max-w-4xl (896), py-4 (16), space-y-8 (32) -->
        <StackPanel MaxWidth="896" Margin="32,16,32,32" HorizontalAlignment="Center">

            <!-- Heading: text-center, space-y-2 (8) -->
            <StackPanel>
                <!-- px-3 py-1 (12/4) rounded-full text-xs font-semibold -->
                <!--
                    A rounded-rectangle chip, not a pill. The mockup's rounded-full outline
                    here was the one shape in the app that belongs to nothing else, and the
                    owner read it as a stray border rather than a label.
                -->
                <Border Background="{StaticResource Brand50}" CornerRadius="8" Padding="10,4"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Выберите режим" Style="{StaticResource TextXsSemibold}"
                               Foreground="{StaticResource Brand600}" />
                </Border>
                <!-- text-2xl (24) font-bold -->
                <TextBlock Text="Два способа собрать фотокниги" Style="{StaticResource Text2xlBold}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <!-- text-xs slate-500 max-w-lg (512) -->
                <TextBlock Text="Режим выбирается один раз — при создании проекта. Он определяет, как фотографии попадут в книги, а переключить его позже можно, открыв проект, созданный в нужном режиме."
                           Style="{StaticResource TextXs}" HorizontalAlignment="Center"
                           TextAlignment="Center" TextWrapping="Wrap" MaxWidth="560" Margin="0,8,0,0"
                           Foreground="{StaticResource Slate500}" />
            </StackPanel>

            <!--
                Two equal columns, gap 24. A UniformGrid was wrong here: it hands every cell
                the same height, so the taller card's last bullet was sliced off mid-word.
                A Grid with auto rows lets each card be exactly as tall as its own text.
            -->
            <Grid Margin="0,32,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============ Уникальные папки ============ -->
                <Border Grid.Column="0" Style="{StaticResource ModeCard}" MouseLeftButtonDown="OnUniqueFoldersClick">
                    <Grid>
                        <!-- The body row takes the slack so the footer sits on the card's
                             bottom edge in both cards, however many lines the text takes. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- Green = the automatic mode. Same colour as the chip on a
                                 saved project and on this project's empty state. -->
                            <Border Style="{StaticResource ModeIconBox}" Background="{StaticResource Sky50}">
                                <TextBlock Style="{StaticResource ModeIcon}" Text="&#xE8C0;"
                                           Foreground="{StaticResource Sky600}" />
                            </Border>

                            <TextBlock x:Name="UniqueTitleTextBlock" Text="Уникальные папки"
                                       Style="{StaticResource TextLgBold}" />
                            <TextBlock Style="{StaticResource TextXs}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource Slate600}" LineHeight="19"
                                       Text="Каждая загруженная папка становится отдельной фотокнигой. Программа сама определит обложку, разложит фотографии по разворотам и присвоит файлам имена, готовые к загрузке." />

                            <!-- ul mt-5 (20) space-y-2 (8) -->
                            <StackPanel Margin="0,20,0,0">
                                <Grid Style="{StaticResource FeatureRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Sky500}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextXs}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                               Text="Обложка определяется сама: самое большое фото в папке" />
                    </Grid>
                                <Grid Style="{StaticResource FeatureRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Sky500}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextXs}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                               Text="Порядок разворотов можно изменить, если фотографии в папке идут не по сюжету" />
                    </Grid>
                                <Grid Style="{StaticResource FeatureRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Sky500}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextXs}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                               Text="В одном проекте можно загружать только папки с одинаковым количеством файлов — это нужно для правильной сборки книг" />
                    </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!-- footer: border-t, mt-8 pt-4 (32/16) -->
                        <Grid Grid.Row="1" Style="{StaticResource ModeFooter}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="1" Background="{StaticResource Slate100}"
                                    VerticalAlignment="Top" Margin="0,0,0,16" />
                            <TextBlock Grid.Row="0" Margin="0,16,0,0" Text="Выбрать режим"
                                       Style="{StaticResource TextXsSemibold}"
                                       Foreground="{StaticResource Sky600}" />
                            <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="&#xE72A;"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Sky600}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ Комбинированный ============ -->
                <Border Grid.Column="1" Style="{StaticResource ModeCard}" MouseLeftButtonDown="OnCombinedModeClick" Margin="24,0,0,0">
                    <Grid>
                        <!-- The body row takes the slack so the footer sits on the card's
                             bottom edge in both cards, however many lines the text takes. -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- Indigo = the hand-tuned mode, the app's own colour. -->
                            <Border Style="{StaticResource ModeIconBox}" Background="{StaticResource Brand50}">
                                <TextBlock Style="{StaticResource ModeIcon}" Text="&#xE8F1;"
                                           Foreground="{StaticResource Brand600}" />
                            </Border>

                            <TextBlock x:Name="CombinedTitleTextBlock" Text="Комбинированный"
                                       Style="{StaticResource TextLgBold}" />
                            <TextBlock Style="{StaticResource TextXs}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource Slate600}" LineHeight="19"
                                       Text="Режим для сборки книг вручную: вы выбираете, какое фото в какой книге и на каком развороте будет стоять. Подходит, когда состав каждой книги подбирают отдельно." />

                            <!-- The point of the mode, in one sentence. "Общий разворот" is
                                 what makes a run of forty books bearable, and it is the one
                                 thing this mode does that the folders mode cannot. -->
                            <Border Background="{StaticResource Brand50}" BorderBrush="{StaticResource Brand100}"
                                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Главное — общие развороты и обложки" Style="{StaticResource TextXsSemibold}"
                                               Foreground="{StaticResource Brand700}" />
                                    <TextBlock Style="{StaticResource TextXs}" TextWrapping="Wrap" Margin="0,3,0,0"
                                               Foreground="{StaticResource Slate600}" LineHeight="18"
                                               Text="Одинаковый разворот или обложку можно добавить сразу во все книги одним действием — и больше не заполнять его вручную в каждой. На больших заказах это заметно ускоряет сборку." />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,20,0,0">
                                <Grid Style="{StaticResource FeatureRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Brand500}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextXs}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                               Text="Любая фотография попадает в любую книгу и на любой разворот" />
                    </Grid>
                                <Grid Style="{StaticResource FeatureRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Brand500}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextXs}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                               Text="Общий разворот или обложка добавляется сразу во все книги одним действием" />
                    </Grid>
                                <Grid Style="{StaticResource FeatureRow}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Brand500}" />
                        <TextBlock Grid.Column="1" Style="{StaticResource TextXs}" TextWrapping="Wrap"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                               Text="Количество разворотов у всех книг одинаковое — это нужно для правильной сборки" />
                    </Grid>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Style="{StaticResource ModeFooter}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="1" Background="{StaticResource Slate100}"
                                    VerticalAlignment="Top" Margin="0,0,0,16" />
                            <TextBlock Grid.Row="0" Margin="0,16,0,0" Text="Выбрать режим"
                                       Style="{StaticResource TextXsSemibold}"
                                       Foreground="{StaticResource Brand600}" />
                            <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="&#xE72A;"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Brand600}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!--
                Reworded: the mode tabs are no longer a way in. A mode is reached by
                picking it here (or by opening a saved project), and the tab only lights
                up while that project is open.
            -->
            <TextBlock Style="{StaticResource TextXs}" HorizontalAlignment="Center" Margin="0,32,0,0"
                       TextAlignment="Center" Foreground="{StaticResource Slate500}"
                       Text="Выбранный режим откроется в отдельной вкладке и будет доступен, пока проект открыт." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
