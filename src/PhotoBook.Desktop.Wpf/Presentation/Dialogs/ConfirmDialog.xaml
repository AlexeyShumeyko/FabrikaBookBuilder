<Window x:Class="PhotoBookRenamer.Presentation.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Подтверждение"
        SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        FontFamily="{StaticResource UiFont}">

    <!-- The room the shadow falls into: with AllowsTransparency the effect is painted
         inside the window and comes out square if the surface sits on the edge. -->
    <Border Style="{StaticResource DialogShadowRoom}">
        <Border Style="{StaticResource DialogSurface}">
            <StackPanel Margin="24,22,24,20">

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="IconHost" Grid.Column="0" Width="36" Height="36"
                            CornerRadius="10" Background="{StaticResource Red50}"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="IconGlyph" Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                                   FontSize="15" Foreground="{StaticResource Red600}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock x:Name="TitleText" Grid.Column="1" Margin="12,0,0,0"
                               Style="{StaticResource TextH3}" VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </Grid>

                <TextBlock x:Name="MessageText" Style="{StaticResource TextBody}"
                           Foreground="{StaticResource Slate600}" TextWrapping="Wrap"
                           LineHeight="19" Margin="48,0,0,0" />

                <Border Height="1" Background="{StaticResource Slate100}" Margin="0,20,0,18" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Click="OnCancelClick"
                            AutomationProperties.Name="Отмена" Content="Отмена" Margin="0,0,8,0"
                            IsCancel="True" IsDefault="True" />
                    <!-- Only for a question that really has three answers; collapsed
                         otherwise, so the common two-button case is unchanged. -->
                    <Button x:Name="SecondaryButton" Style="{StaticResource SecondaryButton}"
                            Click="OnSecondaryClick" AutomationProperties.Name="Второй вариант"
                            Margin="0,0,8,0" Visibility="Collapsed" />
                    <Button x:Name="ConfirmButton" Style="{StaticResource DangerButton}"
                            Click="OnConfirmClick" AutomationProperties.Name="Подтвердить" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
