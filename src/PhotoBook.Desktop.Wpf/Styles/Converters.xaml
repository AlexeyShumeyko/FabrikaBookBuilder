<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:utils="clr-namespace:PhotoBookRenamer.Presentation.Converters">

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--  Value converters.                                                    -->
    <!--  Keys are preserved verbatim from the previous AppStyles.xaml so that  -->
    <!--  every existing binding keeps resolving.                              -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <utils:BooleanToVisibilityConverter        x:Key="BooleanToVisibilityConverter" />
    <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    <utils:ErrorToBackgroundConverter          x:Key="ErrorToBackgroundConverter" />
    <utils:ErrorToForegroundConverter          x:Key="ErrorToForegroundConverter" />
    <utils:ErrorToFontWeightConverter          x:Key="ErrorToFontWeightConverter" />
    <utils:FilePathToThumbnailConverter        x:Key="FilePathToThumbnailConverter" />
    <utils:PageSourceConverter                 x:Key="PageSourceConverter" />

    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
    <!--  Converters added for the redesign                                    -->
    <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->



    <!-- Project status -> pill brush / label / dot brush, so views stay declarative -->
    <utils:StatusToBrushConverter              x:Key="StatusToBrushConverter" />
    <utils:StatusToLabelConverter              x:Key="StatusToLabelConverter" />

    <!-- "РР·РјРµРЅС‘РЅ: 24 РјР°СЏ, 14:20" -->
    <utils:LastModifiedTextConverter           x:Key="LastModifiedTextConverter" />


    <!-- null-or-empty string -> collapsed -->
    <utils:StringToVisibilityConverter         x:Key="StringToVisibilityConverter" />
    <utils:InverseStringToVisibilityConverter  x:Key="InverseStringToVisibilityConverter" />

    <!-- SourcePath present -> true (used for slot states) -->
    <utils:HasValueConverter                   x:Key="HasValueConverter" />

    <!-- Any-collection non-empty -> true -->
    <utils:CountToBoolConverter                x:Key="CountToBoolConverter" />



    <!-- AppMode <-> bool, for the RadioButton tabs in the persistent header -->
    <utils:AppModeEqualsConverter              x:Key="AppModeEqualsConverter" />

    <!-- Slot / pool state helpers for the Combined mode workspace -->
    <utils:InverseHasValueConverter            x:Key="InverseHasValueConverter" />


    <!-- Rounded clip for card content: Border.ClipToBounds clips to a rectangle only -->
    <utils:RoundedClipGeometryConverter       x:Key="RoundedClipGeometryConverter" />

    <!-- Card size from the book's format and the room left in the row -->
    <utils:AdaptiveCardSizeConverter            x:Key="AdaptiveCardSizeConverter" />

    <!-- Free / assigned / shared badge colours for the file list -->
    <utils:PhotoUsageToBrushConverter           x:Key="PhotoUsageToBrushConverter" />

    <!-- Mode chip on a saved project's card: label, or the tab glyph with "icon" -->
    <utils:AppModeToLabelConverter             x:Key="AppModeToLabelConverter" />

</ResourceDictionary>
