<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The palette, in two themes, transcribed from the 2.2 design prototype (see
        doc/DESIGN-2.2.md §4 for the source lines and the numbers).

        Every value below is one the prototype uses. Nothing here is invented: a difference
        in a screenshot from this point on is a difference in the engine, not in the design.

        The two themes carry the same names and different values, which is what makes one
        screen work in both. "Default" is the light theme: Avalonia falls back to it whenever
        a scope asks for the light variant, so the file does not repeat ninety-odd keys a
        third time under the name "Light".

        Colours are plain Colors rather than brushes. Avalonia will convert a Color wherever
        a brush is expected, and a Color cannot be mistaken for a frozen brush - which in the
        WPF theme is how a frozen resource ended up somewhere it could not be unfrozen.

        The numbered families (Slate, Brand, Emerald, Sky, Amber, Red) are the old design
        system's names, kept because the views written against them still use them. They now
        hold the new palette's values, so those views follow the theme even before they are
        rewritten. New work uses the semantic names below them.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- =============================== light =============================== -->
        <!-- Warm paper: a photograph sits on this, so nothing in it is cold. -->
        <ResourceDictionary x:Key="Default">

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ brand ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!-- The accent is gold, and what sits on it is ink rather than white. -->
            <Color x:Key="Brand50">#F8F1E0</Color>
            <Color x:Key="Brand100">#F2E5C8</Color>
            <Color x:Key="Brand200">#E6D2A4</Color>
            <Color x:Key="Brand400">#D6A31F</Color>
            <Color x:Key="Brand500">#BD8B06</Color>
            <Color x:Key="Brand600">#A87400</Color>
            <Color x:Key="Brand700">#8A6000</Color>

            <Color x:Key="Indigo50">#F8F1E0</Color>
            <Color x:Key="Indigo100">#F2E5C8</Color>
            <Color x:Key="Indigo400">#D6A31F</Color>
            <Color x:Key="Indigo600">#A87400</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ slate ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <Color x:Key="Slate50">#0E4A3A1C</Color>
            <Color x:Key="Slate100">#F1E9D8</Color>
            <Color x:Key="Slate200">#214A3A1C</Color>
            <Color x:Key="Slate300">#3B4A3A1C</Color>
            <Color x:Key="Slate400">#8A7C63</Color>
            <Color x:Key="Slate500">#776A53</Color>
            <Color x:Key="Slate600">#42392A</Color>
            <Color x:Key="Slate700">#2B2417</Color>
            <Color x:Key="Slate800">#2B2417</Color>
            <Color x:Key="Slate900">#2B2417</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ status ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                Status keeps the colours the program already uses. The prototype's teal and
                warm orange are a change of meaning across the whole product - the tray icon
                and the installer included - and that is a decision, not a detail.
            -->
            <Color x:Key="Emerald50">#ECFDF5</Color>
            <Color x:Key="Emerald100">#D1FAE5</Color>
            <Color x:Key="Emerald200">#A7F3D0</Color>
            <Color x:Key="Emerald500">#10B981</Color>
            <Color x:Key="Emerald600">#059669</Color>
            <Color x:Key="Emerald700">#047857</Color>

            <Color x:Key="Sky50">#F0F9FF</Color>
            <Color x:Key="Sky100">#E0F2FE</Color>
            <Color x:Key="Sky200">#BAE6FD</Color>
            <Color x:Key="Sky500">#0EA5E9</Color>
            <Color x:Key="Sky600">#0284C7</Color>
            <Color x:Key="Sky700">#0369A1</Color>

            <Color x:Key="Amber50">#FFFBEB</Color>
            <Color x:Key="Amber100">#FEF3C7</Color>
            <Color x:Key="Amber200">#FDE68A</Color>
            <Color x:Key="Amber400">#FBBF24</Color>
            <Color x:Key="Amber500">#F59E0B</Color>
            <Color x:Key="Amber600">#D97706</Color>
            <Color x:Key="Amber700">#B45309</Color>

            <Color x:Key="Red50">#FEF2F2</Color>
            <Color x:Key="Red100">#FEE2E2</Color>
            <Color x:Key="Red200">#FECACA</Color>
            <Color x:Key="Red400">#F87171</Color>
            <Color x:Key="Red500">#EF4444</Color>
            <Color x:Key="Red600">#DC2626</Color>
            <Color x:Key="Red700">#B91C1C</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~ semantics ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!-- The names new markup uses. One of each per theme. -->
            <Color x:Key="AppBackground">#F2EADC</Color>
            <Color x:Key="Surface">#FAF6EA</Color>
            <Color x:Key="SurfaceMuted">#F1E9D8</Color>
            <Color x:Key="SurfaceRaised">#F1E9D8</Color>
            <Color x:Key="SurfaceModal">#FDFAF1</Color>
            <Color x:Key="BorderSubtle">#124A3A1C</Color>
            <Color x:Key="BorderDefault">#214A3A1C</Color>
            <Color x:Key="BorderStrong">#3B4A3A1C</Color>
            <Color x:Key="TextStrong">#2B2417</Color>
            <Color x:Key="TextDefault">#42392A</Color>
            <Color x:Key="TextMuted">#776A53</Color>
            <Color x:Key="TextFaint">#8A7C63</Color>
            <Color x:Key="TextLink">#A87400</Color>

            <Color x:Key="Accent">#A87400</Color>
            <Color x:Key="AccentStrong">#8A6000</Color>
            <!-- The ink that sits on a filled accent button. Never white: gold takes ink. -->
            <Color x:Key="OnAccent">#2A1E00</Color>

            <!-- The gold a filled control is filled with, and the line that defines it.
                 The prototype keeps the same gold in both themes, and so does this. -->
            <Color x:Key="Gold">#F2B41C</Color>
            <Color x:Key="GoldDeep">#CF9105</Color>
            <!-- A filled gold control lifts on hover and settles on press, the way the
                 prototype's does. Darkening it would read as a door instead of a lamp. -->
            <Color x:Key="GoldHover">#F8BF2B</Color>
            <Color x:Key="GoldPressed">#E7A80F</Color>

            <!-- A filled action, in each theme's own tone. On warm paper the prototype does
                 not lay a solid gold slab - that is a lamp in a lit room - but a 24% gold tint
                 with a gold line and deep-gold words on it. In the evening the same button is
                 the gold itself, because that is the only warm thing on a graphite page. -->
            <Color x:Key="ActionFill">#3DFFC43C</Color>
            <Color x:Key="ActionFillHover">#57FFC43C</Color>
            <Color x:Key="ActionFillPressed">#33FFC43C</Color>
            <Color x:Key="ActionBorder">#61B07B00</Color>
            <Color x:Key="ActionInk">#8A5F00</Color>

            <!-- What gives the filled action its thickness. The prototype's own
                 numbers: a hairline of light inside the top edge and a brown descent
                 below, so the button is a raised cap of paint rather than a tinted
                 rectangle. -->
            <BoxShadows x:Key="ActionShadow">inset 0 1 0 0 #99FFFFFF, 0 6 16 -12 #B358421C</BoxShadows>
            <BoxShadows x:Key="ActionShadowHover">inset 0 1 0 0 #B3FFFFFF, 0 8 20 -12 #B358421C</BoxShadows>
            <BoxShadows x:Key="ActionShadowPressed">inset 0 2 4 0 #33785A14, 0 1 2 0 #1A785A14</BoxShadows>

            <!-- The line a card takes under the pointer. Gold, not a darker hairline: it is
                 the card answering, and the answer is the product's colour. -->
            <Color x:Key="BorderAccentHover">#59B07B00</Color>

            <!-- The mat behind a photograph, and the tray a group of tabs sits in. -->
            <Color x:Key="MatSurface">#E2D7C1</Color>
            <Color x:Key="TabTray">#0F4A3A1C</Color>

            <!-- The chosen tab is a cream card lifted off the tray. The prototype paints it
                 with the same 180-degree gradient its cards use, so it reads as paper standing
                 on a tray - a flat near-white pill on warm paper reads as a hole cut through
                 it, which is what this screen had. -->
            <LinearGradientBrush x:Key="TabSelectedFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#FFFDF6" Offset="0" />
                <GradientStop Color="#FBF4E3" Offset="1" />
            </LinearGradientBrush>

            <!-- A tab under the pointer, before it is chosen: the tray warms where the pointer
                 is. A tab that is not current cannot change its words, so this is the only
                 answer it has. -->
            <Color x:Key="TabHoverFill">#0E4A3A1C</Color>

            <!-- The chosen tab stands above the tray, and a shadow is what says "above".

                 The prototype's two shadows, number for number: the hairline it draws inside
                 the card, and a descent of 0 2px 8px at 14%. Brown, not black - a grey shadow
                 on warm paper is a smudge. It only ever showed as a one-pixel rim until the
                 tab stopped clipping its own template; see Header.axaml. -->
            <BoxShadows x:Key="TabLift">inset 0 0 0 1 #124A3A1C, 0 2 8 0 #244A3A1C</BoxShadows>

            <!-- The welcome panel is lit from its top-right corner: a warm glow laid over the
                 card, not part of it, because a control carries one brush and the prototype
                 paints a radial glow on top of a card gradient. -->
            <RadialGradientBrush x:Key="WelcomeGlow" Center="90%,4%" GradientOrigin="90%,4%"
                                 RadiusX="43%" RadiusY="50%">
                <GradientStop Color="#40FFC428" Offset="0" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <!-- The halo behind the stack of pages: the same gold, softer, fading by 68%. -->
            <RadialGradientBrush x:Key="WelcomeHalo" Center="50%,50%" GradientOrigin="50%,50%"
                                 RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#33FFC428" Offset="0" />
                <GradientStop Color="#0DFFC428" Offset="0.46" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <!-- The two hairlines of the halo, and the paper the photographs are mounted on.
                 The paper stays cream in both themes: it is a photograph on a desk, not a
                 surface of the program. -->
            <!-- Daylight hairlines are brown rather than gold: gold at a fifth of its
                 strength on cream vanishes into the paper, which is exactly what the
                 two rings did before this line. -->
            <Color x:Key="WelcomeRing">#33B07B00</Color>
            <Color x:Key="WelcomeRingFaint">#24B07B00</Color>
            <Color x:Key="PhotoSheet">#FBF7EE</Color>

            <!-- The chip on the stack: a dark glass pill with a gold hairline. -->
            <Color x:Key="WelcomeChipFill">#EBFFFDF7</Color>
            <Color x:Key="WelcomeChipBorder">#4DB07B00</Color>
            <Color x:Key="WelcomeChipInk">#42392A</Color>
            <BoxShadows x:Key="WelcomeChipShadow">0 14 34 0 #2958421C</BoxShadows>

            <!-- The dim over the page behind a modal panel. -->
            <Color x:Key="Backdrop">#6B3A301E</Color>

            <!-- Recessed wells: a list of photographs, an input, a step container. -->
            <Color x:Key="Sunken">#0F4A3A1C</Color>
            <Color x:Key="SunkenSoft">#0B4A3A1C</Color>
            <Color x:Key="SunkenFaint">#064A3A1C</Color>

            <!--
                Translucent tints the design uses in more than one place. Avalonia writes
                colour as AARRGGBB, not the CSS RRGGBBAA, so these are spelled once here
                rather than guessed at each use - a colour string this engine cannot parse
                is a crash at startup, not a wrong shade.
            -->
            <Color x:Key="Slate200At70">#B3E2D7C1</Color>

            <!-- The page, as the prototype draws it: a warm wash from the top down, not one
                 flat colour. A flat fill reads as a screenshot of the design, not the design. -->
            <LinearGradientBrush x:Key="PageBackdrop" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#F7F1E6" Offset="0" />
                <GradientStop Color="#F3EBDE" Offset="0.6" />
                <GradientStop Color="#EFE6D6" Offset="1" />
            </LinearGradientBrush>

            <!-- The glow behind the top of the page, one ellipse wide and mostly above it. -->
            <RadialGradientBrush x:Key="PageGlow" Center="0.5,-0.18" GradientOrigin="0.5,-0.18"
                                 RadiusX="0.55" RadiusY="1.1">
                <GradientStop Color="#73FFE8AA" Offset="0" />
                <GradientStop Color="#00FFE8AA" Offset="0.64" />
                <GradientStop Color="#00FFE8AA" Offset="1" />
            </RadialGradientBrush>

            <!-- A card is lighter at its top edge than at its foot, by two percent. -->
            <LinearGradientBrush x:Key="CardFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#FFFDF7" Offset="0" />
                <GradientStop Color="#FAF6EA" Offset="0.42" />
                <GradientStop Color="#FAF6EA" Offset="1" />
            </LinearGradientBrush>


            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~ the shell ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                The header is a pane of glass over the page: the prototype's topbar is
                translucent with a blur, and a window that cannot blur what is behind it
                still shows the tint through. The gold line along its top edge is one pixel
                of light rather than a frame, and it fades out at both ends.
            -->
            <Color x:Key="TopBarGlass">#D1FAF6EC</Color>
            <LinearGradientBrush x:Key="TopBarEdge" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00B07B00" Offset="0" />
                <GradientStop Color="#50B07B00" Offset="0.5" />
                <GradientStop Color="#00B07B00" Offset="1" />
            </LinearGradientBrush>
            <BoxShadows x:Key="TopBarShadow">0 1 0 0 #0D4A3A1C, 0 12 32 0 #0F4A3A1C</BoxShadows>

            <!-- The recommended mode card is lifted off the page by a warm glow, not by a
                 grey shadow: it is the card the product is pointing at. -->
            <BoxShadows x:Key="ModeCardGlow">0 18 44 0 #40AA7D00</BoxShadows>

            <!-- The tray the tabs sit in. The ring around the chosen one is part of its
                 shadow, where the prototype puts it, so it cannot drift from the fill. -->
            <Color x:Key="TabTrayBorder">#144A3A1C</Color>

            <!-- What a quiet icon shows under the pointer, and under a press. -->
            <Color x:Key="HoverWash">#0D4A3A1C</Color>
            <Color x:Key="ActiveWash">#174A3A1C</Color>

            <!-- The glow the company's mark carries, and the gradient the product's second
                 word is cut out of. -->
            <Color x:Key="LogoGlowColor">#59AA7D00</Color>
            <LinearGradientBrush x:Key="BrandNameTail" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#C99100" Offset="0" />
                <GradientStop Color="#8A6000" Offset="1" />
            </LinearGradientBrush>

            <!-- The account's avatar: gold, and the ink that reads on it. -->
            <Color x:Key="AvatarInk">#2A1C00</Color>
            <Color x:Key="AvatarRing">#CF9105</Color>
            <LinearGradientBrush x:Key="AvatarFill" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FFD471" Offset="0" />
                <GradientStop Color="#F2B41C" Offset="0.48" />
                <GradientStop Color="#DC9A08" Offset="1" />
            </LinearGradientBrush>

            <!-- The three marks under the welcome panel are not the avatar. By day the
                 prototype washes them to a quarter-strength gold with a white sheen on
                 top and writes them in deep gold; at night they are the gold itself.
                 Separate keys, because sharing the avatar would repaint the account too. -->
            <LinearGradientBrush x:Key="WelcomeIconFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#7BFCF0D6" Offset="0" />
                <GradientStop Color="#3DFFC43C" Offset="0.62" />
                <GradientStop Color="#3DFFC43C" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="WelcomeIconRing">#61B07B00</Color>
            <Color x:Key="WelcomeIconInk">#8A5F00</Color>
            <BoxShadows x:Key="WelcomeIconShadow">inset 0 1 0 0 #99FFFFFF, 0 10 22 -14 #BF58421C</BoxShadows>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ shadows ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                BoxShadow instead of DropShadowEffect. Blur and depth are the prototype's;
                the colour is brown in the light theme and black in the dark one, because a
                grey shadow on warm paper is a smudge.
            -->
            <BoxShadows x:Key="ShadowSm">0 1 3 0 #1258421C</BoxShadows>
            <BoxShadows x:Key="ShadowSubtle">0 2 8 0 #1458421C</BoxShadows>
            <BoxShadows x:Key="ShadowCard">0 8 24 0 #1A58421C</BoxShadows>
            <BoxShadows x:Key="ShadowHover">0 14 34 0 #2458421C</BoxShadows>
            <BoxShadows x:Key="ShadowModal">0 30 70 0 #4D58421C</BoxShadows>

            <!-- ~~~~~~~~~~~~~~~~~~ saved projects and the delete panel ~~~~~~~~ -->

            <!-- The filled action deepens its gold line as the fill warms, which is what the
                 prototype's light theme does under the pointer. -->
            <Color x:Key="ActionBorderHover">#80B07B00</Color>

            <!-- A delete under the pointer: the red the prototype uses for a destructive
                 icon, pale enough to stay a warning rather than an alarm. -->
            <Color x:Key="DangerInk">#B4461F</Color>
            <Color x:Key="DangerWash">#1FFF7846</Color>

            <!-- "Открыть проект" warms toward gold under the pointer. -->
            <Color x:Key="OpenHoverFill">#1AFFCD2D</Color>
            <Color x:Key="OpenHoverBorder">#4DFFCD2D</Color>

            <!-- The folders mode carries amber and the combined one the product gold, so the
                 two are told apart by the mark before the word is read. -->
            <Color x:Key="ModeIconUnique">#B25F10</Color>


        </ResourceDictionary>

        <!-- ================================ dark ================================ -->
        <!-- Warm graphite: the same paper, in the evening. -->
        <ResourceDictionary x:Key="Dark">

            <Color x:Key="Brand50">#2A2114</Color>
            <Color x:Key="Brand100">#332813</Color>
            <Color x:Key="Brand200">#4A3A16</Color>
            <Color x:Key="Brand400">#E8AC1E</Color>
            <Color x:Key="Brand500">#FFC53D</Color>
            <Color x:Key="Brand600">#F2B41C</Color>
            <Color x:Key="Brand700">#D89B0E</Color>

            <Color x:Key="Indigo50">#2A2114</Color>
            <Color x:Key="Indigo100">#332813</Color>
            <Color x:Key="Indigo400">#E8AC1E</Color>
            <Color x:Key="Indigo600">#F2B41C</Color>

            <!--
                The slate ramp is inverted, not darkened. The old names are positional -
                Slate50 was the lightest surface and Slate900 the darkest ink - and on a dark
                page the lightest surface is the card and the ink is nearly white. Used as
                they were written, they keep meaning the same thing.
            -->
            <Color x:Key="Slate50">#0FFFF2D6</Color>
            <Color x:Key="Slate100">#2B2318</Color>
            <Color x:Key="Slate200">#14FFF2D6</Color>
            <Color x:Key="Slate300">#26FFF2D6</Color>
            <Color x:Key="Slate400">#8D8372</Color>
            <Color x:Key="Slate500">#8D8372</Color>
            <Color x:Key="Slate600">#E6DDCA</Color>
            <Color x:Key="Slate700">#F8F3E7</Color>
            <Color x:Key="Slate800">#F8F3E7</Color>
            <Color x:Key="Slate900">#F8F3E7</Color>

            <!-- Status keeps its hues; only the tints and the ink turn for the dark page. -->
            <Color x:Key="Emerald50">#0C2A21</Color>
            <Color x:Key="Emerald100">#10382C</Color>
            <Color x:Key="Emerald200">#14503C</Color>
            <Color x:Key="Emerald500">#34D399</Color>
            <Color x:Key="Emerald600">#10B981</Color>
            <Color x:Key="Emerald700">#6EE7B7</Color>

            <Color x:Key="Sky50">#0C2231</Color>
            <Color x:Key="Sky100">#0F2F42</Color>
            <Color x:Key="Sky200">#12415B</Color>
            <Color x:Key="Sky500">#38BDF8</Color>
            <Color x:Key="Sky600">#0EA5E9</Color>
            <Color x:Key="Sky700">#7DD3FC</Color>

            <Color x:Key="Amber50">#2B2110</Color>
            <Color x:Key="Amber100">#3A2C12</Color>
            <Color x:Key="Amber200">#4F3B14</Color>
            <Color x:Key="Amber400">#FBBF24</Color>
            <Color x:Key="Amber500">#F59E0B</Color>
            <Color x:Key="Amber600">#FBBF24</Color>
            <Color x:Key="Amber700">#FCD34D</Color>

            <Color x:Key="Red50">#2E1614</Color>
            <Color x:Key="Red100">#3B1A17</Color>
            <Color x:Key="Red200">#52201B</Color>
            <Color x:Key="Red400">#F87171</Color>
            <Color x:Key="Red500">#EF4444</Color>
            <Color x:Key="Red600">#F87171</Color>
            <Color x:Key="Red700">#FCA5A5</Color>

            <Color x:Key="AppBackground">#14110D</Color>
            <Color x:Key="Surface">#1F1A14</Color>
            <Color x:Key="SurfaceMuted">#262017</Color>
            <Color x:Key="SurfaceRaised">#262017</Color>
            <Color x:Key="SurfaceModal">#1D1913</Color>
            <Color x:Key="BorderSubtle">#0FFFF2D6</Color>
            <Color x:Key="BorderDefault">#14FFF2D6</Color>
            <Color x:Key="BorderStrong">#26FFF2D6</Color>
            <Color x:Key="TextStrong">#F8F3E7</Color>
            <Color x:Key="TextDefault">#E6DDCA</Color>
            <Color x:Key="TextMuted">#AAA08F</Color>
            <Color x:Key="TextFaint">#8D8372</Color>
            <Color x:Key="TextLink">#F2B41C</Color>

            <Color x:Key="Accent">#F2B41C</Color>
            <Color x:Key="AccentStrong">#E09A00</Color>
            <Color x:Key="OnAccent">#241800</Color>

            <Color x:Key="Gold">#F2B41C</Color>
            <Color x:Key="GoldDeep">#CF9105</Color>
            <Color x:Key="GoldHover">#F8BF2B</Color>
            <Color x:Key="GoldPressed">#E7A80F</Color>

            <!-- The same button at night: the gold itself, with ink on it. -->
            <Color x:Key="ActionFill">#F2B41C</Color>
            <Color x:Key="ActionFillHover">#F8BF2B</Color>
            <Color x:Key="ActionFillPressed">#E7A80F</Color>
            <Color x:Key="ActionBorder">#CF9105</Color>
            <Color x:Key="ActionInk">#2A1C00</Color>

            <!-- The prototype's evening button: a black descent under it and a shade
                 pressed into the bottom edge. -->
            <BoxShadows x:Key="ActionShadow">0 2 5 0 #4D000000, inset 0 -2 0 0 #388C5600</BoxShadows>
            <BoxShadows x:Key="ActionShadowHover">0 6 16 0 #57000000, inset 0 -2 0 0 #388C5600</BoxShadows>
            <BoxShadows x:Key="ActionShadowPressed">inset 0 2 4 0 #4D6E4200</BoxShadows>

            <Color x:Key="BorderAccentHover">#3DFFCD2D</Color>

            <Color x:Key="MatSurface">#15120E</Color>
            <Color x:Key="TabTray">#42000000</Color>

            <!-- In the evening the chosen tab is a pane of light rather than a card: the
                 prototype lifts it by 7.5% of white over the tray, and the tray stays visible
                 through it. -->
            <Color x:Key="TabSelectedFill">#13FFFFFF</Color>
            <Color x:Key="TabHoverFill">#0BFFFFFF</Color>

            <BoxShadows x:Key="TabLift">inset 0 0 0 1 #12FFFFFF, 0 2 12 0 #4D000000</BoxShadows>

            <RadialGradientBrush x:Key="WelcomeGlow" Center="90%,4%" GradientOrigin="90%,4%"
                                 RadiusX="43%" RadiusY="50%">
                <GradientStop Color="#24FFC428" Offset="0" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <RadialGradientBrush x:Key="WelcomeHalo" Center="50%,50%" GradientOrigin="50%,50%"
                                 RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#33FFC428" Offset="0" />
                <GradientStop Color="#0DFFC428" Offset="0.46" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <Color x:Key="WelcomeRing">#2EFFCD2D</Color>
            <Color x:Key="WelcomeRingFaint">#1FFCDD2D</Color>
            <Color x:Key="PhotoSheet">#FBF7EE</Color>
            <Color x:Key="WelcomeChipFill">#D118140E</Color>
            <Color x:Key="WelcomeChipBorder">#3DFFCD2D</Color>
            <Color x:Key="WelcomeChipInk">#E6DDCA</Color>
            <BoxShadows x:Key="WelcomeChipShadow">0 14 34 0 #59000000</BoxShadows>

            <Color x:Key="Backdrop">#B8080505</Color>

            <Color x:Key="Sunken">#38000000</Color>
            <Color x:Key="SunkenSoft">#26000000</Color>
            <Color x:Key="SunkenFaint">#14000000</Color>

            <Color x:Key="Slate200At70">#14FFF2D6</Color>

            <!-- No light wash here: the dark page is the same graphite with the glow at its
                 top left, and the card is lifted off it by a slight lightening. -->
            <LinearGradientBrush x:Key="PageBackdrop" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#17130E" Offset="0" />
                <GradientStop Color="#14110D" Offset="0.7" />
                <GradientStop Color="#14110D" Offset="1" />
            </LinearGradientBrush>

            <RadialGradientBrush x:Key="PageGlow" Center="0.06,-0.14" GradientOrigin="0.06,-0.14"
                                 RadiusX="0.5" RadiusY="1.05">
                <GradientStop Color="#1FFFC428" Offset="0" />
                <GradientStop Color="#00FFC428" Offset="0.62" />
                <GradientStop Color="#00FFC428" Offset="1" />
            </RadialGradientBrush>

            <LinearGradientBrush x:Key="CardFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#252019" Offset="0" />
                <GradientStop Color="#1F1A14" Offset="0.38" />
                <GradientStop Color="#1F1A14" Offset="1" />
            </LinearGradientBrush>


            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~ the shell ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <Color x:Key="TopBarGlass">#C213100B</Color>
            <LinearGradientBrush x:Key="TopBarEdge" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00FFCD2D" Offset="0" />
                <GradientStop Color="#26FFCD2D" Offset="0.5" />
                <GradientStop Color="#00FFCD2D" Offset="1" />
            </LinearGradientBrush>
            <BoxShadows x:Key="TopBarShadow">0 0 0 0 #00000000</BoxShadows>

            <BoxShadows x:Key="ModeCardGlow">0 18 44 0 #4DFFBE14</BoxShadows>

            <Color x:Key="TabTrayBorder">#0EFFFFFF</Color>

            <Color x:Key="HoverWash">#0DFFFFFF</Color>
            <Color x:Key="ActiveWash">#17FFFFFF</Color>

            <Color x:Key="LogoGlowColor">#47FFBE14</Color>
            <LinearGradientBrush x:Key="BrandNameTail" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#FFE98A" Offset="0" />
                <GradientStop Color="#FFC21A" Offset="1" />
            </LinearGradientBrush>

            <Color x:Key="AvatarInk">#2A1C00</Color>
            <Color x:Key="AvatarRing">#CF9105</Color>
            <LinearGradientBrush x:Key="AvatarFill" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FFD471" Offset="0" />
                <GradientStop Color="#F2B41C" Offset="0.48" />
                <GradientStop Color="#DC9A08" Offset="1" />
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WelcomeIconFill" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FFD471" Offset="0" />
                <GradientStop Color="#F2B41C" Offset="0.48" />
                <GradientStop Color="#DC9A08" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="WelcomeIconRing">#CF9105</Color>
            <Color x:Key="WelcomeIconInk">#2A1C00</Color>
            <BoxShadows x:Key="WelcomeIconShadow">inset 0 1 0 0 #80FFFFFF, 0 8 18 -10 #80BE8200</BoxShadows>

            <BoxShadows x:Key="ShadowSm">0 1 3 0 #33000000</BoxShadows>
            <BoxShadows x:Key="ShadowSubtle">0 2 8 0 #3D000000</BoxShadows>
            <BoxShadows x:Key="ShadowCard">0 16 40 0 #2E000000</BoxShadows>
            <BoxShadows x:Key="ShadowHover">0 26 60 0 #57000000</BoxShadows>
            <BoxShadows x:Key="ShadowModal">0 50 120 0 #A6000000</BoxShadows>

            <Color x:Key="ActionBorderHover">#FFD9990A</Color>
            <Color x:Key="DangerInk">#FF9A73</Color>
            <Color x:Key="DangerWash">#1FFF7846</Color>
            <Color x:Key="OpenHoverFill">#1AFFCD2D</Color>
            <Color x:Key="OpenHoverBorder">#4DFFCD2D</Color>
            <Color x:Key="ModeIconUnique">#EAA063</Color>


        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Radii, because the design system has five of them and they keep reappearing.
         Outside the themes: a corner is the same corner in the evening. -->
    <CornerRadius x:Key="RadiusSm">4</CornerRadius>
    <CornerRadius x:Key="RadiusMd">6</CornerRadius>
    <CornerRadius x:Key="RadiusLg">8</CornerRadius>
    <CornerRadius x:Key="RadiusXl">12</CornerRadius>
    <CornerRadius x:Key="Radius2Xl">18</CornerRadius>

</ResourceDictionary>
