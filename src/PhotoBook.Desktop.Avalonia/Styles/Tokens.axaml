<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The palette, in two themes, transcribed from the 2.2 design prototype (see
        doc/DESIGN-2.2.md §4 for the source lines and the numbers).

        Every value below is one the prototype uses. Nothing here is invented: a difference
        in a screenshot from this point on is a difference in the engine, not in the design.

        The two themes carry the same names and different values, which is what makes one
        screen work in both. "Default" is the light theme: Avalonia falls back to it whenever
        a scope asks for the light variant, so the file does not repeat ninety-odd keys a
        third time under the name "Light".

        Colours are plain Colors rather than brushes. Avalonia will convert a Color wherever
        a brush is expected, and a Color cannot be mistaken for a frozen brush - which in the
        WPF theme is how a frozen resource ended up somewhere it could not be unfrozen.

        The numbered families (Slate, Brand, Emerald, Sky, Amber, Red) are the old design
        system's names, kept because the views written against them still use them. They now
        hold the new palette's values, so those views follow the theme even before they are
        rewritten. New work uses the semantic names below them.
    -->

    <ResourceDictionary.ThemeDictionaries>

        <!-- =============================== light =============================== -->
        <!-- Warm paper: a photograph sits on this, so nothing in it is cold. -->
        <ResourceDictionary x:Key="Default">

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ brand ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!-- The accent is gold, and what sits on it is ink rather than white. -->
            <Color x:Key="Brand50">#F8F1E0</Color>
            <Color x:Key="Brand100">#F2E5C8</Color>
            <Color x:Key="Brand200">#E6D2A4</Color>
            <Color x:Key="Brand400">#D6A31F</Color>
            <Color x:Key="Brand500">#BD8B06</Color>
            <Color x:Key="Brand600">#A87400</Color>
            <Color x:Key="Brand700">#8A6000</Color>

            <Color x:Key="Indigo50">#F8F1E0</Color>
            <Color x:Key="Indigo100">#F2E5C8</Color>
            <Color x:Key="Indigo400">#D6A31F</Color>
            <Color x:Key="Indigo600">#A87400</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ slate ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <Color x:Key="Slate50">#0E4A3A1C</Color>
            <Color x:Key="Slate100">#F1E9D8</Color>
            <Color x:Key="Slate200">#214A3A1C</Color>
            <Color x:Key="Slate300">#3B4A3A1C</Color>
            <Color x:Key="Slate400">#8A7C63</Color>
            <Color x:Key="Slate500">#776A53</Color>
            <Color x:Key="Slate600">#42392A</Color>
            <Color x:Key="Slate700">#2B2417</Color>
            <Color x:Key="Slate800">#2B2417</Color>
            <Color x:Key="Slate900">#2B2417</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ status ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                Status keeps the colours the program already uses. The prototype's teal and
                warm orange are a change of meaning across the whole product - the tray icon
                and the installer included - and that is a decision, not a detail.
            -->
            <Color x:Key="Emerald50">#ECFDF5</Color>
            <Color x:Key="Emerald100">#D1FAE5</Color>
            <Color x:Key="Emerald200">#A7F3D0</Color>
            <Color x:Key="Emerald500">#10B981</Color>
            <Color x:Key="Emerald600">#059669</Color>
            <Color x:Key="Emerald700">#047857</Color>

            <Color x:Key="Sky50">#F0F9FF</Color>
            <Color x:Key="Sky100">#E0F2FE</Color>
            <Color x:Key="Sky200">#BAE6FD</Color>
            <Color x:Key="Sky500">#0EA5E9</Color>
            <Color x:Key="Sky600">#0284C7</Color>
            <Color x:Key="Sky700">#0369A1</Color>

            <Color x:Key="Amber50">#FFFBEB</Color>
            <Color x:Key="Amber100">#FEF3C7</Color>
            <Color x:Key="Amber200">#FDE68A</Color>
            <Color x:Key="Amber400">#FBBF24</Color>
            <Color x:Key="Amber500">#F59E0B</Color>
            <Color x:Key="Amber600">#D97706</Color>
            <Color x:Key="Amber700">#B45309</Color>

            <Color x:Key="Red50">#FEF2F2</Color>
            <Color x:Key="Red100">#FEE2E2</Color>
            <Color x:Key="Red200">#FECACA</Color>
            <Color x:Key="Red400">#F87171</Color>
            <Color x:Key="Red500">#EF4444</Color>
            <Color x:Key="Red600">#DC2626</Color>
            <Color x:Key="Red700">#B91C1C</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~ semantics ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!-- The names new markup uses. One of each per theme. -->
            <Color x:Key="AppBackground">#F2EADC</Color>
            <Color x:Key="Surface">#FAF6EA</Color>
            <Color x:Key="SurfaceMuted">#F1E9D8</Color>
            <Color x:Key="SurfaceRaised">#F1E9D8</Color>
            <Color x:Key="SurfaceModal">#FDFAF1</Color>
            <Color x:Key="BorderSubtle">#124A3A1C</Color>
            <Color x:Key="BorderDefault">#214A3A1C</Color>
            <Color x:Key="BorderStrong">#3B4A3A1C</Color>
            <Color x:Key="TextStrong">#2B2417</Color>
            <Color x:Key="TextDefault">#42392A</Color>
            <Color x:Key="TextMuted">#776A53</Color>
            <Color x:Key="TextFaint">#8A7C63</Color>
            <Color x:Key="TextLink">#A87400</Color>

            <Color x:Key="Accent">#A87400</Color>
            <Color x:Key="AccentStrong">#8A6000</Color>
            <!-- The ink that sits on a filled accent button. Never white: gold takes ink. -->
            <Color x:Key="OnAccent">#2A1E00</Color>

            <!-- The gold a filled control is filled with, and the line that defines it.
                 The prototype keeps the same gold in both themes, and so does this. -->
            <Color x:Key="Gold">#F2B41C</Color>
            <Color x:Key="GoldDeep">#CF9105</Color>
            <!-- A filled gold control lifts on hover and settles on press, the way the
                 prototype's does. Darkening it would read as a door instead of a lamp. -->
            <Color x:Key="GoldHover">#F8BF2B</Color>
            <Color x:Key="GoldPressed">#E7A80F</Color>

            <!-- A chip that lies on a picture: the folder card's book number and its open
                 arrow. Dark in both themes, because it is a label on an image and not a
                 surface of the page - the numbered scale flips with the theme, and a chip
                 that turned white at night would sit on the picture like a hole. -->
            <Color x:Key="OverlayChipFill">#B8140F09</Color>
            <Color x:Key="OverlayChipInk">#FFFFEEC2</Color>

            <!-- A filled action, in each theme's own tone. On warm paper the prototype does
                 not lay a solid gold slab - that is a lamp in a lit room - but a 24% gold tint
                 with a gold line and deep-gold words on it. In the evening the same button is
                 the gold itself, because that is the only warm thing on a graphite page. -->
            <Color x:Key="ActionFill">#3DFFC43C</Color>
            <Color x:Key="ActionFillHover">#57FFC43C</Color>
            <Color x:Key="ActionFillPressed">#33FFC43C</Color>
            <Color x:Key="ActionBorder">#61B07B00</Color>
            <Color x:Key="ActionInk">#8A5F00</Color>

            <!-- What gives the filled action its thickness. The prototype's own
                 numbers: a hairline of light inside the top edge and a brown descent
                 below, so the button is a raised cap of paint rather than a tinted
                 rectangle. -->
            <BoxShadows x:Key="ActionShadow">inset 0 1 0 0 #99FFFFFF, 0 6 16 -12 #B358421C</BoxShadows>
            <BoxShadows x:Key="ActionShadowHover">inset 0 1 0 0 #B3FFFFFF, 0 8 20 -12 #B358421C</BoxShadows>
            <BoxShadows x:Key="ActionShadowPressed">inset 0 2 4 0 #33785A14, 0 1 2 0 #1A785A14</BoxShadows>

            <!-- The same cap with nothing to press. The prototype keeps the raised edge of a
                 filled button it cannot press in daylight, because its disabled rule never
                 outranks the base shadow, and paints the same button flat at night. Both are
                 copied rather than tidied: the raised cap is what makes the press answer read
                 as a press. -->
            <BoxShadows x:Key="ActionShadowOff">inset 0 1 0 0 #99FFFFFF, 0 6 16 -12 #B358421C</BoxShadows>
            <BoxShadows x:Key="ActionShadowOffHover">inset 0 1 0 0 #B3FFFFFF, 0 8 20 -12 #B358421C</BoxShadows>

            <!-- The line a card takes under the pointer. Gold, not a darker hairline: it is
                 the card answering, and the answer is the product's colour. -->
            <Color x:Key="BorderAccentHover">#59B07B00</Color>

            <!-- The mat behind a photograph, and the tray a group of tabs sits in. -->
            <Color x:Key="MatSurface">#E2D7C1</Color>
            <Color x:Key="TabTray">#0F4A3A1C</Color>

            <!-- The chosen tab is a cream card lifted off the tray. The prototype paints it
                 with the same 180-degree gradient its cards use, so it reads as paper standing
                 on a tray - a flat near-white pill on warm paper reads as a hole cut through
                 it, which is what this screen had. -->
            <LinearGradientBrush x:Key="TabSelectedFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#FFFDF6" Offset="0" />
                <GradientStop Color="#FBF4E3" Offset="1" />
            </LinearGradientBrush>

            <!-- A tab under the pointer, before it is chosen: the tray warms where the pointer
                 is. A tab that is not current cannot change its words, so this is the only
                 answer it has. -->
            <Color x:Key="TabHoverFill">#0E4A3A1C</Color>

            <!-- The chosen tab stands above the tray, and a shadow is what says "above".

                 The prototype's two shadows, number for number: the hairline it draws inside
                 the card, and a descent of 0 2px 8px at 14%. Brown, not black - a grey shadow
                 on warm paper is a smudge. It only ever showed as a one-pixel rim until the
                 tab stopped clipping its own template; see Header.axaml. -->
            <BoxShadows x:Key="TabLift">inset 0 0 0 1 #124A3A1C, 0 2 8 0 #244A3A1C</BoxShadows>

            <!-- The welcome panel is lit from its top-right corner: a warm glow laid over the
                 card, not part of it, because a control carries one brush and the prototype
                 paints a radial glow on top of a card gradient. -->
            <RadialGradientBrush x:Key="WelcomeGlow" Center="90%,4%" GradientOrigin="90%,4%"
                                 RadiusX="43%" RadiusY="50%">
                <GradientStop Color="#40FFC428" Offset="0" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <!-- The halo behind the stack of pages: the same gold, softer, fading by 68%. -->
            <RadialGradientBrush x:Key="WelcomeHalo" Center="50%,50%" GradientOrigin="50%,50%"
                                 RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#33FFC428" Offset="0" />
                <GradientStop Color="#0DFFC428" Offset="0.46" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <!-- The two hairlines of the halo, and the paper the photographs are mounted on.
                 The paper stays cream in both themes: it is a photograph on a desk, not a
                 surface of the program. -->
            <!-- Daylight hairlines are brown rather than gold: gold at a fifth of its
                 strength on cream vanishes into the paper, which is exactly what the
                 two rings did before this line. -->
            <Color x:Key="WelcomeRing">#33B07B00</Color>
            <Color x:Key="WelcomeRingFaint">#24B07B00</Color>
            <Color x:Key="PhotoSheet">#FBF7EE</Color>

            <!-- The chip on the stack: a dark glass pill with a gold hairline. -->
            <Color x:Key="WelcomeChipFill">#EBFFFDF7</Color>
            <Color x:Key="WelcomeChipBorder">#4DB07B00</Color>
            <Color x:Key="WelcomeChipInk">#42392A</Color>
            <BoxShadows x:Key="WelcomeChipShadow">0 14 34 0 #2958421C</BoxShadows>

            <!-- The dim over the page behind a modal panel. -->
            <Color x:Key="Backdrop">#6B3A301E</Color>

            <!-- Recessed wells: a list of photographs, an input, a step container. -->
            <Color x:Key="Sunken">#0F4A3A1C</Color>
            <Color x:Key="SunkenSoft">#0B4A3A1C</Color>
            <Color x:Key="SunkenFaint">#064A3A1C</Color>

            <!--
                Translucent tints the design uses in more than one place. Avalonia writes
                colour as AARRGGBB, not the CSS RRGGBBAA, so these are spelled once here
                rather than guessed at each use - a colour string this engine cannot parse
                is a crash at startup, not a wrong shade.
            -->
            <Color x:Key="Slate200At70">#B3E2D7C1</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~ the folder picker ~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                The panel's own numbers, read off the prototype's .pk-* rules. The gradients
                are gold at fixed values and therefore the same in both themes; the washes are
                the page's own ink, so they stack as translucent layers the way the
                stylesheet's rgba() ones do - a hovered row inside the side column is a wash
                on a wash, not a second flat colour.
            -->
            <Color x:Key="PickerChipWash">#0D4A3A1C</Color>
            <Color x:Key="PickerChipRing">#144A3A1C</Color>
            <!--
                The place whose folders are on screen. On paper the prototype lights it with a
                wash of gold, not with the page's own ink: a grey row on cream is the same
                rectangle as the rows above it, only heavier.
            -->
            <Color x:Key="PickerPlaceActive">#29FFCD3C</Color>
            <Color x:Key="PickerPlaceRing">#0E4A3A1C</Color>
            <Color x:Key="PickerBookEdge">#24FFFFFF</Color>
            <BoxShadows x:Key="PickerPlaceRingShadow">inset 0 0 0 1 #0E4A3A1C</BoxShadows>
            <BoxShadows x:Key="PickerBarGlow">0 0 12 0 #B3F2B41C</BoxShadows>

            <!-- The tray the two view buttons sit in, and the card the chosen one becomes. -->
            <BoxShadows x:Key="PickerViewTrayRing">inset 0 0 0 1 #0F4A3A1C</BoxShadows>
            <Color x:Key="PickerViewActiveFill">#FFFDF6</Color>
            <BoxShadows x:Key="PickerViewActiveShadow">0 1 3 0 #2E58421C</BoxShadows>

            <!-- The box of a folder in the list view, before and after it is ticked. -->
            <Color x:Key="PickerBoxFill">#B8FFFFFF</Color>

            <!-- The first-run page of a combined project: the gold wash of its small
                 plates, the dashed frame of the drop zone, and the faint tiles of the
                 plan rows. -->
            <Color x:Key="CombinedWash">#29FFCE3C</Color>
            <Color x:Key="CombinedWashRing">#42B07B00</Color>
            <Color x:Key="CombinedDashedRing">#66B07B00</Color>
            <Color x:Key="CombinedDashedRingHover">#99B07B00</Color>
            <Color x:Key="CombinedEmptyFill">#0A4A3A1C</Color>
            <Color x:Key="CombinedEmptyRing">#244A3A1C</Color>
            <RadialGradientBrush x:Key="CombinedDropFill" Center="50%,40%" GradientOrigin="50%,40%"
                                 RadiusX="60%" RadiusY="60%">
                <GradientStop Color="#38FFC43C" Offset="0" />
                <GradientStop Color="#00FFC43C" Offset="0.7" />
            </RadialGradientBrush>
            <Color x:Key="PickerBoxRing">#384A3A1C</Color>

            <!-- The light of a lamp in the panel's top-left corner, over a warm wash down the
                 whole band. Two gradients, because a brush carries one. -->
            <RadialGradientBrush x:Key="PickerHeadGlow" Center="5%,0%" GradientOrigin="5%,0%"
                                 RadiusX="38%" RadiusY="150%">
                <GradientStop Color="#1CFFCD2D" Offset="0" />
                <GradientStop Color="#00FFCD2D" Offset="0.72" />
            </RadialGradientBrush>
            <LinearGradientBrush x:Key="PickerHeadWash" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#0AFFCD2D" Offset="0" />
                <GradientStop Color="#00FFCD2D" Offset="1" />
            </LinearGradientBrush>

            <!-- The seal: a cream cap with a hairline ring inside it, the way every other mark
                 in the program is plated by daylight. A cap of gold on paper was the loudest
                 thing on a page lit by the sun; at night it stays the gold the design draws. -->
            <LinearGradientBrush x:Key="PickerBadgeFill" StartPoint="50%,0%" EndPoint="30%,100%">
                <GradientStop Color="#FCF1D4" Offset="0" />
                <GradientStop Color="#FBEAC0" Offset="1" />
            </LinearGradientBrush>
            <BoxShadows x:Key="PickerBadgeShadow">inset 0 1 0 0 #B3FFFFFF, inset 0 0 0 1 #61B07B00, 0 10 22 -14 #BF58421C</BoxShadows>
            <Color x:Key="PickerBadgeInk">#8A5F00</Color>

            <!-- The plate that says what the project already holds, and the bar that says how
                 much of the result this visit adds. -->
            <LinearGradientBrush x:Key="PickerProjectFill" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#1AFFCD2D" Offset="0" />
                <GradientStop Color="#05FFCD2D" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="PickerProjectRing">#24FFCD2D</Color>
            <Color x:Key="PickerBarTrack">#1A4A3A1C</Color>
            <LinearGradientBrush x:Key="PickerBarFill" StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#F2B41C" Offset="0" />
                <GradientStop Color="#FFD977" Offset="1" />
            </LinearGradientBrush>

            <!-- A folder card: a wash of the panel's ink at rest, a warmer one under the
                 pointer, and a gold-lit gradient once it is chosen. -->
            <Color x:Key="PickerCardFill">#064A3A1C</Color>
            <Color x:Key="PickerCardHover">#0A4A3A1C</Color>
            <Color x:Key="PickerCardLineHover">#244A3A1C</Color>
            <LinearGradientBrush x:Key="PickerCardChosen" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#13FFCD2D" Offset="0" />
                <GradientStop Color="#04FFCD2D" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="PickerCardChosenRing">#6BFFCD2D</Color>
            <BoxShadows x:Key="PickerCardChosenShadow">0 16 32 -20 #99F2B41C, inset 0 0 0 1 #14FFCD2D</BoxShadows>
            <BoxShadows x:Key="PickerCardLift">0 14 28 -18 #D9000000</BoxShadows>

            <RadialGradientBrush x:Key="PickerCoverGlow" Center="50%,0%" GradientOrigin="50%,0%"
                                 RadiusX="120%" RadiusY="90%">
                <GradientStop Color="#0FF2B41C" Offset="0" />
                <GradientStop Color="#00F2B41C" Offset="0.72" />
            </RadialGradientBrush>
            <Color x:Key="PickerCoverRing">#0D4A3A1C</Color>
            <Color x:Key="PickerSumFill">#084A3A1C</Color>
            <Color x:Key="PickerSumRing">#0E4A3A1C</Color>

            <!-- The tick, and the gold cap of the filled action. -->
            <LinearGradientBrush x:Key="PickerTickFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#FFE066" Offset="0" />
                <GradientStop Color="#F2B41C" Offset="1" />
            </LinearGradientBrush>
            <BoxShadows x:Key="PickerTickShadow">0 3 10 0 #73F2B41C, inset 0 1 0 0 #73FFFFFF</BoxShadows>
            <BoxShadows x:Key="PickerBookRing">inset 0 0 0 1 #24FFFFFF</BoxShadows>
            <Color x:Key="PickerOpenFill">#8C140F09</Color>
            <!--
                The folder on the picture of a chosen card. It is pale gold at night, where it
                catches the lamp on a dark cover; on paper that same pale gold is invisible
                against the warm light of the cover, so there it is the darker gold the other
                folder marks are drawn in.
            -->
            <Color x:Key="PickerOnIcon">#A97400</Color>
            <BoxShadows x:Key="PickerButtonShadow">0 2 5 0 #4D000000, inset 0 -2 0 0 #388C5600</BoxShadows>

            <!-- The close ring under the pointer, in the gold the prototype answers with. -->
            <Color x:Key="PickerIconRing">#8CE0AC57</Color>
            <Color x:Key="PickerIconWash">#14E0AC57</Color>

            <!-- The tray of an empty column: a gold light with its own hairline. -->
            <RadialGradientBrush x:Key="PickerEmptyFill" Center="50%,40%" GradientOrigin="50%,40%"
                                 RadiusX="60%" RadiusY="60%">
                <GradientStop Color="#38FFCD2D" Offset="0" />
                <GradientStop Color="#0DFFCD2D" Offset="1" />
            </RadialGradientBrush>
            <Color x:Key="PickerEmptyRing">#38FFCD2D</Color>

            <!-- The page, as the prototype draws it: a warm wash from the top down, not one
                 flat colour. A flat fill reads as a screenshot of the design, not the design. -->
            <LinearGradientBrush x:Key="PageBackdrop" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#F7F1E6" Offset="0" />
                <GradientStop Color="#F3EBDE" Offset="0.6" />
                <GradientStop Color="#EFE6D6" Offset="1" />
            </LinearGradientBrush>

            <!--
                The light the page stands in: the prototype's two radial washes over its
                vertical one, in its numbers. 1300x820 at 50% -18% is the sun over the top
                of the page; 900x600 at 100% 108% is the shade its lower right corner sits
                in. Both are written as percentages of the page, so they hold their shape
                when the window changes - the pixel figures are what they come to at the
                program's usual 1600x860.
            -->
            <RadialGradientBrush x:Key="PageGlow" Center="50%,-18%" GradientOrigin="50%,-18%"
                                 RadiusX="81%" RadiusY="95%">
                <GradientStop Color="#73FFE8AA" Offset="0" />
                <GradientStop Color="#00FFE8AA" Offset="0.64" />
            </RadialGradientBrush>

            <RadialGradientBrush x:Key="PageGlowCorner" Center="100%,108%" GradientOrigin="100%,108%"
                                 RadiusX="56%" RadiusY="70%">
                <GradientStop Color="#24D6C4A0" Offset="0" />
                <GradientStop Color="#00D6C4A0" Offset="0.6" />
            </RadialGradientBrush>

            <!-- A card is lighter at its top edge than at its foot, by two percent. -->
            <LinearGradientBrush x:Key="CardFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#FFFDF7" Offset="0" />
                <GradientStop Color="#FAF6EA" Offset="0.42" />
                <GradientStop Color="#FAF6EA" Offset="1" />
            </LinearGradientBrush>


            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~ the shell ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                The header is a pane of glass over the page: the prototype's topbar is
                translucent with a blur, and a window that cannot blur what is behind it
                still shows the tint through. The gold line along its top edge is one pixel
                of light rather than a frame, and it fades out at both ends.
            -->
            <Color x:Key="TopBarGlass">#D1FAF6EC</Color>
            <LinearGradientBrush x:Key="TopBarEdge" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#00B07B00" Offset="0" />
                <GradientStop Color="#50B07B00" Offset="0.5" />
                <GradientStop Color="#00B07B00" Offset="1" />
            </LinearGradientBrush>
            <BoxShadows x:Key="TopBarShadow">0 1 0 0 #0D4A3A1C, 0 12 32 0 #0F4A3A1C</BoxShadows>

            <!--
                A mode card on the start screen, in the prototype's own numbers. Its shadow is
                large and soft rather than a hairline descent: the card is a sheet of paper
                standing off the page, drawn with eighteen of offset and forty-four of blur at
                twelve percent of brown, and a second, tighter descent under its edge.
            -->
            <BoxShadows x:Key="ModeCardShadow">0 18 44 0 #1F58421C, 0 2 6 0 #0D58421C</BoxShadows>
            <BoxShadows x:Key="ModeCardShadowHover">0 26 56 0 #2B58421C, 0 0 0 1 #1FD6A014</BoxShadows>

            <!-- The frame answers the pointer in gold, and the recommended card wears a gold
                 ring that is brightest at its top-left and gone by the far corner. -->
            <Color x:Key="ModeCardBorderHover">#59B07B00</Color>
            <LinearGradientBrush x:Key="ModeCardFeaturedRing" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#2EB07B00" Offset="0" />
                <GradientStop Color="#00B07B00" Offset="0.3" />
                <GradientStop Color="#00B07B00" Offset="0.7" />
                <GradientStop Color="#0FB07B00" Offset="1" />
            </LinearGradientBrush>

            <!-- The recommended card is lit from its top-right corner, inside the card rather
                 than behind it: a glow drawn outside a rounded card spills past its corners. -->
            <RadialGradientBrush x:Key="ModeCardGlowFill" Center="110%,-10%" GradientOrigin="110%,-10%"
                                 RadiusX="90%" RadiusY="48%">
                <GradientStop Color="#38FFBA28" Offset="0" />
                <GradientStop Color="#00FFBA28" Offset="0.7" />
            </RadialGradientBrush>

            <!-- The lamp of the first-run card: one round light in its top-right corner, of a
                 size of its own rather than a share of the card. The mode card's glow is a
                 share, which suits a card it was drawn for; on a card this tall the same
                 share covers the whole of it and reads as a rectangle of another colour
                 laid over the paper. The radii make a circle of the card's own scale, and
                 the second stop is where the light is gone. -->
            <RadialGradientBrush x:Key="StarterGlowFill" Center="50%,50%" GradientOrigin="50%,50%"
                                 RadiusX="43%" RadiusY="50%">
                <GradientStop Color="#29FFBA28" Offset="0" />
                <GradientStop Color="#00FFBA28" Offset="0.72" />
            </RadialGradientBrush>

            <!-- The plate a mode's mark sits on: a gold tile with a hairline ring inside it. -->
            <LinearGradientBrush x:Key="ModePlateFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#7BFCF0D6" Offset="0" />
                <GradientStop Color="#3DFFC43C" Offset="0.62" />
                <GradientStop Color="#3DFFC43C" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="ModePlateRing">#61B07B00</Color>
            <Color x:Key="ModePlateInnerRing">#33B07B00</Color>
            <Color x:Key="ModePlateInk">#8A5F00</Color>
            <BoxShadows x:Key="ModePlateShadow">inset 0 1 0 0 #99FFFFFF, 0 8 18 -12 #B358421C</BoxShadows>

            <!-- The one line the recommended mode leads with: a warm box inside the card. -->
            <LinearGradientBrush x:Key="CalloutFill" StartPoint="0%,0%" EndPoint="35%,100%">
                <GradientStop Color="#3DFFCE3C" Offset="0" />
                <GradientStop Color="#1AFFCE3C" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="CalloutBorder">#52B07B00</Color>
            <Color x:Key="CalloutTitle">#7D5900</Color>
            <Color x:Key="CalloutText">#6C5A3C</Color>

            <!-- The "Рекомендуем" tag is a cap of gold, not a pale wash. -->
            <LinearGradientBrush x:Key="TagAccentFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#F9C53C" Offset="0" />
                <GradientStop Color="#EAA60D" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="TagAccentInk">#2A1C00</Color>
            <BoxShadows x:Key="TagAccentShadow">inset 0 1 0 0 #73FFFFFF, 0 4 14 0 #38B47D00</BoxShadows>

            <!-- The tray the tabs sit in. The ring around the chosen one is part of its
                 shadow, where the prototype puts it, so it cannot drift from the fill. -->
            <Color x:Key="TabTrayBorder">#144A3A1C</Color>

            <!-- What a quiet icon shows under the pointer, and under a press. -->
            <Color x:Key="HoverWash">#0D4A3A1C</Color>
            <Color x:Key="ActiveWash">#174A3A1C</Color>

            <!-- The glow the company's mark carries, and the gradient the product's second
                 word is cut out of. -->
            <Color x:Key="LogoGlowColor">#59AA7D00</Color>
            <LinearGradientBrush x:Key="BrandNameTail" StartPoint="0%,0%" EndPoint="100%,0%">
                <GradientStop Color="#C99100" Offset="0" />
                <GradientStop Color="#8A6000" Offset="1" />
            </LinearGradientBrush>

            <!-- The account's avatar: gold, and the ink that reads on it. -->
            <Color x:Key="AvatarInk">#2A1C00</Color>
            <Color x:Key="AvatarRing">#CF9105</Color>
            <LinearGradientBrush x:Key="AvatarFill" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#FFD471" Offset="0" />
                <GradientStop Color="#F2B41C" Offset="0.48" />
                <GradientStop Color="#DC9A08" Offset="1" />
            </LinearGradientBrush>

            <!-- The three marks under the welcome panel are not the avatar. By day the
                 prototype washes them to a quarter-strength gold with a white sheen on
                 top and writes them in deep gold; at night they are the gold itself.
                 Separate keys, because sharing the avatar would repaint the account too. -->
            <LinearGradientBrush x:Key="WelcomeIconFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#7BFCF0D6" Offset="0" />
                <GradientStop Color="#3DFFC43C" Offset="0.62" />
                <GradientStop Color="#3DFFC43C" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="WelcomeIconRing">#61B07B00</Color>
            <Color x:Key="WelcomeIconInk">#8A5F00</Color>
            <BoxShadows x:Key="WelcomeIconShadow">inset 0 1 0 0 #99FFFFFF, 0 10 22 -14 #BF58421C</BoxShadows>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~ shadows ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                BoxShadow instead of DropShadowEffect. Blur and depth are the prototype's;
                the colour is brown in the light theme and black in the dark one, because a
                grey shadow on warm paper is a smudge.
            -->
            <BoxShadows x:Key="ShadowSm">0 1 3 0 #1258421C</BoxShadows>
            <BoxShadows x:Key="ShadowSubtle">0 2 8 0 #1458421C</BoxShadows>
            <BoxShadows x:Key="ShadowCard">0 8 24 0 #1A58421C</BoxShadows>
            <BoxShadows x:Key="ShadowHover">0 14 34 0 #2458421C</BoxShadows>
            <BoxShadows x:Key="ShadowModal">0 30 70 0 #4D58421C</BoxShadows>

            <!-- ~~~~~~~~~~~~~~~~~~ saved projects and the delete panel ~~~~~~~~ -->

            <!-- The filled action deepens its gold line as the fill warms, which is what the
                 prototype's light theme does under the pointer. -->
            <Color x:Key="ActionBorderHover">#80B07B00</Color>

            <!-- A delete under the pointer: the red the prototype uses for a destructive
                 icon, pale enough to stay a warning rather than an alarm. -->
            <Color x:Key="DangerInk">#B4461F</Color>
            <Color x:Key="DangerWash">#13B4461F</Color>

            <!-- The block that reports a broken choice stands over the folder list, so its
                 fill is opaque and its words are read against it: a wash let the names behind
                 the block show through the sentence that explains the mistake. -->
            <Color x:Key="DangerPaperFill">#FCEEE7</Color>
            <Color x:Key="DangerPaperRing">#EFC3B3</Color>

            <!-- "Открыть проект" warms toward gold under the pointer. -->
            <Color x:Key="OpenHoverFill">#1AFFCD2D</Color>
            <Color x:Key="OpenHoverBorder">#4DFFCD2D</Color>
            <!-- The edge of a panel over the page, and the tray its buttons sit in. The
                 shadow is the prototype's: two brown descents and a hairline of white inside
                 the top edge, which is what makes the panel stand off the dimmed page. -->
            <Color x:Key="ModalEdge">#1F4A3A1C</Color>
            <Color x:Key="ModalFootFill">#094A3A1C</Color>
            <BoxShadows x:Key="ModalShadow">0 50 110 0 #473C2D14, 0 6 20 0 #1F3C2D14, inset 0 1 0 0 #FFFFFF</BoxShadows>

            <!-- The warning tile of the delete panel: a warm red wash behind a red mark,
                 with the hairline the prototype draws inside it. -->
            <LinearGradientBrush x:Key="DangerTileFill" StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#24C85532" Offset="0" />
                <GradientStop Color="#0DC85532" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="DangerTileBorder">#42B4461F</Color>
            <BoxShadows x:Key="DangerTileShadow">inset 0 1 0 0 #80FFFFFF</BoxShadows>
            <LinearGradientBrush x:Key="DangerHeadWash" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#12C85532" Offset="0" />
                <GradientStop Color="#00C85532" Offset="1" />
            </LinearGradientBrush>

            <!-- The destructive action of a panel: a red cap of paint with a light top edge,
                 lifted a pixel under the pointer. -->
            <LinearGradientBrush x:Key="DangerButtonFill" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#D9563A" Offset="0" />
                <GradientStop Color="#BD3F24" Offset="1" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DangerButtonFillHover" StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#E1603F" Offset="0" />
                <GradientStop Color="#C44528" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="DangerButtonBorder">#A8341A</Color>
            <Color x:Key="DangerButtonBorderHover">#B93A19</Color>
            <Color x:Key="DangerButtonInk">#FFF6F2</Color>
            <BoxShadows x:Key="DangerButtonShadow">0 2 5 0 #3D5A1E0A, inset 0 1 0 0 #38FFFFFF</BoxShadows>
            <BoxShadows x:Key="DangerButtonShadowHover">0 8 18 0 #4278280F, inset 0 1 0 0 #3DFFFFFF</BoxShadows>
            <BoxShadows x:Key="DangerButtonShadowPressed">inset 0 2 4 0 #665A1405</BoxShadows>

            <!-- The line that says the photographs are not part of what is being deleted. -->
            <Color x:Key="KeepInk">#0D8B79</Color>
            <Color x:Key="KeepFill">#0F0D8B79</Color>
            <Color x:Key="KeepBorder">#330D8B79</Color>

            <!-- The mode mark inside the delete panel's target row. -->
            <Color x:Key="ModeMarkFill">#14FFCD2D</Color>
            <BoxShadows x:Key="ModeMarkShadow">inset 0 0 0 1 #2EFFCD2D</BoxShadows>

            <!-- The folders mode carries amber and the combined one the product gold, so the
                 two are told apart by the mark before the word is read. -->
            <Color x:Key="ModeIconUnique">#B25F10</Color>

            <!-- ~~~~~~~~~~~~~ the quiet fields of a card, and the pill ~~~~~~~~~~ -->
            <!--
                A field on a card is a wash of the card's own ink rather than a shadow sunk
                into it: the prototype mixes the card's own ink at a few percent, which is
                brown at noon and white in the evening. Sunken* is the other thing - it is
                darker than the surface in both themes - and used here it made the open
                button and the basket read as holes punched in a dark card.
            -->
            <Color x:Key="FieldFill">#084A3A1C</Color>
            <Color x:Key="FieldBorder">#0F4A3A1C</Color>
            <Color x:Key="QuietFill">#0B4A3A1C</Color>
            <Color x:Key="QuietBorder">#144A3A1C</Color>
            <Color x:Key="QuietFillHover">#134A3A1C</Color>
            <Color x:Key="QuietBorderHover">#294A3A1C</Color>

            <!-- The pill's three answers: a draft is grey, a book being assembled is amber,
                 a finished one is teal, and the dot is the text's own colour. -->
            <Color x:Key="StatusMutedInk">#776A53</Color>
            <Color x:Key="StatusMutedFill">#0E4A3A1C</Color>
            <Color x:Key="StatusMutedBorder">#0F4A3A1C</Color>
            <Color x:Key="StatusWarnInk">#A8570C</Color>
            <Color x:Key="StatusWarnFill">#1FBE6919</Color>
            <Color x:Key="StatusWarnBorder">#40AA5F14</Color>
            <Color x:Key="StatusTealInk">#0B7A69</Color>
            <Color x:Key="StatusTealFill">#1A0D8B79</Color>
            <Color x:Key="StatusTealBorder">#330D8B79</Color>

            <!-- ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~ the guide ~~~~~~~~~~~~~~~~~~~~~~~~~~ -->
            <!--
                The manual is a page of type on paper rather than a set of cards, so it needs
                inks of its own: the prototype writes its small capitals in a deeper gold than
                the accent by day, and in the gold itself at night.

                "Mock" is the drawn window in chapter one and the empty screenshot frames:
                washes of the page's own ink, which are brown on paper and white in the evening.
                The gold washes stay the same gold in both themes, as the prototype's do.
            -->
            <Color x:Key="ManualAccent">#8A5F00</Color>
            <Color x:Key="ManualPageMat">#F3EBDE</Color>
            <Color x:Key="ManualRule">#214A3A1C</Color>
            <Color x:Key="ManualRuleStrong">#3B4A3A1C</Color>
            <Color x:Key="ManualMockTop">#0B4A3A1C</Color>
            <Color x:Key="ManualMockBottom">#034A3A1C</Color>
            <Color x:Key="ManualMockDot">#294A3A1C</Color>
            <Color x:Key="ManualMockLineSoft">#1F4A3A1C</Color>
            <Color x:Key="ManualMockLine">#1A4A3A1C</Color>
            <Color x:Key="ManualMockCard">#084A3A1C</Color>
            <Color x:Key="ManualGold55">#8CF2B41C</Color>
            <Color x:Key="ManualGold50">#80F2B41C</Color>
            <Color x:Key="ManualGold40">#66F2B41C</Color>
            <Color x:Key="ManualGold28">#47F2B41C</Color>
            <Color x:Key="ManualGold06">#0FF2B41C</Color>
            <Color x:Key="ManualFrameBorder">#47B07B00</Color>
            <Color x:Key="ManualFrameTop">#29FFCE3C</Color>
            <Color x:Key="ManualFrameTagBorder">#124A3A1C</Color>
            <Color x:Key="ManualPinFill">#EAB223</Color>
            <Color x:Key="ManualPinBorder">#C89100</Color>
            <Color x:Key="ManualPinInk">#2A1E00</Color>
            <BoxShadows x:Key="ManualPinShadow">0 4 10 0 #40785A14</BoxShadows>
            <Color x:Key="ManualSealBorder">#61B07B00</Color>
            <Color x:Key="ManualSealRing">#33B07B00</Color>
            <Color x:Key="ManualSealInk">#8A5F00</Color>
            <LinearGradientBrush x:Key="ManualSealFill" StartPoint="0%,0%" EndPoint="41%,100%">
                <GradientStop Color="#FCF1D4" Offset="0" />
                <GradientStop Color="#FBEAC0" Offset="1" />
            </LinearGradientBrush>
            <BoxShadows x:Key="ManualSealShadow">inset 0 1 0 0 #8CFFFFFF, 0 10 22 -14 #BF58421C</BoxShadows>
            <BoxShadows x:Key="ManualWindowShadow">0 16 38 0 #2458421C</BoxShadows>
            <Color x:Key="ManualLifeLine">#294A3A1C</Color>
            <Color x:Key="ManualLifeDotRing">#80B07B00</Color>
            <BoxShadows x:Key="ManualLifeGlow">0 0 12 0 #73F2B41C</BoxShadows>
            <Color x:Key="ManualGhostNumeral">#33B07B00</Color>
            <Color x:Key="ManualRouteDot">#D69A08</Color>
            <BoxShadows x:Key="ManualRouteDotShadow">0 0 0 4 #F3EBDE</BoxShadows>
            <LinearGradientBrush x:Key="ManualFrameWash" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#29FFCE3C" Offset="0" />
                <GradientStop Color="#05FFCE3C" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="ManualGold70">#B3B07B00</Color>
            <Color x:Key="ManualTipRule">#66B07B00</Color>
            <Color x:Key="ManualTick">#B07B00</Color>
            <Color x:Key="ManualKeyFill">#0F4A3A1C</Color>
            <Color x:Key="ManualKeyInk">#2B2417</Color>
            <LinearGradientBrush x:Key="ManualNextFill" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#F3C04A" Offset="0" />
                <GradientStop Color="#E0A30C" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="ManualChannelRing">#4DB07B00</Color>
            <Color x:Key="ManualChannelRingHover">#80B07B00</Color>
            <Color x:Key="ManualChannelFill">#2EFFCE3C</Color>
            <Color x:Key="ManualChannelFillHover">#57FFCE3C</Color>
            <LinearGradientBrush x:Key="ManualDayLine" StartPoint="0%,50%" EndPoint="100%,50%">
                <GradientStop Color="#40B07B00" Offset="0" />
                <GradientStop Color="#C89100" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="BadgeFill">#3DFFCE3C</Color>
            <Color x:Key="BadgeBorder">#42B07B00</Color>
            <Color x:Key="BadgeInk">#8A6000</Color>
            <!-- The connector between the steps is the one place a pale yellow disappears
                 on paper: the prototype's rgba(255,205,45,.32) is invisible on cream, so
                 daylight carries the gold the badge's ring is drawn in, at a weight that
                 reads at one pixel. -->
            <LinearGradientBrush x:Key="StepLine" StartPoint="50%,0%" EndPoint="50%,100%">
                <GradientStop Color="#85B07B00" Offset="0" />
                <GradientStop Color="#1AB07B00" Offset="1" />
            </LinearGradientBrush>
            <Color x:Key="ManualNextBorder">#C89100</Color>
            <Color x:Key="ManualNextInk">#2A1C00</Color>
            <BoxShadows x:Key="ManualNextShadow">inset 0 1 0 0 #59FFFFFF</BoxShadows>


        </ResourceDictionary>

        <!-- ================================ dark ================================ -->
        <!-- Warm graphite: the same paper, in the evening. -->
        <ResourceDictionary x:Key="Dark">

            <Color x:Key="Brand50">#2A2114</Color>
            <Color x:Key="Brand100">#332813</Color>
            <Color x:Key="Brand200">#4A3A16</Color>
            <Color x:Key="Brand400">#E8AC1E</Color>
            <Color x:Key="Brand500">#FFC53D</Color>
            <Color x:Key="Brand600">#F2B41C</Color>
            <Color x:Key="Brand700">#D89B0E</Color>

            <Color x:Key="Indigo50">#2A2114</Color>
            <Color x:Key="Indigo100">#332813</Color>
            <Color x:Key="Indigo400">#E8AC1E</Color>
            <Color x:Key="Indigo600">#F2B41C</Color>

            <!--
                The slate ramp is inverted, not darkened. The old names are positional -
                Slate50 was the lightest surface and Slate900 the darkest ink - and on a dark
                page the lightest surface is the card and the ink is nearly white. Used as
                they were written, they keep meaning the same thing.
            -->
            <Color x:Key="Slate50">#0FFFF2D6</Color>
            <Color x:Key="Slate100">#2B2318</Color>
            <Color x:Key="Slate200">#14FFF2D6</Color>
            <Color x:Key="Slate300">#26FFF2D6</Color>
            <Color x:Key="Slate400">#8D8372</Color>
            <Color x:Key="Slate500">#8D8372</Color>
            <Color x:Key="Slate600">#E6DDCA</Color>
            <Color x:Key="Slate700">#F8F3E7</Color>
            <Color x:Key="Slate800">#F8F3E7</Color>
            <Color x:Key="Slate900">#F8F3E7</Color>

            <!-- Status keeps its hues; only the tints and the ink turn for the dark page. -->
            <Color x:Key="Emerald50">#0C2A21</Color>
            <Color x:Key="Emerald100">#10382C</Color>
            <Color x:Key="Emerald200">#14503C</Color>
            <Color x:Key="Emerald500">#34D399</Color>
            <Color x:Key="Emerald600">#10B981</Color>
            <Color x:Key="Emerald700">#6EE7B7</Color>

            <Color x:Key="Sky50">#0C2231</Color>
            <Color x:Key="Sky100">#0F2F42</Color>
            <Color x:Key="Sky200">#12415B</Color>
            <Color x:Key="Sky500">#38BDF8</Color>
            <Color x:Key="Sky600">#0EA5E9</Color>
            <Color x:Key="Sky700">#7DD3FC</Color>

            <Color x:Key="Amber50">#2B2110</Color>
            <Color x:Key="Amber100">#3A2C12</Color>
            <Color x:Key="Amber200">#4F3B14</Color>
            <Color x:Key="Amber400">#FBBF24</Color>
            <Color x:Key="Amber500">#F59E0B</Color>
            <Color x:Key="Amber600">#FBBF24</Color>
            <Color x:Key="Amber700">#FCD34D</Color>

            <Color x:Key="Red50">#2E1614</Color>
            <Color x:Key="Red100">#3B1A17</Color>
            <Color x:Key="Red200">#52201B</Color>
            <Color x:Key="Red400">#F87171</Color>
            <Color x:Key="Red500">#EF4444</Color>
            <Color x:Key="Red600">#F87171</Color>
            <Color x:Key="Red700">#FCA5A5</Color>

            <Color x:Key="AppBackground">#14110D</Color>
            <Color x:Key="Surface">#1F1A14</Color>
            <Color x:Key="SurfaceMuted">#262017</Color>
            <Color x:Key="SurfaceRaised">#262017</Color>
            <Color x:Key="SurfaceModal">#1D1913</Color>
            <Color x:Key="BorderSubtle">#0FFFF2D6</Color>
            <Color x:Key="BorderDefault">#14FFF2D6</Color>
            <Color x:Key="BorderStrong">#26FFF2D6</Color>
            <Color x:Key="TextStrong">#F8F3E7</Color>
            <Color x:Key="TextDefault">#E6DDCA</Color>
            <Color x:Key="TextMuted">#AAA08F</Color>
            <Color x:Key="TextFaint">#8D8372</Color>
            <Color x:Key="TextLink">#F2B41C</Color>

            <Color x:Key="Accent">#F2B41C</Color>
            <Color x:Key="AccentStrong">#E09A00</Color>
            <Color x:Key="OnAccent">#241800</Color>

            <Color x:Key="Gold">#F2B41C</Color>
            <Color x:Key="GoldDeep">#CF9105</Color>
            <Color x:Key="GoldHover">#F8BF2B</Color>
            <Color x:Key="GoldPressed">#E7A80F</Color>

            <!-- The same chip on a picture, and the same colour in both themes. -->
            <Color x:Key="OverlayChipFill">#B8140F09</Color>
            <Color x:Key="OverlayChipInk">#FFFFEEC2</Color>

            <!-- The same button at night: the gold itself, with ink on it. -->
            <Color x:Key="ActionFill">#F2B41C</Color>
            <Color x:Key="ActionFillHover">#F8BF2B</Color>
            <Color x:Key="ActionFillPressed">#E7A80F</Color>
            <Color x:Key="ActionBorder">#CF9105</Color>
            <Color x:Key="ActionInk">#2A1C00</Color>

            <!-- The prototype's evening button: a black descent under it and a shade
                 pressed into the bottom edge. -->
            <BoxShadows x:Key="ActionShadow">0 2 5 0 #4D000000, inset 0 -2 0 0 #388C5600</BoxShadows>
            <BoxShadows x:Key="ActionShadowHover">0 6 16 0 #57000000, inset 0 -2 0 0 #388C5600</BoxShadows>
            <BoxShadows x:Key="ActionShadowPressed">inset 0 2 4 0 #4D6E4200</BoxShadows>
            <BoxShadows x:Key="ActionShadowOff">0 0 0 0 #00000000</BoxShadows>
            <BoxShadows x:Key="ActionShadowOffHover">0 0 0 0 #00000000</BoxShadows>

            <Color x:Key="BorderAccentHover">#3DFFCD2D</Color>

            <Color x:Key="MatSurface">#15120E</Color>
            <Color x:Key="TabTray">#42000000</Color>

            <!-- In the evening the chosen tab is a pane of light rather than a card: the
                 prototype lifts it by 7.5% of white over the tray, and the tray stays visible
                 through it. -->
            <Color x:Key="TabSelectedFill">#13FFFFFF</Color>
            <Color x:Key="TabHoverFill">#0BFFFFFF</Color>

            <BoxShadows x:Key="TabLift">inset 0 0 0 1 #12FFFFFF, 0 2 12 0 #4D000000</BoxShadows>

            <RadialGradientBrush x:Key="WelcomeGlow" Center="90%,4%" GradientOrigin="90%,4%"
                                 RadiusX="43%" RadiusY="50%">
                <GradientStop Color="#24FFC428" Offset="0" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <RadialGradientBrush x:Key="WelcomeHalo" Center="50%,50%" GradientOrigin="50%,50%"
                                 RadiusX="50%" RadiusY="50%">
                <GradientStop Color="#33FFC428" Offset="0" />
                <GradientStop Color="#0DFFC428" Offset="0.46" />
                <GradientStop Color="#00FFC428" Offset="0.68" />
            </RadialGradientBrush>

            <Color x:Key="WelcomeRing">#2EFFCD2D</Color>
            <Color x:Key="WelcomeRingFaint">#1FFCDD2D</Color>
            <Color x:Key="PhotoSheet">#FBF7EE</Color>
            <Color x:Key="WelcomeChipFill">#D118140E</Color>
            <Color x:Key="WelcomeChipBorder">#3DFFCD2D</Color>
            <Color x:Key="WelcomeChipInk">#E6DDCA</Color>
            <BoxShadows x:Key="WelcomeChipShadow">0 14 34 0 #59000000</BoxShadows>

            <Color x:Key="Backdrop">#B8080505</Color>

            <Color x:Key="Sunken">#38000000</Color>
            <Color x:Key="SunkenSoft">#26000000</Color>
            <Color x:Key="SunkenFaint">#14000000</Color>

            <Color x:Key="Slate200At70">#14FFF2D6</Color>

            <!-- The folder picker at night: the same gold, and the panel's washes turned
                 white. See the light theme for what each one is. -->
            <Color x:Key="PickerChipWash">#0DFFFFFF</Color>
            <Color x:Key="PickerChipRing">#14FFFFFF</Color>
            <Color x:Key="PickerPlaceActive">#12FFFFFF</Color>
            <Color x:Key="PickerPlaceRing">#0EFFFFFF</Color>
            <Color x:Key="PickerBookEdge">#24FFFFFF</Color>
            <BoxShadows x:Key="PickerPlaceRingShadow">inset 0 0 0 1 #0EFFFFFF</BoxShadows>
            <BoxShadows x:Key="PickerBarGlow">0 0 12 0 #B3F2B41C</BoxShadows>

            <BoxShadows x:Key="PickerViewTrayRing">inset 0 0 0 1 #0FFFFFFF</BoxShadows>
            <Color x:Key="PickerViewActiveFill">#17FFFFFF</Color>
            <BoxShadows x:Key="PickerViewActiveShadow">0 1 3 0 #40000000</BoxShadows>
            <Color x:Key="PickerBoxFill">#0DFFFFFF</Color>
            <Color x:Key="PickerBoxRing">#2EFFFFFF</Color>

            <Color x:Key="CombinedWash">#1FF2B41C</Color>
            <Color x:Key="CombinedWashRing">#3DFFCD2D</Color>
            <Color x:Key="CombinedDashedRing">#52FFCD2D</Color>
            <Color x:Key="CombinedDashedRingHover">#8CFFCD2D</Color>
            <Color x:Key="CombinedEmptyFill">#0DFFFFFF</Color>
            <Color x:Key="CombinedEmptyRing">#1FFFFFFF</Color>
