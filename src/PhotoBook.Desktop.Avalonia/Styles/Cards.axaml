<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Surfaces and buttons the screens share, transcribed from doc\DESIGN_SPEC.md.

        Card: padding comes from the caller because two screens pad theirs differently (24 for
        the section header, 20 for a project card) and a style that carries both has to be
        overridden as often as it is used. What the style does own is the part that must be
        identical everywhere: white, a one-pixel slate-200 at 80%, radius 16, the subtle
        shadow.

        The shadow is a BoxShadow rather than a DropShadowEffect. WPF painted its drop shadow
        inside the element's own bounds, which is why every dialog needed a transparent margin
        to fall into; Avalonia's box shadow is drawn outside, so the same value gives the same
        look with none of that.
    -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200At70}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowSubtle}" />
    </Style>

    <Style Selector="Border.slotCard:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowHover}" />
    </Style>

    <!--
        A card answers the pointer. It is the difference between a row of pictures on a
        background and a row of things you can act on, and the other shell has always done
        it: the shadow deepens and the frame takes a little more colour.
    -->
    <Style Selector="Border.card:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate300}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brand600}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!--
        The one destructive control on a card. Grey until the pointer is on it, then the red
        the WPF shell uses, with the same red-50 fill behind it. A delete that is red all the
        time is a row of red on a screen of white, and it stops meaning anything.
    -->
    <Style Selector="Button.dangerIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.dangerIcon:pointerover">
        <Setter Property="Background" Value="#FEF2F2" />
    </Style>

    <Style Selector="Button.dangerIcon:pointerover TextBlock.dangerGlyph">
        <Setter Property="Foreground" Value="#EF4444" />
    </Style>

<Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- The two arrows under a slot. Padding 2, so the pill is exactly as tight as the
         spec asks and the whole thing disappears into the card's footer rather than
         competing with the caption for room. -->
    <Style Selector="Button.arrow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.arrow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Slate200}" />
    </Style>

</Styles>
