<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Surfaces and buttons the screens share, transcribed from doc\DESIGN_SPEC.md.

        Card: padding comes from the caller because two screens pad theirs differently (24 for
        the section header, 20 for a project card) and a style that carries both has to be
        overridden as often as it is used. What the style does own is the part that must be
        identical everywhere: the card surface with its light top edge, a one-pixel line at
        thirteen percent of the ink, radius 18, the subtle shadow.

        The shadow is a BoxShadow rather than a DropShadowEffect. WPF painted its drop shadow
        inside the element's own bounds, which is why every dialog needed a transparent margin
        to fall into; Avalonia's box shadow is drawn outside, so the same value gives the same
        look with none of that.
    -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius2Xl}" />
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowSubtle}" />
    </Style>

    <!--
        A row in the file list. A list box draws its own rows - a background, a border, a
        focus rectangle and some padding - and all four of those turn a photograph row into
        something that looks like a form field. The row is meant to be the row: the state is
        read off the badge at its end, not off a wash of colour across the whole 320 pixels.
    -->
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        A slot on the combined screen: radius 12, a hairline frame, and the cover framed
        two pixels in the product's colour. The border and its thickness are bound to the
        page rather than set here, because which of the two a slot is depends on what is in
        it.
    -->
    <Style Selector="Border.slotCard">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.slotCard:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowHover}" />
    </Style>

    <Style Selector="Border.card:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentHover}" />
    </Style>

    <!--
        The one filled action of a screen, and the only definition of it in the program.

        Its fill is a theme token rather than the gold, because the prototype fills it
        differently in each theme: gold at night, and a warm gold tint on paper in daylight.
        A solid gold slab on cream is a lamp in a lit room - it was the first thing wrong
        with the welcome screen.
    -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource ActionFill}" />
        <Setter Property="Foreground" Value="{DynamicResource ActionInk}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ActionBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <!-- The filled action rises under the pointer, and a rise draws outside the
             control's rectangle: clipping would cut the shadow to a rim. -->
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{DynamicResource ActionShadow}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.14" />
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                        </Transitions>
                    </Border.Transitions>
                    <!--
                        The words and the mark take the button's own colour rather than
                        whatever the theme hands them, so that a disabled button - which is
                        given slate-400 below - turns both of them and not just the label.
                    -->
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource ActionFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ActionBorder}" />
    </Style>

    <!-- One pixel up, and a wider and softer descent under it. -->
    <Style Selector="Button.primary:pointerover /template/ Border">
        <Setter Property="RenderTransform" Value="translate(0px,-1px)" />
        <Setter Property="BoxShadow" Value="{DynamicResource ActionShadowHover}" />
    </Style>

    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource ActionFillPressed}" />
    </Style>

    <Style Selector="Button.primary:pressed /template/ Border">
        <Setter Property="RenderTransform" Value="translate(0px,0px)" />
        <Setter Property="BoxShadow" Value="{DynamicResource ActionShadowPressed}" />
    </Style>

    <!--
        A disabled primary button goes grey, as the released one does. Left violet it reads
        as a button that is momentarily not answering, which is a different thing from a
        button that cannot be pressed at all.
    -->
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource Slate200}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
    </Style>

    <!--
        A button in a control panel, as opposed to the one on a card.

        The released program has two of these and they are deliberately not the same thing.
        A card's own button is a filled one, and the grey it is filled with is what keeps it
        from looking like the card it sits on. A panel's buttons sit on white next to a filled
        one, and filling them grey as well gives a row of three grey blocks - heavier than
        the panel they sit in, and a different shape from every other button in the product.

        So these are white with a hairline and the same small shadow the dialogs use, and
        their icons are muted to slate-400 while the words stay slate-700: an icon at the
        same weight as its own label reads as one smudge instead of a mark and a word.
    -->
    <Style Selector="Button.outline">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="42" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{DynamicResource ShadowSm}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.14" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.outline:pointerover">
        <Setter Property="Background" Value="{DynamicResource Slate50}" />
    </Style>

    <Style Selector="Button.outline:pressed /template/ Border">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.outline:disabled">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
    </Style>

    <!--
        The words inside these buttons take the button's own colour.

        The shared TextBlock style sets a foreground, and a value set on the control beats
        one handed down through a property - so a template that only passes Foreward on
        leaves the label in the default ink. That is how "Экспортировать" came out as dark
        words on a violet button.
    -->
    <Style Selector="Button.primary TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ActionInk}" />
    </Style>

    <Style Selector="Button.primary:disabled TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
    </Style>

    <Style Selector="Button.outline TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
    </Style>

    <Style Selector="Button.outline:disabled TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <!--
                    No box, ever - not at rest and not under the pointer. It was slate all
                    the time, which put a grey slab around "сбросить порядок" on every book
                    and around the cover action; then it was slate only on hover, which is
                    still a box, and a box around four words is what the eye reads first.

                    What the pointer gets instead is the words turning darker. On a white
                    card that is enough, and nothing is drawn behind it at all.
                -->
                <Border x:Name="Root"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.ghost:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource Slate900}" />
    </Style>

    <Style Selector="Button.ghost:pressed">
        <Setter Property="Foreground" Value="{DynamicResource Slate500}" />
    </Style>

    <Style Selector="Button.ghost TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
    </Style>

    <!--
        The one destructive control on a card. Grey until the pointer is on it, then the red
        the WPF shell uses, with the same red-50 fill behind it. A delete that is red all the
        time is a row of red on a screen of white, and it stops meaning anything.
    -->
    <Style Selector="Button.dangerIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.dangerIcon:pointerover">
        <Setter Property="Background" Value="{DynamicResource Red50}" />
    </Style>

    <Style Selector="Button.dangerIcon:pointerover TextBlock.dangerGlyph">
        <Setter Property="Foreground" Value="{DynamicResource Red500}" />
    </Style>

<Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- The two arrows under a slot. Padding 2, so the pill is exactly as tight as the
         spec asks and the whole thing disappears into the card's footer rather than
         competing with the caption for room. -->
    <Style Selector="Button.arrow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.arrow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Slate200}" />
    </Style>


    <!--
        "Открыть проект" on a saved card.

        The template is written out because the platform's button paints its own wash, and
        what the prototype does here is a warm gold wash and a gold frame under the pointer
        with the arrow stepping two pixels to the right. The card's whole width is this
        control, so the answer has to be read at its edges, not in a grey rectangle.
    -->
    <Style Selector="Button.openProject">
        <Setter Property="Background" Value="{DynamicResource SunkenSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QuietBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.openProject:pointerover">
        <Setter Property="Background" Value="{DynamicResource OpenHoverFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenHoverBorder}" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
    </Style>

    <Style Selector="Button.openProject:pressed">
        <Setter Property="Background" Value="{DynamicResource OpenHoverFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource OpenHoverBorder}" />
    </Style>

    <!-- The arrow is the only mark on the button, and it steps toward the screen the press
         opens rather than sitting still while the words change colour. -->
    <Style Selector="Path.openArrow">
        <Setter Property="RenderTransform" Value="translate(0px,0px)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.openProject:pointerover Path.openArrow">
        <Setter Property="RenderTransform" Value="translate(2px,0px)" />
    </Style>

    <!--
        The one destructive control on a card.

        It has a field of its own - a faint wash with a hairline - because the prototype puts
        it beside the wide "open" button as a square of the same height, and a bare glyph
        there read as a decoration. Under the pointer the field warms to red and the basket
        turns with it.
    -->
    <Style Selector="Button.projectDelete">
        <Setter Property="Background" Value="{DynamicResource FieldFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.projectDelete:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerWash}" />
        <Setter Property="Foreground" Value="{DynamicResource DangerInk}" />
    </Style>

    <Style Selector="Button.projectDelete:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerWash}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerInk}" />
    </Style>

    <!--
        The quiet button of a panel over the page: the same size as the filled one beside it,
        a wash instead of a fill, and a hairline that keeps it a control rather than a word.
    -->
    <Style Selector="Button.soft">
        <Setter Property="Background" Value="{DynamicResource QuietFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QuietBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.soft:pointerover">
        <Setter Property="Background" Value="{DynamicResource QuietFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource QuietBorderHover}" />
    </Style>

    <!--
        The destructive answer of a panel.

        A red cap of paint rather than a red slab: a gradient with a light top edge, a hairline
        of its own, and the lift under the pointer that every filled control in this product
        has. A button that does not move when pressed is a picture of a button.
    -->
    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource DangerButtonFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource DangerButtonInk}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{DynamicResource DangerButtonShadow}">
                    <Border.Transitions>
                        <Transitions>
                            <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.16" />
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.danger TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource DangerButtonInk}" />
    </Style>

    <Style Selector="Button.danger:pointerover">
        <Setter Property="Background" Value="{DynamicResource DangerButtonFillHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerButtonBorderHover}" />
    </Style>

    <Style Selector="Button.danger:pointerover /template/ Border">
        <Setter Property="RenderTransform" Value="translate(0px,-1px)" />
        <Setter Property="BoxShadow" Value="{DynamicResource DangerButtonShadowHover}" />
    </Style>

    <Style Selector="Button.danger:pressed">
        <Setter Property="Background" Value="{DynamicResource DangerButtonFill}" />
    </Style>

    <Style Selector="Button.danger:pressed /template/ Border">
        <Setter Property="RenderTransform" Value="translate(0px,0px)" />
        <Setter Property="BoxShadow" Value="{DynamicResource DangerButtonShadowPressed}" />
    </Style>


    <!-- The cross in the corner of a panel: no plate until the pointer is on it, and the
         glyph takes the button's own colour so the hover reaches it. -->
    <Style Selector="Button.modalClose">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.16" />
                <BrushTransition Property="Foreground" Duration="0:0:0.16" />
            </Transitions>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.modalClose:pointerover">
        <Setter Property="Background" Value="{DynamicResource Sunken}" />
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
    </Style>

</Styles>
