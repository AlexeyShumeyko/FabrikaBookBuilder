<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Surfaces and buttons the screens share, transcribed from doc\DESIGN_SPEC.md.

        Card: padding comes from the caller because two screens pad theirs differently (24 for
        the section header, 20 for a project card) and a style that carries both has to be
        overridden as often as it is used. What the style does own is the part that must be
        identical everywhere: white, a one-pixel slate-200 at 80%, radius 16, the subtle
        shadow.

        The shadow is a BoxShadow rather than a DropShadowEffect. WPF painted its drop shadow
        inside the element's own bounds, which is why every dialog needed a transparent margin
        to fall into; Avalonia's box shadow is drawn outside, so the same value gives the same
        look with none of that.
    -->

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200At70}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowSubtle}" />
    </Style>

    <!--
        A row in the file list. A list box draws its own rows - a background, a border, a
        focus rectangle and some padding - and all four of those turn a photograph row into
        something that looks like a form field. The row is meant to be the row: the state is
        read off the badge at its end, not off a wash of colour across the whole 320 pixels.
    -->
    <Style Selector="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="0" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!--
        A slot on the combined screen: radius 12, a hairline frame, and the cover framed
        two pixels in the product's colour. The border and its thickness are bound to the
        page rather than set here, because which of the two a slot is depends on what is in
        it.
    -->
    <Style Selector="Border.slotCard">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>

    <Style Selector="Border.slotCard:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowHover}" />
    </Style>

    <Style Selector="Border.card:pointerover">
        <Setter Property="BoxShadow" Value="{DynamicResource ShadowCard}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate300}" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brand600}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <!--
                        The words and the mark take the button's own colour rather than
                        whatever the theme hands them, so that a disabled button - which is
                        given slate-400 below - turns both of them and not just the label.
                    -->
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.92" />
    </Style>

    <!--
        A disabled primary button goes grey, as the released one does. Left violet it reads
        as a button that is momentarily not answering, which is a different thing from a
        button that cannot be pressed at all.
    -->
    <Style Selector="Button.primary:disabled">
        <Setter Property="Background" Value="{DynamicResource Slate200}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
    </Style>

    <!--
        A button in a control panel, as opposed to the one on a card.

        The released program has two of these and they are deliberately not the same thing.
        A card's own button is a filled one, and the grey it is filled with is what keeps it
        from looking like the card it sits on. A panel's buttons sit on white next to a filled
        one, and filling them grey as well gives a row of three grey blocks - heavier than
        the panel they sit in, and a different shape from every other button in the product.

        So these are white with a hairline and the same small shadow the dialogs use, and
        their icons are muted to slate-400 while the words stay slate-700: an icon at the
        same weight as its own label reads as one smudge instead of a mark and a word.
    -->
    <Style Selector="Button.outline">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        BoxShadow="{DynamicResource ShadowSm}">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.14" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.outline:pointerover">
        <Setter Property="Background" Value="{DynamicResource Slate50}" />
    </Style>

    <Style Selector="Button.outline:pressed /template/ Border">
        <Setter Property="Opacity" Value="0.9" />
    </Style>

    <Style Selector="Button.outline:disabled">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!--
        The one destructive control on a card. Grey until the pointer is on it, then the red
        the WPF shell uses, with the same red-50 fill behind it. A delete that is red all the
        time is a row of red on a screen of white, and it stops meaning anything.
    -->
    <Style Selector="Button.dangerIcon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.dangerIcon:pointerover">
        <Setter Property="Background" Value="#FEF2F2" />
    </Style>

    <Style Selector="Button.dangerIcon:pointerover TextBlock.dangerGlyph">
        <Setter Property="Foreground" Value="#EF4444" />
    </Style>

<Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- The two arrows under a slot. Padding 2, so the pill is exactly as tight as the
         spec asks and the whole thing disappears into the card's footer rather than
         competing with the caption for room. -->
    <Style Selector="Button.arrow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.arrow:pointerover">
        <Setter Property="Background" Value="{DynamicResource Slate200}" />
    </Style>

</Styles>
