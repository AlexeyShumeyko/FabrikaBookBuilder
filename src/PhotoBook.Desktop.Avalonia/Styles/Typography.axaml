<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The type scale, split from the palette on purpose: a Styles root cannot hold keyed
        resources, so the colours, shadows and radii live in Tokens.axaml as a ResourceDictionary
        and this file holds only styles. Cards are in Cards.axaml and only there - this file
        used to carry a second copy of that rule, and whichever file was included last quietly
        decided how a card looked.

        The scale is exactly the one the mockup uses - 9 / 10 / 11 / 12 / 14 / 16 / 18 / 20 /
        24 - and so are the names, which are t9 / t10 ... rather than a dozen near-duplicates
        called TextMicro and TextTiny and TextXs. Avalonia styles are addressed by class
        rather than by key, so the shorter name is also the easier one to read in a view.
    -->

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
    </Style>

    <Style Selector="TextBlock.t9">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.t10">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.t11">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <!-- The mode chip's label: the prototype sets it at 11.5 semi bold, a half step under
         the body. The view already asked for this class before it existed, and drew the
         words at the default size instead. -->
    <Style Selector="TextBlock.t11Semi">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The header's project line: the prototype sets it a half step under twelve. -->
    <Style Selector="TextBlock.t11Half">
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- The product's own name in the header, at the weight the prototype gives it. -->
    <Style Selector="TextBlock.t16ExtraBold">
        <Setter Property="FontSize" Value="16.5" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
    </Style>

    <!-- The status tag is a label at 11.5 bold. -->
    <Style Selector="TextBlock.t11Bold">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.t12">
        <Setter Property="FontSize" Value="12.5" />
    </Style>
    <Style Selector="TextBlock.t12Medium">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="TextBlock.t12Semi">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.t14">
        <Setter Property="FontSize" Value="13.5" />
    </Style>
    <Style Selector="TextBlock.t14Bold">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
    </Style>
    <Style Selector="TextBlock.t16">
        <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBlock.t16Bold">
        <Setter Property="FontSize" Value="16.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
    </Style>
    <Style Selector="TextBlock.t18Bold">
        <Setter Property="FontSize" Value="19" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style Selector="TextBlock.t20Bold">
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
    </Style>
    <Style Selector="TextBlock.t24Bold">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
    </Style>

    <!-- The one heading a screen carries: the prototype sets it at 29, extra bold, a touch
         tighter than the rest. -->
    <Style Selector="TextBlock.t29ExtraBold">
        <Setter Property="FontSize" Value="29" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
    </Style>


</Styles>