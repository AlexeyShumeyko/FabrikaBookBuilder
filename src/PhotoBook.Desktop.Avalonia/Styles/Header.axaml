<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Header controls, transcribed from the design specification rather than copied from
        the WPF theme, because the numbers are the point: a card that is "about right" is a
        card that is wrong by a number nobody can see in review.

          secondary button   padding 12/8   radius 12   white on a slate-200 border
          primary button     padding 14/8   radius 12   brand-600, white text
          tab                padding 14/6   radius 8    12px
          tab container      padding 4      radius 12

        These live in their own file rather than in the window's own styles so that every
        screen reuses exactly the same header, which is what makes the two shells comparable
        at all.
    -->

    <Style Selector="Button.secondary">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource Brand600}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.primary:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brand700}" />
    </Style>

    <Style Selector="Button.primary:pressed">
        <Setter Property="Background" Value="{DynamicResource Brand700}" />
    </Style>
    <!--
        The one action on a screen. Deliberately not the loudest thing in the window: the
        photographer is mostly looking, and the loudest control on a screen is the one they
        are invited to press.

        Thirty-eight pixels, not forty-two. It had been given a height of its own that
        nothing else in the program uses, which made it read as a prop rather than as a
        button - and a 14-pixel mark beside 13-pixel text is a mark that outweighs the word.
        The mark is 12 now and the word is the same size, which is what a mark is for.
    -->
    <Style Selector="Button.createProject">
        <Setter Property="Background" Value="{DynamicResource Brand600}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Height" Value="40" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Cursor" Value="Hand" />

        <!-- Light, not heavy: the fill LIFTS on hover and settles on press. A button that
             darkens on hover is telling the person it is a door; this one is a lamp. -->
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
            </Transitions>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="11">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.14" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.createProject:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brand500}" />
    </Style>

    <Style Selector="Button.createProject:pressed">
        <Setter Property="Background" Value="{DynamicResource Brand700}" />
    </Style>

    <!--
        The two filters, living inside the control panel rather than in a bar of their own.

        They were borderless and grey. Borderless was right - a framed control inside a
        white panel reads as something that arrived from another program. Grey was not: the
        only shape these controls took was the panel's own grey on hover, and grey on grey
        is the one combination that looks like a control nobody finished drawing.

        So they wear the brand instead. A whisper of it - Brand50, which is #EEF2FF, barely
        a shade off the white they sit on - and the pointer deepens it to Brand100 rather
        than darkening it. A filter that changes colour on the way in is saying "this one is
        live", and it says it in the only colour the program has for meaning anything.

        The open state gets a hairline in Brand200. That ring is the whole of the "you are
        choosing right now" signal, and it is a ring rather than a fill because a fill that
        changes again while the list is already open is a control that keeps moving.

        Same width, both of them. The two labels are different lengths and letting the
        controls size themselves left them as a matched pair that did not match.
    -->
    <Style Selector="ComboBox.filter">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource Brand50}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Slate800}" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                <BrushTransition Property="Foreground" Duration="0:0:0.14" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="ComboBox.filter:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brand100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate900}" />
    </Style>

    <!-- The platform paints a box inside the dropdown's own template, which is the grey
         frame these controls were supposed to have stopped wearing. It is told to stop
         twice - once for the resting shape and once while the list is open, because the
         platform has a separate rule for the open one. -->
    <Style Selector="ComboBox.filter /template/ ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ComboBox.filter:open /template/ ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="ComboBox.filter:open">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand200}" />
    </Style>

    <Style Selector="ComboBox.filter:pressed">
        <Setter Property="Background" Value="{DynamicResource Brand100}" />
    </Style>

    <!--
        "Сбросить", and it only exists while something is being filtered out - so there is
        never a control on the screen that is there and does nothing.
    -->
    <Style Selector="Button.ghostClear">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brand600}" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="8">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.ghostClear:pointerover">
        <Setter Property="Background" Value="{DynamicResource Brand50}" />
    </Style>

    <!--
        An icon button is an icon and nothing else: no plate, no frame, no fill. The other
        shell's version is a transparent rounded rectangle with 8 of padding around a 14px
        glyph, and this one had a white fill, a grey border and a fixed 32x32 box - which
        turned three quiet icons in the header into three framed buttons, and was the first
        thing anyone noticed was wrong.

        The faint foreground is the same faint the other shell uses for its icon buttons.
    -->
    <Style Selector="Button.icon">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.icon:pointerover">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate600}" />
    </Style>

    <Style Selector="Button.icon:pressed">
        <Setter Property="Background" Value="{DynamicResource Slate200}" />
    </Style>

    <Style Selector="ToggleButton.tab">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Slate500}" />
        <Setter Property="Cursor" Value="Hand" />

        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.14" />
                <BrushTransition Property="Foreground" Duration="0:0:0.14" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
            </Transitions>
        </Setter>

        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="Pill"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.14" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!--
        Hover: a breath of white, not a ring. With the chosen tab a white pill, a frame
        round the unchosen ones would put a second shape into the control and make it
        busy. The text darkening does the rest of the work.
    -->
    <Style Selector="ToggleButton.tab:pointerover">
        <Setter Property="Background" Value="#B3FFFFFF" />
        <Setter Property="Foreground" Value="{DynamicResource Slate800}" />
    </Style>

    <Style Selector="ToggleButton.tab:pressed">
        <Setter Property="Background" Value="#80FFFFFF" />
    </Style>

    <!--
        Difference one of this step, listed rather than fudged: the active tab carries a
        subtle shadow in the WPF theme. ToggleButton has no BoxShadow property in this
        engine, so the shadow lives on the pill's own border inside the template above.

        Difference two: a disabled tab in the WPF theme is greyed and loses the pointer.
        Here a disabled ToggleButton simply stops reacting, so the greying is done
        explicitly - otherwise a disabled tab would look exactly like an enabled one, which
        is how a person learns to click something that cannot be clicked. It is the TEXT
        that goes quiet, not the whole control: fading the pill too made the bar look
        broken rather than busy.
    -->
    <Style Selector="ToggleButton.tab:disabled">
        <Setter Property="Foreground" Value="{DynamicResource Slate300}" />
    </Style>

    <!--
        Utility icons: a small family, not three floating things.

        The step between them is two pixels rather than six. At six they each sat in their own
        space and read as three separate controls a person happened to be able to reach; at
        two they read as one group of three, which is what they are.
    -->
    <Style Selector="Button.utility">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9" />
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource Slate400}" />
        <Setter Property="Cursor" Value="Hand" />

        <!--
            The template is written out for the same reason as the tab's, and it is not
            tidiness: the platform paints a disabled button's fill inside its own template,
            so a rule that sets Background on the button is a rule that loses. Two grey
            blocks in the bar cannot be argued out of existence from a style.
        -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="9">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.utility:pointerover">
        <Setter Property="Background" Value="{DynamicResource Slate100}" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
    </Style>

    <Style Selector="Button.utility:pressed">
        <Setter Property="Background" Value="{DynamicResource Slate200}" />
    </Style>

    <!--
        A disabled utility icon is still an icon.

        The platform paints a filled background on a disabled button, which turned the two
        history arrows into two grey blocks - heavier than everything else in the bar and
        pulling the eye to the one pair of controls a person cannot use. Nothing there, and
        the glyph faint: they are there when there is something to undo, and quiet when there
        is not.
    -->
    <Style Selector="Button.utility:disabled">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!--
        The account control.

        A sign-in is not a utility icon and is not drawn as one. It has a label, because a
        labelled control says what state the program is in - signed out - to somebody who has
        never seen the program before, while a lone glyph says it only to somebody who already
        knows. It is an outline rather than a filled brand button on purpose: working on a
        photograph is what this program is for, and the account is not that.
    -->
    <Style Selector="Button.account">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate300}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Slate700}" />
        <Setter Property="Cursor" Value="Hand" />

        <!-- Written out for the same reason as the utility button's: the platform owns the
             paint otherwise, and the outline this control is made of is the whole of it. -->
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="10">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="Button.account:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand500}" />
        <Setter Property="Foreground" Value="{DynamicResource Brand600}" />
        <Setter Property="Background" Value="{DynamicResource Brand50}" />
    </Style>

    <Style Selector="Button.account:pressed">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand600}" />
        <Setter Property="Background" Value="{DynamicResource Brand100}" />
    </Style>

<!--
        A number field for the run controls. The ordinary text box is sized for a form -
        padding 12 by 8 and 12px - so two of them side by side made the run fields taller
        than the buttons beside them and the panel looked uneven. Same box, smaller.
    -->
    <Style Selector="TextBox.numberField">
        <Setter Property="Width" Value="64" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="TextBox.searchField">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!--
        A mode card on the start screen: the whole card is the choice, so the control has to
        be one that can be pressed, focused and reached by automation. Padding 24, a 1px
        slate frame, radius 16, and the frame takes the product's colour on hover - which is
        what makes a screen-sized block read as a card rather than as a form field.
    -->
    <Style Selector="Button.modeCard">
        <Setter Property="Background" Value="{DynamicResource Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Slate200}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.modeCard:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource Brand500}" />
    </Style>

</Styles>
