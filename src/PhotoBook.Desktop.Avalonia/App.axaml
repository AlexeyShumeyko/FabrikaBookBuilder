<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:PhotoBook.Shell.Converters"
             x:Class="PhotoBook.Shell.App">

    <!--
        Light, and pinned in App.Initialize rather than here.

        Written on this element it arrives too late: the platform theme has already chosen a
        variant by the time the markup finishes reading, and the value is accepted and
        ignored. On a dark machine the platform's own control colours then come in dark while
        the product's palette - which is light, deliberately, because a photograph has to sit
        on white - stays light. Being "the light theme on a dark machine" is not a state this
        product has. The line itself is in the code-behind, next to the comment that explains
        why it could not go here.
    -->

    <!--
        Light on purpose, and pinned above. RequestedThemeVariant is set because the product
        has one theme today, and a theme switch with nothing to switch to is a button that
        lies. It is one line to remove once there is a second theme, and the decision is
        recorded with the rest of the header stubs.

        The palette lives in Tokens.axaml and the type scale in Typography.axaml, included
        the same way a dictionary is included in any other Avalonia project: as a merged
        dictionary rather than as loose keys. Keys are not copied into the application - they
        stay inside their file, so where a value came from stays visible.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://PhotoBook.Desktop.Avalonia/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Converters live in the application rather than in each screen, because a
                card binds the same four of them and a second copy would be a second table to
                keep right. Their instances are static: these are pure functions of a value
                and a parameter, and one per screen would only be more copies of one table.
            -->
            <conv:StatusToLabelConverter x:Key="StatusToLabel" />
            <conv:StatusToBrushConverter x:Key="StatusToBrush" />
            <conv:AppModeToLabelConverter x:Key="AppModeToLabel" />
            <conv:LastModifiedTextConverter x:Key="LastModifiedText" />
            <conv:FilePathToBitmapConverter x:Key="FilePathToBitmap" />
            <conv:NotEmptyConverter x:Key="NotEmpty" />
            <conv:CardWidthConverter x:Key="CardWidth" />
            <conv:AdaptiveCardSizeConverter x:Key="AdaptiveCardSize" />
            <conv:PageCaptionConverter x:Key="PageCaption" />
            <conv:BookStatusConverter x:Key="BookStatus" />
            <conv:SelectedTabToBrushConverter x:Key="SelectedTab" />
            <conv:PageToBitmapConverter x:Key="PageToBitmap" />
            <conv:PageStateConverter x:Key="PageState" />
            <conv:PhotoUsageToBrushConverter x:Key="PhotoUsageBrush" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <!--
            Fluent first, our styles after: the design system is the product's, and the
            platform's control chrome is only a starting point.
        -->
        <FluentTheme />
        <StyleInclude Source="avares://PhotoBook.Desktop.Avalonia/Styles/Typography.axaml" />
        <StyleInclude Source="avares://PhotoBook.Desktop.Avalonia/Styles/Header.axaml" />
        <StyleInclude Source="avares://PhotoBook.Desktop.Avalonia/Styles/Cards.axaml" />
        <StyleInclude Source="avares://PhotoBook.Desktop.Avalonia/Styles/ScrollBars.axaml" />
    </Application.Styles>
</Application>
