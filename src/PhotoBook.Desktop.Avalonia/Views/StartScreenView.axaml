<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PhotoBook.Shell.Controls"
             x:Class="PhotoBook.Shell.Views.StartScreenView">

    <!--
        Two ways to make a photo book, and nothing else on the page.

        Every number here is the prototype's: the kicker at ten and a half with a fifth of an
        em between its letters, the heading at thirty-seven tightened by four hundredths of an
        em, the two cards at radius twenty-two with twenty-eight of padding, and the marks on
        gold plates. Where a value departs from it, the reason is written in place.

        The copy is the prototype's too, word for word: it is the only place on the screen that
        explains what the two modes are for, and rewording it would be a different screen.
    -->

    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  controls:SmoothScroll.IsEnabled="True">
        <!--
            The bar is hidden and the wheel is not: this page barely overflows at the sizes the
            program supports, and a trough down the edge of a page that nearly fits is a mark
            on the design rather than a way through it.

            Stretch with a ceiling rather than Centred, and that is the whole of why the two
            cards are the same width now. A centred panel is only as wide as what is inside it,
            so each star column took its own card's text width and the combined card came out
            seventeen pixels wider than its neighbour.
        -->
        <StackPanel MaxWidth="1240" Margin="32,26,32,32" HorizontalAlignment="Stretch">

            <!-- ============================== heading ============================== -->
            <StackPanel>
                <!--
                    The kicker: two short rules on either side of a line of capitals a fifth of
                    an em apart, in the product's gold. The rules are eighteen long and barely
                    there, as the prototype draws them - they are punctuation for the words, not
                    a frame around them.
                -->
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                    <Border Width="18" Height="1" VerticalAlignment="Center" Opacity="0.5"
                            Background="{DynamicResource Accent}" />
                    <TextBlock Text="НОВЫЙ ПРОЕКТ" FontSize="10.5" FontWeight="Bold"
                               LetterSpacing="1.9" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}" />
                    <Border Width="18" Height="1" VerticalAlignment="Center" Opacity="0.5"
                            Background="{DynamicResource Accent}" />
                </StackPanel>

                <!--
                    One line of type, and the second word cut out of the gold gradient. Three
                    runs in one TextBlock rather than three TextBlocks side by side: the letter
                    spacing is set once on the line, and a block per word would add that spacing
                    after every word as well.
                -->
                <TextBlock Classes="t37ExtraBold" LetterSpacing="-1.4"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           Margin="0,12,0,0">
                    <Run Text="Выберите " />
                    <Run Text="режим" Foreground="{DynamicResource BrandNameTail}" />
                    <Run Text=" создания проекта" />
                </TextBlock>

                <TextBlock FontSize="14" LineHeight="24"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="590" Margin="0,12,0,0"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Выбранный режим определяет формат работы с книгами. Режим выбирается один раз при создании проекта." />
            </StackPanel>

            <!-- A fixed 22-wide spacer column rather than a spacing property: this engine's grid
                 has no ColumnSpacing, and a spacer is the same 22 with nothing left to get
                 wrong. -->
            <Grid ColumnDefinitions="*,22,*" Margin="0,30,0,0">

                <!-- ======================== уникальные папки ========================= -->
                <Button x:Name="UniqueCard" Classes="modeCard"
                        AutomationProperties.Name="Уникальные папки"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="*,Auto">

                        <StackPanel Grid.Row="0">
                            <!--
                                The mark on its plate, and the name beside it. The plate is the
                                gold tile of the prototype: a warm fill, a hairline of gold round
                                it, and a second hairline five pixels inside - which is what makes
                                it read as a tile with a frame rather than as a coloured square.
                            -->
                            <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,20">
                                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="15"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ModePlateFill}"
                                        BorderBrush="{DynamicResource ModePlateRing}"
                                        BorderThickness="1"
                                        BoxShadow="{DynamicResource ModePlateShadow}">
                                    <Panel>
                                        <Border Margin="5" CornerRadius="10" BorderThickness="1"
                                                IsHitTestVisible="False"
                                                BorderBrush="{DynamicResource ModePlateInnerRing}" />
                                        <!-- The mark from the prototype's sprite: a folder with a
                                             photograph in it, in its own 24-pixel grid. -->
                                        <Path Width="24" Height="24" Stretch="Uniform"
                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource ModePlateInk}"
                                              Data="M3.4 17V7.6A2.4 2.4 0 0 1 5.8 5.2h3.4l1.8 2.2h6.6a2.4 2.4 0 0 1 2.4 2.4V17a2.4 2.4 0 0 1-2.4 2.4H5.8A2.4 2.4 0 0 1 3.4 17z M9.5 11.4a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 1 1 2.2 0z M4.7 17.5l3-2.6a1.3 1.3 0 0 1 1.7 0l2.9 2.5" />
                                    </Panel>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Уникальные папки"
                                           Classes="t23ExtraBold" LetterSpacing="-0.7"
                                           Margin="15,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <TextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap" Margin="0,11,0,0"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="Каждая загруженная папка становится отдельной фотокнигой. Программа сама определит обложку, разложит фотографии по разворотам и присвоит файлам имена, готовые к загрузке." />

                            <!-- The three lines under the copy: a gold check, and the text a
                                 step paler than the heading above it. -->
                            <StackPanel Margin="0,20,0,0">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                                    <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Top" Margin="0,3,0,0"
                                          Stroke="{DynamicResource Accent}"
                                          Data="M4.5 12.5l5 5 10-11" />
                                    <TextBlock Grid.Column="1" FontSize="13.5" LineHeight="21"
                                               TextWrapping="Wrap" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextDefault}"
                                               Text="Обложка определяется сама: самое большое фото в папке" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                                    <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Top" Margin="0,3,0,0"
                                          Stroke="{DynamicResource Accent}"
                                          Data="M4.5 12.5l5 5 10-11" />
                                    <TextBlock Grid.Column="1" FontSize="13.5" LineHeight="21"
                                               TextWrapping="Wrap" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextDefault}"
                                               Text="Порядок разворотов можно изменить, если фотографии в папке идут не по сюжету" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Top" Margin="0,3,0,0"
                                          Stroke="{DynamicResource Accent}"
                                          Data="M4.5 12.5l5 5 10-11" />
                                    <TextBlock Grid.Column="1" FontSize="13.5" LineHeight="21"
                                               TextWrapping="Wrap" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextDefault}"
                                               Text="В одном проекте можно загружать только папки с одинаковым количеством файлов — это нужно для правильной сборки книг" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <!--
                            The rule and the call to action sit on the card's own bottom edge, on
                            the card's hairline rather than a paler one: in the prototype both are
                            the same line, and a rule that is lighter than the frame around it
                            reads as a divider that was left unfinished.
                        -->
                        <StackPanel Grid.Row="1" Margin="0,32,0,0">
                            <Border Height="1" Background="{DynamicResource BorderDefault}" />
                            <Grid Margin="0,20,0,0">
                                <TextBlock Text="Выбрать режим" FontSize="13.5" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" />
                                <Path Classes="modeArrow" HorizontalAlignment="Right"
                                      Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource Accent}"
                                      Data="M4 12h15M13 6l6 6-6 6" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- ========================= комбинированный ========================= -->
                <Button x:Name="CombinedCard" Classes="modeCard featured" Grid.Column="2"
                        AutomationProperties.Name="Комбинированный"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <Grid RowDefinitions="*,Auto">

                        <StackPanel Grid.Row="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,20">
                                <Border Grid.Column="0" Width="50" Height="50" CornerRadius="15"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource ModePlateFill}"
                                        BorderBrush="{DynamicResource ModePlateRing}"
                                        BorderThickness="1"
                                        BoxShadow="{DynamicResource ModePlateShadow}">
                                    <Panel>
                                        <Border Margin="5" CornerRadius="10" BorderThickness="1"
                                                IsHitTestVisible="False"
                                                BorderBrush="{DynamicResource ModePlateInnerRing}" />
                                        <!-- The prototype's second mark: an open book. -->
                                        <Path Width="24" Height="24" Stretch="Uniform"
                                              StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Stroke="{DynamicResource ModePlateInk}"
                                              Data="M12 7.2C10.4 5.8 8.1 5.2 4.2 5.5v12.4c3.9-.3 6.2.4 7.8 1.7 1.6-1.3 3.9-2 7.8-1.7V5.5C15.9 5.2 13.6 5.8 12 7.2z M12 7.2v12.4" />
                                    </Panel>
                                </Border>

                                <TextBlock Grid.Column="1" Text="Комбинированный"
                                           Classes="t23ExtraBold" LetterSpacing="-0.7"
                                           Margin="15,0,0,0" VerticalAlignment="Center" />

                                <!-- The one card the product recommends, and it says so itself
                                     rather than through the order it is drawn in. A cap of gold
                                     with ink on it, not a pale wash with gold words: on warm
                                     paper a washed pill is a label, and this is the product
                                     pointing. -->
                                <Border Grid.Column="2" Height="26" CornerRadius="999"
                                        Padding="11,0" VerticalAlignment="Center"
                                        Background="{DynamicResource TagAccentFill}"
                                        BoxShadow="{DynamicResource TagAccentShadow}">
                                    <TextBlock Text="Рекомендуем" FontSize="11.5" FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TagAccentInk}" />
                                </Border>
                            </Grid>

                            <TextBlock FontSize="14" LineHeight="24" TextWrapping="Wrap" Margin="0,11,0,0"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="Режим для сборки книг вручную: вы выбираете, какое фото в какой книге и на каком развороте будет стоять. Подходит, когда состав каждой книги подбирают отдельно." />

                            <!--
                                The one thing this mode does that the folders mode cannot, said
                                in a box of its own. The box is a warm wash with a gold hairline
                                and a deeper gold for its heading - a note laid on the card, not
                                a third card inside it.
                            -->
                            <Border Background="{DynamicResource CalloutFill}"
                                    BorderBrush="{DynamicResource CalloutBorder}" BorderThickness="1"
                                    CornerRadius="14" Padding="18,16" Margin="0,18,0,4">
                                <StackPanel>
                                    <TextBlock Text="Главное — общие развороты и обложки"
                                               FontSize="13" FontWeight="ExtraBold" LetterSpacing="-0.13"
                                               Foreground="{DynamicResource CalloutTitle}" />
                                    <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               Foreground="{DynamicResource CalloutText}"
                                               Text="Одинаковый разворот или обложку можно добавить сразу во все книги одним действием — и больше не заполнять его вручную в каждой. На больших заказах это заметно ускоряет сборку." />
                                </StackPanel>
                            </Border>

                            <StackPanel Margin="0,20,0,0">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                                    <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Top" Margin="0,3,0,0"
                                          Stroke="{DynamicResource Accent}"
                                          Data="M4.5 12.5l5 5 10-11" />
                                    <TextBlock Grid.Column="1" FontSize="13.5" LineHeight="21"
                                               TextWrapping="Wrap" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextDefault}"
                                               Text="Любая фотография попадает в любую книгу и на любой разворот" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,9">
                                    <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Top" Margin="0,3,0,0"
                                          Stroke="{DynamicResource Accent}"
                                          Data="M4.5 12.5l5 5 10-11" />
                                    <TextBlock Grid.Column="1" FontSize="13.5" LineHeight="21"
                                               TextWrapping="Wrap" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextDefault}"
                                               Text="Общий разворот или обложка добавляется сразу во все книги одним действием" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Path Grid.Column="0" Width="15" Height="15" Stretch="Uniform"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          VerticalAlignment="Top" Margin="0,3,0,0"
                                          Stroke="{DynamicResource Accent}"
                                          Data="M4.5 12.5l5 5 10-11" />
                                    <TextBlock Grid.Column="1" FontSize="13.5" LineHeight="21"
                                               TextWrapping="Wrap" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextDefault}"
                                               Text="Количество разворотов у всех книг одинаковое — это нужно для правильной сборки" />
                                </Grid>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,32,0,0">
                            <Border Height="1" Background="{DynamicResource BorderDefault}" />
                            <Grid Margin="0,20,0,0">
                                <TextBlock Text="Выбрать режим" FontSize="13.5" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Accent}" />
                                <Path Classes="modeArrow" HorizontalAlignment="Right"
                                      Width="17" Height="17" Stretch="Uniform" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource Accent}"
                                      Data="M4 12h15M13 6l6 6-6 6" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>
            </Grid>

            <TextBlock FontSize="12.5" HorizontalAlignment="Center" TextAlignment="Center"
                       TextWrapping="Wrap" Margin="0,26,0,0"
                       Foreground="{DynamicResource TextFaint}"
                       Text="Выбранный режим откроется в отдельной вкладке и будет доступен, пока проект открыт." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
