<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PhotoBook.Shell.Views"
             x:Class="PhotoBook.Shell.Views.ProjectListView"
             FontFamily="Inter">

    <!--
        Transcribed from doc\DESIGN_SPEC.md section 3, number by number, the same way the
        header was. Nothing here is a value looked at by eye:

            header card  padding 24, radius 16, white, slate-200/80 border, shadow-subtle
            title        20 bold            subtitle 12, slate-500, 2 above
            create       16/10, radius 12, brand-600, 12 semibold
            grid         at most 3 columns, gap 24
            card         padding 20, radius 16, same border and shadow
            status pill  padding 11/5, radius 10, border 1, 12 semibold, dot 6
            time         11, slate-400
            name         16 bold
            mode chip    8 left, radius 8, padding 9/4, border 1
            stats        16 above / 12 below a slate-100 rule, two columns 8 apart
            footer       20 above / 12 below a slate-100 rule, 8 apart
            open         8/12, radius 12, slate-100, 12 semibold
            delete       8, radius 12, glyph 14, slate-400 turning red-500 on red-50

        The pill radius is 10 rather than the 6 the mockup asked for: at 22 pixels tall a
        radius of 6 still reads as a rectangle patch, and more rounding was asked for. One
        number if that changes.

        Every command on a card is bound to the screen's data context rather than to the item,
        with the item as the parameter. Binding a command that lives on the item would mean
        every card was its own little view model, and the list is one.
    -->
    <Grid MaxWidth="1600" Margin="32,24" HorizontalAlignment="Stretch">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================ section header ======================== -->
        <Border Grid.Row="0" Classes="card" Padding="24">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Проекты фотокниг" Classes="t20Bold" />
                    <TextBlock Classes="t12" Margin="0,2,0,0"
                               Foreground="{DynamicResource Slate500}"
                               Text="Управляйте подготовленными макетами и запускайте их в автоматический экспорт" />
                </StackPanel>

                <!-- The one action on this screen. -->
                <Button Grid.Column="2" Classes="createProject"
                        AutomationProperties.Name="Создать проект"
                        Command="{Binding CreateProjectCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Opacity="0.95" />
                        <TextBlock Text="Создать проект" Foreground="White"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--
            Finding one project among several.

            Four controls, because there are four different questions somebody actually
            asks: where is the one I want (search), which of these am I working on (mode
            and status), and in what order should I look at them (sort). Anything beyond
            these - a date range, a photograph count, a size - has no question behind it
            yet, and an empty-looking filter is worse than a missing one because it
            promises something and then filters nothing.

            The count on the right is the true total unless something is narrowing, in
            which case it reads "7 из 39". A total that silently changed with the filter
            would be a lie about how many projects exist.
        -->
        <Border Grid.Row="1" Margin="0,16,0,0" IsVisible="{Binding ProjectsCount, Converter={StaticResource NotEmpty}}">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <TextBox Grid.Column="0" Classes="filterSearch" Width="300" HorizontalAlignment="Left"
                         Watermark="Поиск по названию проекта"
                         AutomationProperties.Name="Поиск по названию проекта"
                         Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ComboBox Classes="filter" AutomationProperties.Name="Фильтр по режиму"
                              ItemsSource="{Binding ModeChoices}"
                              SelectedItem="{Binding SelectedMode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Classes="filter" AutomationProperties.Name="Фильтр по статусу"
                              ItemsSource="{Binding StatusChoices}"
                              SelectedItem="{Binding SelectedStatus, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <ComboBox Classes="filter" AutomationProperties.Name="Сортировка"
                              ItemsSource="{Binding SortChoices}"
                              SelectedItem="{Binding SelectedSort, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                <Button Margin="10,0,0,0" Classes="secondary" Padding="12,0"
                        Height="34" IsVisible="{Binding IsNarrowed}"
                        ToolTip.Tip="Показать все проекты"
                        AutomationProperties.Name="Сбросить фильтры"
                        Command="{Binding ClearFiltersCommand}">
                    <TextBlock Text="Сбросить" />
                </Button>

                  <!--
                      The count is the true total, and says so in words: a bare number beside
                      three filters reads as "the filter returned 39", which is a different
                      and wrong thing to believe. While something narrows the list it reads
                      "7 из 39", which is honest about both numbers.
                  -->
                  <TextBlock Text="{Binding FilterSummary}" VerticalAlignment="Center"
                             Margin="16,0,0,0" Classes="t12"
                             Foreground="{DynamicResource Slate500}" />

                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ body ============================== -->
        <Panel Grid.Row="2" Margin="0,24,0,0">

            <!-- loading veil -->
            <Border IsVisible="{Binding IsLoading}" Background="#B3F8FAFC" CornerRadius="16">
                <Border Background="White" CornerRadius="12" Padding="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        BoxShadow="{DynamicResource ShadowSubtle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   Foreground="{DynamicResource Slate400}" />
                        <TextBlock Text="Загрузка проектов..." Classes="t12Medium"
                                   Foreground="{DynamicResource Slate600}" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- error banner -->
            <Border IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}"
                    Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1"
                    CornerRadius="12" Padding="16,12" VerticalAlignment="Top">
                <TextBlock Text="{Binding ErrorMessage}" Classes="t12"
                           Foreground="#DC2626" TextWrapping="Wrap" />
            </Border>

            <!-- empty state: gone the moment there is one project -->

            <!--
                A filter that matched nothing, which is a different thing from having no
                projects at all. The empty state below says "create your first project",
                which is nonsense to somebody with thirty of them - so the two are kept
                apart, and this one offers the way back instead.
            -->
            <Border IsVisible="{Binding HasNoMatches}" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Classes="card" Padding="24">
                <StackPanel Spacing="14" HorizontalAlignment="Center">
                    <TextBlock Text="Ничего не найдено" Classes="t16Bold" />
                    <TextBlock Classes="t12" TextAlignment="Center"
                               Foreground="{DynamicResource Slate500}"
                               Text="Ни один проект не подходит под выбранные условия" />
                    <Button Classes="createProject" AutomationProperties.Name="Сбросить фильтры пусто"
                            Command="{Binding ClearFiltersCommand}">
                        <TextBlock Text="Сбросить фильтры" Foreground="White" />
                    </Button>
                </StackPanel>
            </Border>
            <Border Classes="card" Padding="24" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding ProjectsCount, Converter={StaticResource NotEmpty}, ConverterParameter=empty}">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <Border Width="56" Height="56" CornerRadius="16"
                            Background="{DynamicResource Brand50}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C0;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                   Foreground="{DynamicResource Brand600}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Проектов пока нет" Classes="t18Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock Classes="t12" TextWrapping="Wrap" TextAlignment="Center"
                               Foreground="{DynamicResource Slate500}"
                               Text="Создайте первый проект, выберите режим вёрстки и загрузите фотографии." />
                    <Button Classes="primary" Padding="16,10"
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Создать первый проект"
                            Command="{Binding CreateProjectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="White" />
                            <TextBlock Text="Создать проект" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- the cards -->
            <!--
                 A scroll viewer, not a decoration. With twenty projects the grid is taller
                 than the window, and a screen that silently cuts its own list is a screen
                 that looks like it has six projects.
            -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding FilteredProjects}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                    <!-- Three columns, every card in a row as tall as the tallest card beside it.
                     The platform's uniform grid makes every cell in the list one height and
                     clips the long ones; a wrapping panel makes each card its own height and
                     an empty project comes out visibly shorter than its neighbours. Neither
                     is what the other shell does - it puts three columns in a grid and lets
                     each row be as tall as that row needs. That is the whole of what this
                     panel is. -->
                        <local:ThreeColumnPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Padding="20" Margin="0,0,24,24" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
                            <!--
                                The content sits at the top and the button comes straight after
                                it. Pinning the button to the bottom of the card was tried and
                                undone against the released program: a card with no photographs in
                                it has its button high up there, and that is what people know.
                                Every card in a row is as tall as the row needs, so the slack is
                                at the bottom of the card - and it is the card's own slack, not a
                                hole left to be filled.
                            -->
                            <StackPanel>

                                <!-- status pill + when it changed -->
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" CornerRadius="10" Padding="11,5"
                                            BorderThickness="1"
                                            Background="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=bg}"
                                            BorderBrush="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=border}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                     Fill="{Binding Status, Converter={StaticResource StatusToLabel}, ConverterParameter=dot}" />
                                            <TextBlock Classes="t12Semi" VerticalAlignment="Center"
                                                       Foreground="{Binding Status, Converter={StaticResource StatusToBrush}, ConverterParameter=text}"
                                                       Text="{Binding Status, Converter={StaticResource StatusToLabel}}" />
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Grid.Column="1" Classes="t11"
                                               Foreground="{DynamicResource Slate400}"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding LastModified, Converter={StaticResource LastModifiedText}, ConverterParameter=prefix}" />
                                </Grid>

                                <!-- name + which mode it belongs to -->
                                <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                    <TextBlock Grid.Column="0" Classes="t16Bold"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Text="{Binding Name}" />

                                    <Border Grid.Column="1" Margin="8,0,0,0" CornerRadius="8"
                                            Padding="9,4" BorderThickness="1"
                                            VerticalAlignment="Center"
                                            IsVisible="{Binding Mode, Converter={StaticResource AppModeToLabel}, ConverterParameter=visibility}"
                                            Background="{Binding Mode, Converter={StaticResource AppModeToLabel}, ConverterParameter=tintbg}"
                                            BorderBrush="{Binding Mode, Converter={StaticResource AppModeToLabel}, ConverterParameter=tintborder}">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding Mode, Converter={StaticResource AppModeToLabel}, ConverterParameter=tinticon}"
                                                       Text="{Binding Mode, Converter={StaticResource AppModeToLabel}, ConverterParameter=icon}" />
                                            <TextBlock Classes="t11Semi" VerticalAlignment="Center"
                                                       Foreground="{Binding Mode, Converter={StaticResource AppModeToLabel}, ConverterParameter=tinttext}"
                                                       Text="{Binding Mode, Converter={StaticResource AppModeToLabel}}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <!-- three 48x48 previews plus the remainder -->
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0" Spacing="8"
                                            IsVisible="{Binding HasPreviewPhotos}">
                                    <ItemsControl ItemsSource="{Binding PreviewPhotos}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="48" Height="48" CornerRadius="8"
                                                        ClipToBounds="True"
                                                        BorderThickness="1"
                                                        Background="{DynamicResource Slate100}"
                                                        BorderBrush="{DynamicResource Slate200}">
                                                    <!-- 96 for a 48-pixel tile: two times the drawn size, so a card that lands on a
                                                               high-density screen is not scaling a 48-pixel bitmap back up. -->
                                                    <Image Stretch="UniformToFill"
                                                           Source="{Binding Converter={StaticResource FilePathToBitmap}, ConverterParameter=96}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Border Width="48" Height="48" CornerRadius="8"
                                            Background="{DynamicResource Slate100}"
                                            IsVisible="{Binding RemainingPhotoCount, Converter={StaticResource NotEmpty}}">
                                        <StackPanel Orientation="Horizontal" Spacing="0"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="+" Classes="t11Semi"
                                                       Foreground="{DynamicResource Slate500}" />
                                            <TextBlock Text="{Binding RemainingPhotoCount}"
                                                       Classes="t11Semi"
                                                       Foreground="{DynamicResource Slate500}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Two numbers side by side, each behind its own glyph, the figure in bold and
                                     the unit after it. They sit on one row on purpose: stacked,
                                     the card grows by a line and the two numbers stop being
                                     comparable at a glance, which is all they are there for. -->
                                <Border Height="1" Background="{DynamicResource Slate100}"
                                        Margin="0,16,0,0" />
                                <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Slate400}" />
                                        <TextBlock Classes="t12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Slate600}">
                                            <Run Text="Книг: " />
                                            <Run Text="{Binding BookCount, Mode=OneWay}"
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource Slate800}" />
                                            <Run Text=" шт." FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Slate400}" />
                                        <TextBlock Classes="t12" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Slate600}">
                                            <Run Text="Разворотов: " />
                                            <Run Text="{Binding PageCount, Mode=OneWay}"
                                                 FontWeight="Bold"
                                                 Foreground="{DynamicResource Slate800}" />
                                            <Run Text=" стр." FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>

                                <!-- footer: the card's own width of "open", and the one
                                     destructive thing on it -->

                                <Border Height="1" Background="{DynamicResource Slate100}"
                                        Margin="0,16,0,0" />
                                <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                                    <Button Grid.Column="0" Classes="secondary" Padding="12,8"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Открыть проект"
                                            Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="Открыть проект" Classes="t12Semi" />
                                    </Button>

                                    <Button Grid.Column="1" Classes="icon" Margin="8,0,0,0"
                                            AutomationProperties.Name="Удалить проект"
                                            Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource Slate400}" />
                                    </Button>
                                </Grid>
                                </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Panel>
    </Grid>
</UserControl>
