<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotoBook.Shell.Views.UniqueFoldersView"
             FontFamily="Inter">

    <!--
        Transcribed from doc\DESIGN_SPEC.md section 5, number by number.

            panel         padding 20, radius 16
            icon tile     48x48, radius 12, emerald-50 on emerald-100, glyph 20
            "Проект:"     14 bold, with a 12px pencil beside it that promises an edit you
                          cannot see in the text alone
            counters      12, slate-500, always three numbers - an empty project says
                          "0 обложек · 0 разворотов · 0 папок", not a sentence of its own
            book block    white, 1px slate-200, radius 16, padding 20, 24 between books
            badge         28x28, radius 8, indigo-50, indigo-600 text, zero-padded
            book name     14 bold slate-900; "(Папка: …)" 12 slate-400
            structure     emerald when complete, amber when not, glyph 12 semibold
            "сбросить"    padding 10/6, glyph 12, slate-600 - with an explicit foreground,
                          because in WPF this button inherited white from PrimaryButton and
                          was invisible on a white card
            slot card     radius 12, cover 2px brand-500, spread 1px slate-200, photo flush
            slot grid     WrapPanel, gap 16, card width measured per book, never derived
            filename chip top-left, 10 in, slate-900, radius 6, 8/4, 12 mono semibold
            footer        no rule, padding 10/8/10/10
            arrows        slate-100 pill, radius 8, padding 2, 1px divider, glyphs 12
    -->
    <Grid MaxWidth="1600" Margin="32,24" HorizontalAlignment="Stretch"
          RowDefinitions="Auto,*">

        <!-- =========================== control panel ========================== -->
        <Border Grid.Row="0" Classes="card" Padding="20">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                        Background="{DynamicResource Emerald50}"
                        BorderBrush="{DynamicResource Emerald100}" BorderThickness="1">
                    <TextBlock Text="&#xE8C0;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{DynamicResource Emerald600}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Проект:" Classes="t14Bold" />
                        <TextBlock Classes="t14Bold" Text="{Binding DisplayProjectName}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        <Button Classes="ghost" Padding="6,4"
                                AutomationProperties.Name="Переименовать проект"
                                ToolTip.Tip="Переименовать проект">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource Slate600}" />
                        </Button>
                    </StackPanel>
                    <TextBlock Classes="t12" Margin="0,2,0,0"
                               Foreground="{DynamicResource Slate500}"
                               Text="{Binding BooksSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">

                    <Button Classes="secondary" Padding="12,10"
                            AutomationProperties.Name="Добавить или заменить папки"
                            ToolTip.Tip="Догрузить новые папки или заменить все папки проекта"
                            Command="{Binding LoadFoldersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE8E9;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            <TextBlock Text="Папки" />
                        </StackPanel>
                    </Button>

                    <Button Classes="secondary" Padding="12,10"
                            AutomationProperties.Name="Сохранить проект"
                            Command="{Binding SaveProjectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE8E7;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            <TextBlock Text="Сохранить" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" VerticalAlignment="Center"
                            Background="{DynamicResource Slate200}" />

                    <Button Classes="primary" Padding="16,10"
                            AutomationProperties.Name="Экспортировать все книги"
                            ToolTip.Tip="Выгрузить все книги проекта в одну папку"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                            <TextBlock Text="Экспорт" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ books =============================
             Books are containers, not a flat list. The mockup drew a header and a grid with
             no box around them, and that turned out to be unreadable once a book held
             sixteen spreads. A deliberate departure, recorded in the spec. -->
        <ScrollViewer Grid.Row="1" Margin="0,24,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Padding="20" Margin="0,0,0,24"
                                VerticalAlignment="Top">
                            <StackPanel>

                                <!-- ============================= header ==================== -->
                                <Grid ColumnDefinitions="Auto,*,Auto">

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                            Background="{DynamicResource Indigo50}"
                                            VerticalAlignment="Center">
                                        <TextBlock Classes="t12Semi"
                                                   Foreground="{DynamicResource Indigo600}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding BookIndex, StringFormat={}{0:D2}}" />
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Classes="t14Bold"
                                                   Foreground="{DynamicResource Slate900}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="t12"
                                                   Foreground="{DynamicResource Slate400}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip.Tip="{Binding FolderPath}"
                                                   Text="{Binding FolderPath, StringFormat='(Папка: {0})'}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center">
                                        <!--
                                            The action comes before the state. That is the
                                            order the reference uses, and it is the right one:
                                            "reset the order" is something you can do, and
                                            "the structure is correct" is a fact about the
                                            book, and a fact reads better after the thing
                                            it follows than before it.
                                        -->
                                        <Button Classes="ghost" Padding="10,6" Margin="0,0,8,0"
                                                AutomationProperties.Name="Сбросить порядок"
                                                ToolTip.Tip="Вернуть развороты в исходный порядок"
                                                Command="{Binding DataContext.ResetBookOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Slate600}" />
                                                <TextBlock Text="Сбросить порядок" Classes="t12Semi"
                                                           Foreground="{DynamicResource Slate600}" />
                                            </StackPanel>
                                        </Button>

                                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                   Classes="t12Semi" VerticalAlignment="Center"
                                                   Foreground="{Binding IsValid, Converter={StaticResource BookStatus}, ConverterParameter=brush}"
                                                   Text="{Binding IsValid, Converter={StaticResource BookStatus}, ConverterParameter=glyph}" />
                                        <TextBlock Classes="t12Semi" VerticalAlignment="Center"
                                                   Foreground="{Binding IsValid, Converter={StaticResource BookStatus}, ConverterParameter=brush}"
                                                   Text="{Binding IsValid, Converter={StaticResource BookStatus}, ConverterParameter=text}" />

                                        <Button Classes="icon" Margin="8,0,0,0"
                                                AutomationProperties.Name="Удалить книгу"
                                                Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Slate400}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ============================== slots ==================== -->
                                <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding AllSlotsPages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,16,16" CornerRadius="12" ClipToBounds="True"
                                                    BorderBrush="{Binding Converter={StaticResource PageCaption}, ConverterParameter=border}"
                                                    BorderThickness="{Binding Converter={StaticResource PageCaption}, ConverterParameter=borderthickness}">
                                                <!--
                                                    The width is measured from this row's own
                                                    measured width and the page's own format.
                                                    That is the only pair that cannot feed
                                                    back into each other. Derived from a
                                                    hand-picked reserve it came out ten pixels
                                                    short, and ten pixels is a whole card -
                                                    the row fitted two where it had planned
                                                    three and left a fifth of the width empty.
                                                -->
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                  ConverterParameter="width">
                                                        <Binding Path="Bounds.Width"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Border.Width>

                                                <StackPanel>

                                                    <!-- the photograph, flush to the edges. The clipping that matters is on the
                                                     card above: a photo that runs to the edge of a
                                                     card with rounded corners has to be cut to
                                                     those same corners, or it squares them
                                                     off. Clipping the inner panel instead
                                                     clips to a rectangle and changes
                                                     nothing. -->
                                                    <Panel Height="190">
                                                        <!-- 360 for a cell a little under that wide. The photograph is the whole cost of this
                                                                  screen: decoded at full size it is the reason the list used to
                                                                  freeze, and it is the reason a long book stuttered while
                                                                  scrolling. -->
                                                        <Image Stretch="UniformToFill"
                                                               Source="{Binding SourcePath, Converter={StaticResource FilePathToBitmap}, ConverterParameter=360}" />

                                                        <!-- the file name, on the photograph -->
                                                        <Border VerticalAlignment="Top"
                                                                HorizontalAlignment="Left" Margin="10"
                                                                Background="{DynamicResource Slate900}"
                                                                CornerRadius="6" Padding="8,4"
                                                                IsVisible="{Binding FileName, Converter={StaticResource NotEmpty}}">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Panel>

                                                    <!-- the caption, and the two arrows -->
                                                    <Grid Margin="10,8,10,10" ColumnDefinitions="*,Auto">
                                                        <TextBlock Grid.Column="0" Classes="t12"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Converter={StaticResource PageCaption}, ConverterParameter=brush}"
                                                                   Text="{Binding Converter={StaticResource PageCaption}, ConverterParameter=text}" />

                                                        <Border Grid.Column="1"
                                                                Background="{DynamicResource Slate100}"
                                                                CornerRadius="8" Padding="2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Classes="arrow" Padding="4"
                                                                        AutomationProperties.Name="Переместить левее"
                                                                        Command="{Binding DataContext.MovePageUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="&#xE72B;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource Slate400}" />
                                                                </Button>
                                                                <Border Width="1" Margin="2,0"
                                                                        Background="{DynamicResource Slate200}" />
                                                                <Button Classes="arrow" Padding="4"
                                                                        AutomationProperties.Name="Переместить правее"
                                                                        Command="{Binding DataContext.MovePageDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}">
                                                                    <TextBlock Text="&#xE72A;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource Slate400}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>