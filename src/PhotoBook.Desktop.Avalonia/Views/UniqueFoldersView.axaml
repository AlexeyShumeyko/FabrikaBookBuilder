<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotoBook.Shell.Views.UniqueFoldersView"
             FontFamily="Inter">

    <!--
        Two steps up on this screen, and only this screen, for the reason the other two give.

        This screen is mostly small print: counters under the project name, a folder path, a
        caption under every spread. At twelve pixels none of it can be read without leaning
        in. The body goes to thirteen and the project and book names to fifteen - the project
        name is this screen's heading, and at fourteen it did not look like one. Written here
        rather than in Typography.axaml, so the dialogs keep the twelve they are sized for.
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.t12">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.t14Bold">
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Styles>

    <!--
        Transcribed from doc\DESIGN_SPEC.md section 5, number by number.

            panel         padding 20, radius 16
            icon tile     48x48, radius 12, emerald-50 on emerald-100, glyph 20
            "Проект:"     14 bold, with a 12px pencil beside it that promises an edit you
                          cannot see in the text alone
            counters      12, slate-500, always three numbers - an empty project says
                          "0 обложек · 0 разворотов · 0 папок", not a sentence of its own
            book block    white, 1px slate-200, radius 16, padding 20, 24 between books
            badge         28x28, radius 8, indigo-50, indigo-600 text, zero-padded
            book name     14 bold slate-900; "(Папка: …)" 12 slate-400
            structure     emerald when complete, amber when not, glyph 12 semibold
            "сбросить"    padding 10/6, glyph 12, slate-600 - with an explicit foreground,
                          because in WPF this button inherited white from PrimaryButton and
                          was invisible on a white card
            slot card     radius 12, cover 2px brand-500, spread 1px slate-200, photo flush
            slot grid     WrapPanel, gap 16, card width measured per book, never derived
            filename chip top-left, 10 in, slate-900, radius 6, 8/4, 12 mono semibold
            footer        no rule, padding 10/8/10/10
            arrows        slate-100 pill, radius 8, padding 2, 1px divider, glyphs 12
    -->
    <Grid MaxWidth="1600" Margin="32,24" HorizontalAlignment="Stretch"
          RowDefinitions="Auto,*">

        <!-- =========================== control panel ========================== -->
        <Border Grid.Row="0" Classes="card" Padding="20">
            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="52">

                <!-- Sky, like the mode card on the screen this one is chosen from. It was emerald:
                     green was the old accent and it was given up, and the only thing left of
                     it here was this tile, which is why the screen looked like it belonged
                     to something else. The structure line below the books still turns green
                     when a book is complete, because that is a state and not an accent. -->
                <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                        Background="{DynamicResource Sky50}"
                        BorderBrush="{DynamicResource Sky100}" BorderThickness="1">
                    <TextBlock Text="&#xE8C0;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="{DynamicResource Sky600}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <!--
                        The name is edited where it is shown, not in a dialog. The other shell
                        does it this way and the reason is worth keeping: a name you are
                        renaming is already on screen, and a second window for it is a second
                        thing to look at. Clicking the name itself starts the edit too - the
                        whole name is the target, not just the pencil.
                    -->
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <!-- The word first. A name on its own says what it is called; the
                             word says what it is, and the two screens that also show a
                             project - this one and the combined one - both say it. -->
                        <TextBlock Text="Проект:" Classes="t14Bold"
                                   VerticalAlignment="Center" />

                        <TextBlock Name="ProjectNameTextBlock" Classes="t14Bold"
                                   Text="{Binding DisplayProjectName}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420"
                                   VerticalAlignment="Center" Cursor="Hand"
                                   PointerPressed="OnProjectNameClick" />

                        <Button Classes="icon" Padding="4,4"
                                AutomationProperties.Name="Переименовать проект"
                                ToolTip.Tip="Переименовать проект"
                                Click="OnProjectNamePencilClick">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource Slate600}" />
                        </Button>

                        <TextBox Name="ProjectNameTextBox" Width="360" FontSize="13"
                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                 IsVisible="False"
                                 KeyDown="OnProjectNameKeyDown"
                                 LostFocus="OnProjectNameLostFocus" />
                    </StackPanel>
                    <TextBlock Classes="t12" Margin="0,2,0,0"
                               Foreground="{DynamicResource Slate500}"
                               Text="{Binding BooksSummary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center">

                    <!--
                        Drawn, not fetched from a font.

                        The three marks came out of a Windows 8 icon font, which is why they
                        sat above the words - a glyph and a line of type have different
                        heights and nothing was aligning them - and why the export one looked
                        like it belonged to another program. These are strokes on a 24 grid,
                        so they scale with the button, centre on it by construction, and are
                        the same weight as the line beside them.
                    -->
                    <Button Classes="outline" Padding="12,10"
                            AutomationProperties.Name="Добавить или заменить папки"
                            ToolTip.Tip="Догрузить новые папки или заменить все папки проекта"
                            Command="{Binding LoadFoldersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Slate400}" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 3 7.2 A 1.4 1.4 0 0 1 4.4 5.8 H 9.2 L 11.4 8 H 19.6 A 1.4 1.4 0 0 1 21 9.4 V 17.6 A 1.4 1.4 0 0 1 19.6 19 H 4.4 A 1.4 1.4 0 0 1 3 17.6 Z M 12 11.6 V 16.4 M 9.6 14 H 14.4" />
                            <TextBlock Text="Добавить или заменить папки" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="outline" Padding="12,10"
                            AutomationProperties.Name="Сохранить проект"
                            Command="{Binding SaveProjectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Slate400}" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 12 3.2 V 14.4 M 8.2 10.8 L 12 14.6 L 15.8 10.8 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                            <TextBlock Text="Сохранить проект" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" VerticalAlignment="Center"
                            Background="{DynamicResource Slate200}" />

                    <Button Classes="primary" Padding="16,10"
                            AutomationProperties.Name="Экспортировать"
                            ToolTip.Tip="Выгрузить все книги проекта в одну папку"
                            IsEnabled="{Binding CanExport}"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <!-- Out of the book and out of the program: an arrow leaving a tray. -->
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 12 14.8 V 3.6 M 8.2 7.4 L 12 3.6 L 15.8 7.4 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                            <TextBlock Text="Экспортировать" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================================ books =============================
             Books are containers, not a flat list. The mockup drew a header and a grid with
             no box around them, and that turned out to be unreadable once a book held
             sixteen spreads. A deliberate departure, recorded in the spec. -->
        <ScrollViewer Grid.Row="1" Classes="contentScroll" Margin="0,24,-20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!--
                The bar hangs in the window's own margin and the books finish at the same
                right-hand edge as the panel above them, which is how the projects list does
                it. Twenty pixels are taken back here and handed over by the padding, so
                nothing is lost and the bar is no longer pressed against the last book.
            -->
            <Border Padding="0,0,20,0">
            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Padding="20" Margin="0,0,0,24"
                                VerticalAlignment="Top">
                            <StackPanel>

                                <!-- ============================= header ==================== -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                            Background="{DynamicResource Indigo50}"
                                            VerticalAlignment="Center">
                                        <TextBlock Classes="t12Semi"
                                                   Foreground="{DynamicResource Indigo600}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding BookIndex, StringFormat={}{0:D2}}" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="t14Bold"
                                               Foreground="{DynamicResource Slate900}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               MaxWidth="460" TextTrimming="CharacterEllipsis" />

                                    <!--
                                        The path on the same line, as the released program has
                                        it, and only when there is one. It was stacked under
                                        the name on a line of its own, which made a two-word
                                        book title into a two-line heading and pushed the
                                        actions down with it.
                                    -->
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis" MaxWidth="460"
                                               ToolTip.Tip="{Binding FolderPath}"
                                               IsVisible="{Binding FolderPath, Converter={StaticResource NotEmpty}}"
                                               Classes="t12" Foreground="{DynamicResource Slate400}">
                                        <TextBlock Text="(Папка: " />
                                        <TextBlock Text="{Binding FolderPath}" />
                                    </TextBlock>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center">
                                        <!--
                                            The action comes before the state. That is the
                                            order the reference uses, and it is the right one:
                                            "reset the order" is something you can do, and
                                            "the structure is correct" is a fact about the
                                            book, and a fact reads better after the thing
                                            it follows than before it.
                                        -->
                                        <Button Classes="ghost" Padding="10,6" Margin="0,0,8,0"
                                                AutomationProperties.Name="Сбросить порядок книги"
                                                ToolTip.Tip="Вернуть развороты в исходный порядок"
                                                Command="{Binding DataContext.ResetBookOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Slate600}" />
                                                <TextBlock Text="Сбросить порядок книги" Classes="t12Semi"
                                                           Foreground="{DynamicResource Slate600}" />
                                            </StackPanel>
                                        </Button>

                                        <!--
                                            The structure line used to be here, saying "structure
                                            complete" or not. Removed: it reads the same property
                                            the export button reads, and in this mode it is the
                                            export button that decides - a book here cannot lose
                                            a spread or change its shape, the only way to be
                                            incomplete is a folder that held fewer photographs
                                            than the book has room for, and that is caught when
                                            the folders are loaded.

                                            It was also disagreeing with that button on screen:
                                            the button enabled and the line saying otherwise,
                                            which means the line was answering from a stale
                                            value. Two labels for one condition is one too many;
                                            the one that gates the action stays.
                                        -->

                                        <Button Classes="icon" Margin="8,0,0,0"
                                                AutomationProperties.Name="Удалить книгу"
                                                Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Slate400}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ============================== slots ==================== -->
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AllSlotsPages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,16,16" CornerRadius="12" ClipToBounds="True" Classes="slotCard"
                                                    PointerEntered="OnCardPointerEntered"
                                                    PointerExited="OnCardPointerExited"
                                                    BorderBrush="{Binding Converter={StaticResource PageCaption}, ConverterParameter=border}"
                                                    BorderThickness="{Binding Converter={StaticResource PageCaption}, ConverterParameter=borderthickness}">
                                                <!--
                                                    The width is measured from this row's own
                                                    measured width and the page's own format.
                                                    That is the only pair that cannot feed
                                                    back into each other. Derived from a
                                                    hand-picked reserve it came out ten pixels
                                                    short, and ten pixels is a whole card -
                                                    the row fitted two where it had planned
                                                    three and left a fifth of the width empty.
                                                -->
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                  ConverterParameter="width">
                                                        <Binding Path="Bounds.Width"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Border.Width>

                                                <StackPanel>

                                                    <!-- the photograph, flush to the edges. The clipping that matters is on the
                                                     card above: a photo that runs to the edge of a
                                                     card with rounded corners has to be cut to
                                                     those same corners, or it squares them
                                                     off. Clipping the inner panel instead
                                                     clips to a rectangle and changes
                                                     nothing. -->
                                                    <Panel Height="190">
                                                        <!-- 360 for a cell a little under that wide, in layout units - the converter turns it
                                                                  into device pixels by the monitor's own scaling, which is what keeps a
                                                                  photo sharp on a dense screen instead of stretched back up.
                                                                  Fit, not fill: a photograph that is cropped to the cell loses the
                                                                  edges a photographer chose, and moving the window to a
                                                                  monitor with a different scaling used to crop more of it. -->
                                                        <Image Stretch="Uniform"
                                                               Source="{Binding Converter={StaticResource PageToBitmap}, ConverterParameter=360}" />

                                                        <!-- the file name, on the photograph -->
                                                        <Border VerticalAlignment="Top"
                                                                HorizontalAlignment="Left" Margin="10"
                                                                Background="{DynamicResource Slate900}"
                                                                CornerRadius="6" Padding="8,4"
                                                                IsVisible="{Binding FileName, Converter={StaticResource NotEmpty}}">
                                                            <TextBlock Text="{Binding FileName}"
                                                                       FontFamily="Consolas"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="White"
                                                                       TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                    </Panel>

                                                    <!-- the caption, and the two arrows -->
                                                    <Grid Margin="10,8,10,10" ColumnDefinitions="*,Auto">
                                                        <!-- The action and the caption share the left half of the row, and only one
                         of them is ever on screen: the caption normally, the action while the
                         pointer is on the card. The action is a real button rather than styled
                         text because it has to be reachable from the keyboard and show up in
                         automation. Neither is bound to a converter for visibility: which one
                         is showing is a fact about the pointer, and the pointer is not in the
                         model. Binding the caption's visibility to the slot instead - "hide
                         the caption on every spread" - is what put the two words on top of
                         each other.

                         What the action SAYS is the slot's own business and is bound: a
                         spread is offered promotion, and the cover is offered a different
                         photograph, because it cannot be promoted to be what it already is. -->
                                                    <Grid Grid.Column="0">
                                                        <TextBlock Name="PageCaption" Classes="t12"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Converter={StaticResource PageCaption}, ConverterParameter=brush}"
                                                                   Text="{Binding Converter={StaticResource PageCaption}, ConverterParameter=text}" />

                                                        <Button Name="AssignCoverAction" Classes="ghost"
                                                                Padding="0" HorizontalAlignment="Left"
                                                                IsVisible="False"
                                                                AutomationProperties.Name="{Binding Converter={StaticResource PageCaption}, ConverterParameter=actionname}"
                                                                Click="OnSlotActionClick">
                                                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{Binding Converter={StaticResource PageCaption}, ConverterParameter=actionbrush}"
                                                                       Text="{Binding Converter={StaticResource PageCaption}, ConverterParameter=actiontext}" />
                                                        </Button>
                                                    </Grid>

                                                        <Border Grid.Column="1"
                                                                Background="{DynamicResource Slate100}"
                                                                CornerRadius="8" Padding="2">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Button Classes="arrow" Padding="4"
                                                                        AutomationProperties.Name="Переместить левее"
                                                                        Click="OnMovePageLeftClick">
                                                                    <TextBlock Text="&#xE72B;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource Slate400}" />
                                                                </Button>
                                                                <Border Width="1" Margin="2,0"
                                                                        Background="{DynamicResource Slate200}" />
                                                                <Button Classes="arrow" Padding="4"
                                                                        AutomationProperties.Name="Переместить правее"
                                                                        Click="OnMovePageRightClick">
                                                                    <TextBlock Text="&#xE72A;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource Slate400}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
