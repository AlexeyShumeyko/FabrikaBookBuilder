<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotoBook.Shell.Views.UniqueFoldersView">

    <!--
        Two steps up on this screen, and only this screen, for the reason the other two give.

        This screen is mostly small print: counters under the project name, a folder path, a
        caption under every spread. At twelve pixels none of it can be read without leaning
        in. The body goes to thirteen and the project and book names to fifteen - the project
        name is this screen's heading, and at fourteen it did not look like one. Written here
        rather than in Typography.axaml, so the dialogs keep the twelve they are sized for.
    -->
    <UserControl.Styles>
        <Style Selector="TextBlock.t12">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="TextBlock.t14Bold">
            <Setter Property="FontSize" Value="15" />
        </Style>
    </UserControl.Styles>

    <!--
        Transcribed from doc\DESIGN_SPEC.md section 5, number by number.

            panel         padding 20, radius 16
            icon tile     48x48, radius 12, emerald-50 on emerald-100, glyph 20
            "Проект:"     14 bold, with a 12px pencil beside it that promises an edit you
                          cannot see in the text alone
            counters      12, slate-500, always three numbers - an empty project says
                          "0 обложек · 0 разворотов · 0 папок", not a sentence of its own
            book block    white, 1px slate-200, radius 16, padding 20, 24 between books
            badge         28x28, radius 8, indigo-50, indigo-600 text, zero-padded
            book name     14 bold slate-900; "(Папка: …)" 12 slate-400
            structure     emerald when complete, amber when not, glyph 12 semibold
            "сбросить"    padding 10/6, glyph 12, slate-600 - with an explicit foreground,
                          because in WPF this button inherited white from PrimaryButton and
                          was invisible on a white card
            slot card     radius 12, cover 2px brand-500, spread 1px slate-200, photo flush
            slot grid     WrapPanel, gap 16, card width measured per book, never derived
            filename chip top-left, 10 in, slate-900, radius 6, 8/4, 12 mono semibold
            footer        no rule, padding 10/8/10/10
            arrows        slate-100 pill, radius 8, padding 2, 1px divider, glyphs 12
    -->
    <Grid MaxWidth="1600" Margin="32,24" HorizontalAlignment="Stretch"
          RowDefinitions="Auto,*">

        <!-- =========================== control panel ========================== -->
        <Border Grid.Row="0" Classes="card" Padding="24,20">
            <Grid ColumnDefinitions="Auto,*,Auto" MinHeight="58">

                <!-- Sky, like the mode card on the screen this one is chosen from. It was emerald:
                     green was the old accent and it was given up, and the only thing left of
                     it here was this tile, which is why the screen looked like it belonged
                     to something else. The structure line below the books still turns green
                     when a book is complete, because that is a state and not an accent. -->
                <Border Grid.Column="0" Width="52" Height="52" CornerRadius="15"
                        VerticalAlignment="Center" Margin="0,0,14,0"
                        Background="{DynamicResource AvatarFill}"
                        BorderBrush="{DynamicResource AvatarRing}" BorderThickness="1">
                    <TextBlock Text="&#xE8C0;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                               Foreground="{DynamicResource AvatarInk}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!--
                        The name is edited where it is shown, not in a dialog. The other shell
                        does it this way and the reason is worth keeping: a name you are
                        renaming is already on screen, and a second window for it is a second
                        thing to look at. Clicking the name itself starts the edit too - the
                        whole name is the target, not just the pencil.
                    -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                        <!-- The word first. A name on its own says what it is called; the
                             word says what it is, and the two screens that also show a
                             project - this one and the combined one - both say it. -->
                        <TextBlock Grid.Column="0" Text="Проект:" Classes="t19ExtraBold"
                                   VerticalAlignment="Center" />

                        <TextBlock Grid.Column="1" Name="ProjectNameTextBlock" Classes="t19ExtraBold"
                                   Text="{Binding DisplayProjectName}" Margin="8,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" Cursor="Hand"
                                   PointerPressed="OnProjectNameClick" />

                        <Button Grid.Column="2" Classes="icon" Padding="4,4" Margin="6,0,0,0"
                                AutomationProperties.Name="Переименовать проект"
                                ToolTip.Tip="Переименовать проект"
                                Click="OnProjectNamePencilClick">
                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource Slate600}" />
                        </Button>

                        <TextBox Grid.Column="3" Name="ProjectNameTextBox" Width="360" FontSize="13"
                                 Margin="6,0,0,0" VerticalAlignment="Center"
                                 IsVisible="False"
                                 KeyDown="OnProjectNameKeyDown"
                                 LostFocus="OnProjectNameLostFocus" />
                    </Grid>
                    <TextBlock Classes="t11Half" Margin="0,3,0,0"
                               Foreground="{DynamicResource Slate500}"
                               Text="{Binding BooksSummary}" />
                </StackPanel>

                <WrapPanel Grid.Column="2" Orientation="Horizontal"
                           VerticalAlignment="Center">

                    <!--
                        Drawn, not fetched from a font.

                        The three marks came out of a Windows 8 icon font, which is why they
                        sat above the words - a glyph and a line of type have different
                        heights and nothing was aligning them - and why the export one looked
                        like it belonged to another program. These are strokes on a 24 grid,
                        so they scale with the button, centre on it by construction, and are
                        the same weight as the line beside them.
                    -->
                    <Button Classes="outline" Padding="12,10" Margin="0,0,8,0"
                            AutomationProperties.Name="Добавить или заменить папки"
                            ToolTip.Tip="Догрузить новые папки или заменить все папки проекта"
                            Command="{Binding LoadFoldersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Slate400}" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 3 7.2 A 1.4 1.4 0 0 1 4.4 5.8 H 9.2 L 11.4 8 H 19.6 A 1.4 1.4 0 0 1 21 9.4 V 17.6 A 1.4 1.4 0 0 1 19.6 19 H 4.4 A 1.4 1.4 0 0 1 3 17.6 Z M 12 11.6 V 16.4 M 9.6 14 H 14.4" />
                            <TextBlock Text="Добавить или заменить папки" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="outline" Padding="12,10" Margin="0,0,8,0"
                            AutomationProperties.Name="Сохранить проект"
                            Command="{Binding SaveProjectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Slate400}" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 12 3.2 V 14.4 M 8.2 10.8 L 12 14.6 L 15.8 10.8 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                            <TextBlock Text="Сохранить проект" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Margin="0,0,8,0" VerticalAlignment="Center"
                            Background="{DynamicResource Slate200}" />

                    <Button Classes="outline" Padding="12,10" Margin="0,0,8,0"
                            AutomationProperties.Name="Загрузить на сайт"
                            ToolTip.Tip="Собрать заказ для сайта: только полностью собранный проект"
                            IsEnabled="{Binding CanExport}"
                            Command="{Binding OrderOnSiteCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="{DynamicResource Slate400}" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 12 16.8 V 5.6 M 8.2 9.4 L 12 5.6 L 15.8 9.4 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                            <TextBlock Text="Загрузить на сайт" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Classes="primary" Padding="16,10" Margin="0,0,8,0"
                            AutomationProperties.Name="Экспортировать"
                            ToolTip.Tip="Выгрузить все книги проекта в одну папку"
                            IsEnabled="{Binding CanExport}"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <!-- Out of the book and out of the program: an arrow leaving a tray. -->
                            <Path Width="15" Height="15" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 12 14.8 V 3.6 M 8.2 7.4 L 12 3.6 L 15.8 7.4 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                            <TextBlock Text="Экспортировать" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ================================ books =============================
             Books are containers, not a flat list. The mockup drew a header and a grid with
             no box around them, and that turned out to be unreadable once a book held
             sixteen spreads. A deliberate departure, recorded in the spec. -->
        <ScrollViewer Grid.Row="1" Classes="contentScroll" Margin="0,24,-20,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!--
                The bar hangs in the window's own margin and the books finish at the same
                right-hand edge as the panel above them, which is how the projects list does
                it. Twenty pixels are taken back here and handed over by the padding, so
                nothing is lost and the bar is no longer pressed against the last book.
            -->
            <Border Padding="0,18,20,0">
            <StackPanel>

            <!--
                No folders yet. The panel says what a folder becomes and what the program does
                with it; the two cards beside it answer the two questions that come before
                anybody presses a button - what has to be true of the folders, and what the
                files will be called.
            -->
            <Grid IsVisible="{Binding BooksCount, Converter={StaticResource NotEmpty}, ConverterParameter=empty}"
                  ColumnDefinitions="*,18,356">
                <Border Grid.Column="0" Classes="card" CornerRadius="22" Padding="34,28,34,26">
                    <StackPanel>
                        <Border Width="58" Height="58" CornerRadius="17" HorizontalAlignment="Left"
                                Background="{DynamicResource AvatarFill}"
                                BorderBrush="{DynamicResource AvatarRing}" BorderThickness="1">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="27"
                                       Foreground="{DynamicResource AvatarInk}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <TextBlock Text="УНИКАЛЬНЫЕ ПАПКИ" Classes="t11ExtraBold" Margin="0,16,0,0"
                                   Foreground="{DynamicResource Gold}" />

                        <TextBlock Text="Добавьте первую папку — книга соберётся сама"
                                   Classes="t29ExtraBold" Margin="0,12,0,0"
                                   LineHeight="34" TextWrapping="Wrap" />

                        <TextBlock Classes="t14" Margin="0,12,0,0" MaxWidth="700"
                                   TextWrapping="Wrap" LineHeight="24"
                                   Foreground="{DynamicResource Slate500}"
                                   Text="Каждая папка становится отдельной книгой. Программа выберет обложку, разложит фотографии по разворотам и даст файлам имена, готовые к загрузке." />

                            <StackPanel Margin="0,20,0,0">
                                <Grid ColumnDefinitions="30,*" Margin="0,0,0,0">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brand50}"
                                            BorderBrush="{DynamicResource BorderAccentHover}" BorderThickness="1">
                                        <TextBlock Text="1" Classes="t12Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Gold}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="Подготовьте папки на диске" Classes="t13ExtraBold" Margin="0,5,0,0" />
                                        <TextBlock Classes="t12Half" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Text="В каждой папке — фотографии одной книги в нужном порядке. Количество файлов во всех папках проекта одинаковое." />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Width="1" Height="14" Margin="14,0,0,0"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource Gold}" Opacity="0.22" />
                                <Grid ColumnDefinitions="30,*" Margin="0,0,0,0">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brand50}"
                                            BorderBrush="{DynamicResource BorderAccentHover}" BorderThickness="1">
                                        <TextBlock Text="2" Classes="t12Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Gold}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="Добавьте папки в проект" Classes="t13ExtraBold" Margin="0,5,0,0" />
                                        <TextBlock Classes="t12Half" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Text="Кнопкой «Добавить папки» или перетаскиванием в окно. Можно сразу весь заказ — программа разложит папки по книгам." />
                                    </StackPanel>
                                </Grid>
                                <Rectangle Width="1" Height="14" Margin="14,0,0,0"
                                           HorizontalAlignment="Left"
                                           Fill="{DynamicResource Gold}" Opacity="0.22" />
                                <Grid ColumnDefinitions="30,*" Margin="0,0,0,0">
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="15"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brand50}"
                                            BorderBrush="{DynamicResource BorderAccentHover}" BorderThickness="1">
                                        <TextBlock Text="3" Classes="t12Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Gold}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                        <TextBlock Text="Проверьте раскладку" Classes="t13ExtraBold" Margin="0,5,0,0" />
                                        <TextBlock Classes="t12Half" Margin="0,4,0,0" TextWrapping="Wrap"
                                                   LineHeight="20"
                                                   Text="Обложка определяется автоматически, а развороты можно переставить до загрузки." />
                                    </StackPanel>
                                </Grid>

                            </StackPanel>

                        <Border Margin="0,20,0,0" Padding="0,18,0,0"
                                BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0">
                            <WrapPanel Orientation="Horizontal">
                                <Button Classes="primary" Padding="16,10" Margin="0,0,14,0"
                                        AutomationProperties.Name="Добавить папки"
                                        Command="{Binding LoadFoldersCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OnAccent}" />
                                        <TextBlock Text="Добавить папки" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource OnAccent}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Classes="t11Half" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Slate400}"
                                           Text="JPG и PNG · исходные файлы не изменяются" />
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="2" Spacing="16">
                    <Border Classes="card" CornerRadius="18" Padding="22,20">
                        <StackPanel>
                            <TextBlock Text="Что важно в этом режиме" Classes="t15ExtraBold" />
                            <StackPanel Margin="0,12,0,0">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                                    <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Gold}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Одинаковое число файлов" Classes="t12Semi" />
                                        <TextBlock Classes="t11Half" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   LineHeight="18" Foreground="{DynamicResource Slate500}"
                                                   Text="Если в папках разное количество снимков, книги соберутся неправильно." />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,12">
                                    <TextBlock Grid.Column="0" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Gold}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Папка — это книга" Classes="t12Semi" />
                                        <TextBlock Classes="t11Half" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   LineHeight="18" Foreground="{DynamicResource Slate500}"
                                                   Text="Название папки станет названием книги в проекте." />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Column="0" Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="13" Margin="0,2,0,0"
                                               Foreground="{DynamicResource Slate400}" />
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Один проект — один формат" Classes="t12Semi" />
                                        <TextBlock Classes="t11Half" Margin="0,3,0,0" TextWrapping="Wrap"
                                                   LineHeight="18" Foreground="{DynamicResource Slate500}"
                                                   Text="Не смешивайте разные макеты в одной папке заказа." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" CornerRadius="18" Padding="22,20">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Имена файлов" Classes="t15ExtraBold" />
                                <Border Grid.Column="1" CornerRadius="999" Padding="8,3"
                                        Background="{DynamicResource Brand50}"
                                        BorderBrush="{DynamicResource BorderAccentHover}" BorderThickness="1">
                                    <TextBlock Text="автоматически" Classes="t11ExtraBold"
                                               Foreground="{DynamicResource Gold}" />
                                </Border>
                            </Grid>

                            <StackPanel Margin="0,12,0,0" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="001-00_474_14.jpg" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Slate900}" />
                                    <TextBlock Grid.Column="1" Text="обложка" Classes="t11"
                                               Foreground="{DynamicResource Slate400}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="001-01.jpg" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Slate900}" />
                                    <TextBlock Grid.Column="1" Text="разворот 1" Classes="t11"
                                               Foreground="{DynamicResource Slate400}" />
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="001-02.jpg" FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Slate900}" />
                                    <TextBlock Grid.Column="1" Text="разворот 2" Classes="t11"
                                               Foreground="{DynamicResource Slate400}" />
                                </Grid>
                            </StackPanel>

                            <TextBlock Classes="t11Half" Margin="0,12,0,0" TextWrapping="Wrap"
                                       LineHeight="18" Foreground="{DynamicResource Slate400}"
                                       Text="Номер книги, номер страницы и размер — так файлы понимает сайт печати." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <ItemsControl ItemsSource="{Binding Books}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Classes="card" Padding="20,18,20,22" Margin="0,0,0,18"
                                VerticalAlignment="Top">
                            <StackPanel>

                                <!-- ============================= header ==================== -->
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto">

                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8"
                                            Background="{DynamicResource Slate100}"
                                            BorderBrush="{DynamicResource Slate200}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Classes="t11ExtraBold"
                                                   Foreground="{DynamicResource Slate500}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding BookIndex, StringFormat={}{0:D2}}" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Classes="t14Bold"
                                               Foreground="{DynamicResource Slate900}"
                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                               MaxWidth="460" TextTrimming="CharacterEllipsis" />

                                    <!--
                                        The path on the same line, as the released program has
                                        it, and only when there is one. It was stacked under
                                        the name on a line of its own, which made a two-word
                                        book title into a two-line heading and pushed the
                                        actions down with it.
                                    -->
                                    <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                                               HorizontalAlignment="Left" TextAlignment="Left"
                                               TextTrimming="CharacterEllipsis" MaxWidth="460"
                                               ToolTip.Tip="{Binding FolderPath}"
                                               IsVisible="{Binding FolderPath, Converter={StaticResource NotEmpty}}"
                                               Classes="t11Half" Foreground="{DynamicResource Slate400}">
                                        <TextBlock Text="(Папка: " />
                                        <TextBlock Text="{Binding FolderPath}" />
                                    </TextBlock>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                Spacing="6" VerticalAlignment="Center">
                                        <!--
                                            The action comes before the state. That is the
                                            order the reference uses, and it is the right one:
                                            "reset the order" is something you can do, and
                                            "the structure is correct" is a fact about the
                                            book, and a fact reads better after the thing
                                            it follows than before it.
                                        -->
                                        <Button Classes="ghost" Padding="10,6" Margin="0,0,8,0"
                                                AutomationProperties.Name="Сбросить порядок книги"
                                                ToolTip.Tip="Вернуть развороты в исходный порядок"
                                                Command="{Binding DataContext.ResetBookOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource Slate600}" />
                                                <TextBlock Text="Сбросить порядок книги" Classes="t12Semi"
                                                           Foreground="{DynamicResource Slate600}" />
                                            </StackPanel>
                                        </Button>

                                        <!--
                                            The structure line used to be here, saying "structure
                                            complete" or not. Removed: it reads the same property
                                            the export button reads, and in this mode it is the
                                            export button that decides - a book here cannot lose
                                            a spread or change its shape, the only way to be
                                            incomplete is a folder that held fewer photographs
                                            than the book has room for, and that is caught when
                                            the folders are loaded.

                                            It was also disagreeing with that button on screen:
                                            the button enabled and the line saying otherwise,
                                            which means the line was answering from a stale
                                            value. Two labels for one condition is one too many;
                                            the one that gates the action stays.
                                        -->

                                        <Button Classes="icon" Margin="8,0,0,0"
                                                AutomationProperties.Name="Удалить книгу"
                                                Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource Slate400}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- ============================== slots ==================== -->
                                <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding AllSlotsPages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,0,16,16" CornerRadius="12" ClipToBounds="True" Classes="slotCard"
                                                    PointerEntered="OnCardPointerEntered"
                                                    PointerExited="OnCardPointerExited"
                                                    BorderBrush="{Binding Converter={StaticResource PageCaption}, ConverterParameter=border}"
                                                    BorderThickness="{Binding Converter={StaticResource PageCaption}, ConverterParameter=borderthickness}">
                                                <!--
                                                    The width is measured from this row's own
                                                    measured width and the page's own format.
                                                    That is the only pair that cannot feed
                                                    back into each other. Derived from a
                                                    hand-picked reserve it came out ten pixels
                                                    short, and ten pixels is a whole card -
                                                    the row fitted two where it had planned
                                                    three and left a fifth of the width empty.
                                                -->
                                                <Border.Width>
                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                  ConverterParameter="width">
                                                        <Binding Path="Bounds.Width"
                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding Path="." />
                                                    </MultiBinding>
                                                </Border.Width>

                                                <StackPanel>

                                                    <!-- the photograph, flush to the edges. The clipping that matters is on the
                                                     card above: a photo that runs to the edge of a
                                                     card with rounded corners has to be cut to
                                                     those same corners, or it squares them
                                                     off. Clipping the inner panel instead
                                                     clips to a rectangle and changes
                                                     nothing. -->
                                                    <!--
                                                    One rounded edge for the photograph, and it
                                                    is not the card's own.

                                                    The card drew its frame and clipped its
                                                    contents with one border, so the
                                                    photograph's square corner lay over the
                                                    inside half of the stroke and cut the
                                                    rounded line off exactly where it turned -
                                                    worst on the cover, where the stroke is
                                                    two pixels of colour rather than a
                                                    hairline. The stroke is now on a border
                                                    that clips nothing, and the round edge
                                                    belongs to the photograph alone. Only its
                                                    top two corners are round: the caption
                                                    sits under it on white, and rounding the
                                                    bottom two would show that white through
                                                    the photograph.
                                                -->
                                                <Border CornerRadius="12,12,0,0" ClipToBounds="True"
                                                        Background="{DynamicResource Slate100}">
                                                    <Panel>
                                                    <!--
                                                        The frame keeps the book's own format,
                                                        both sides at once.

                                                        Only the width was asked for here, and
                                                        the height was pinned at 190: so on a
                                                        narrow window the frame got shorter
                                                        while its height stayed, the photo
                                                        inside was scaled to fit what was left,
                                                        and the card showed white above and
                                                        below it. The count per row was right -
                                                        it is decided from the width - and that
                                                        is why it only showed once the row
                                                        filled up.

                                                        The height comes from the same two
                                                        numbers as the width, so a frame and
                                                        the photograph in it are always the same
                                                        shape, and resizing the window resizes
                                                        both by the same factor.
                                                    -->
                                                    <Panel.Height>
                                                        <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                      ConverterParameter="height">
                                                            <Binding Path="Bounds.Width"
                                                                     RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                            <Binding Path="." />
                                                        </MultiBinding>
                                                    </Panel.Height>

                                                    <!-- Fill, not fit - as the released program
                                                         does it. The frame is the book's own
                                                         format and the photograph is drawn to
                                                         it, so filling crops nothing; fitting
                                                         left white above and below, which is the
                                                         half-empty look this replaces.

                                                         360 for a cell a little under that wide,
                                                         in layout units - the converter turns it
                                                         into device pixels by the monitor's own
                                                         scaling, which is what keeps a photo
                                                         sharp on a dense screen instead of
                                                         stretched back up. -->
                                                    <Image Stretch="UniformToFill">
                                                        <Image.Source>
                                                            <!-- MultiBinding: the page object alone is
                                                                 evaluated once per card, so a slot filled
                                                                 later kept drawing nothing. -->
                                                            <MultiBinding Converter="{StaticResource PageToBitmap}" ConverterParameter="360">
                                                                <Binding />
                                                                <Binding Path="SourcePath" />
                                                                <Binding Path="ThumbnailPath" />
                                                            </MultiBinding>
                                                        </Image.Source>
                                                    </Image>

                                                    <!-- the file name, on the photograph -->
                                                    <Border VerticalAlignment="Top"
                                                            HorizontalAlignment="Left" Margin="10"
                                                            Background="{DynamicResource Slate900}"
                                                            CornerRadius="6" Padding="8,4"
                                                            IsVisible="{Binding FileName, Converter={StaticResource NotEmpty}}">
                                                        <TextBlock Text="{Binding FileName}"
                                                                   FontFamily="Consolas"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Surface}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                            </Border>
                                                        </Panel>
                                                    </Border>

                                                    <!-- the caption, and the two arrows -->
                                                    <Grid Margin="10,8,10,10" ColumnDefinitions="*,Auto">
                                                        <!-- The action and the caption share the left half of the row, and only one
                         of them is ever on screen: the caption normally, the action while the
                         pointer is on the card. The action is a real button rather than styled
                         text because it has to be reachable from the keyboard and show up in
                         automation. Neither is bound to a converter for visibility: which one
                         is showing is a fact about the pointer, and the pointer is not in the
                         model. Binding the caption's visibility to the slot instead - "hide
                         the caption on every spread" - is what put the two words on top of
                         each other.

                         What the action SAYS is the slot's own business and is bound: a
                         spread is offered promotion, and the cover is offered a different
                         photograph, because it cannot be promoted to be what it already is. -->
                                                    <Grid Grid.Column="0">
                                                        <TextBlock Name="PageCaption" Classes="t12"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{Binding Converter={StaticResource PageCaption}, ConverterParameter=brush}"
                                                                   Text="{Binding Converter={StaticResource PageCaption}, ConverterParameter=text}" />

                                                        <Button Name="AssignCoverAction" Classes="ghost"
                                                                Padding="0" HorizontalAlignment="Left"
                                                                IsVisible="False"
                                                                AutomationProperties.Name="{Binding Converter={StaticResource PageCaption}, ConverterParameter=actionname}"
                                                                Click="OnSlotActionClick">
                                                            <TextBlock FontSize="14" FontWeight="SemiBold"
                                                                       Foreground="{Binding Converter={StaticResource PageCaption}, ConverterParameter=actionbrush}"
                                                                       Text="{Binding Converter={StaticResource PageCaption}, ConverterParameter=actiontext}" />
                                                        </Button>
                                                    </Grid>

                                                        <Border Grid.Column="1"
                                                                Background="Transparent"
                                                                CornerRadius="6" Padding="0">
                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                <Button Classes="arrow" Padding="0"
                                                                        Width="22" Height="22"
                                                                        AutomationProperties.Name="Переместить левее"
                                                                        Click="OnMovePageLeftClick">
                                                                    <TextBlock Text="&#xE72B;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource Slate400}" />
                                                                </Button>
                                                                <Border Width="1" Margin="2,0"
                                                                        Background="{DynamicResource Slate200}" />
                                                                <Button Classes="arrow" Padding="0"
                                                                        Width="22" Height="22"
                                                                        AutomationProperties.Name="Переместить правее"
                                                                        Click="OnMovePageRightClick">
                                                                    <TextBlock Text="&#xE72A;"
                                                                               FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource Slate400}" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
