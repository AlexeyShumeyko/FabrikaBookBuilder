<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PhotoBook.Shell.Controls"
             x:Class="PhotoBook.Shell.Views.HelpView">

    <!--
        The guide, transcribed from the prototype's #view-help and its pages.css.

        Nothing here is a card. The prototype's manual is a page of type on paper: hairlines
        instead of frames, small capitals instead of headings in boxes, and the only filled
        objects on it are the marks that stand for a mode and the step that is current. That
        is the whole difference from the dialog this used to be.

        The spine stays beside the chapters as they scroll, which is what `position: sticky`
        does in the prototype; this engine has no sticky, so the offset is applied in
        code-behind as the page scrolls. Everything else is the prototype's own numbers.
    -->
    <UserControl.Styles>

        <!--
            A row of the spine is a line of the contents, not a button. Its chrome is gone;
            what the pointer gets is the words turning darker, and what the current chapter
            gets is the two-pixel gold rule the prototype draws at its left.
        -->
        <Style Selector="Button.spine">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="2,*">
                        <Border Name="Mark" CornerRadius="2" Background="Transparent"
                                Margin="0,9,0,9" />
                        <ContentPresenter Grid.Column="1" Margin="13,7,0,7"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.spine TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="Button.spine TextBlock.numeral">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Button.spine:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        </Style>
        <Style Selector="Button.spine.active TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
        </Style>
        <Style Selector="Button.spine.active TextBlock.numeral">
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.spine.active /template/ Border#Mark">
            <Setter Property="Background" Value="{DynamicResource ManualTick}" />
        </Style>

        <!--
            The way out to people. The prototype closes the spine with a gold line and the
            word «Поддержка», and it is a row of the same list rather than a button at its
            foot.
        -->
        <Style Selector="Button.spineSupport">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.spineSupport TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource ManualAccent}" />
        </Style>
        <Style Selector="Button.spineSupport Path">
            <Setter Property="Stroke" Value="{DynamicResource ManualAccent}" />
        </Style>
        <Style Selector="Button.spineSupport:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentStrong}" />
        </Style>
        <Style Selector="Button.spineSupport:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentStrong}" />
        </Style>

        <!--
            The five steps of the training. A tab is a row of a list for the same reason the
            spine is: the chrome would turn five steps into five grey blocks.
        -->
        <Style Selector="Button.trainTab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="2,*">
                        <Border Name="Mark" CornerRadius="2" Background="Transparent"
                                Margin="0,10,0,10" />
                        <ContentPresenter Grid.Column="1" Margin="12,9,0,9"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Stretch"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.trainTab TextBlock">
            <Setter Property="FontSize" Value="12.2" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="Button.trainTab TextBlock.numeral">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Button.trainTab:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        </Style>
        <Style Selector="Button.trainTab.on TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
        </Style>
        <Style Selector="Button.trainTab.on TextBlock.numeral">
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Button.trainTab.on /template/ Border#Mark">
            <Setter Property="Background" Value="{DynamicResource ManualTick}" />
        </Style>
        <!-- A step already passed keeps its number in gold, faded: the rail says where you are
             and where you have been without a second colour for it. -->
        <Style Selector="Button.trainTab.done TextBlock.numeral">
            <Setter Property="Foreground" Value="{DynamicResource ManualAccent}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>

        <!-- The two quiet controls under the training, and the filled one that starts it. -->
        <Style Selector="Button.trainBtn">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ManualRuleStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="Surface"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.16" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.trainBtn TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        </Style>
        <Style Selector="Button.trainBtn Path">
            <Setter Property="Stroke" Value="{DynamicResource TextDefault}" />
        </Style>
        <Style Selector="Button.trainBtn:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ManualGold40}" />
            <Setter Property="Background" Value="{DynamicResource ManualGold06}" />
        </Style>
        <Style Selector="Button.trainBtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
        </Style>
        <Style Selector="Button.trainBtn:disabled">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Button.trainBtn.next">
            <Setter Property="Background" Value="{DynamicResource ManualNextFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ManualNextBorder}" />
        </Style>
        <!-- The light along the top edge of the gold, inside the button's own surface. -->
        <Style Selector="Button.trainBtn.next /template/ Border#Surface">
            <Setter Property="BoxShadow" Value="{DynamicResource ManualNextShadow}" />
        </Style>
        <Style Selector="Button.trainBtn.next TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ManualNextInk}" />
        </Style>
        <Style Selector="Button.trainBtn.next Path">
            <Setter Property="Stroke" Value="{DynamicResource ManualNextInk}" />
        </Style>
        <Style Selector="Button.trainBtn.next:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource ManualNextBorder}" />
        </Style>
        <Style Selector="Button.trainBtn.next:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource ManualNextInk}" />
        </Style>

        <!--
            A question is a summary row and an answer under it. The prototype uses <details>,
            which this engine does not have; an Expander is the same thing once its chrome is
            taken off. What is left is the row: number, question, chevron.
        -->
        <Style Selector="Expander.faq">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <ToggleButton Classes="faqRow" Cursor="Hand"
                                          Background="Transparent" BorderThickness="0" Padding="0"
                                          HorizontalAlignment="Stretch"
                                          HorizontalContentAlignment="Stretch"
                                          Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate>
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="Stretch"
                                                              HorizontalContentAlignment="Stretch" />
                                        </Border>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border IsVisible="{TemplateBinding IsExpanded}">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  HorizontalAlignment="Stretch" />
                            </Border>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="ToggleButton.faqRow TextBlock.question">
            <Setter Property="FontSize" Value="13.2" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
        </Style>
        <Style Selector="ToggleButton.faqRow TextBlock.qNo">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="LetterSpacing" Value="0.6" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="ToggleButton.faqRow:checked TextBlock.question">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
        </Style>
        <Style Selector="ToggleButton.faqRow:checked TextBlock.qNo">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Path.faqChevron">
            <Setter Property="Stroke" Value="{DynamicResource TextFaint}" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.faqRow:checked Path.faqChevron">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        </Style>

        <!--
            The drawing inside a training frame: four zones of a window, the same in every
            step, and a numbered pin where the step is talking. The zones are at the
            prototype's own percents of a 694 x 390 frame, worked out once here rather than
            five times in the markup.
        -->
        <Style Selector="Border.wire">
            <Setter Property="BorderBrush" Value="{DynamicResource ManualMockLineSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ManualMockBottom}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="Border.wire.gold">
            <Setter Property="BorderBrush" Value="{DynamicResource ManualGold28}" />
            <Setter Property="Background" Value="{DynamicResource ManualGold06}" />
        </Style>
        <Style Selector="Border.wireA">
            <Setter Property="Canvas.Left" Value="48.6" />
            <Setter Property="Canvas.Top" Value="35.1" />
            <Setter Property="Width" Value="596.8" />
            <Setter Property="Height" Value="31.2" />
        </Style>
        <Style Selector="Border.wireB">
            <Setter Property="Canvas.Left" Value="48.6" />
            <Setter Property="Canvas.Top" Value="81.9" />
            <Setter Property="Width" Value="111" />
            <Setter Property="Height" Value="261.3" />
        </Style>
        <Style Selector="Border.wireC">
            <Setter Property="Canvas.Left" Value="180.4" />
            <Setter Property="Canvas.Top" Value="81.9" />
            <Setter Property="Width" Value="465" />
            <Setter Property="Height" Value="218.4" />
        </Style>
        <Style Selector="Border.wireD">
            <Setter Property="Canvas.Left" Value="180.4" />
            <Setter Property="Canvas.Top" Value="308.1" />
            <Setter Property="Width" Value="215.1" />
            <Setter Property="Height" Value="35.1" />
        </Style>
        <Style Selector="Border.pin">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource ManualPinFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ManualPinBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="{DynamicResource ManualPinShadow}" />
        </Style>
        <Style Selector="Border.pin TextBlock">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="ExtraBold" />
            <Setter Property="Foreground" Value="{DynamicResource ManualPinInk}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </UserControl.Styles>

    <ScrollViewer Name="PageScroll" VerticalScrollBarVisibility="Hidden"
                  HorizontalScrollBarVisibility="Disabled"
                  controls:SmoothScroll.IsEnabled="True"
                  ScrollChanged="OnPageScrollChanged">
        <!-- The bar is hidden and the wheel is not: the guide is meant to be read straight
             through, and a trough down its edge is a mark on the design rather than a way
             through it. -->
        <StackPanel Name="PageContent" MaxWidth="1080" Margin="32,26,32,32"
                    HorizontalAlignment="Stretch">

            <!-- ================================ cover ================================ -->
            <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Left">
                    <Border Width="16" Height="1" VerticalAlignment="Center" Opacity="0.6"
                            Background="{DynamicResource ManualAccent}" />
                    <TextBlock Text="РУКОВОДСТВО · ВЕРСИЯ 2.2" FontSize="10" FontWeight="ExtraBold"
                               LetterSpacing="2" VerticalAlignment="Center"
                               Foreground="{DynamicResource ManualAccent}" />
                </StackPanel>

                <!-- One line of type over two rows: the second one in the product's gold, which
                     is the one place on the cover that signs itself. -->
                <TextBlock FontSize="58" FontWeight="ExtraBold" LetterSpacing="-2.6"
                           LineHeight="59" Margin="0,18,0,0" MaxWidth="760"
                           HorizontalAlignment="Left" TextWrapping="NoWrap">
                    <Run Text="Сначала разберёмся," />
                    <LineBreak />
                    <Run Text="потом соберём" Foreground="{DynamicResource Accent}" />
                </TextBlock>

                <TextBlock FontSize="15" LineHeight="26" Margin="0,22,0,0" MaxWidth="620"
                           HorizontalAlignment="Left" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"
                           Text="Программа не просит запоминать кнопки. Она держит структуру книги целиком: раскладывает кадры по разворотам, выбирает обложку, проверяет пропорции и готовит файлы, которые принимает сайт фабрики. Здесь — как всё это устроено и в каком порядке идти." />

                <!-- The route: five stops on one line, the way the order runs. -->
                <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,42,0,0">
                    <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Top"
                            Background="{DynamicResource ManualRule}" />

                    <Grid Grid.Column="0" Margin="0,20,14,0">
                        <StackPanel Spacing="7">
                            <TextBlock Text="01" FontSize="9.5" FontWeight="ExtraBold"
                                       LetterSpacing="1.3" Opacity="0.8"
                                       Foreground="{DynamicResource ManualAccent}" />
                            <TextBlock Text="Проект" FontSize="13" FontWeight="Bold"
                                       LineHeight="17" Foreground="{DynamicResource TextDefault}" />
                            <TextBlock Text="режим и количество книг" FontSize="11" LineHeight="16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" />
                        </StackPanel>
                        <Border Width="7" Height="7" CornerRadius="999"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,-23,0,0"
                                Background="{DynamicResource ManualRouteDot}"
                                BoxShadow="{DynamicResource ManualRouteDotShadow}" />
                    </Grid>

                    <Grid Grid.Column="1" Margin="0,20,14,0">
                        <StackPanel Spacing="7">
                            <TextBlock Text="02" FontSize="9.5" FontWeight="ExtraBold"
                                       LetterSpacing="1.3" Opacity="0.8"
                                       Foreground="{DynamicResource ManualAccent}" />
                            <TextBlock Text="Папки" FontSize="13" FontWeight="Bold"
                                       LineHeight="17" Foreground="{DynamicResource TextDefault}" />
                            <TextBlock Text="фотографии попадают в книги" FontSize="11" LineHeight="16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" />
                        </StackPanel>
                        <Border Width="7" Height="7" CornerRadius="999"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,-23,0,0"
                                Background="{DynamicResource ManualRouteDot}"
                                BoxShadow="{DynamicResource ManualRouteDotShadow}" />
                    </Grid>

                    <Grid Grid.Column="2" Margin="0,20,14,0">
                        <StackPanel Spacing="7">
                            <TextBlock Text="03" FontSize="9.5" FontWeight="ExtraBold"
                                       LetterSpacing="1.3" Opacity="0.8"
                                       Foreground="{DynamicResource ManualAccent}" />
                            <TextBlock Text="Проверка" FontSize="13" FontWeight="Bold"
                                       LineHeight="17" Foreground="{DynamicResource TextDefault}" />
                            <TextBlock Text="обложка и порядок разворотов" FontSize="11" LineHeight="16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" />
                        </StackPanel>
                        <Border Width="7" Height="7" CornerRadius="999"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,-23,0,0"
                                Background="{DynamicResource ManualRouteDot}"
                                BoxShadow="{DynamicResource ManualRouteDotShadow}" />
                    </Grid>

                    <Grid Grid.Column="3" Margin="0,20,14,0">
                        <StackPanel Spacing="7">
                            <TextBlock Text="04" FontSize="9.5" FontWeight="ExtraBold"
                                       LetterSpacing="1.3" Opacity="0.8"
                                       Foreground="{DynamicResource ManualAccent}" />
                            <TextBlock Text="Экспорт" FontSize="13" FontWeight="Bold"
                                       LineHeight="17" Foreground="{DynamicResource TextDefault}" />
                            <TextBlock Text="файлы с именами для сайта" FontSize="11" LineHeight="16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" />
                        </StackPanel>
                        <Border Width="7" Height="7" CornerRadius="999"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,-23,0,0"
                                Background="{DynamicResource ManualRouteDot}"
                                BoxShadow="{DynamicResource ManualRouteDotShadow}" />
                    </Grid>

                    <Grid Grid.Column="4" Margin="0,20,14,0">
                        <StackPanel Spacing="7">
                            <TextBlock Text="05" FontSize="9.5" FontWeight="ExtraBold"
                                       LetterSpacing="1.3" Opacity="0.8"
                                       Foreground="{DynamicResource ManualAccent}" />
                            <TextBlock Text="Сайт" FontSize="13" FontWeight="Bold"
                                       LineHeight="17" Foreground="{DynamicResource TextDefault}" />
                            <TextBlock Text="группы, параметры, отправка" FontSize="11" LineHeight="16"
                                       TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" />
                        </StackPanel>
                        <Border Width="7" Height="7" CornerRadius="999"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="0,-23,0,0"
                                Background="{DynamicResource ManualRouteDot}"
                                BoxShadow="{DynamicResource ManualRouteDotShadow}" />
                    </Grid>
                </Grid>
            </StackPanel>

            <!-- ============================== spine + chapters ======================= -->
            <Grid Name="ManualShell" ColumnDefinitions="134,52,*" Margin="0,64,0,0">

                <StackPanel Name="Spine" Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="РАЗДЕЛЫ" FontSize="9" FontWeight="ExtraBold" LetterSpacing="2"
                               Margin="0,0,0,14" Foreground="{DynamicResource TextFaint}" />

                    <Button Name="Spine1" Classes="spine" Tag="1" Click="OnSpineClick"
                            AutomationProperties.Name="Раздел 01 Обзор">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="numeral" Text="01" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Обзор" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Name="Spine2" Classes="spine" Tag="2" Click="OnSpineClick"
                            AutomationProperties.Name="Раздел 02 Режимы">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="numeral" Text="02" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Режимы" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Name="Spine3" Classes="spine" Tag="3" Click="OnSpineClick"
                            AutomationProperties.Name="Раздел 03 Проекты">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="numeral" Text="03" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Проекты" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Name="Spine4" Classes="spine" Tag="4" Click="OnSpineClick"
                            AutomationProperties.Name="Раздел 04 Обучение">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="numeral" Text="04" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Обучение" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Name="Spine5" Classes="spine" Tag="5" Click="OnSpineClick"
                            AutomationProperties.Name="Раздел 05 Фишки">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="numeral" Text="05" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Фишки" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Name="Spine6" Classes="spine" Tag="6" Click="OnSpineClick"
                            AutomationProperties.Name="Раздел 06 Вопросы">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="numeral" Text="06" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Вопросы" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button Name="Spine7" Classes="spine" Tag="7" Click="OnSpineClick"
                            AutomationProperties.Name="Раздел 07 Клавиши">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Classes="numeral" Text="07" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="Клавиши" Margin="9,0,0,0"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                            Margin="0,18,0,0" Padding="0,15,0,0">
                        <Button Classes="spineSupport" Click="OnSupportClick"
                                AutomationProperties.Name="Поддержка">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center"
                                      Data="M20 12.4c0 3.6-3.6 6.5-8 6.5-1 0-2-.15-2.9-.45L4.6 20l1.2-3.3C4.6 15.4 4 14 4 12.4 4 8.8 7.6 5.9 12 5.9s8 2.9 8 6.5z M8.6 12.3h.01M12 12.3h.01M15.4 12.3h.01" />
                                <TextBlock Text="Поддержка" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </StackPanel>

                <StackPanel Name="Chapters" Grid.Column="2">

                    <!-- ============================== 01 обзор ========================== -->
                    <Border Name="Chapter1">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel MaxWidth="560" HorizontalAlignment="Left"
                                            Margin="0,0,120,0">
                                    <TextBlock Text="Глава 01" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="2.2" Margin="0,0,0,11"
                                               Foreground="{DynamicResource ManualAccent}" />
                                    <TextBlock Text="Что делает программа" FontSize="32"
                                               FontWeight="ExtraBold" LetterSpacing="-1.2"
                                               LineHeight="35" Foreground="{DynamicResource TextStrong}" />
                                    <TextBlock Text="Одно окно вместо ручной нумерации файлов"
                                               FontSize="12.5" Margin="0,9,0,0"
                                               Foreground="{DynamicResource TextFaint}" />
                                </StackPanel>
                                <Path Name="Ghost1" Grid.Column="1" Stretch="None"
                                      Stroke="{DynamicResource ManualGhostNumeral}"
                                      StrokeThickness="1" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,-26,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <TextBlock FontSize="14.5" LineHeight="26" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="660" Margin="0,20,0,0"
                                       Foreground="{DynamicResource TextDefault}">
                                <Run Text="Вы показываете, где лежат фотографии. Дальше программа сама собирает из них книги: определяет обложку, раскладывает кадры по разворотам, следит за толщиной книги и присваивает файлам имена вида " />
                                <Run Text="001-00.jpg" FontWeight="Bold"
                                     Foreground="{DynamicResource TextStrong}" />
                                <Run Text=" — номер книги и номер страницы." />
                            </TextBlock>

                            <TextBlock FontSize="14.5" LineHeight="26" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="660" Margin="0,13,0,0"
                                       Foreground="{DynamicResource TextDefault}"
                                       Text="Ручной работы остаётся ровно столько, сколько нужно вкусу: проверить сюжет, поменять кадры местами, выбрать другой разворот. Всё техническое — пропорции, порядок, проверку формата и отправку — программа берёт на себя. Именно поэтому на заказе из десятков книг она надёжнее ручной раскладки: ошибку видно до печати, а не после." />

                            <TextBlock Text="ИЗ ЧЕГО СОСТОИТ ОКНО" FontSize="10" FontWeight="ExtraBold"
                                       LetterSpacing="1.8" Margin="0,30,0,14"
                                       Foreground="{DynamicResource TextFaint}" />

                            <Grid ColumnDefinitions="*,30,250">
                                <!-- The window, drawn: four zones, numbered. A fixed drawing
                                     inside a Viewbox, so the proportions hold at any width. -->
                                <Viewbox Grid.Column="0" Stretch="Uniform" HorizontalAlignment="Stretch">
                                    <Grid Width="614" Height="384">
                                        <Border CornerRadius="13" ClipToBounds="True"
                                                BorderBrush="{DynamicResource ManualRuleStrong}"
                                                BorderThickness="1"
                                                BoxShadow="{DynamicResource ManualWindowShadow}">
                                            <Panel>
                                                <Border Background="{DynamicResource SunkenFaint}" />
                                                <Border>
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
                                                            <GradientStop Color="{DynamicResource ManualMockTop}" Offset="0" />
                                                            <GradientStop Color="{DynamicResource ManualMockBottom}" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>

                                                <Grid RowDefinitions="42,*,42">
                                                    <!-- title strip -->
                                                    <Border BorderBrush="{DynamicResource ManualRule}"
                                                            BorderThickness="0,0,0,1" Padding="12,0">
                                                        <StackPanel Orientation="Horizontal" Spacing="6"
                                                                    VerticalAlignment="Center">
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{DynamicResource ManualMockDot}" />
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{DynamicResource ManualMockDot}" />
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{DynamicResource ManualMockDot}" />
                                                            <TextBlock Text="ФАБРИКА ФОТОКНИГИ · КОМБИНИРОВАННЫЙ"
                                                                       FontSize="8" FontWeight="Bold"
                                                                       LetterSpacing="0.8"
                                                                       Margin="8,0,0,0"
                                                                       Foreground="{DynamicResource TextFaint}" />
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- body: rail and workspace -->
                                                    <Grid Grid.Row="1" ColumnDefinitions="104,*">
                                                        <Border BorderBrush="{DynamicResource ManualRule}"
                                                                BorderThickness="0,0,1,0"
                                                                Padding="10,14">
                                                            <StackPanel Spacing="9">
                                                                <Border Height="5" CornerRadius="3"
                                                                        Background="{DynamicResource ManualGold55}" />
                                                                <Border Height="5" CornerRadius="3" Width="77"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource ManualMockLineSoft}" />
                                                                <Border Height="5" CornerRadius="3"
                                                                        Background="{DynamicResource ManualMockLineSoft}" />
                                                                <Border Height="5" CornerRadius="3" Width="65"
                                                                        HorizontalAlignment="Left"
                                                                        Background="{DynamicResource ManualMockLineSoft}" />
                                                                <Border Height="5" CornerRadius="3"
                                                                        Background="{DynamicResource ManualMockLineSoft}" />
                                                            </StackPanel>
                                                        </Border>

                                                        <Grid Grid.Column="1" Margin="16,14"
                                                              RowDefinitions="Auto,*,Auto">
                                                            <Border Height="6" CornerRadius="3" Width="312"
                                                                    HorizontalAlignment="Left"
                                                                    Background="{DynamicResource ManualMockLine}" />
                                                            <Grid Grid.Row="1" ColumnDefinitions="*,11,*"
                                                                  Margin="0,11">
                                                                <Border Grid.Column="0" CornerRadius="7"
                                                                        BorderBrush="{DynamicResource ManualMockLine}"
                                                                        BorderThickness="1"
                                                                        Background="{DynamicResource ManualMockCard}" />
                                                                <Border Grid.Column="2" CornerRadius="7"
                                                                        BorderBrush="{DynamicResource ManualGold40}"
                                                                        BorderThickness="1"
                                                                        Background="{DynamicResource ManualGold06}" />
                                                            </Grid>
                                                            <Border Grid.Row="2" Height="6" CornerRadius="3"
                                                                    Width="208" HorizontalAlignment="Left"
                                                                    Background="{DynamicResource ManualMockLine}" />
                                                        </Grid>
                                                    </Grid>

                                                    <!-- the foot: counts at the left, the action at the right -->
                                                    <Border Grid.Row="2" Padding="14,0"
                                                            BorderBrush="{DynamicResource ManualRule}"
                                                            BorderThickness="0,1,0,0">
                                                        <Grid ColumnDefinitions="*,Auto">
                                                            <Border Width="190" Height="5" CornerRadius="3"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center"
                                                                    Background="{DynamicResource ManualMockLine}" />
                                                            <Border Grid.Column="1" Width="64" Height="11"
                                                                    CornerRadius="6" VerticalAlignment="Center"
                                                                    Background="{DynamicResource ManualGold50}" />
                                                        </Grid>
                                                    </Border>
                                                </Grid>

                                                <!-- the four pins, at the prototype's own percents of
                                                     this 614x384 drawing -->
                                                <Canvas IsHitTestVisible="False">
                                                    <Border Canvas.Left="522" Canvas.Top="10" Width="21" Height="21"
                                                            CornerRadius="999"
                                                            Background="{DynamicResource ManualPinFill}"
                                                            BorderBrush="{DynamicResource ManualPinBorder}"
                                                            BorderThickness="1"
                                                            BoxShadow="{DynamicResource ManualPinShadow}">
                                                        <TextBlock Text="1" FontSize="10" FontWeight="ExtraBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ManualPinInk}" />
                                                    </Border>
                                                    <Border Canvas.Left="25" Canvas.Top="169" Width="21" Height="21"
                                                            CornerRadius="999"
                                                            Background="{DynamicResource ManualPinFill}"
                                                            BorderBrush="{DynamicResource ManualPinBorder}"
                                                            BorderThickness="1"
                                                            BoxShadow="{DynamicResource ManualPinShadow}">
                                                        <TextBlock Text="2" FontSize="10" FontWeight="ExtraBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ManualPinInk}" />
                                                    </Border>
                                                    <Border Canvas.Left="344" Canvas.Top="200" Width="21" Height="21"
                                                            CornerRadius="999"
                                                            Background="{DynamicResource ManualPinFill}"
                                                            BorderBrush="{DynamicResource ManualPinBorder}"
                                                            BorderThickness="1"
                                                            BoxShadow="{DynamicResource ManualPinShadow}">
                                                        <TextBlock Text="3" FontSize="10" FontWeight="ExtraBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ManualPinInk}" />
                                                    </Border>
                                                    <Border Canvas.Left="55" Canvas.Top="352" Width="21" Height="21"
                                                            CornerRadius="999"
                                                            Background="{DynamicResource ManualPinFill}"
                                                            BorderBrush="{DynamicResource ManualPinBorder}"
                                                            BorderThickness="1"
                                                            BoxShadow="{DynamicResource ManualPinShadow}">
                                                        <TextBlock Text="4" FontSize="10" FontWeight="ExtraBold"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource ManualPinInk}" />
                                                    </Border>
                                                </Canvas>
                                            </Panel>
                                        </Border>
                                    </Grid>
                                </Viewbox>

                                <StackPanel Grid.Column="2">
                                    <Grid ColumnDefinitions="18,*">
                                        <TextBlock Text="1" FontSize="10" FontWeight="ExtraBold"
                                                   Margin="0,2,0,0"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="18"
                                                   FontSize="11.5"
                                                   Foreground="{DynamicResource TextMuted}">
                                            <Run Text="Верхняя панель." FontWeight="Bold"
                                                 Foreground="{DynamicResource TextDefault}" />
                                            <Run Text=" Разделы, тема, справка, поддержка и аккаунт." />
                                        </TextBlock>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource ManualRule}"
                                            BorderThickness="0,1,0,0" Padding="0,11,0,0"
                                            Margin="0,11,0,0">
                                        <Grid ColumnDefinitions="18,*">
                                            <TextBlock Text="2" FontSize="10" FontWeight="ExtraBold"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="18"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextMuted}">
                                                <Run Text="Список слева." FontWeight="Bold"
                                                     Foreground="{DynamicResource TextDefault}" />
                                                <Run Text=" Книги или папки текущего проекта — по одной строке." />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource ManualRule}"
                                            BorderThickness="0,1,0,0" Padding="0,11,0,0"
                                            Margin="0,11,0,0">
                                        <Grid ColumnDefinitions="18,*">
                                            <TextBlock Text="3" FontSize="10" FontWeight="ExtraBold"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="18"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextMuted}">
                                                <Run Text="Рабочая область." FontWeight="Bold"
                                                     Foreground="{DynamicResource TextDefault}" />
                                                <Run Text=" Слоты обложки и разворотов: сюда ставятся кадры." />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource ManualRule}"
                                            BorderThickness="0,1,0,0" Padding="0,11,0,0"
                                            Margin="0,11,0,0">
                                        <Grid ColumnDefinitions="18,*">
                                            <TextBlock Text="4" FontSize="10" FontWeight="ExtraBold"
                                                       Margin="0,2,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap" LineHeight="18"
                                                       FontSize="11.5"
                                                       Foreground="{DynamicResource TextMuted}">
                                                <Run Text="Итог внизу." FontWeight="Bold"
                                                     Foreground="{DynamicResource TextDefault}" />
                                                <Run Text=" Сколько файлов, какая цена и кнопка отправки на сайт." />
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- A screenshot frame, empty in the prototype too: it marks where
                                 the picture of the screen goes. 894 x 383 is 21:9 at this page's
                                 width, so the frame keeps its shape at any window size. -->
                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                <Grid Width="894" Height="383">
                                    <Border CornerRadius="12" ClipToBounds="True"
                                            BorderBrush="{DynamicResource ManualFrameBorder}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ManualFrameWash}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                            Background="{DynamicResource ManualMockTop}"
                                            BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource ManualGold70}"
                                                  Data="M3.5 4.5h17v15h-17z M3.5 17l4.8-4.4a1.5 1.5 0 0 1 2 0l3 2.7 2.2-2a1.5 1.5 0 0 1 2 0l1.6 1.4 M9 10a1.6 1.6 0 1 1-3.2 0a1.6 1.6 0 1 1 3.2 0z" />
                                            <TextBlock Text="СНИМОК: ЭКРАН «МОИ ПРОЕКТЫ»" FontSize="8.5"
                                                       FontWeight="ExtraBold" LetterSpacing="1.36"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFaint}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Viewbox>
                            <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="700" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextFaint}">
                                <Run Text="С этого экрана начинается заказ." FontWeight="Bold"
                                     Foreground="{DynamicResource TextDefault}" />
                                <Run Text=" Список проектов, фильтры по режиму и статусу, кнопка создания нового проекта." />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- ============================== 02 режимы ========================= -->
                    <Border Name="Chapter2" BorderBrush="{DynamicResource ManualRule}"
                            BorderThickness="0,1,0,0" Margin="0,64,0,0" Padding="0,44,0,0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,120,0">
                                    <TextBlock Text="Глава 02" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="2.2" Margin="0,0,0,11"
                                               Foreground="{DynamicResource ManualAccent}" />
                                    <TextBlock Text="Два режима — две логики" FontSize="32"
                                               FontWeight="ExtraBold" LetterSpacing="-1.2"
                                               LineHeight="35" Foreground="{DynamicResource TextStrong}" />
                                    <TextBlock Text="Режим выбирается один раз при создании проекта"
                                               FontSize="12.5" Margin="0,9,0,0"
                                               Foreground="{DynamicResource TextFaint}" />
                                </StackPanel>
                                <Path Name="Ghost2" Grid.Column="1" Stretch="None"
                                      Stroke="{DynamicResource ManualGhostNumeral}"
                                      StrokeThickness="1" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,-26,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <TextBlock FontSize="14.5" LineHeight="26" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="660" Margin="0,20,0,0"
                                       Foreground="{DynamicResource TextDefault}"
                                       Text="Оба режима делают одно и то же — собирают фотокниги. Разница в том, кто решает, какой кадр попадёт в какую книгу. Если папки уже разложены по книгам — работает программа. Если состав каждой книги уникален — раскладываете вы, а программа держит структуру и проверяет формат." />

                            <Grid ColumnDefinitions="*,1,*" Margin="0,26,0,0">

                                <!-- ===================== режим A ===================== -->
                                <StackPanel Grid.Column="0" Margin="0,0,32,0">
                                    <Border Width="54" Height="54" CornerRadius="16"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ManualSealFill}"
                                            BorderBrush="{DynamicResource ManualSealBorder}"
                                            BorderThickness="1"
                                            BoxShadow="{DynamicResource ManualSealShadow}">
                                        <Panel>
                                            <Border Margin="5" CornerRadius="11" BorderThickness="1"
                                                    IsHitTestVisible="False"
                                                    BorderBrush="{DynamicResource ManualSealRing}" />
                                            <Path Width="25" Height="25" Stretch="Uniform"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource ManualSealInk}"
                                                  Data="M3.4 17V7.6A2.4 2.4 0 0 1 5.8 5.2h3.4l1.8 2.2h6.6a2.4 2.4 0 0 1 2.4 2.4V17a2.4 2.4 0 0 1-2.4 2.4H5.8A2.4 2.4 0 0 1 3.4 17z M9.5 11.4a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 1 1 2.2 0z M4.7 17.5l3-2.6a1.3 1.3 0 0 1 1.7 0l2.9 2.5" />
                                        </Panel>
                                    </Border>

                                    <TextBlock Text="РЕЖИМ A · ПОТОК" FontSize="9.5" FontWeight="ExtraBold"
                                               LetterSpacing="1.7" Margin="0,20,0,0"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <TextBlock Text="Уникальные папки" FontSize="24"
                                               FontWeight="ExtraBold" LetterSpacing="-0.77"
                                               LineHeight="26" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextStrong}" />
                                    <TextBlock Text="Одна папка — одна книга." FontSize="13"
                                               FontWeight="SemiBold" LineHeight="19" Margin="0,8,0,0"
                                               Foreground="{DynamicResource ManualAccent}" />
                                    <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                               Margin="0,12,0,0"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="Для серий: на каждую книгу есть готовая папка, внутри уже разложен порядок снимков. Программа читает папки подряд и собирает книги без вашего участия." />

                                    <TextBlock Text="КАК ИДЁТ РАБОТА" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="1.8" Margin="0,24,0,10"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="01" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Перетаскиваете папки в левую панель — каждая становится отдельной книгой." />
                                        </Grid>
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="02" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Самое большое фото папки встаёт на обложку, остальные идут по разворотам в порядке файлов." />
                                        </Grid>
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="03" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Программа проверяет пропорции и присваивает имена 001-00.jpg." />
                                        </Grid>
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="04" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Книги собираются в группы по формату — параметры задаются сразу на группу." />
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="СИЛЬНЫЕ СТОРОНЫ" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="1.8" Margin="0,24,0,10"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="19,*">
                                            <Border Width="9" Height="1" Opacity="0.8"
                                                    VerticalAlignment="Top" Margin="0,6,0,0"
                                                    Background="{DynamicResource ManualTick}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextDefault}"
                                                       Text="Самая быстрая сборка, когда книг много и они однотипные." />
                                        </Grid>
                                        <Grid ColumnDefinitions="19,*">
                                            <Border Width="9" Height="1" Opacity="0.8"
                                                    VerticalAlignment="Top" Margin="0,6,0,0"
                                                    Background="{DynamicResource ManualTick}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextDefault}"
                                                       Text="Порядок кадров повторяет порядок в папке — результат предсказуем." />
                                        </Grid>
                                        <Grid ColumnDefinitions="19,*">
                                            <Border Width="9" Height="1" Opacity="0.8"
                                                    VerticalAlignment="Top" Margin="0,6,0,0"
                                                    Background="{DynamicResource ManualTick}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextDefault}"
                                                       Text="Структура прозрачная: одна папка — одна книга, нужную видно сразу." />
                                        </Grid>
                                    </StackPanel>

                                    <Border BorderThickness="2,0,0,0" Margin="0,22,0,0" Padding="13,0,0,0"
                                            MaxWidth="370" HorizontalAlignment="Left"
                                            BorderBrush="{DynamicResource ManualTipRule}">
                                        <TextBlock FontSize="12.2" LineHeight="20" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}">
                                            <Run Text="Тонкость." FontWeight="ExtraBold"
                                                 Foreground="{DynamicResource TextDefault}" />
                                            <Run Text=" В одном проекте — только папки с одинаковым числом файлов. Иначе книги получатся разной толщины, и фабрика не соберёт тираж по одному макету." />
                                        </TextBlock>
                                    </Border>

                                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                        <Grid Width="415" Height="233">
                                            <Border CornerRadius="12" ClipToBounds="True"
                                                    BorderBrush="{DynamicResource ManualFrameBorder}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource ManualFrameWash}" />
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                                    Background="{DynamicResource ManualMockTop}"
                                                    BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource ManualGold70}"
                                                          Data="M3.5 8A2.5 2.5 0 0 1 6 5.5h3.6l1.8 2.2H18a2.5 2.5 0 0 1 2.5 2.5v7A2.5 2.5 0 0 1 18 19.7H6A2.5 2.5 0 0 1 3.5 17.2z" />
                                                    <TextBlock Text="СНИМОК: ЗАГРУЗКА ПАПОК" FontSize="8.5"
                                                               FontWeight="ExtraBold" LetterSpacing="1.36"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFaint}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextFaint}"
                                               Text="Перетащите папки в левую панель: количество файлов и разворотов программа посчитает сама." />
                                </StackPanel>

                                <!-- the gate between the two modes -->
                                <Grid Grid.Column="1">
                                    <Border Width="1" HorizontalAlignment="Center"
                                            Background="{DynamicResource ManualRule}" />
                                    <Border Width="32" Height="32" CornerRadius="999"
                                            HorizontalAlignment="Center" VerticalAlignment="Top"
                                            Margin="0,-16,0,0"
                                            Background="{DynamicResource ManualPageMat}"
                                            BorderBrush="{DynamicResource ManualRule}"
                                            BorderThickness="1">
                                        <TextBlock Text="ИЛИ" FontSize="10" FontWeight="ExtraBold"
                                                   LetterSpacing="0.4"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFaint}" />
                                    </Border>
                                </Grid>

                                <!-- ===================== режим B ===================== -->
                                <StackPanel Grid.Column="2" Margin="32,0,0,0">
                                    <Border Width="54" Height="54" CornerRadius="16"
                                            HorizontalAlignment="Left"
                                            Background="{DynamicResource ManualSealFill}"
                                            BorderBrush="{DynamicResource ManualSealBorder}"
                                            BorderThickness="1"
                                            BoxShadow="{DynamicResource ManualSealShadow}">
                                        <Panel>
                                            <Border Margin="5" CornerRadius="11" BorderThickness="1"
                                                    IsHitTestVisible="False"
                                                    BorderBrush="{DynamicResource ManualSealRing}" />
                                            <Path Width="25" Height="25" Stretch="Uniform"
                                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource ManualSealInk}"
                                                  Data="M12 7.2C10.4 5.8 8.1 5.2 4.2 5.5v12.4c3.9-.3 6.2.4 7.8 1.7 1.6-1.3 3.9-2 7.8-1.7V5.5C15.9 5.2 13.6 5.8 12 7.2z M12 7.2v12.4" />
                                        </Panel>
                                    </Border>

                                    <TextBlock Text="РЕЖИМ B · КОНТРОЛЬ" FontSize="9.5" FontWeight="ExtraBold"
                                               LetterSpacing="1.7" Margin="0,20,0,0"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <TextBlock Text="Комбинированный" FontSize="24"
                                               FontWeight="ExtraBold" LetterSpacing="-0.77"
                                               LineHeight="26" Margin="0,8,0,0"
                                               Foreground="{DynamicResource TextStrong}" />
                                    <TextBlock Text="Вы решаете, что в какой книге." FontSize="13"
                                               FontWeight="SemiBold" LineHeight="19" Margin="0,8,0,0"
                                               Foreground="{DynamicResource ManualAccent}" />
                                    <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                               Margin="0,12,0,0"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="Для заказов, где книги отличаются: разный состав, разные истории, общие служебные страницы. Кадры раскладываете сами — программа следит за структурой и проверяет формат." />

                                    <TextBlock Text="КАК ИДЁТ РАБОТА" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="1.8" Margin="0,24,0,10"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="01" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Создаёте нужное количество книг и задаёте число разворотов." />
                                        </Grid>
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="02" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Перетаскиваете кадры в слоты — в любую книгу, на любой разворот." />
                                        </Grid>
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="03" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Общий разворот или обложку добавляете одним действием сразу во все книги." />
                                        </Grid>
                                        <Grid ColumnDefinitions="25,*">
                                            <TextBlock Text="04" FontSize="9.5" FontWeight="ExtraBold"
                                                       Opacity="0.9" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Проверяете порядок и отправляете книги на сайт." />
                                        </Grid>
                                    </StackPanel>

                                    <TextBlock Text="СИЛЬНЫЕ СТОРОНЫ" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="1.8" Margin="0,24,0,10"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Spacing="9">
                                        <Grid ColumnDefinitions="19,*">
                                            <Border Width="9" Height="1" Opacity="0.8"
                                                    VerticalAlignment="Top" Margin="0,6,0,0"
                                                    Background="{DynamicResource ManualTick}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextDefault}"
                                                       Text="Полный контроль над составом каждой книги." />
                                        </Grid>
                                        <Grid ColumnDefinitions="19,*">
                                            <Border Width="9" Height="1" Opacity="0.8"
                                                    VerticalAlignment="Top" Margin="0,6,0,0"
                                                    Background="{DynamicResource ManualTick}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextDefault}"
                                                       Text="Общие развороты не нужно повторять в каждой книге отдельно." />
                                        </Grid>
                                        <Grid ColumnDefinitions="19,*">
                                            <Border Width="9" Height="1" Opacity="0.8"
                                                    VerticalAlignment="Top" Margin="0,6,0,0"
                                                    Background="{DynamicResource ManualTick}" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap"
                                                       FontSize="12.3" LineHeight="20"
                                                       Foreground="{DynamicResource TextDefault}"
                                                       Text="Одинаковое количество разворотов держит тираж собираемым." />
                                        </Grid>
                                    </StackPanel>

                                    <Border BorderThickness="2,0,0,0" Margin="0,22,0,0" Padding="13,0,0,0"
                                            MaxWidth="370" HorizontalAlignment="Left"
                                            BorderBrush="{DynamicResource ManualTipRule}">
                                        <TextBlock FontSize="12.2" LineHeight="20" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextMuted}">
                                            <Run Text="Тонкость." FontWeight="ExtraBold"
                                                 Foreground="{DynamicResource TextDefault}" />
                                            <Run Text=" Число разворотов у всех книг одинаковое — это требование сборки на фабрике. Задайте его до того, как начнёте раскладывать кадры: потом придётся пересобирать." />
                                        </TextBlock>
                                    </Border>

                                    <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                        <Grid Width="415" Height="233">
                                            <Border CornerRadius="12" ClipToBounds="True"
                                                    BorderBrush="{DynamicResource ManualFrameBorder}"
                                                    BorderThickness="1"
                                                    Background="{DynamicResource ManualFrameWash}" />
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                                    Background="{DynamicResource ManualMockTop}"
                                                    BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                                    BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource ManualGold70}"
                                                          Data="M12 7.2C10.4 5.8 8.1 5.2 4.2 5.5v12.4c3.9-.3 6.2.4 7.8 1.7 1.6-1.3 3.9-2 7.8-1.7V5.5C15.9 5.2 13.6 5.8 12 7.2z M12 7.2v12.4" />
                                                    <TextBlock Text="СНИМОК: РАСКЛАДКА РАЗВОРОТОВ" FontSize="8.5"
                                                               FontWeight="ExtraBold" LetterSpacing="1.36"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFaint}" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                               Margin="0,10,0,0"
                                               Foreground="{DynamicResource TextFaint}"
                                               Text="Слоты книги: обложка всегда первая. Общий разворот отмечается один раз на весь проект." />
                                </StackPanel>
                            </Grid>

                            <!-- What the two modes answer differently, side by side. -->
                            <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                    Padding="0,14" Margin="0,34,0,0">
                                <Grid ColumnDefinitions="200,*,*">
                                    <TextBlock Text="КТО РАСКЛАДЫВАЕТ КАДРЫ" FontSize="11"
                                               FontWeight="ExtraBold" LetterSpacing="0.66"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="УНИКАЛЬНЫЕ ПАПКИ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Программа, по порядку файлов в папке"
                                                   FontSize="12.3" LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="КОМБИНИРОВАННЫЙ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Вы, кадр за кадром в каждой книге"
                                                   FontSize="12.3" LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                    Padding="0,14">
                                <Grid ColumnDefinitions="200,*,*">
                                    <TextBlock Text="ОБЛОЖКА" FontSize="11" FontWeight="ExtraBold"
                                               LetterSpacing="0.66" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="УНИКАЛЬНЫЕ ПАПКИ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Самое большое фото в папке" FontSize="12.3"
                                                   LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="КОМБИНИРОВАННЫЙ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Та, которую поставите в первый слот"
                                                   FontSize="12.3" LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                    Padding="0,14">
                                <Grid ColumnDefinitions="200,*,*">
                                    <TextBlock Text="ОБЩИЕ РАЗВОРОТЫ" FontSize="11" FontWeight="ExtraBold"
                                               LetterSpacing="0.66" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="УНИКАЛЬНЫЕ ПАПКИ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Не нужны: книги не пересекаются" FontSize="12.3"
                                                   LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="КОМБИНИРОВАННЫЙ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Один разворот сразу во все книги"
                                                   FontSize="12.3" LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                    Padding="0,14">
                                <Grid ColumnDefinitions="200,*,*">
                                    <TextBlock Text="КОГДА ВЫБИРАТЬ" FontSize="11" FontWeight="ExtraBold"
                                               LetterSpacing="0.66" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                                        <TextBlock Text="УНИКАЛЬНЫЕ ПАПКИ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Много однотипных книг, папки готовы" FontSize="12.3"
                                                   LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="КОМБИНИРОВАННЫЙ" FontSize="9.5"
                                                   FontWeight="ExtraBold" LetterSpacing="1.1"
                                                   Margin="0,0,0,3"
                                                   Foreground="{DynamicResource ManualAccent}" />
                                        <TextBlock Text="Состав книг разный, кадры отбираются вручную"
                                                   FontSize="12.3" LineHeight="19" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextDefault}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Height="1" Background="{DynamicResource ManualRule}" />
                        </StackPanel>
                    </Border>

                    <!-- ============================== 03 проекты ======================== -->
                    <Border Name="Chapter3" BorderBrush="{DynamicResource ManualRule}"
                            BorderThickness="0,1,0,0" Margin="0,64,0,0" Padding="0,44,0,0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,120,0">
                                    <TextBlock Text="Глава 03" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="2.2" Margin="0,0,0,11"
                                               Foreground="{DynamicResource ManualAccent}" />
                                    <TextBlock Text="Проекты: создать и вести" FontSize="32"
                                               FontWeight="ExtraBold" LetterSpacing="-1.2"
                                               LineHeight="35" Foreground="{DynamicResource TextStrong}" />
                                    <TextBlock Text="Проект хранит режим, книги и параметры"
                                               FontSize="12.5" Margin="0,9,0,0"
                                               Foreground="{DynamicResource TextFaint}" />
                                </StackPanel>
                                <Path Name="Ghost3" Grid.Column="1" Stretch="None"
                                      Stroke="{DynamicResource ManualGhostNumeral}"
                                      StrokeThickness="1" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,-26,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <TextBlock FontSize="14.5" LineHeight="26" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="660" Margin="0,20,0,0"
                                       Foreground="{DynamicResource TextDefault}"
                                       Text="Проект — это заказ. Можно закрыть программу и вернуться к сборке через день: режим, книги, выбранные кадры и параметры групп останутся на месте. Ниже — весь цикл работы с проектом, от создания до удаления." />

                            <!-- The life of an order: a line with a stop per stage, the first one
                                 filled because it is where every order starts. -->
                            <Grid Margin="0,28,0,0">
                                <Border Width="1" HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch" Margin="9,8,0,8"
                                        Background="{DynamicResource ManualLifeLine}" />
                                <StackPanel Margin="34,0,0,0">
                                    <Grid Margin="0,0,0,26">
                                        <StackPanel>
                                            <TextBlock Text="Создать" FontSize="14" FontWeight="ExtraBold"
                                                       LetterSpacing="-0.2"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="500" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextMuted}">
                                                <Run Text="Кнопка " />
                                                <Run Text="«Создать проект»" FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextDefault}" />
                                                <Run Text=" в правом верхнем углу списка. Открывается выбор режима — это единственное решение, которое нельзя изменить потом." />
                                            </TextBlock>
                                        </StackPanel>
                                        <Border Width="9" Height="9" CornerRadius="999"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-30,5,0,0"
                                                Background="{DynamicResource Accent}"
                                                BorderBrush="{DynamicResource Accent}"
                                                BorderThickness="1"
                                                BoxShadow="{DynamicResource ManualLifeGlow}" />
                                    </Grid>

                                    <Grid Margin="0,0,0,26">
                                        <StackPanel>
                                            <TextBlock Text="Открыть и продолжить" FontSize="14"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.2"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock Text="Клик по карточке проекта возвращает к тому состоянию сборки, на котором вы остановились. Ничего не нужно собирать заново."
                                                       FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="500" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <Border Width="9" Height="9" CornerRadius="999"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-30,5,0,0"
                                                Background="{DynamicResource ManualPageMat}"
                                                BorderBrush="{DynamicResource ManualLifeDotRing}"
                                                BorderThickness="1" />
                                    </Grid>

                                    <Grid Margin="0,0,0,26">
                                        <StackPanel>
                                            <TextBlock Text="Найти нужный" FontSize="14"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.2"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock Text="Фильтры по режиму и статусу над списком. Счётчик рядом показывает, сколько проектов всего — удобно, когда заказов десятки."
                                                       FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="500" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <Border Width="9" Height="9" CornerRadius="999"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-30,5,0,0"
                                                Background="{DynamicResource ManualPageMat}"
                                                BorderBrush="{DynamicResource ManualLifeDotRing}"
                                                BorderThickness="1" />
                                    </Grid>

                                    <Grid Margin="0,0,0,26">
                                        <StackPanel>
                                            <TextBlock Text="Понять статус" FontSize="14"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.2"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock Text="Карточка показывает этап: проект собирается, готов к отправке или уже загружен на сайт. По статусу видно, что ждёт вашего внимания."
                                                       FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="500" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <Border Width="9" Height="9" CornerRadius="999"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-30,5,0,0"
                                                Background="{DynamicResource ManualPageMat}"
                                                BorderBrush="{DynamicResource ManualLifeDotRing}"
                                                BorderThickness="1" />
                                    </Grid>

                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Удалить" FontSize="14" FontWeight="ExtraBold"
                                                       LetterSpacing="-0.2"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock Text="В меню карточки. Проект исчезает из списка, но файлы, уже выгруженные на сайт, остаются на месте — заказ не пропадёт."
                                                       FontSize="12.5" LineHeight="21" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="500" Margin="0,5,0,0"
                                                       Foreground="{DynamicResource TextMuted}" />
                                        </StackPanel>
                                        <Border Width="9" Height="9" CornerRadius="999"
                                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="-30,5,0,0"
                                                Background="{DynamicResource ManualPageMat}"
                                                BorderBrush="{DynamicResource ManualLifeDotRing}"
                                                BorderThickness="1" />
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                <Grid Width="894" Height="383">
                                    <Border CornerRadius="12" ClipToBounds="True"
                                            BorderBrush="{DynamicResource ManualFrameBorder}"
                                            BorderThickness="1"
                                            Background="{DynamicResource ManualFrameWash}" />
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                            Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                            Background="{DynamicResource ManualMockTop}"
                                            BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                            BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource ManualGold70}"
                                                  Data="M4 6.5h16M4 12h16M4 17.5h9" />
                                            <TextBlock Text="СНИМОК: КАРТОЧКА ПРОЕКТА" FontSize="8.5"
                                                       FontWeight="ExtraBold" LetterSpacing="1.36"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextFaint}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Viewbox>
                            <TextBlock FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="700" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextFaint}"
                                       Text="На карточке видно режим, количество книг и разворотов, превью обложки и кнопку открытия." />
                        </StackPanel>
                    </Border>

                    <!-- ============================== 04 обучение ====================== -->
                    <Border Name="Chapter4" BorderBrush="{DynamicResource ManualRule}"
                            BorderThickness="0,1,0,0" Margin="0,64,0,0" Padding="0,44,0,0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,120,0">
                                    <TextBlock Text="Глава 04" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="2.2" Margin="0,0,0,11"
                                               Foreground="{DynamicResource ManualAccent}" />
                                    <TextBlock Text="Пять шагов до сайта" FontSize="32"
                                               FontWeight="ExtraBold" LetterSpacing="-1.2"
                                               LineHeight="35" Foreground="{DynamicResource TextStrong}" />
                                    <TextBlock Text="Мини-обучение: пройдите один раз целиком"
                                               FontSize="12.5" Margin="0,9,0,0"
                                               Foreground="{DynamicResource TextFaint}" />
                                </StackPanel>
                                <Path Name="Ghost4" Grid.Column="1" Stretch="None"
                                      Stroke="{DynamicResource ManualGhostNumeral}"
                                      StrokeThickness="1" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,-26,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <TextBlock FontSize="14.5" LineHeight="26" TextWrapping="Wrap"
                                       HorizontalAlignment="Left" MaxWidth="660" Margin="0,20,0,0"
                                       Foreground="{DynamicResource TextDefault}"
                                       Text="Это короткая тренировка на реальном пути заказа. Пять шагов, у каждого — что нажать, что проверить и где обычно спотыкаются. На снимках цифры отмечают места, о которых идёт речь." />

                            <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                    Margin="0,28,0,0" Padding="0,26,0,0">
                                <Grid ColumnDefinitions="166,34,*">

                                    <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Top">
                                        <Button Name="TrainTab1" Classes="trainTab on" Tag="0"
                                                Click="OnTrainTabClick"
                                                AutomationProperties.Name="Шаг 01 Проект">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Classes="numeral" Text="01" />
                                                <TextBlock Grid.Column="1" Text="Проект" Margin="9,0,0,0" />
                                            </Grid>
                                        </Button>
                                        <Button Name="TrainTab2" Classes="trainTab" Tag="1"
                                                Click="OnTrainTabClick"
                                                AutomationProperties.Name="Шаг 02 Папки">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Classes="numeral" Text="02" />
                                                <TextBlock Grid.Column="1" Text="Папки" Margin="9,0,0,0" />
                                            </Grid>
                                        </Button>
                                        <Button Name="TrainTab3" Classes="trainTab" Tag="2"
                                                Click="OnTrainTabClick"
                                                AutomationProperties.Name="Шаг 03 Проверка">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Classes="numeral" Text="03" />
                                                <TextBlock Grid.Column="1" Text="Проверка" Margin="9,0,0,0" />
                                            </Grid>
                                        </Button>
                                        <Button Name="TrainTab4" Classes="trainTab" Tag="3"
                                                Click="OnTrainTabClick"
                                                AutomationProperties.Name="Шаг 04 Экспорт">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Classes="numeral" Text="04" />
                                                <TextBlock Grid.Column="1" Text="Экспорт" Margin="9,0,0,0" />
                                            </Grid>
                                        </Button>
                                        <Button Name="TrainTab5" Classes="trainTab" Tag="4"
                                                Click="OnTrainTabClick"
                                                AutomationProperties.Name="Шаг 05 Сайт">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <TextBlock Classes="numeral" Text="05" />
                                                <TextBlock Grid.Column="1" Text="Сайт" Margin="9,0,0,0" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <!-- ======================= шаг 1 ====================== -->
                                        <StackPanel Name="TrainPanel1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="ШАГ 1 ИЗ 5" FontSize="9.5" FontWeight="ExtraBold"
                                                           LetterSpacing="1.7"
                                                           Foreground="{DynamicResource ManualAccent}" />
                                                <TextBlock Grid.Column="1" Text="≈ 1 минута" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFaint}" />
                                            </Grid>
                                            <TextBlock Text="Создайте проект и выберите режим" FontSize="22"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.7"
                                                       LineHeight="26" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="540" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Нажмите «Создать проект» на экране «Мои проекты». Появится выбор из двух режимов: посмотрите, что произойдёт с фотографиями в каждом, и выберите подходящий. Это решение фиксируется — сменить режим можно только новым проектом." />
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                                <Grid Width="694" Height="390">
                                                    <Border CornerRadius="12" ClipToBounds="True"
                                                            BorderBrush="{DynamicResource ManualFrameBorder}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource ManualFrameWash}" />
                                                    <Canvas>
                                                        <Border Classes="wire wireA" />
                                                        <Border Classes="wire wireB" />
                                                        <Border Classes="wire wireC" />
                                                        <Border Classes="wire wireD gold" />
                                                        <Border Classes="pin" Canvas.Left="139" Canvas.Top="51">
                                                            <TextBlock Text="1" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="326" Canvas.Top="172">
                                                            <TextBlock Text="2" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="541" Canvas.Top="320">
                                                            <TextBlock Text="3" />
                                                        </Border>
                                                    </Canvas>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                            Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                                            Background="{DynamicResource ManualMockTop}"
                                                            BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource ManualGold70}"
                                                                  Data="M4 7h8M16.5 7H20M4 17h3.5M12 17h8M16.4 7a2.2 2.2 0 1 1-4.4 0a2.2 2.2 0 1 1 4.4 0zM11.6 17a2.2 2.2 0 1 1-4.4 0a2.2 2.2 0 1 1 4.4 0z" />
                                                            <TextBlock Text="СНИМОК: ВЫБОР РЕЖИМА" FontSize="8.5"
                                                                       FontWeight="ExtraBold" LetterSpacing="1.36"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFaint}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="Две карточки режимов: в каждой написано, что произойдёт с папками и кадрами."
                                                       FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextFaint}" />
                                            <StackPanel Spacing="7" Margin="0,16,0,0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="1" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Кнопка создания проекта — единственный вход в новый заказ."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="2" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Карточка режима: читайте не название, а описание работы."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="3" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="«Выбрать режим» — проект создаётся и открывается редактор."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ======================= шаг 2 ====================== -->
                                        <StackPanel Name="TrainPanel2" IsVisible="False">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="ШАГ 2 ИЗ 5" FontSize="9.5" FontWeight="ExtraBold"
                                                           LetterSpacing="1.7"
                                                           Foreground="{DynamicResource ManualAccent}" />
                                                <TextBlock Grid.Column="1" Text="≈ 3 минуты" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFaint}" />
                                            </Grid>
                                            <TextBlock Text="Добавьте фотографии" FontSize="22"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.7"
                                                       LineHeight="26" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="540" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Перетащите папки или отдельные файлы в левую панель. Программа сразу покажет, сколько получилось книг, сколько в них разворотов и какие файлы не проходят проверку. Если книги не появились — почти всегда дело в разном количестве файлов в папках." />
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                                <Grid Width="694" Height="390">
                                                    <Border CornerRadius="12" ClipToBounds="True"
                                                            BorderBrush="{DynamicResource ManualFrameBorder}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource ManualFrameWash}" />
                                                    <Canvas>
                                                        <Border Classes="wire wireA" />
                                                        <Border Classes="wire wireB" />
                                                        <Border Classes="wire wireC" />
                                                        <Border Classes="wire wireD gold" />
                                                        <Border Classes="pin" Canvas.Left="97" Canvas.Top="273">
                                                            <TextBlock Text="1" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="361" Canvas.Top="133">
                                                            <TextBlock Text="2" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="583" Canvas.Top="55">
                                                            <TextBlock Text="3" />
                                                        </Border>
                                                    </Canvas>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                            Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                                            Background="{DynamicResource ManualMockTop}"
                                                            BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource ManualGold70}"
                                                                  Data="M12 15.2V4.2 M7.9 8.3 12 4.2l4.1 4.1 M3.9 14.2v3a2.6 2.6 0 0 0 2.6 2.6h11a2.6 2.6 0 0 0 2.6-2.6v-3" />
                                                            <TextBlock Text="СНИМОК: ПАНЕЛЬ ЗАГРУЗКИ" FontSize="8.5"
                                                                       FontWeight="ExtraBold" LetterSpacing="1.36"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFaint}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="Зона перетаскивания, список книг и счётчики файлов и разворотов."
                                                       FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextFaint}" />
                                            <StackPanel Spacing="7" Margin="0,16,0,0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="1" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Зона загрузки: папки можно перетаскивать или выбирать вручную."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="2" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Список книг: одна папка — одна строка, с количеством разворотов."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="3" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Счётчик файлов и предупреждения о неподходящих кадрах."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ======================= шаг 3 ====================== -->
                                        <StackPanel Name="TrainPanel3" IsVisible="False">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="ШАГ 3 ИЗ 5" FontSize="9.5" FontWeight="ExtraBold"
                                                           LetterSpacing="1.7"
                                                           Foreground="{DynamicResource ManualAccent}" />
                                                <TextBlock Grid.Column="1" Text="≈ 5 минут" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFaint}" />
                                            </Grid>
                                            <TextBlock Text="Проверьте обложку и развороты" FontSize="22"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.7"
                                                       LineHeight="26" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="540" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Разверните книгу и пройдите по слотам: обложка, затем развороты по порядку. Если сюжет идёт иначе — поменяйте кадры местами или сбросьте порядок книги и начните заново. Рядом с каждым файлом видно отклонение пропорций в пикселях." />
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                                <Grid Width="694" Height="390">
                                                    <Border CornerRadius="12" ClipToBounds="True"
                                                            BorderBrush="{DynamicResource ManualFrameBorder}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource ManualFrameWash}" />
                                                    <Canvas>
                                                        <Border Classes="wire wireA" />
                                                        <Border Classes="wire wireB" />
                                                        <Border Classes="wire wireC" />
                                                        <Border Classes="wire wireD gold" />
                                                        <Border Classes="pin" Canvas.Left="180" Canvas.Top="148">
                                                            <TextBlock Text="1" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="402" Canvas.Top="234">
                                                            <TextBlock Text="2" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="597" Canvas.Top="101">
                                                            <TextBlock Text="3" />
                                                        </Border>
                                                    </Canvas>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                            Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                                            Background="{DynamicResource ManualMockTop}"
                                                            BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource ManualGold70}"
                                                                  Data="M12 7.2C10.4 5.8 8.1 5.2 4.2 5.5v12.4c3.9-.3 6.2.4 7.8 1.7 1.6-1.3 3.9-2 7.8-1.7V5.5C15.9 5.2 13.6 5.8 12 7.2z M12 7.2v12.4" />
                                                            <TextBlock Text="СНИМОК: ПРОВЕРКА РАЗВОРОТОВ" FontSize="8.5"
                                                                       FontWeight="ExtraBold" LetterSpacing="1.36"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFaint}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="Раскрытая книга: слоты, стрелки порядка и отклонение в пикселях."
                                                       FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextFaint}" />
                                            <StackPanel Spacing="7" Margin="0,16,0,0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="1" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Обложка всегда первая — её видно на карточке проекта."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="2" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Слот разворота: кадр можно заменить, не трогая остальные."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="3" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Допуск ±59 px. Больше — кадр нужно обрезать под макет."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ======================= шаг 4 ====================== -->
                                        <StackPanel Name="TrainPanel4" IsVisible="False">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="ШАГ 4 ИЗ 5" FontSize="9.5" FontWeight="ExtraBold"
                                                           LetterSpacing="1.7"
                                                           Foreground="{DynamicResource ManualAccent}" />
                                                <TextBlock Grid.Column="1" Text="≈ 2 минуты" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFaint}" />
                                            </Grid>
                                            <TextBlock Text="Экспортируйте файлы" FontSize="22"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.7"
                                                       LineHeight="26" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="540" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Выберите папку назначения и запустите экспорт. Каждая выгрузка создаёт новую папку, поэтому прошлые заказы не перезаписываются. Имена файлов программа задаёт сама — переименовывать вручную ничего не нужно." />
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                                <Grid Width="694" Height="390">
                                                    <Border CornerRadius="12" ClipToBounds="True"
                                                            BorderBrush="{DynamicResource ManualFrameBorder}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource ManualFrameWash}" />
                                                    <Canvas>
                                                        <Border Classes="wire wireA" />
                                                        <Border Classes="wire wireB" />
                                                        <Border Classes="wire wireC" />
                                                        <Border Classes="wire wireD gold" />
                                                        <Border Classes="pin" Canvas.Left="208" Canvas.Top="109">
                                                            <TextBlock Text="1" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="430" Canvas.Top="203">
                                                            <TextBlock Text="2" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="569" Canvas.Top="328">
                                                            <TextBlock Text="3" />
                                                        </Border>
                                                    </Canvas>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                            Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                                            Background="{DynamicResource ManualMockTop}"
                                                            BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource ManualGold70}"
                                                                  Data="M12 3v11M7.5 10l4.5 4.5L16.5 10M4 20h16" />
                                                            <TextBlock Text="СНИМОК: ОКНО ЭКСПОРТА" FontSize="8.5"
                                                                       FontWeight="ExtraBold" LetterSpacing="1.36"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFaint}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="Папка назначения, количество склеек и кнопка запуска экспорта."
                                                       FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextFaint}" />
                                            <StackPanel Spacing="7" Margin="0,16,0,0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="1" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Папка назначения: новая для каждого экспорта."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="2" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Склейки и количество файлов — проверьте до запуска."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="3" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="«Начать экспорт»: прогресс идёт в фоне, окно можно свернуть."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- ======================= шаг 5 ====================== -->
                                        <StackPanel Name="TrainPanel5" IsVisible="False">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="ШАГ 5 ИЗ 5" FontSize="9.5" FontWeight="ExtraBold"
                                                           LetterSpacing="1.7"
                                                           Foreground="{DynamicResource ManualAccent}" />
                                                <TextBlock Grid.Column="1" Text="зависит от объёма" FontSize="10.5"
                                                           Foreground="{DynamicResource TextFaint}" />
                                            </Grid>
                                            <TextBlock Text="Отправьте книги на сайт" FontSize="22"
                                                       FontWeight="ExtraBold" LetterSpacing="-0.7"
                                                       LineHeight="26" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextStrong}" />
                                            <TextBlock FontSize="13" LineHeight="22" TextWrapping="Wrap"
                                                       HorizontalAlignment="Left" MaxWidth="540" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="Отметьте группы «В загрузке», проверьте параметры и итоговую цену, запустите отправку. Загрузка идёт в фоне: окно прогресса можно свернуть и продолжать работу над следующим проектом. Если связь прервалась — откройте загрузку заново, уже отправленные книги отмечены." />
                                            <Viewbox Stretch="Uniform" HorizontalAlignment="Stretch" Margin="0,26,0,0">
                                                <Grid Width="694" Height="390">
                                                    <Border CornerRadius="12" ClipToBounds="True"
                                                            BorderBrush="{DynamicResource ManualFrameBorder}"
                                                            BorderThickness="1"
                                                            Background="{DynamicResource ManualFrameWash}" />
                                                    <Canvas>
                                                        <Border Classes="wire wireA" />
                                                        <Border Classes="wire wireB" />
                                                        <Border Classes="wire wireC" />
                                                        <Border Classes="wire wireD gold" />
                                                        <Border Classes="pin" Canvas.Left="236" Canvas.Top="117">
                                                            <TextBlock Text="1" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="458" Canvas.Top="218">
                                                            <TextBlock Text="2" />
                                                        </Border>
                                                        <Border Classes="pin" Canvas.Left="583" Canvas.Top="62">
                                                            <TextBlock Text="3" />
                                                        </Border>
                                                    </Canvas>
                                                    <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                            Margin="11,0,0,10" CornerRadius="6" Padding="9,5"
                                                            Background="{DynamicResource ManualMockTop}"
                                                            BorderBrush="{DynamicResource ManualFrameTagBorder}"
                                                            BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="7">
                                                            <Path Width="13" Height="13" Stretch="Uniform"
                                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                                  VerticalAlignment="Center"
                                                                  Stroke="{DynamicResource ManualGold70}"
                                                                  Data="M8.3 17.9a4.2 4.2 0 0 1-.6-8.4 5.5 5.5 0 0 1 10.4 1 3.7 3.7 0 0 1-.5 7.4 M12 16.6v-5.1 M9.9 13.6 12 11.5l2.1 2.1" />
                                                            <TextBlock Text="СНИМОК: ЗАГРУЗКА НА САЙТ" FontSize="8.5"
                                                                       FontWeight="ExtraBold" LetterSpacing="1.36"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextFaint}" />
                                                        </StackPanel>
                                                    </Border>
                                                </Grid>
                                            </Viewbox>
                                            <TextBlock Text="Группы книг, итоговая сумма и состояние каждой книги."
                                                       FontSize="11.5" LineHeight="18" TextWrapping="Wrap"
                                                       Margin="0,10,0,0"
                                                       Foreground="{DynamicResource TextFaint}" />
                                            <StackPanel Spacing="7" Margin="0,16,0,0">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="1" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Группы по формату: у каждой свои параметры и цена."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="2" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Состояние книги: готова или не прошла проверку формата."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="3" FontSize="9.5" FontWeight="ExtraBold"
                                                               Margin="0,2,0,0"
                                                               Foreground="{DynamicResource ManualAccent}" />
                                                    <TextBlock Grid.Column="1" Text="Итог к отправке — сумма и количество файлов до запуска."
                                                               FontSize="11.8" LineHeight="18" TextWrapping="Wrap"
                                                               Margin="9,0,0,0"
                                                               Foreground="{DynamicResource TextMuted}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- the way through the five steps -->
                                        <Border BorderBrush="{DynamicResource ManualRule}"
                                                BorderThickness="0,1,0,0" Margin="0,22,0,0" Padding="0,18,0,0">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Button Name="TrainPrev" Classes="trainBtn" Click="OnTrainPrev"
                                                        IsEnabled="False"
                                                        AutomationProperties.Name="Предыдущий шаг">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Path Width="13" Height="13" Stretch="Uniform"
                                                              StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                              VerticalAlignment="Center"
                                                              Data="M20 12H5M11 6l-6 6 6 6" />
                                                        <TextBlock Text="Назад" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Name="TrainPosition" Text="1" FontSize="11.5"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{DynamicResource TextStrong}" />
                                                    <TextBlock Text="/ 5" FontSize="11.5" FontWeight="SemiBold"
                                                               LetterSpacing="0.5"
                                                               Foreground="{DynamicResource TextFaint}" />
                                                </StackPanel>

                                                <Button Name="TrainNext" Grid.Column="2" Classes="trainBtn next"
                                                        Click="OnTrainNext"
                                                        AutomationProperties.Name="Следующий шаг">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <TextBlock Name="TrainNextLabel" Text="Дальше"
                                                                   VerticalAlignment="Center" />
                                                        <Path Name="TrainNextArrow" Width="13" Height="13"
                                                              Stretch="Uniform" StrokeThickness="1.7"
                                                              StrokeLineCap="Round" StrokeJoin="Round"
                                                              VerticalAlignment="Center"
                                                              Data="M4 12h15M13 6l6 6-6 6" />
                                                        <Path Name="TrainAgainIcon" Width="13" Height="13"
                                                              Stretch="Uniform" StrokeThickness="1.7"
                                                              StrokeLineCap="Round" StrokeJoin="Round"
                                                              VerticalAlignment="Center" IsVisible="False"
                                                              Data="M20 12a8 8 0 1 1-2.6-5.9M20 4v4.5h-4.5" />
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ============================== 05 фишки ========================= -->
                    <Border Name="Chapter5" BorderBrush="{DynamicResource ManualRule}"
                            BorderThickness="0,1,0,0" Margin="0,64,0,0" Padding="0,44,0,0">
                        <StackPanel>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel MaxWidth="560" HorizontalAlignment="Left" Margin="0,0,120,0">
                                    <TextBlock Text="Глава 05" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="2.2" Margin="0,0,0,11"
                                               Foreground="{DynamicResource ManualAccent}" />
                                    <TextBlock Text="Фишки, которые экономят время" FontSize="32"
                                               FontWeight="ExtraBold" LetterSpacing="-1.2"
                                               LineHeight="35" Foreground="{DynamicResource TextStrong}" />
                                    <TextBlock Text="Мелочи, заметные на больших заказах"
                                               FontSize="12.5" Margin="0,9,0,0"
                                               Foreground="{DynamicResource TextFaint}" />
                                </StackPanel>
                                <Path Name="Ghost5" Grid.Column="1" Stretch="None"
                                      Stroke="{DynamicResource ManualGhostNumeral}"
                                      StrokeThickness="1" Fill="Transparent"
                                      HorizontalAlignment="Right" VerticalAlignment="Top"
                                      Margin="0,-26,0,0" IsHitTestVisible="False" />
                            </Grid>

                            <!-- Six of them in two columns, each a line of the page rather than a box. -->
                            <Grid ColumnDefinitions="*,40,*" Margin="0,26,0,0">
                                <StackPanel Grid.Column="0">
                                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                            Padding="0,16">
                                        <Grid ColumnDefinitions="26,*">
                                            <TextBlock Text="01" FontSize="9.5" FontWeight="ExtraBold"
                                                       LetterSpacing="0.76" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Общие развороты" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextStrong}" />
                                                <TextBlock Text="Один разворот добавляется сразу во все книги — не нужно повторять его в каждой."
                                                           FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                            Padding="0,16">
                                        <Grid ColumnDefinitions="26,*">
                                            <TextBlock Text="03" FontSize="9.5" FontWeight="ExtraBold"
                                                       LetterSpacing="0.76" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Проверка пропорций" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextStrong}" />
                                                <TextBlock Text="Отклонение показывается в пикселях: до ±59 px кадр считается допустимым."
                                                           FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                            Padding="0,16">
                                        <Grid ColumnDefinitions="26,*">
                                            <TextBlock Text="05" FontSize="9.5" FontWeight="ExtraBold"
                                                       LetterSpacing="0.76" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Фоновая отправка" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextStrong}" />
                                                <TextBlock Text="Прогресс не блокирует программу — можно продолжать сборку следующего проекта."
                                                           FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                            Padding="0,16">
                                        <Grid ColumnDefinitions="26,*">
                                            <TextBlock Text="02" FontSize="9.5" FontWeight="ExtraBold"
                                                       LetterSpacing="0.76" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Автоматическая обложка" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextStrong}" />
                                                <TextBlock Text="В режиме папок обложкой становится самое большое фото — обычно это и есть задуманный кадр."
                                                           FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                            Padding="0,16">
                                        <Grid ColumnDefinitions="26,*">
                                            <TextBlock Text="04" FontSize="9.5" FontWeight="ExtraBold"
                                                       LetterSpacing="0.76" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="Группы по формату" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextStrong}" />
                                                <TextBlock Text="Книги одного формата собраны вместе: параметры и цена считаются на всю группу."
                                                           FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                            Padding="0,16">
                                        <Grid ColumnDefinitions="26,*">
                                            <TextBlock Text="06" FontSize="9.5" FontWeight="ExtraBold"
                                                       LetterSpacing="0.76" Margin="0,3,0,0"
                                                       Foreground="{DynamicResource ManualAccent}" />
                                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                                <TextBlock Text="История экспортов" FontSize="13" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextStrong}" />
                                                <TextBlock Text="Новая выгрузка не перезаписывает предыдущую: файлы прошлого заказа остаются на диске."
                                                           FontSize="12" LineHeight="19" TextWrapping="Wrap"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource TextMuted}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ============================== 06 вопросы ======================== -->
                    <Border Name="Chapter6" BorderBrush="{DynamicResource ManualRule}"
                            BorderThickness="0,1,0,0" Margin="0,64,0,0" Padding="0,44,0,0">
                        <StackPanel>
                            <TextBlock Text="Глава 06" FontSize="10" FontWeight="ExtraBold"
                                       LetterSpacing="2.2" Margin="0,0,0,11"
                                       Foreground="{DynamicResource ManualAccent}" />
                            <TextBlock Text="Вопросы, с которых начинают" FontSize="32"
                                       FontWeight="ExtraBold" LetterSpacing="-1.2" LineHeight="35"
                                       Foreground="{DynamicResource TextStrong}" />

                            <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                    Margin="0,22,0,0">
                                <StackPanel>
                                    <Expander Classes="faq">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16">
                                                <TextBlock Classes="qNo" Text="01" Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Classes="question"
                                                           Text="Можно ли поменять режим после создания проекта?"
                                                           TextWrapping="Wrap" />
                                                <Path Grid.Column="2" Classes="faqChevron" Width="14" Height="14"
                                                      Stretch="Uniform" StrokeThickness="1.7"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M6 9.5l6 6 6-6" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                                   Margin="40,0,30,18" HorizontalAlignment="Left" MaxWidth="570"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="Нет. Режим определяет структуру книг, поэтому меняется только созданием нового проекта. При смене режима уже собранные книги пришлось бы собирать заново — программа не даёт сделать это случайно." />
                                    </Expander>
                                    <Expander Classes="faq">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16">
                                                <TextBlock Classes="qNo" Text="02" Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Classes="question"
                                                           Text="Почему книга «не готова», хотя все фотографии на месте?"
                                                           TextWrapping="Wrap" />
                                                <Path Grid.Column="2" Classes="faqChevron" Width="14" Height="14"
                                                      Stretch="Uniform" StrokeThickness="1.7"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M6 9.5l6 6 6-6" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                                   Margin="40,0,30,18" HorizontalAlignment="Left" MaxWidth="570"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="Чаще всего не выбраны параметры группы — ламинация и плотность разворота. Вторая причина — отклонение пропорций больше допуска. Разверните книгу: в списке файлов видно отклонение каждой страницы." />
                                    </Expander>
                                    <Expander Classes="faq">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16">
                                                <TextBlock Classes="qNo" Text="03" Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Classes="question"
                                                           Text="Что делать, если в папках разное количество файлов?"
                                                           TextWrapping="Wrap" />
                                                <Path Grid.Column="2" Classes="faqChevron" Width="14" Height="14"
                                                      Stretch="Uniform" StrokeThickness="1.7"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M6 9.5l6 6 6-6" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                                   Margin="40,0,30,18" HorizontalAlignment="Left" MaxWidth="570"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="В режиме уникальных папок все папки проекта должны содержать одинаковое число снимков — иначе книги выйдут разной толщины. Добавьте недостающие кадры или уберите лишние, затем загрузите папки заново." />
                                    </Expander>
                                    <Expander Classes="faq">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16">
                                                <TextBlock Classes="qNo" Text="04" Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Classes="question"
                                                           Text="Нужно ли переименовывать файлы вручную?"
                                                           TextWrapping="Wrap" />
                                                <Path Grid.Column="2" Classes="faqChevron" Width="14" Height="14"
                                                      Stretch="Uniform" StrokeThickness="1.7"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M6 9.5l6 6 6-6" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                                   Margin="40,0,30,18" HorizontalAlignment="Left" MaxWidth="570"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="Нет. Имена вида 001-00.jpg программа присваивает при экспорте: номер книги и номер страницы. Исходные имена могут быть любыми — на сборку они не влияют." />
                                    </Expander>
                                    <Expander Classes="faq">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16">
                                                <TextBlock Classes="qNo" Text="05" Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Classes="question"
                                                           Text="Можно ли загрузить книгу с другим соотношением сторон?"
                                                           TextWrapping="Wrap" />
                                                <Path Grid.Column="2" Classes="faqChevron" Width="14" Height="14"
                                                      Stretch="Uniform" StrokeThickness="1.7"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M6 9.5l6 6 6-6" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                                   Margin="40,0,30,18" HorizontalAlignment="Left" MaxWidth="570"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="Небольшое отклонение допускается — до ±59 px. Если разница больше, обрежьте кадр под пропорции макета и замените его в слоте. Иначе сайт не примет файл." />
                                    </Expander>
                                    <Expander Classes="faq">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16">
                                                <TextBlock Classes="qNo" Text="06" Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Classes="question"
                                                           Text="Что делать, если загрузка на сайт прервалась?"
                                                           TextWrapping="Wrap" />
                                                <Path Grid.Column="2" Classes="faqChevron" Width="14" Height="14"
                                                      Stretch="Uniform" StrokeThickness="1.7"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M6 9.5l6 6 6-6" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                                   Margin="40,0,30,18" HorizontalAlignment="Left" MaxWidth="570"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="Откройте загрузку заново: уже отправленные книги отмечены, повторять их не нужно. Программа не отправляет один и тот же файл дважды." />
                                    </Expander>
                                    <Expander Classes="faq">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,16">
                                                <TextBlock Classes="qNo" Text="07" Margin="0,2,12,0"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1" Classes="question"
                                                           Text="Где взять номер проекта для поддержки?"
                                                           TextWrapping="Wrap" />
                                                <Path Grid.Column="2" Classes="faqChevron" Width="14" Height="14"
                                                      Stretch="Uniform" StrokeThickness="1.7"
                                                      StrokeLineCap="Round" StrokeJoin="Round"
                                                      Margin="12,0,0,0" VerticalAlignment="Center"
                                                      Data="M6 9.5l6 6 6-6" />
                                            </Grid>
                                        </Expander.Header>
                                        <TextBlock FontSize="12.5" LineHeight="22" TextWrapping="Wrap"
                                                   Margin="40,0,30,18" HorizontalAlignment="Left" MaxWidth="570"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="Он виден в верхней панели открытого проекта и в окне успешной загрузки, например 536691. С номером специалист сразу найдёт заказ и не будет уточнять детали." />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ============================== 07 клавиши ======================== -->
                    <Border Name="Chapter7" BorderBrush="{DynamicResource ManualRule}"
                            BorderThickness="0,1,0,0" Margin="0,64,0,0" Padding="0,44,0,0">
                        <StackPanel>
                            <TextBlock Text="Глава 07" FontSize="10" FontWeight="ExtraBold"
                                       LetterSpacing="2.2" Margin="0,0,0,11"
                                       Foreground="{DynamicResource ManualAccent}" />
                            <TextBlock Text="Горячие клавиши" FontSize="32" FontWeight="ExtraBold"
                                       LetterSpacing="-1.2" LineHeight="35"
                                       Foreground="{DynamicResource TextStrong}" />

                            <Grid ColumnDefinitions="*,40,*" Margin="0,20,0,0">
                                <Border Grid.Column="0" BorderBrush="{DynamicResource ManualRule}"
                                        BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Экспорт книг" FontSize="12.2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Border CornerRadius="5" Padding="7,2"
                                                    BorderThickness="1,1,1,2"
                                                    BorderBrush="{DynamicResource ManualMockLineSoft}"
                                                    Background="{DynamicResource ManualKeyFill}">
                                                <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource ManualKeyInk}" />
                                            </Border>
                                            <Border CornerRadius="5" Padding="7,2"
                                                    BorderThickness="1,1,1,2"
                                                    BorderBrush="{DynamicResource ManualMockLineSoft}"
                                                    Background="{DynamicResource ManualKeyFill}">
                                                <TextBlock Text="E" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource ManualKeyInk}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource ManualRule}"
                                        BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Сохранить проект" FontSize="12.2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Border CornerRadius="5" Padding="7,2"
                                                    BorderThickness="1,1,1,2"
                                                    BorderBrush="{DynamicResource ManualMockLineSoft}"
                                                    Background="{DynamicResource ManualKeyFill}">
                                                <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource ManualKeyInk}" />
                                            </Border>
                                            <Border CornerRadius="5" Padding="7,2"
                                                    BorderThickness="1,1,1,2"
                                                    BorderBrush="{DynamicResource ManualMockLineSoft}"
                                                    Background="{DynamicResource ManualKeyFill}">
                                                <TextBlock Text="S" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource ManualKeyInk}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="0" BorderBrush="{DynamicResource ManualRule}"
                                        BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Загрузка на сайт" FontSize="12.2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Border CornerRadius="5" Padding="7,2"
                                                    BorderThickness="1,1,1,2"
                                                    BorderBrush="{DynamicResource ManualMockLineSoft}"
                                                    Background="{DynamicResource ManualKeyFill}">
                                                <TextBlock Text="Ctrl" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource ManualKeyInk}" />
                                            </Border>
                                            <Border CornerRadius="5" Padding="7,2"
                                                    BorderThickness="1,1,1,2"
                                                    BorderBrush="{DynamicResource ManualMockLineSoft}"
                                                    Background="{DynamicResource ManualKeyFill}">
                                                <TextBlock Text="U" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource ManualKeyInk}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" BorderBrush="{DynamicResource ManualRule}"
                                        BorderThickness="0,1,0,0" Padding="0,12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="Справка" FontSize="12.2"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                            <Border CornerRadius="5" Padding="7,2"
                                                    BorderThickness="1,1,1,2"
                                                    BorderBrush="{DynamicResource ManualMockLineSoft}"
                                                    Background="{DynamicResource ManualKeyFill}">
                                                <TextBlock Text="F1" FontSize="10.5" FontWeight="Bold"
                                                           Foreground="{DynamicResource ManualKeyInk}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--
                                The journal is the program's own line, and the prototype has no
                                place for it: it is what turns "не получилось" into something a
                                person can send. A quiet row under the keys rather than a box.
                            -->
                            <Border BorderBrush="{DynamicResource ManualRule}" BorderThickness="0,1,0,0"
                                    Margin="0,24,0,0" Padding="0,16,0,0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <TextBlock Text="Журнал программы:" FontSize="11.5"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <TextBox Name="JournalPath" Grid.Column="1" Margin="8,0,0,0"
                                             FontSize="11" FontFamily="Consolas" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             VerticalAlignment="Center"
                                             Foreground="{DynamicResource TextMuted}" />
                                    <Button Grid.Column="2" Classes="trainBtn" Margin="12,0,0,0"
                                            Click="OnOpenJournalFolder"
                                            AutomationProperties.Name="Открыть папку с журналом">
                                        <TextBlock Text="Открыть папку" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Border BorderBrush="{DynamicResource ManualRule}"
                                    BorderThickness="0,1,0,1" Margin="0,56,0,0" Padding="0,26">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Не нашли свой случай?" FontSize="15"
                                                   FontWeight="ExtraBold" LetterSpacing="-0.3"
                                                   Foreground="{DynamicResource TextStrong}" />
                                        <TextBlock FontSize="12.5" LineHeight="20" TextWrapping="Wrap"
                                                   HorizontalAlignment="Left" MaxWidth="450" Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="Поддержка работает ежедневно с 9:00 до 21:00. Напишите, что происходит, и приложите снимок экрана — разберём конкретный проект." />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="primary" Padding="20,0"
                                            VerticalAlignment="Center" Click="OnSupportClick"
                                            AutomationProperties.Name="Написать в поддержку">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Path Width="16" Height="16" Stretch="Uniform"
                                                  StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                  VerticalAlignment="Center"
                                                  Stroke="{DynamicResource ActionInk}"
                                                  Data="M20 12.4c0 3.6-3.6 6.5-8 6.5-1 0-2-.15-2.9-.45L4.6 20l1.2-3.3C4.6 15.4 4 14 4 12.4 4 8.8 7.6 5.9 12 5.9s8 2.9 8 6.5z M8.6 12.3h.01M12 12.3h.01M15.4 12.3h.01" />
                                            <TextBlock Text="Написать в поддержку" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>


                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
