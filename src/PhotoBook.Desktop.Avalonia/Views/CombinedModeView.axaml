<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PhotoBook.Shell.Views"
             x:Class="PhotoBook.Shell.Views.CombinedModeView"
             >

    <!--
        The combined screen, transcribed from doc\DESIGN_SPEC.md section 6 and checked
        number by number against the other shell's markup. It is the largest screen in the
        product: a control panel, a file list and a column of books, all at once.

            shell        max 1600, margin 32/24
            panel        card, padding 20; badge 48 with a 20 glyph; two star columns
                         either side of the run fields, so the run stays in the middle
                         whatever the window does
            run fields   two number boxes, 64 wide, 12px, labels above in 10px slate
            file column  320 (280-360), card, padding 16
            drop zone    14 corner, slate-50, dashed line of its own shape at 13 inside
            book cards   card, padding 20, 16 below; the number IS the name, so a run of
                         forty books reads as forty named things and not as a table
            slot         radius 12, margin 0/0/16/16, cover framed at 2px in the product
                         colour, everything else a hairline
            slot frame   150 tall - not the 190 the folders screen uses, because this one
                         shares the window with a 320px file list - and as wide as the
                         book's own format, both sides scaling together when one more card
                         per row is within reach

        Four departures, each written down rather than quietly copied:

        1. The photo fits its frame rather than being cropped to it, as on the folders
           screen. A crop throws away the edges a photographer chose.
        2. The label and the "to all books" action replace one another, driven from the code
           behind rather than by a trigger. There is no way in this engine to hide one child
           because its parent is hovered.
        3. The zoom on hover is done by setting the transform in the same place, for the
           same reason.
        4. The photo's own frame is 150 tall and the design height for this mode is a
           parameter of the size converter, so the two can never disagree.
    -->

    <UserControl.Styles>
        <!--
            The upload zone answers the pointer.

            It used to be a grey box with a dashed line in it, and nothing happened when
            the pointer went over it - so the one place on the screen that takes files
            looked the same as the one place that does not. The line takes the product's
            colour, the box takes a tint of it, and the mark goes a shade darker, all of
            it over a moment rather than at once: a zone that brightens when the pointer
            arrives says "here", and a zone that does not say nothing at all.

            The colours live here and not on the elements. A value set on the element
            itself beats a style, so a colour written down in the markup could never be
            changed by the style that answers the pointer - which is why the first version
            of this did nothing at all.
        -->
        <!--
            The drop zone of the first-run page: a dashed frame of gold over a wash of gold, and
            the cloud on the same plate every other mark in the program sits on. It answers the
            pointer by deepening both, over a moment rather than at once.
        -->
        <Style Selector="Border#DropZone">
            <Setter Property="Background" Value="{DynamicResource CombinedDropFill}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#DropZone:pointerover">
            <Setter Property="Background" Value="{DynamicResource CombinedWash}" />
        </Style>

        <Style Selector="Rectangle#DropZoneFrame">
            <Setter Property="Stroke" Value="{DynamicResource CombinedDashedRing}" />
        </Style>

        <Style Selector="Border#DropZone:pointerover Rectangle#DropZoneFrame">
            <Setter Property="Stroke" Value="{DynamicResource CombinedDashedRingHover}" />
        </Style>

        <!--
            The mark of the drop zone is the mark of the button that uploads a book - the same
            cloud with the same arrow - and it stands on the wash on its own, with no plate
            around it: the zone already has a frame, and a second one inside it was a box in a box.
        -->
        <Style Selector="Path#DropZoneMark">
            <Setter Property="Stroke" Value="{DynamicResource Accent}" />
        </Style>

        <!--
            Renaming the project happens where the name is, so the field looks like part of this
            panel rather than like a form control - the same field the folders screen shows: one
            rounded frame, seventeen-point bold words the size of the heading it replaces, and
            the gold of the product when it takes the keyboard.
        -->
        <Style Selector="TextBox#ProjectNameTextBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
            <Setter Property="Background" Value="{DynamicResource FieldFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource ActionFill}" />
            <Setter Property="Watermark" Value="Название проекта" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox#ProjectNameTextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBorder}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
        </Style>

        <!-- The pencil beside the project name: the same 26 square the folders screen uses, with
             no chrome until the pointer is on it. -->
        <Style Selector="Button.pencil">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.pencil:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceMuted}" />
        </Style>
        <Style Selector="Button.pencil:pointerover Path">
            <Setter Property="Stroke" Value="{DynamicResource TextDefault}" />
        </Style>

        <!--
            One row of controls of one shape: the quiet button of the panel wears the same pill,
            the same quiet fill and the same hairline as the soft one beside it, in both states.
            A bare ghost next to a framed soft one read as two kinds of control rather than as
            the same row of buttons.
        -->
        <Style Selector="Button.panelGhost">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource QuietFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuietBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.panelGhost:pointerover">
            <Setter Property="Background" Value="{DynamicResource QuietFillHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuietBorderHover}" />
        </Style>
        <Style Selector="Button.panelGhost TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="Button.panelGhost:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
        </Style>
        <Style Selector="Button.panelGhost:disabled">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuietBorder}" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Button.panelGhost:disabled /template/ Border#Root">
            <Setter Property="Background" Value="{DynamicResource QuietFill}" />
        </Style>
        <Style Selector="Button.panelGhost:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>

        <!-- A disabled filled button in this panel is a faint frame, not a grey slab. -->
        <Style Selector="Button.primary:disabled">
            <Setter Property="Background" Value="{DynamicResource QuietFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource QuietBorder}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Button.primary:disabled /template/ Border">
            <Setter Property="BoxShadow" Value="{DynamicResource ActionShadowOff}" />
        </Style>
        <Style Selector="Button.primary:disabled TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>
        <Style Selector="Button.primary:disabled Path">
            <Setter Property="Stroke" Value="{DynamicResource TextFaint}" />
        </Style>

        <!--
            The site button while it cannot be pressed answers the pointer the way the folders
            screen's does: the pane in front of it lends the shadow of a hover and the sunken
            shadow of a press, and the button itself does not move.
        -->
        <Style Selector="Button.primary:disabled.siteHover /template/ Border">
            <Setter Property="BoxShadow" Value="{DynamicResource ActionShadowOffHover}" />
        </Style>
        <Style Selector="Button.primary:disabled.sitePressed /template/ Border">
            <Setter Property="BoxShadow" Value="{DynamicResource ActionShadowPressed}" />
        </Style>

        <!--
            The run counter: a box of one height with a minus, the number and a plus. The number
            is still a field, so it can be typed into, but it looks like the plain bold figure the
            prototype draws - no frame of its own inside the box that already has one.
        -->
        <Style Selector="Border.stepperBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource Sunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.stepperStep">
            <Setter Property="Width" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.stepperStep:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Background" Value="{DynamicResource CombinedWash}" />
        </Style>
        <Style Selector="Button.stepperStep:disabled">
            <Setter Property="Opacity" Value="0.4" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <Style Selector="TextBox.stepperValue">
            <Setter Property="Width" Value="36" />
            <Setter Property="MinWidth" Value="36" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <!--
            The number sits in the box, not in a box of its own. The theme paints a field's
            frame with its own fill the moment the field is focused or the pointer crosses
            it, and the books field is focused as soon as the page opens - which is why the
            middle of the stepper was a white rectangle in a sunken one.
        -->
        <Style Selector="TextBox.stepperValue /template/ Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.stepperValue:pointerover /template/ Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.stepperValue:focus /template/ Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <!--
            The search of the photo column, as the prototype draws it: a sunken well with the
            magnifier inside its own left padding, the same fill and the same hairline as the
            boxes around it rather than the white form field the theme hands out.
        -->
        <Style Selector="TextBox.searchInput">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="36,0,12,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <!--
                Sunken once, on the field's own frame. The template draws two borders - the
                named frame of the text control and a plain one inset by the border's
                thickness - and a selector that named neither painted both, so six per cent
                of brown was laid down twice and the well came out darker than the
                prototype's. The frame is addressed by its name below.
            -->
            <Setter Property="Background" Value="{DynamicResource Sunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBox.searchInput /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Sunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        </Style>
        <Style Selector="TextBox.searchInput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Sunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}" />
        </Style>
        <Style Selector="TextBox.searchInput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource Sunken}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ActionBorder}" />
        </Style>

        <!--
            A row answers the pointer with a light wash, as the folders screen's rows do.

            It is a hover and not a selection: nothing in this list is selected, and a row that
            stayed tinted after a click would claim it was. The wash sits on the row's own
            rounded border rather than on the list's square cell, so it follows the corner.
        -->
        <Style Selector="Border.fileRow">
            <Setter Property="Cursor" Value="Hand" />

            <!--
                Transparent, and written down: a border with no background is not hit-tested,
                so the pointer only counted while it was over the picture or a word. Crossing
                a row quickly went through the gaps between them and the wash never came up,
                which is what made the highlight feel slow and unreliable. The background is
                null right up to the moment the style is applied, so the colour is set here.
            -->
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Transitions">
                <Transitions>
                    <!-- Just over a frame's worth: a wash that fades in says the row is live,
                         and anything slower than a tenth of a second is read as lag. -->
                    <BrushTransition Property="Background" Duration="0:0:0.07" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.fileRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Slate100}" />
        </Style>

        <!--
            An empty run field is the focused one, and the theme paints a focused box's own
            frame in its colour - a dark ring inside the red one, which reads as a black box
            with a red halo. While the field holds no number, the ring around it is the frame.
        -->
        <Style Selector="TextBox.numberField.invalid:focus /template/ Border">
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid MaxWidth="1600" Margin="32,24" HorizontalAlignment="Stretch"
          RowDefinitions="Auto,Auto,*">

        <!-- ================================ error ================================ -->
        <Border Grid.Row="0" Background="{DynamicResource Red50}"
                BorderBrush="{DynamicResource Red200}" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,0,0,16"
                VerticalAlignment="Top"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Classes="t12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Red700}" />
        </Border>

        <!-- ============================ control panel ============================ -->
        <Border Grid.Row="1" Classes="card" Padding="24,20" Margin="0,0,0,18">
            <!--
                Two columns: the project on the left at its own width, the controls on the
                right in what is left. The controls wrap (see the panel below) rather than
                being cut off: a project with a long name and five controls is wider than a
                1280 window, and the site button used to disappear past its edge.
            -->
            <Grid ColumnDefinitions="Auto,*">

                <!-- left: the tile, the name, one line of state -->
                <Grid Grid.Column="0" ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                    <!--
                        The tile of the mode, not a badge made for this screen: the same cream
                        plate in daylight and gold at night as the mode's own mark on the choice
                        screen, with the second hairline inside it that makes it a plate rather
                        than a coloured square.
                    -->
                    <Border Width="52" Height="52" CornerRadius="15" VerticalAlignment="Center"
                            Background="{DynamicResource ModePlateFill}"
                            BorderBrush="{DynamicResource ModePlateRing}" BorderThickness="1"
                            BoxShadow="{DynamicResource ModePlateShadow}">
                        <Panel>
                            <Border Margin="5" CornerRadius="11" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource ModePlateInnerRing}" />
                            <Path Width="24" Height="24" Stretch="Uniform"
                                  StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{DynamicResource ModePlateInk}"
                                  Data="M12 7.2C10.4 5.8 8.1 5.2 4.2 5.5v12.4c3.9-.3 6.2.4 7.8 1.7 1.6-1.3 3.9-2 7.8-1.7V5.5C15.9 5.2 13.6 5.8 12 7.2z M12 7.2v12.4" />
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                        <Grid ColumnDefinitions="Auto,Auto,Auto" VerticalAlignment="Center">
                            <TextBlock Grid.Column="0" Text="Проект:" Classes="t19ExtraBold"
                                       LetterSpacing="-0.5" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Name="ProjectNameTextBlock" Classes="t19ExtraBold"
                                       Text="{Binding DisplayProjectName}" Margin="8,0,0,0"
                                       LetterSpacing="-0.5" MaxWidth="480"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Cursor="Hand" PointerPressed="OnProjectNameClick" />
                            <TextBox Grid.Column="1" Name="ProjectNameTextBox"
                                     MinWidth="200" MaxWidth="300" HorizontalAlignment="Left"
                                     Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="False"
                                     KeyDown="OnProjectNameKeyDown" LostFocus="OnProjectNameLostFocus" />
                            <Button Grid.Column="2" Classes="pencil" Margin="8,0,0,0"
                                    AutomationProperties.Name="Переименовать проект"
                                    ToolTip.Tip="Переименовать проект"
                                    Click="OnProjectNamePencilClick">
                                <Path Width="12.5" Height="12.5" Stretch="Uniform" StrokeThickness="1.6"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Stroke="{DynamicResource TextFaint}"
                                      Data="M4 20l4.2-1 10-10a2.3 2.3 0 0 0-3.2-3.2l-10 10z M13.5 7.5l3 3" />
                            </Button>
                        </Grid>

                        <TextBlock Classes="t12Half" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   IsVisible="{Binding !IsVisible, ElementName=ProjectNameTextBox}"
                                   Text="{Binding StructureProgress}" />
                        <TextBlock FontSize="12.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextFaint}"
                                   IsVisible="{Binding IsVisible, ElementName=ProjectNameTextBox}"
                                   Text="Enter — сохранить · Esc — отмена" />
                    </StackPanel>
                </Grid>

                <!--
                    right: the two counters and everything that can be done with the project, on
                    one line. Every button is 42 tall and hangs from the same baseline as the
                    counters' boxes, so the row reads as one row.
                -->
                <!--
                    A wrapping row, as the prototype's panel is: twelve pixels between the
                    controls, and a second line when the window cannot hold one - never a
                    button half past the edge. A WrapPanel has no gap of its own, so the gap
                    is the right margin of every child but the last.
                -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Margin="18,0,0,0">

                    <StackPanel Spacing="6" Margin="0,0,12,0">
                        <TextBlock Text="Книг" FontSize="10.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFaint}" />
                        <Border CornerRadius="12" BorderThickness="2"
                                BorderBrush="{Binding NumberOfBooksIsValid, Converter={StaticResource RunFieldFrame}}">
                            <Border Classes="stepperBox">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="ghost stepperStep"
                                            AutomationProperties.Name="Меньше книг"
                                            ToolTip.Tip="Меньше книг"
                                            Command="{Binding DecreaseBooksCommand}">
                                        <TextBlock Text="&#x2212;" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <TextBox Classes="stepperValue"
                                             Text="{Binding NumberOfBooksText}"
                                             AutomationProperties.Name="Количество книг" />
                                    <Button Classes="ghost stepperStep"
                                            AutomationProperties.Name="Больше книг"
                                            ToolTip.Tip="Больше книг"
                                            Command="{Binding IncreaseBooksCommand}">
                                        <TextBlock Text="+" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>

                    <StackPanel Spacing="6" Margin="0,0,12,0">
                        <TextBlock Text="Разворотов" FontSize="10.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFaint}" />
                        <Border CornerRadius="12" BorderThickness="2"
                                BorderBrush="{Binding SpreadsPerBookIsValid, Converter={StaticResource RunFieldFrame}}">
                            <Border Classes="stepperBox">
                                <StackPanel Orientation="Horizontal">
                                    <Button Classes="ghost stepperStep"
                                            AutomationProperties.Name="Меньше разворотов"
                                            ToolTip.Tip="Меньше разворотов"
                                            Command="{Binding DecreaseSpreadsCommand}">
                                        <TextBlock Text="&#x2212;" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <TextBox Classes="stepperValue"
                                             Text="{Binding SpreadsPerBookText}"
                                             AutomationProperties.Name="Разворотов в книге" />
                                    <Button Classes="ghost stepperStep"
                                            AutomationProperties.Name="Больше разворотов"
                                            ToolTip.Tip="Больше разворотов"
                                            Command="{Binding IncreaseSpreadsCommand}">
                                        <TextBlock Text="+" FontSize="16" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </Border>
                    </StackPanel>

                    <Button Classes="primary" VerticalAlignment="Bottom" Margin="0,0,12,0"
                            AutomationProperties.Name="Добавить структуру"
                            Command="{Binding ConfirmStructureCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Stroke="{DynamicResource ActionInk}"
                                  Data="M12 5 V19 M5 12 H19" />
                            <TextBlock Text="{Binding StructureButtonText}" VerticalAlignment="Center"
                                       Foreground="{DynamicResource ActionInk}" />
                        </StackPanel>
                    </Button>

                    <!--
                        The rule between the structure and what is done with the project, as on the
                        folders screen: the counters and «Добавить структуру» belong to one thing,
                        everything to the right of the line to another.
                    -->
                    <Border Width="1" Height="38" Margin="2,0,14,0" VerticalAlignment="Bottom"
                            Background="{DynamicResource BorderStrong}" />

                    <Button Classes="soft" VerticalAlignment="Bottom" Margin="0,0,12,0"
                            AutomationProperties.Name="Экспортировать"
                            ToolTip.Tip="Выгрузить все книги проекта в одну папку"
                            IsEnabled="{Binding CanExport}"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Path Width="12" Height="12" Stretch="Uniform" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Data="M12 15.2V4.2 M7.9 8.3 12 4.2l4.1 4.1 M3.9 14.2v3a2.6 2.6 0 0 0 2.6 2.6h11a2.6 2.6 0 0 0 2.6-2.6v-3" />
                            <TextBlock Text="Экспортировать" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!--
                        The same pair as on the folders screen: a gold action and a pane in front of
                        it while it cannot be pressed, so a pressable button is never covered and the
                        pointer's two answers are still there.
                    -->
                    <Panel>
                        <Button Name="SiteOrderButton" Classes="primary" VerticalAlignment="Bottom"
                                AutomationProperties.Name="Загрузить на сайт"
                                ToolTip.Tip="Собрать заказ для сайта: только полностью собранный проект"
                                IsEnabled="{Binding CanExport}"
                                Command="{Binding OrderOnSiteCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Path Width="16" Height="16" Stretch="Uniform"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M8.3 17.9a4.2 4.2 0 0 1-.6-8.4 5.5 5.5 0 0 1 10.4 1 3.7 3.7 0 0 1-.5 7.4 M12 16.6v-5.1 M9.9 13.6 12 11.5l2.1 2.1" />
                                <TextBlock Text="Загрузить на сайт" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border Name="SiteOrderPane" Background="Transparent" Cursor="Arrow"
                                IsVisible="{Binding !CanExport}"
                                PointerEntered="OnOrderOnSitePointerEntered"
                                PointerExited="OnOrderOnSitePointerExited"
                                PointerPressed="OnOrderOnSitePressed"
                                PointerReleased="OnOrderOnSiteReleased"
                                PointerCaptureLost="OnOrderOnSiteReleased" />
                    </Panel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ========================= two areas, equal height ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="360" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ========================== the file list =========================== -->
            <Border Grid.Column="0" Classes="card" Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">

                    <!-- title and how many are loaded -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Загруженные фото" Classes="t15ExtraBold" />
                        <TextBlock Classes="t11Half" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding AvailableFilesCount, StringFormat='Загружено: {0}'}" />
                    </StackPanel>

                    <!--
                        ONE way in, not two: the zone is clickable and accepts a drop, so a
                        separate button was the same action twice. The dashed line is the zone's
                        own shape, so it follows the rounded corner instead of squaring it off.
                    -->
                    <Border x:Name="DropZone" Grid.Row="1" Margin="0,14,0,0" Cursor="Hand"
                            CornerRadius="14" MinHeight="142"
                            PointerPressed="OnUploadAreaClick"
                            AutomationProperties.Name="Загрузить фото">
                        <Grid Margin="2">
                            <Rectangle x:Name="DropZoneFrame" RadiusX="13" RadiusY="13"
                                       StrokeThickness="1.5" StrokeDashArray="5,4"
                                       IsHitTestVisible="False" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="18,15">
                                <Path x:Name="DropZoneMark" Width="30" Height="30" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M8.3 17.9a4.2 4.2 0 0 1-.6-8.4 5.5 5.5 0 0 1 10.4 1 3.7 3.7 0 0 1-.5 7.4 M12 16.6v-5.1 M9.9 13.6 12 11.5l2.1 2.1" />
                                <TextBlock Text="Перетащите снимки сюда" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDefault}"
                                           HorizontalAlignment="Center" Margin="0,9,0,0" />
                                <TextBlock Text="или нажмите, чтобы выбрать · JPEG"
                                           FontSize="11" Foreground="{DynamicResource TextFaint}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Panel Grid.Row="2" Margin="0,12,0,12">
                        <TextBox Classes="searchInput"
                                 Name="PhotoSearchBox"
                                 Text="{Binding PhotoSearch}"
                                 AutomationProperties.Name="Поиск по имени файла"
                                 Watermark="Поиск по имени файла" />
                        <Path Width="15" Height="15" Stretch="Uniform" IsHitTestVisible="False"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Margin="13,0,0,0"
                              StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                              Stroke="{DynamicResource TextFaint}"
                              Data="M10 3 A 7 7 0 1 0 10 17 A 7 7 0 1 0 10 3 M15 15 L 20.5 20.5" />
                    </Panel>

                    <Grid Grid.Row="3" MinHeight="0">
                        <!--
                            A virtualizing list, and no scroller around it: a scroller whose
                            content is itself a scrolling list hands the inner one an infinite
                            viewport, the inner list then builds every row, and the first paint of
                            a hundred photographs took 1.9 seconds.
                        -->
                        <ListBox ItemsSource="{Binding FilteredPhotoFiles}"
                                 IsVisible="{Binding HasFiles}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="0" MinWidth="0" Focusable="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="fileRow" Margin="0,0,0,2"
                                            CornerRadius="10" Padding="8"
                                            PointerPressed="OnFileItemClick"
                                            ToolTip.Tip="{Binding Path}">
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="40" Height="40"
                                                    CornerRadius="8" ClipToBounds="True"
                                                    Background="{DynamicResource Slate100}">
                                                <Image Stretch="UniformToFill"
                                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                                       Source="{Binding Path, Converter={StaticResource FilePathToBitmap}, ConverterParameter=44}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="8,0,8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Classes="t12Medium"
                                                           Foreground="{DynamicResource Slate700}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}" />
                                                <TextBlock Text="{Binding DimensionsText}"
                                                           Classes="t11"
                                                           Foreground="{DynamicResource Slate400}" />
                                            </StackPanel>

                                            <Border Grid.Column="2" CornerRadius="6"
                                                    Padding="8,3" VerticalAlignment="Center"
                                                    Background="{Binding Usage, Converter={StaticResource PhotoUsageBrush}}">
                                                <TextBlock Text="{Binding UsageText}" FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource OnAccent}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!--
                            The empty answer of the column: what the list will hold, not a shrug.
                            Only while there are no files at all - a search that finds nothing is
                            the list's own answer.
                        -->
                        <Border Classes="emptyPhotos" IsVisible="{Binding !HasFiles}"
                                VerticalAlignment="Center">
                            <StackPanel Spacing="5" HorizontalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="10" Margin="0,0,0,3"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource CombinedEmptyFill}"
                                        BorderBrush="{DynamicResource CombinedEmptyRing}"
                                        BorderThickness="1">
                                    <Path Width="16" Height="16" Stretch="Uniform"
                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                          Stroke="{DynamicResource TextFaint}"
                                          Data="M 6 4.5 H 18 A 2.5 2.5 0 0 1 20.5 7 V 17 A 2.5 2.5 0 0 1 18 19.5 H 6 A 2.5 2.5 0 0 1 3.5 17 V 7 A 2.5 2.5 0 0 1 6 4.5 Z M 9 8.4 A 1.6 1.6 0 1 0 9 11.6 A 1.6 1.6 0 1 0 9 8.4 M 4.5 17 L 9.3 12.6 A 1.5 1.5 0 0 1 11.3 12.6 L 14.3 15.3 L 16.5 13.3 A 1.5 1.5 0 0 1 18.5 13.3 L 20.1 14.7" />
                                </Border>
                                <TextBlock Text="Список пока пуст" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource TextDefault}"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="Сюда попадут все JPEG проекта — по одному или целой папкой."
                                           FontSize="11" LineHeight="17" TextWrapping="Wrap"
                                           TextAlignment="Center" MaxWidth="190"
                                           Foreground="{DynamicResource TextFaint}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--
                        The note of the column, at its foot: a filled strip rather than a line of
                        faint grey. What it says is worth reading before a folder is moved, so it
                        is not dressed as a caption nobody stops at.
                    -->
                    <Border Grid.Row="4" Margin="0,12,0,0" VerticalAlignment="Bottom"
                            CornerRadius="10" Padding="10,8"
                            Background="{DynamicResource SunkenFaint}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="Auto,*">
                            <Path Grid.Column="0" Width="13" Height="13" Stretch="Uniform" StrokeThickness="1.7"
                                  StrokeLineCap="Round" StrokeJoin="Round" Margin="0,2,7,0"
                                  VerticalAlignment="Top"
                                  Stroke="{DynamicResource Accent}"
                                  Data="M12 3 A 9 9 0 1 0 12 21 A 9 9 0 1 0 12 3 M12 11 V16.5 M12 7.8h.01" />
                            <TextBlock Grid.Column="1" Text="Проект помнит пути к снимкам: если файлы переместить или переименовать, они перестанут открываться."
                                       FontSize="11" LineHeight="17" TextWrapping="Wrap"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ============================= the books ============================= -->
            <!--
                No card around the whole column. A white field holding every book, with
                another white field inside it per book, reads as one single object with
                rows in it - a table, not a stack of books. Each book is a card and the
                space between cards is the background, so "there is one more book below" is
                something you see rather than read.
            -->
            <Grid Grid.Column="2">

                <ScrollViewer IsVisible="{Binding !HasStructure}" VerticalScrollBarVisibility="Auto"
                              Padding="0,0,10,0">
                    <Grid ColumnDefinitions="*,18,306">

                        <!--
                            The first-run card: what the mode is, the three steps in order, and
                            the one button that starts it. It stands on the page rather than in a
                            narrow centred card, because at that moment it is the only thing on
                            the screen.
                        -->
                        <Border Grid.Column="0" Classes="card" CornerRadius="22" Padding="26,28,28,22">
                            <Panel>
                                <!--
                                    The lamp in the card's top-right corner, as the design lights
                                    it: one round light hung past the corner and cut off by the
                                    card's own frame - the frame is the clip, because a light
                                    this size drawn inside a rounded card spills past it.

                                    It used to be the mode card's glow, stretched to fill the
                                    card. A light that fills the card is not a corner light: it
                                    reads as a second sheet of paper of a warmer colour laid
                                    over the first, straight edges and all.
                                -->
                                <Border Margin="-26,-28,-28,-22" CornerRadius="22"
                                        ClipToBounds="True" IsHitTestVisible="False">
                                    <Border Width="420" Height="360"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,-140,-120,0"
                                            Background="{DynamicResource StarterGlowFill}" />
                                </Border>

                                <StackPanel>
                                    <!-- The seal and the heading on one line: the mark first, the words beside it. -->
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Grid.Column="0" Width="58" Height="58" CornerRadius="17"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource ModePlateFill}"
                                                BorderBrush="{DynamicResource ModePlateRing}" BorderThickness="1"
                                                BoxShadow="{DynamicResource ModePlateShadow}">
                                            <Panel>
                                                <Border Margin="6" CornerRadius="12" BorderThickness="1"
                                                        IsHitTestVisible="False"
                                                        BorderBrush="{DynamicResource ModePlateInnerRing}" />
                                                <Path Width="27" Height="27" Stretch="Uniform"
                                                      StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Stroke="{DynamicResource ModePlateInk}"
                                                      Data="M12 7.2C10.4 5.8 8.1 5.2 4.2 5.5v12.4c3.9-.3 6.2.4 7.8 1.7 1.6-1.3 3.9-2 7.8-1.7V5.5C15.9 5.2 13.6 5.8 12 7.2z M12 7.2v12.4" />
                                            </Panel>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="Соберите первую книгу" FontSize="26"
                                                   FontWeight="ExtraBold" LetterSpacing="-0.9"
                                                   Margin="16,0,0,0" VerticalAlignment="Center"
                                                   LineHeight="31" TextWrapping="Wrap" />
                                    </Grid>

                                    <!--
                                        The label keeps the place the card has always given it: a
                                        line of its own under the seal, before the lead. It is a
                                        line of capitals a fifth of an em apart in the product's
                                        gold, with eighteen-pixel rules either side of it -
                                        punctuation for the words, not a frame around them.
                                        Above the seal it read as the card's title, which is not
                                        what a mode's own label is.
                                    -->
                                    <StackPanel Orientation="Horizontal" Spacing="8"
                                                HorizontalAlignment="Left" Margin="0,14,0,0">
                                        <Border Width="18" Height="1" VerticalAlignment="Center"
                                                Opacity="0.5" Background="{DynamicResource Accent}" />
                                        <TextBlock Text="КОМБИНИРОВАННЫЙ" FontSize="10.5" FontWeight="Bold"
                                                   LetterSpacing="1.9" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}" />
                                        <Border Width="18" Height="1" VerticalAlignment="Center"
                                                Opacity="0.5" Background="{DynamicResource Accent}" />
                                    </StackPanel>

                                    <TextBlock FontSize="13.5" Margin="0,12,0,0" MaxWidth="820"
                                               HorizontalAlignment="Left" TextWrapping="Wrap" LineHeight="24"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="Структуру задаёте вы: сколько книг и разворотов будет в проекте. Фотографии раскладываются по ячейкам вручную — или сразу во все книги, если разворот общий." />

                                    <StackPanel Margin="0,20,0,0">
                                        <Grid ColumnDefinitions="30,*">
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource CombinedWash}"
                                                    BorderBrush="{DynamicResource CombinedWashRing}"
                                                    BorderThickness="1">
                                                <TextBlock Text="1" FontSize="12" FontWeight="ExtraBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                                <TextBlock Text="Задайте структуру" FontSize="13.5"
                                                           FontWeight="ExtraBold" Margin="0,5,0,0" />
                                                <TextBlock FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           LineHeight="21" MaxWidth="820"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Text="Укажите число книг и разворотов в шапке проекта и нажмите «Добавить структуру». Позже её можно дорастить или уменьшить." />
                                            </StackPanel>
                                        </Grid>
                                        <Rectangle Width="1" Height="14" Margin="14,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   Fill="{DynamicResource Accent}" Opacity="0.22" />
                                        <Grid ColumnDefinitions="30,*">
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource CombinedWash}"
                                                    BorderBrush="{DynamicResource CombinedWashRing}"
                                                    BorderThickness="1">
                                                <TextBlock Text="2" FontSize="12" FontWeight="ExtraBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                                <TextBlock Text="Загрузите фотографии" FontSize="13.5"
                                                           FontWeight="ExtraBold" Margin="0,5,0,0" />
                                                <TextBlock FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           LineHeight="21" MaxWidth="820"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Text="Перетащите файлы в зону слева или нажмите на неё. Снимок можно сразу перетащить в нужную ячейку." />
                                            </StackPanel>
                                        </Grid>
                                        <Rectangle Width="1" Height="14" Margin="14,0,0,0"
                                                   HorizontalAlignment="Left"
                                                   Fill="{DynamicResource Accent}" Opacity="0.22" />
                                        <Grid ColumnDefinitions="30,*">
                                            <Border Width="30" Height="30" CornerRadius="15"
                                                    VerticalAlignment="Top"
                                                    Background="{DynamicResource CombinedWash}"
                                                    BorderBrush="{DynamicResource CombinedWashRing}"
                                                    BorderThickness="1">
                                                <TextBlock Text="3" FontSize="12" FontWeight="ExtraBold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Accent}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="15,0,0,0">
                                                <TextBlock Text="Расставьте фотографии" FontSize="13.5"
                                                           FontWeight="ExtraBold" Margin="0,5,0,0" />
                                                <TextBlock FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                                           LineHeight="21" MaxWidth="820"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           Text="Обложку и общий разворот добавляйте сразу во все книги — так большие заказы собираются быстрее." />
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>

                                    <!--
                                        The same two counters the panel carries, here as well: the
                                        structure is decided on this card, so the numbers that
                                        decide it are within reach of the button that applies
                                        them. They are the very boxes of the panel - the same
                                        two properties of the same model - so a figure typed in
                                        either place is the figure both show.
                                    -->
                                    <Border Margin="0,20,0,0" Padding="0,18,0,0"
                                            BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="0,1,0,0">
                                        <WrapPanel Orientation="Horizontal">

                                            <StackPanel Spacing="6" Margin="0,0,12,0">
                                                <TextBlock Text="Книг" FontSize="10.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextFaint}" />
                                                <Border CornerRadius="12" BorderThickness="2"
                                                        BorderBrush="{Binding NumberOfBooksIsValid, Converter={StaticResource RunFieldFrame}}">
                                                    <Border Classes="stepperBox">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Classes="ghost stepperStep"
                                                                    AutomationProperties.Name="Меньше книг"
                                                                    ToolTip.Tip="Меньше книг"
                                                                    Command="{Binding DecreaseBooksCommand}">
                                                                <TextBlock Text="&#x2212;" FontSize="16" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Button>
                                                            <TextBox Classes="stepperValue"
                                                                     Text="{Binding NumberOfBooksText}"
                                                                     AutomationProperties.Name="Количество книг" />
                                                            <Button Classes="ghost stepperStep"
                                                                    AutomationProperties.Name="Больше книг"
                                                                    ToolTip.Tip="Больше книг"
                                                                    Command="{Binding IncreaseBooksCommand}">
                                                                <TextBlock Text="+" FontSize="16" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Spacing="6" Margin="0,0,12,0">
                                                <TextBlock Text="Разворотов" FontSize="10.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{DynamicResource TextFaint}" />
                                                <Border CornerRadius="12" BorderThickness="2"
                                                        BorderBrush="{Binding SpreadsPerBookIsValid, Converter={StaticResource RunFieldFrame}}">
                                                    <Border Classes="stepperBox">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Classes="ghost stepperStep"
                                                                    AutomationProperties.Name="Меньше разворотов"
                                                                    ToolTip.Tip="Меньше разворотов"
                                                                    Command="{Binding DecreaseSpreadsCommand}">
                                                                <TextBlock Text="&#x2212;" FontSize="16" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Button>
                                                            <TextBox Classes="stepperValue"
                                                                     Text="{Binding SpreadsPerBookText}"
                                                                     AutomationProperties.Name="Разворотов в книге" />
                                                            <Button Classes="ghost stepperStep"
                                                                    AutomationProperties.Name="Больше разворотов"
                                                                    ToolTip.Tip="Больше разворотов"
                                                                    Command="{Binding IncreaseSpreadsCommand}">
                                                                <TextBlock Text="+" FontSize="16" FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </Border>
                                            </StackPanel>

                                            <Button Classes="primary" VerticalAlignment="Bottom" Margin="0,0,14,0"
                                                    AutomationProperties.Name="Добавить структуру"
                                                    Command="{Binding ConfirmStructureCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <Path Width="10" Height="10" Stretch="Uniform" StrokeThickness="1.8"
                                                          StrokeLineCap="Round" StrokeJoin="Round"
                                                          Stroke="{DynamicResource ActionInk}"
                                                          Data="M12 5 V19 M5 12 H19" />
                                                    <TextBlock Text="{Binding StructureButtonText}" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource ActionInk}" />
                                                </StackPanel>
                                            </Button>

                                            <TextBlock Text="{Binding StarterHint}" FontSize="11.5"
                                                       VerticalAlignment="Bottom" Margin="0,0,0,15" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFaint}" />
                                        </WrapPanel>
                                    </Border>
                                </StackPanel>
                            </Panel>
                        </Border>

                        <!--
                            What the project will look like: the two things every book gets, and
                            one that comes later. It answers "what am I building" before the first
                            page exists, which is the question a first-run screen leaves open.
                        -->
                        <StackPanel Grid.Column="2" Spacing="16">
                            <Border Classes="card" CornerRadius="18" Padding="22">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="БУДУЩАЯ КНИГА" FontSize="10" FontWeight="ExtraBold"
                                                   LetterSpacing="1.6" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextFaint}" />
                                        <Border Grid.Column="1" CornerRadius="999" Padding="7,3"
                                                Background="{DynamicResource CombinedWash}"
                                                BorderBrush="{DynamicResource CombinedWashRing}"
                                                BorderThickness="1">
                                            <TextBlock Text="ЧЕРНОВИК" FontSize="9" FontWeight="ExtraBold"
                                                       LetterSpacing="0.8"
                                                       Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </Grid>

                                    <StackPanel Spacing="8" Margin="0,14,0,0">
                                        <Border CornerRadius="10" Padding="9,8,11,8"
                                                Background="{DynamicResource SunkenFaint}"
                                                BorderBrush="{DynamicResource BorderDefault}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="34,*,Auto">
                                                <Border Width="34" Height="26" CornerRadius="5"
                                                        Background="{DynamicResource CombinedWash}"
                                                        BorderBrush="{DynamicResource CombinedWashRing}"
                                                        BorderThickness="1">
                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                          Stroke="{DynamicResource Accent}"
                                                          Data="M 6 4.5 H 18 A 2.5 2.5 0 0 1 20.5 7 V 17 A 2.5 2.5 0 0 1 18 19.5 H 6 A 2.5 2.5 0 0 1 3.5 17 V 7 A 2.5 2.5 0 0 1 6 4.5 Z M 9 8.4 A 1.6 1.6 0 1 0 9 11.6 A 1.6 1.6 0 1 0 9 8.4 M 4.5 17 L 9.3 12.6 A 1.5 1.5 0 0 1 11.3 12.6 L 14.3 15.3 L 16.5 13.3 A 1.5 1.5 0 0 1 18.5 13.3 L 20.1 14.7" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Обложка" Margin="10,0,0,0"
                                                           FontSize="12" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDefault}" />
                                                <Border Grid.Column="2" CornerRadius="999" Padding="7,3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CombinedWash}"
                                                        BorderBrush="{DynamicResource CombinedWashRing}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="ОБЩИЙ" FontSize="9" FontWeight="ExtraBold"
                                                               LetterSpacing="0.8"
                                                               Foreground="{DynamicResource Accent}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border CornerRadius="10" Padding="9,8,11,8"
                                                Background="{DynamicResource SunkenFaint}"
                                                BorderBrush="{DynamicResource BorderDefault}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="34,*,Auto">
                                                <Border Width="34" Height="26" CornerRadius="5"
                                                        Background="{DynamicResource CombinedWash}"
                                                        BorderBrush="{DynamicResource CombinedWashRing}"
                                                        BorderThickness="1">
                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                          Stroke="{DynamicResource Accent}"
                                                          Data="M 6 4.5 H 18 A 2.5 2.5 0 0 1 20.5 7 V 17 A 2.5 2.5 0 0 1 18 19.5 H 6 A 2.5 2.5 0 0 1 3.5 17 V 7 A 2.5 2.5 0 0 1 6 4.5 Z M 9 8.4 A 1.6 1.6 0 1 0 9 11.6 A 1.6 1.6 0 1 0 9 8.4 M 4.5 17 L 9.3 12.6 A 1.5 1.5 0 0 1 11.3 12.6 L 14.3 15.3 L 16.5 13.3 A 1.5 1.5 0 0 1 18.5 13.3 L 20.1 14.7" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Разворот 1" Margin="10,0,0,0"
                                                           FontSize="12" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDefault}" />
                                                <!--
                                                    Assigned, and to this book alone: a quiet grey
                                                    pill. The gold one says the spread is shared by
                                                    every book, and a second gold would say the same
                                                    thing twice.
                                                -->
                                                <Border Grid.Column="2" CornerRadius="999" Padding="7,3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource Slate100}"
                                                        BorderBrush="{DynamicResource Slate200}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="НАЗНАЧЕН" FontSize="9" FontWeight="ExtraBold"
                                                               LetterSpacing="0.8"
                                                               Foreground="{DynamicResource Slate600}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border CornerRadius="10" Padding="9,8,11,8"
                                                Background="{DynamicResource SunkenFaint}"
                                                BorderBrush="{DynamicResource BorderDefault}"
                                                BorderThickness="1">
                                            <Grid ColumnDefinitions="34,*,Auto">
                                                <Border Width="34" Height="26" CornerRadius="5"
                                                        Background="{DynamicResource CombinedWash}"
                                                        BorderBrush="{DynamicResource CombinedWashRing}"
                                                        BorderThickness="1">
                                                    <Path Width="13" Height="13" Stretch="Uniform"
                                                          StrokeThickness="1.7" StrokeLineCap="Round" StrokeJoin="Round"
                                                          Stroke="{DynamicResource Accent}"
                                                          Data="M 6 4.5 H 18 A 2.5 2.5 0 0 1 20.5 7 V 17 A 2.5 2.5 0 0 1 18 19.5 H 6 A 2.5 2.5 0 0 1 3.5 17 V 7 A 2.5 2.5 0 0 1 6 4.5 Z M 9 8.4 A 1.6 1.6 0 1 0 9 11.6 A 1.6 1.6 0 1 0 9 8.4 M 4.5 17 L 9.3 12.6 A 1.5 1.5 0 0 1 11.3 12.6 L 14.3 15.3 L 16.5 13.3 A 1.5 1.5 0 0 1 18.5 13.3 L 20.1 14.7" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="Разворот 2" Margin="10,0,0,0"
                                                           FontSize="12" FontWeight="Bold"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextDefault}" />
                                                <Border Grid.Column="2" CornerRadius="999" Padding="7,3"
                                                        VerticalAlignment="Center"
                                                        Background="{DynamicResource CombinedWash}"
                                                        BorderBrush="{DynamicResource CombinedWashRing}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="ОБЩИЙ" FontSize="9" FontWeight="ExtraBold"
                                                               LetterSpacing="0.8"
                                                               Foreground="{DynamicResource Accent}" />
                                                </Border>
                                            </Grid>
                                        </Border>

                                        <Border CornerRadius="10" Padding="9,8,11,8" Opacity="0.72"
                                                Background="Transparent">
                                            <Panel>
                                                <Rectangle RadiusX="10" RadiusY="10" StrokeThickness="1"
                                                           StrokeDashArray="4,3"
                                                           Stroke="{DynamicResource BorderDefault}"
                                                           IsHitTestVisible="False" />
                                                <Grid ColumnDefinitions="34,*,Auto">
                                                    <Border Width="34" Height="26" CornerRadius="5"
                                                            Background="{DynamicResource CombinedWash}"
                                                            BorderBrush="{DynamicResource CombinedWashRing}"
                                                            BorderThickness="1">
                                                        <Path Width="13" Height="13" Stretch="Uniform"
                                                              StrokeThickness="1.9" StrokeLineCap="Round" StrokeJoin="Round"
                                                              Stroke="{DynamicResource Accent}"
                                                              Data="M12 5 V19 M5 12 H19" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="Разворот 3" Margin="10,0,0,0"
                                                               FontSize="12" FontWeight="Bold"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextDefault}" />
                                                    <TextBlock Grid.Column="2" Text="не назначен" FontSize="10"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextFaint}" />
                                                </Grid>
                                            </Panel>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="11.5"
                                               LineHeight="19"
                                               Foreground="{DynamicResource TextFaint}"
                                               Text="Развороты и книги добавляются в шапке проекта — структура не фиксируется навсегда." />
                                </StackPanel>
                            </Border>

                            <!--
                                A plain block like the one above it, not a wash: the advice used
                                to be a translucent tint over the page and was read as part of the
                                background rather than as the second card of the column. Same solid
                                fill the program uses for a surface that sits below a card.
                            -->
                            <Border CornerRadius="18" Padding="22"
                                    Background="{DynamicResource Surface}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="СОВЕТ" FontSize="10" FontWeight="ExtraBold"
                                               LetterSpacing="1.6"
                                               Foreground="{DynamicResource TextFaint}" />
                                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="12"
                                               FontWeight="Bold" LineHeight="20"
                                               Foreground="{DynamicResource TextDefault}"
                                               Text="Начните с обложки и общего разворота. Они повторяются во всех книгах, поэтому раскладку достаточно сделать один раз." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                    <!--
                        A card for each book, with the page showing between them.

                        It was one card for the whole run with a line drawn between the
                        books, on the reasoning that a column of separate cards reads as a
                        column of separate things. Checked against the released program at
                        full size: each book is its own card, the gap between them is the
                        page, and the gap is what says there is another book below before
                        anyone scrolls to find out.

                        A line drawn between two parts of one white field says there is a
                        boundary. It does not say what is on the other side of it.
                    -->
                    <Border IsVisible="{Binding HasStructure}">

                    <!--
                        Only the books near the viewport are built.

                        A fifty-book order is twenty-six thousand elements when every card is
                        laid out at once, and the screen took eight and a half seconds to
                        appear; more than half of that was the layout of cards nobody could
                        see yet. A book is a tall card in a column that is taller than the
                        window, so the column builds the ones it can show and the ones just
                        below them, and builds the rest as they are scrolled to.

                        The list is dressed as the plain cards it draws: no selection colour,
                        no hover, no border, no padding of its own, and a template that leaves
                        out the parts of a list row that are not a card. Its scroll bar is the
                        one this column already had.
                    -->
                    <ListBox ItemsSource="{Binding Books}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0,0,10,0"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <ControlTemplate>
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </ControlTemplate>
                                </Setter>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Padding="22,20,22,18" Margin="0,0,0,18">
                                <StackPanel>

                                        <!-- book header: the number IS the name -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Spacing="10" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Gold}"
                                                        CornerRadius="8" Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="Bold"
                                                               Foreground="{DynamicResource OnAccent}"
                                                               Text="{Binding BookIndex, StringFormat='Книга {0:D2}'}" />
                                                </Border>
                                                <!-- Green once the book is full. Bound to IsFilled,
                                                     not to the book: bound to the book the colour
                                                     was decided when the card was built, so
                                                     "Готово 8 из 8" stayed red. -->
                                                <TextBlock Text="{Binding ProgressText}"
                                                           Classes="t12" VerticalAlignment="Center"
                                                           FontWeight="{Binding IsFilled, Converter={StaticResource PageState}, ConverterParameter=filledsemi}"
                                                           Foreground="{Binding IsFilled, Converter={StaticResource PageState}, ConverterParameter=filledbrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="icon"
                                                        AutomationProperties.Name="Дублировать книгу"
                                                        ToolTip.Tip="Дублировать книгу"
                                                        Click="OnDuplicateBookClick">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" />
                                                </Button>
                                                <Button Classes="icon"
                                                        AutomationProperties.Name="Удалить книгу"
                                                        ToolTip.Tip="Удалить книгу"
                                                        Click="OnDeleteBookClick">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- slots: measured width, so a wrapping panel -->
                                        <ItemsControl ItemsSource="{Binding AllSlotsPages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Name="SlotCard" Classes="slotCard"
                                                            Margin="0,0,16,16"
                                                            PointerPressed="OnSlotPressed"
                                                            PointerEntered="OnSlotPointerEntered"
                                                            PointerExited="OnSlotPointerExited"
                                                            BorderBrush="{Binding Converter={StaticResource PageCaption}, ConverterParameter=border}"
                                                            BorderThickness="{Binding Converter={StaticResource PageCaption}, ConverterParameter=borderthickness}">
                                                        <!--
                                                            The card draws its frame and clips
                                                            nothing; the frame host below rounds
                                                            its own top corners.

                                                            One border did both, and the
                                                            photograph's square corner lay over
                                                            the inside half of the stroke, so the
                                                            line was cut off exactly where it
                                                            turned - and the cover, whose stroke
                                                            is two pixels of colour rather than a
                                                            hairline, showed it worst. Only the
                                                            top two corners are round: the
                                                            caption sits under the photograph on
                                                            white, and rounding the bottom two
                                                            would show that white through it.
                                                        -->
                                                        <Grid>

                                                            <!--
                                                                Pinned to the frame's own width. Without it the
                                                                card is only as wide as its widest child,
                                                                and revealing "to all books" pushed the card
                                                                wider and the row reflowed. The frame is the
                                                                sizing authority; nothing may outvote it.

                                                                The width is the slots' own row, not the
                                                                scroller with a reserve taken off it: a hand-picked
                                                                reserve was out by ten pixels, and ten pixels is
                                                                a whole card.
                                                            -->
                                                            <Grid.Width>
                                                                <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                              ConverterParameter="width,150">
                                                                    <Binding Path="Bounds.Width"
                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    <Binding Path="FrameAspect" />
                                                                </MultiBinding>
                                                            </Grid.Width>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True"
                                                                    Background="{DynamicResource Slate100}">
                                                                <Grid>
                                                                <Grid.Width>
                                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                                  ConverterParameter="width,150">
                                                                        <Binding Path="Bounds.Width"
                                                                               RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        <Binding Path="FrameAspect" />
                                                                    </MultiBinding>
                                                                </Grid.Width>
                                                                <Grid.Height>
                                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                                  ConverterParameter="height,150">
                                                                        <Binding Path="Bounds.Width"
                                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        <Binding Path="FrameAspect" />
                                                                    </MultiBinding>
                                                                </Grid.Height>

                                                                <Image x:Name="SlotPhoto" Stretch="UniformToFill"
                                                                       IsHitTestVisible="False"
                                                                       IsVisible="{Binding IsEmpty, Converter={StaticResource PageState}, ConverterParameter=hasphoto}">
                                                                    <Image.Source>
                                                                        <MultiBinding Converter="{StaticResource PageToBitmap}" ConverterParameter="360">
                                                                            <Binding />
                                                                            <Binding Path="SourcePath" />
                                                                            <Binding Path="ThumbnailPath" />
                                                                        </MultiBinding>
                                                                    </Image.Source>
                                                                </Image>

                                                                <!-- empty: dashed frame, a plus in a circle and
                                                                     what this slot is waiting for -->
                                                                <Grid IsVisible="{Binding IsEmpty, Converter={StaticResource PageState}, ConverterParameter=empty}">
                                                                    <!--
                                                                        Dashed, not drawn. A solid frame around an empty slot reads as a
                                                                        finished thing with a hole in it; a broken one reads as "put
                                                                        something here", which is the whole message of the frame.
                                                                        The shape is its own so the dashes follow the rounded corner.
                                                                    -->
                                                                    <Rectangle RadiusX="7" RadiusY="7"
                                                                       StrokeThickness="1.5"
                                                                       StrokeDashArray="5,4"
                                                                       Stroke="{DynamicResource Slate300}"
                                                                       Margin="4" IsHitTestVisible="False" />
                                                                    <StackPanel VerticalAlignment="Center"
                                                                                HorizontalAlignment="Center">
                                                                        <!-- The plus sits in a disc, as on the other side of the port: a
                                                                             bare glyph floating over the dashes read as a stray mark. -->
                                                                        <Border Width="28" Height="28" CornerRadius="14"
                                                                                Background="{DynamicResource Slate100}"
                                                                                HorizontalAlignment="Center">
                                                                            <TextBlock Text="&#xE710;"
                                                                                       FontFamily="Segoe MDL2 Assets"
                                                                                       FontSize="12"
                                                                                       Foreground="{DynamicResource Slate400}"
                                                                                       HorizontalAlignment="Center"
                                                                                       VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock Foreground="{DynamicResource Slate600}"
                                                                                   TextAlignment="Center"
                                                                                   Margin="0,9,0,0"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   Text="{Binding IsCover, Converter={StaticResource PageState}, ConverterParameter=slotempty}" />
                                                                        <TextBlock Text="Перетащите сюда фото"
                                                                                   Classes="t10"
                                                                                   Foreground="{DynamicResource Slate400}"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!--
                                                                    A photograph is in this slot but nothing could be
                                                                    read from disk. Shown instead of an empty grey
                                                                    frame, because an empty frame is
                                                                    indistinguishable from an empty slot - and that
                                                                    is how "the photographs fell off" went unnoticed
                                                                    for a day. The path is in the tooltip.
                                                                -->
                                                                <StackPanel VerticalAlignment="Center"
                                                                            HorizontalAlignment="Center" Margin="8"
                                                                            IsVisible="{Binding HasImage, Converter={StaticResource PageState}, ConverterParameter=imageerror}"
                                                                            ToolTip.Tip="{Binding SourcePath}">
                                                                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="18"
                                                                               Foreground="{DynamicResource Red500}"
                                                                               HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Файл не читается"
                                                                               Classes="t10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource Red600}"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,6,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                                </Border>

                                                            <!--
                                                                Footer: what this slot is on the left, what you
                                                                can do with it on the right. The label and the
                                                                "to all books" word share ONE cell and replace
                                                                each other; side by side they needed about 150px
                                                                of footer, which is why the card could not shrink.
                                                            -->
                                                            <Border Grid.Row="1" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource Slate100}"
                                                                    Padding="10,7,8,8">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <Grid Grid.Column="0" Margin="0,0,6,0">
                                                                        <TextBlock Name="SlotLabelText"
                                                                                   Classes="t11"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip.Tip="{Binding SourcePath}"
                                                                                   Text="{Binding SlotLabel}"
                                                                                   FontWeight="{Binding IsSlotLabelAccent, Converter={StaticResource PageState}, ConverterParameter=slotweight}"
                                                                                   Foreground="{Binding IsSlotLabelAccent, Converter={StaticResource PageState}, ConverterParameter=slotbrush}" />

                                                                        <!-- A word, not an icon: putting a photograph
                                                                             into the whole run is the one action a
                                                                             photographer has to be sure about, so it
                                                                             says what it does. -->
                                                                        <TextBlock Name="ApplyToAllText" Text="Во все книги"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource Brand600}"
                                                                                   VerticalAlignment="Center"
                                                                                   Cursor="Hand"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   IsVisible="False"
                                                                                   ToolTip.Tip="Поставить это фото в ту же позицию всех книг"
                                                                                   PointerPressed="OnApplyToAllClick" />
                                                                    </Grid>

                                                                    <!-- clear the slot: always visible -->
                                                                    <Button Grid.Column="1" Classes="icon"
                                                                            Padding="0" Width="22" Height="22"
                                                                            AutomationProperties.Name="Очистить слот"
                                                                            ToolTip.Tip="Убрать фото из слота"
                                                                            Click="OnClearSlotClick"
                                                                            IsVisible="{Binding IsEmpty, Converter={StaticResource PageState}, ConverterParameter=hasphoto}">
                                                                        <TextBlock Text="&#xE74D;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource Red500}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
