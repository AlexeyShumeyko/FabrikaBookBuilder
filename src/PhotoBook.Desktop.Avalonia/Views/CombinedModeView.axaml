<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:PhotoBook.Shell.Views"
             x:Class="PhotoBook.Shell.Views.CombinedModeView"
             FontFamily="Inter">

    <!--
        The combined screen, transcribed from doc\DESIGN_SPEC.md section 6 and checked
        number by number against the other shell's markup. It is the largest screen in the
        product: a control panel, a file list and a column of books, all at once.

            shell        max 1600, margin 32/24
            panel        card, padding 20; badge 48 with a 20 glyph; two star columns
                         either side of the run fields, so the run stays in the middle
                         whatever the window does
            run fields   two number boxes, 64 wide, 12px, labels above in 10px slate
            file column  320 (280-360), card, padding 16
            drop zone    14 corner, slate-50, dashed line of its own shape at 13 inside
            book cards   card, padding 20, 16 below; the number IS the name, so a run of
                         forty books reads as forty named things and not as a table
            slot         radius 12, margin 0/0/16/16, cover framed at 2px in the product
                         colour, everything else a hairline
            slot frame   150 tall - not the 190 the folders screen uses, because this one
                         shares the window with a 320px file list - and as wide as the
                         book's own format, both sides scaling together when one more card
                         per row is within reach

        Four departures, each written down rather than quietly copied:

        1. The photo fits its frame rather than being cropped to it, as on the folders
           screen. A crop throws away the edges a photographer chose.
        2. The label and the "to all books" action replace one another, driven from the code
           behind rather than by a trigger. There is no way in this engine to hide one child
           because its parent is hovered.
        3. The zoom on hover is done by setting the transform in the same place, for the
           same reason.
        4. The photo's own frame is 150 tall and the design height for this mode is a
           parameter of the size converter, so the two can never disagree.
    -->

    <UserControl.Styles>
        <!--
            The upload zone answers the pointer.

            It used to be a grey box with a dashed line in it, and nothing happened when
            the pointer went over it - so the one place on the screen that takes files
            looked the same as the one place that does not. The line takes the product's
            colour, the box takes a tint of it, and the mark goes a shade darker, all of
            it over a moment rather than at once: a zone that brightens when the pointer
            arrives says "here", and a zone that does not say nothing at all.

            The colours live here and not on the elements. A value set on the element
            itself beats a style, so a colour written down in the markup could never be
            changed by the style that answers the pointer - which is why the first version
            of this did nothing at all.
        -->
        <Style Selector="Border#DropZone">
            <Setter Property="Background" Value="{DynamicResource Slate50}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border#DropZone:pointerover">
            <Setter Property="Background" Value="{DynamicResource Brand50}" />
        </Style>

        <Style Selector="Rectangle#DropZoneFrame">
            <Setter Property="Stroke" Value="{DynamicResource Slate300}" />
        </Style>

        <Style Selector="Border#DropZone:pointerover Rectangle#DropZoneFrame">
            <Setter Property="Stroke" Value="{DynamicResource Brand400}" />
        </Style>

        <Style Selector="Path#DropZoneMark">
            <Setter Property="Stroke" Value="{DynamicResource Brand500}" />
        </Style>

        <Style Selector="Border#DropZone:pointerover Path#DropZoneMark">
            <Setter Property="Stroke" Value="{DynamicResource Brand600}" />
        </Style>
    </UserControl.Styles>

    <Grid MaxWidth="1600" Margin="32,24" HorizontalAlignment="Stretch"
          RowDefinitions="Auto,Auto,*">

        <!-- ================================ error ================================ -->
        <Border Grid.Row="0" Background="{DynamicResource Red50}"
                BorderBrush="{DynamicResource Red200}" BorderThickness="1"
                CornerRadius="12" Padding="16" Margin="0,0,0,16"
                VerticalAlignment="Top"
                IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}">
            <TextBlock Text="{Binding ErrorMessage}" Classes="t12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Red700}" />
        </Border>

        <!-- ============================ control panel ============================ -->
        <Border Grid.Row="1" Classes="card" Padding="20" Margin="0,0,0,24">
            <Grid MinHeight="52">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- left: the badge, the name, one line of state -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14"
                            VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center"
                            Background="{DynamicResource Indigo50}"
                            BorderBrush="{DynamicResource Indigo100}" BorderThickness="1"
                            BoxShadow="0 1 4 0 #0D0F172A">
                        <Path Width="20" Height="20" Stretch="Uniform"
                              Stroke="{DynamicResource Indigo600}" StrokeThickness="1.7"
                              StrokeLineCap="Round"
                              Data="M 5 5.5 V 19 M 9.5 4 V 19 M 14 6.5 V 19 M 18 8.5 V 19 M 3.4 19 H 20" />
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Проект:" Classes="t14Bold" VerticalAlignment="Center" />
                            <TextBlock Name="ProjectNameTextBlock" Classes="t14Bold"
                                       Text="{Binding DisplayProjectName}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="420" Cursor="Hand"
                                       PointerPressed="OnProjectNameClick" />
                            <Button Classes="icon" Padding="4,4" Margin="6,0,0,0"
                                    AutomationProperties.Name="Переименовать проект"
                                    ToolTip.Tip="Переименовать проект"
                                    Click="OnProjectNamePencilClick">
                                <Path Width="13" Height="13" Stretch="Uniform"
                                      Stroke="{DynamicResource Slate500}" StrokeThickness="1.7"
                                      StrokeLineCap="Round"
                                      Data="M 4 20 L 4 15.5 L 15.5 4 L 20 8.5 L 8.5 20 Z M 13.5 6 L 18 10.5" />
                            </Button>

                            <!-- 240 and not 360: this panel also carries the run fields,
                                 and the wider box ran out of room and was cut in half
                                 mid-word. -->
                            <TextBox Name="ProjectNameTextBox" Width="240" FontSize="13"
                                     Margin="6,0,0,0" VerticalAlignment="Center"
                                     IsVisible="False"
                                     KeyDown="OnProjectNameKeyDown"
                                     LostFocus="OnProjectNameLostFocus" />
                        </StackPanel>

                        <!-- Red while the run still has books to finish, green when it is
                             done. Muted on purpose: this is a state, not an alarm. -->
                        <TextBlock Classes="t12" Margin="0,2,0,0"
                                   Text="{Binding StructureProgress}"
                                   Foreground="{Binding StructureIsComplete, Converter={StaticResource PageState}, ConverterParameter=structurecomplete}" />
                    </StackPanel>
                </StackPanel>

                <!-- centre: the run. Labels on one line, the fields and the button on the next.

                     It used to be a row of stacks - label over field, label over field,
                     and a button aligned to the bottom - so the button sat against the
                     bottom of the boxes while their labels were above them, and the
                     three things a person reads together were on three different
                     levels. Two rows and one grid: the labels on one line, the boxes and
                     the button on the next, all sharing it. -->
                <Grid Grid.Column="1" Margin="24,0" VerticalAlignment="Center"
                      RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,Auto,Auto">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Книг" Classes="t10"
                               Margin="0,0,10,5"
                               Foreground="{DynamicResource Slate500}" />
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Разворотов" Classes="t10"
                               Margin="0,0,10,5"
                               Foreground="{DynamicResource Slate500}" />

                    <TextBox Grid.Row="1" Grid.Column="0" Classes="numberField"
                             Margin="0,0,10,0" VerticalAlignment="Center"
                             Text="{Binding NumberOfBooks}"
                             AutomationProperties.Name="Количество книг" />
                    <TextBox Grid.Row="1" Grid.Column="1" Classes="numberField"
                             Margin="0,0,16,0" VerticalAlignment="Center"
                             Text="{Binding SpreadsPerBook}"
                             AutomationProperties.Name="Разворотов в книге" />

                    <!-- One button, two labels. A second button appearing with the first
                         book is exactly what used to reshape this panel. -->
                    <Button Grid.Row="1" Grid.Column="2" Classes="primary"
                            Padding="16,10" VerticalAlignment="Center"
                            AutomationProperties.Name="Добавить структуру"
                            Command="{Binding ConfirmStructureCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round"
                                  Data="M 12 5 V 19 M 5 12 H 19" />
                            <TextBlock Text="{Binding StructureButtonText}" Foreground="White" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- right: what you do with the project -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <!-- The same button the folders screen has: white, a hairline, a small
                         shadow. A flat grey slab on a white card read as a disabled thing
                         next to the violet one, and the two were not the same kind of
                         button at all. -->
                    <Button Classes="outline" Padding="14,10"
                            AutomationProperties.Name="Сохранить проект"
                            ToolTip.Tip="Сохранить проект и вернуться к списку проектов"
                            Command="{Binding SaveProjectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{DynamicResource Slate400}" StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  Data="M 12 3.2 V 14.4 M 8.2 10.8 L 12 14.6 L 15.8 10.8 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                            <TextBlock Text="Сохранить проект" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{DynamicResource Slate200}"
                            VerticalAlignment="Center" />

                    <Button Classes="primary" Padding="16,10"
                            AutomationProperties.Name="Экспортировать все книги"
                            ToolTip.Tip="Выгрузка всех книг проекта в одну папку"
                            Command="{Binding ExportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Width="14" Height="14" Stretch="Uniform"
                                  Stroke="White" StrokeThickness="1.8" StrokeLineCap="Round"
                                  Data="M 12 14.8 V 3.6 M 8.2 7.4 L 12 3.6 L 15.8 7.4 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                            <TextBlock Text="Экспортировать все книги" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================= two areas, equal height ==================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="360" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- ========================== the file list =========================== -->
            <Border Grid.Column="0" Classes="card" Padding="16">
                <Grid RowDefinitions="Auto,Auto,*">

                    <!-- title and how many are loaded -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Загруженные фото" Classes="t14Bold" />
                        <TextBlock Classes="t12" Margin="0,2,0,0"
                                   Foreground="{DynamicResource Slate500}"
                                   Text="{Binding AvailableFilesCount, StringFormat='Загружено: {0}'}" />
                    </StackPanel>

                    <!--
                        ONE way in, not two: the zone is clickable and accepts a drop, so a
                        separate button was the same action twice.

                        ONE outline, and it is the zone's own shape: the dashed line sits on
                        the rounded corner - 13 inside a 14 - instead of floating in the
                        middle of a square grey box.
                    -->
                    <Border x:Name="DropZone" Grid.Row="1" Margin="0,14,0,0" Cursor="Hand"
                            CornerRadius="14"
                            PointerPressed="OnUploadAreaClick"
                            AutomationProperties.Name="Загрузить фото">
                        <Grid Margin="2">
                            <Rectangle x:Name="DropZoneFrame" RadiusX="13" RadiusY="13" StrokeThickness="1.5"
                                       StrokeDashArray="5,4"
                                       IsHitTestVisible="False" />
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="18,22">
                                <!--
                                    A cloud with an arrow going into it, drawn rather than
                                    fetched from an icon font. The mark on the zone says
                                    what the zone is for - files go in here - and the
                                    earlier one was an arrow over a line, which says the
                                    same thing less clearly and is a glyph from a font
                                    that has no business being here.
                                -->
                                <Path x:Name="DropZoneMark" Width="34" Height="34" Stretch="Uniform"
                                      StrokeThickness="1.6" StrokeLineCap="Round"
                                      Data="M 7 19.5 A 4 4 0 0 1 7.6 11.6 A 5.2 5.2 0 0 1 17.4 10.4 A 3.9 3.9 0 0 1 20.4 17.4 A 3.1 3.1 0 0 1 19.6 20.4 H 8 A 3 3 0 0 1 7 19.5 Z M 13 21.5 V 13.5 M 10.4 16.1 L 13 13.5 L 15.6 16.1" />
                                <TextBlock Text="Перетащите снимки сюда" Classes="t12Semi"
                                           Foreground="{DynamicResource Slate700}"
                                           HorizontalAlignment="Center" Margin="0,9,0,0" />
                                <TextBlock Text="или нажмите, чтобы выбрать · JPG, PNG до 50MB"
                                           Classes="t10" Foreground="{DynamicResource Slate400}"
                                           HorizontalAlignment="Center" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- search, then the rows -->
                    <Grid Grid.Row="2" Margin="0,14,0,0" MinHeight="0"
                          RowDefinitions="Auto,*">
                        <TextBox Grid.Row="0" Classes="searchField" Margin="0,0,0,8"
                                 Text="{Binding PhotoSearch}"
                                 AutomationProperties.Name="Поиск по имени файла"
                                 Watermark="Поиск по имени файла" />

                        <!--
                            A virtualizing list, and no scroller around it. That second part
                            is the whole performance story: a scroller whose content is
                            itself a scrolling list hands the inner one an infinite viewport,
                            the inner list then builds every row, and the first paint of a
                            hundred photographs took 1.9 seconds.
                        -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding FilteredPhotoFiles}"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Margin="0" MinWidth="0" Focusable="False"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,2" CornerRadius="10" Padding="8"
                                            Background="Transparent"
                                            PointerPressed="OnFileItemClick"
                                            ToolTip.Tip="{Binding Path}">

                                        <!-- No tint on the row: the state is read off the
                                             badge, and a wash over the whole 320px row is
                                             invisible at a glance. A frame is not. -->
                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                            <Border Grid.Column="0" Width="44" Height="44"
                                                    CornerRadius="8" ClipToBounds="True"
                                                    Background="{DynamicResource Slate100}">
                                                <Image Stretch="UniformToFill"
                                                       Source="{Binding Path, Converter={StaticResource FilePathToBitmap}, ConverterParameter=88}" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="8,0,8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Classes="t12Medium"
                                                           Foreground="{DynamicResource Slate700}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip.Tip="{Binding Name}" />
                                                <TextBlock Text="{Binding DimensionsText}"
                                                           Classes="t11"
                                                           Foreground="{DynamicResource Slate400}" />
                                            </StackPanel>

                                            <!-- free / used / run-wide: one solid colour per
                                                 state, white text on it, no frame -->
                                            <Border Grid.Column="2" CornerRadius="6"
                                                    Padding="8,3" VerticalAlignment="Center"
                                                    Background="{Binding Usage, Converter={StaticResource PhotoUsageBrush}}">
                                                <TextBlock Text="{Binding UsageText}" FontSize="10"
                                                           FontWeight="SemiBold"
                                                           Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============================= the books ============================= -->
            <!--
                No card around the whole column. A white field holding every book, with
                another white field inside it per book, reads as one single object with
                rows in it - a table, not a stack of books. Each book is a card and the
                space between cards is the background, so "there is one more book below" is
                something you see rather than read.
            -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>

                    <!--
                        Empty state: no structure yet. An empty project used to show three
                        lines of text and a shrug, which left a first-time user with no idea
                        what to press first - the structure controls are up in the control
                        panel, far from this card. It is the three steps of the mode, in
                        order, with the step that comes next marked as such.
                    -->
                    <Border Classes="card" Padding="28" MaxWidth="600" Margin="0,40,0,0"
                            HorizontalAlignment="Center"
                            IsVisible="{Binding !HasStructure}">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="16"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Brand50}">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="24" Foreground="{DynamicResource Brand600}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Соберите первые книги" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"
                                       TextAlignment="Center" />
                            <TextBlock Classes="t12" TextAlignment="Center" TextWrapping="Wrap"
                                       MaxWidth="460" HorizontalAlignment="Center" Margin="0,8,0,0"
                                       Foreground="{DynamicResource Slate500}"
                                       Text="Книги собираются вручную: структуру задаёте вы, фотографии раскладываете по ячейкам. Три шага:" />

                            <StackPanel Margin="0,20,0,0">
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8"
                                            Background="{DynamicResource Brand600}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="1" FontSize="12" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Задайте структуру" Classes="t12Semi" />
                                        <TextBlock Classes="t12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Slate500}"
                                                   Text="В панели управления укажите число книг и число разворотов — одинаковое для всех книг — и нажмите «Добавить структуру». Потом её можно дорастить или уменьшить." />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" Margin="0,0,0,14">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8"
                                            Background="{DynamicResource Slate200}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="2" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource Slate600}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Загрузите фотографии" Classes="t12Semi" />
                                        <TextBlock Classes="t12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Slate500}"
                                                   Text="Кнопкой «Загрузить фото», перетаскиванием в зону загрузки — или сразу в нужную ячейку. Файлы, оставшиеся в списке слева, ставятся в слоты перетаскиванием." />
                                    </StackPanel>
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8"
                                            Background="{DynamicResource Slate200}"
                                            VerticalAlignment="Top">
                                        <TextBlock Text="3" FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource Slate600}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Text="Расставьте фотографии" Classes="t12Semi" />
                                        <TextBlock Classes="t12" TextWrapping="Wrap" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Slate500}"
                                                   Text="Перетащите фото в нужную ячейку. Если разворот или обложка повторяется во всех книгах, добавьте его сразу во все книги одним действием — так большие заказы собираются быстрее." />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--
                        A card for each book, with the page showing between them.

                        It was one card for the whole run with a line drawn between the
                        books, on the reasoning that a column of separate cards reads as a
                        column of separate things. Checked against the released program at
                        full size: each book is its own card, the gap between them is the
                        page, and the gap is what says there is another book below before
                        anyone scrolls to find out.

                        A line drawn between two parts of one white field says there is a
                        boundary. It does not say what is on the other side of it.
                    -->
                    <Border IsVisible="{Binding HasStructure}">

                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Classes="card" Padding="20" Margin="0,0,0,16">
                                <StackPanel>

                                        <!-- book header: the number IS the name -->
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Spacing="10" VerticalAlignment="Center">
                                                <Border Background="{DynamicResource Brand600}"
                                                        CornerRadius="8" Padding="10,4"
                                                        VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="Bold"
                                                               Foreground="White"
                                                               Text="{Binding BookIndex, StringFormat='Книга {0:D2}'}" />
                                                </Border>
                                                <TextBlock Text="{Binding ProgressText}"
                                                           Classes="t12" VerticalAlignment="Center"
                                                           FontWeight="{Binding IsFilled, Converter={StaticResource PageState}, ConverterParameter=filledsemi}"
                                                           Foreground="{Binding Converter={StaticResource PageState}, ConverterParameter=filledbrush}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        Spacing="4" VerticalAlignment="Center">
                                                <Button Classes="icon"
                                                        AutomationProperties.Name="Дублировать книгу"
                                                        ToolTip.Tip="Дублировать книгу"
                                                        Click="OnDuplicateBookClick">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" />
                                                </Button>
                                                <Button Classes="icon"
                                                        AutomationProperties.Name="Удалить книгу"
                                                        ToolTip.Tip="Удалить книгу"
                                                        Click="OnDeleteBookClick">
                                                    <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- slots: measured width, so a wrapping panel -->
                                        <ItemsControl ItemsSource="{Binding AllSlotsPages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Name="SlotCard" Classes="slotCard"
                                                            Margin="0,0,16,16"
                                                            PointerPressed="OnSlotPressed"
                                                            PointerEntered="OnSlotPointerEntered"
                                                            PointerExited="OnSlotPointerExited"
                                                            BorderBrush="{Binding Converter={StaticResource PageCaption}, ConverterParameter=border}"
                                                            BorderThickness="{Binding Converter={StaticResource PageCaption}, ConverterParameter=borderthickness}">
                                                        <!--
                                                            The card draws its frame and clips
                                                            nothing; the frame host below rounds
                                                            its own top corners.

                                                            One border did both, and the
                                                            photograph's square corner lay over
                                                            the inside half of the stroke, so the
                                                            line was cut off exactly where it
                                                            turned - and the cover, whose stroke
                                                            is two pixels of colour rather than a
                                                            hairline, showed it worst. Only the
                                                            top two corners are round: the
                                                            caption sits under the photograph on
                                                            white, and rounding the bottom two
                                                            would show that white through it.
                                                        -->
                                                        <Grid>

                                                            <!--
                                                                Pinned to the frame's own width. Without it the
                                                                card is only as wide as its widest child,
                                                                and revealing "to all books" pushed the card
                                                                wider and the row reflowed. The frame is the
                                                                sizing authority; nothing may outvote it.

                                                                The width is the slots' own row, not the
                                                                scroller with a reserve taken off it: a hand-picked
                                                                reserve was out by ten pixels, and ten pixels is
                                                                a whole card.
                                                            -->
                                                            <Grid.Width>
                                                                <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                              ConverterParameter="width,150">
                                                                    <Binding Path="Bounds.Width"
                                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                    <Binding />
                                                                </MultiBinding>
                                                            </Grid.Width>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>

                                                            <Border Grid.Row="0" CornerRadius="12,12,0,0" ClipToBounds="True"
                                                                    Background="{DynamicResource Slate100}">
                                                                <Grid>
                                                                <Grid.Width>
                                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                                  ConverterParameter="width,150">
                                                                        <Binding Path="Bounds.Width"
                                                                               RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        <Binding />
                                                                    </MultiBinding>
                                                                </Grid.Width>
                                                                <Grid.Height>
                                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSize}"
                                                                                  ConverterParameter="height,150">
                                                                        <Binding Path="Bounds.Width"
                                                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                                        <Binding />
                                                                    </MultiBinding>
                                                                </Grid.Height>

                                                                <Image x:Name="SlotPhoto" Stretch="UniformToFill"
                                                                       IsHitTestVisible="False"
                                                                       IsVisible="{Binding Converter={StaticResource PageState}, ConverterParameter=hasphoto}"
                                                                       Source="{Binding Converter={StaticResource PageToBitmap}, ConverterParameter=360}" />

                                                                <!-- empty: dashed frame, a plus in a circle and
                                                                     what this slot is waiting for -->
                                                                <Grid IsVisible="{Binding Converter={StaticResource PageState}, ConverterParameter=empty}">
                                                                    <!--
                                                                        Dashed, not drawn. A solid frame around an empty slot reads as a
                                                                        finished thing with a hole in it; a broken one reads as "put
                                                                        something here", which is the whole message of the frame.
                                                                        The shape is its own so the dashes follow the rounded corner.
                                                                    -->
                                                                    <Rectangle RadiusX="7" RadiusY="7"
                                                                       StrokeThickness="1.5"
                                                                       StrokeDashArray="5,4"
                                                                       Stroke="{DynamicResource Slate300}"
                                                                       Margin="4" IsHitTestVisible="False" />
                                                                    <StackPanel VerticalAlignment="Center"
                                                        HorizontalAlignment="Center">
                                                                        <TextBlock Text="&#xE710;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="14"
                                                                                   Foreground="{DynamicResource Slate400}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBlock Foreground="{DynamicResource Slate600}"
                                                                                   TextAlignment="Center"
                                                                                   Margin="0,8,0,0"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   Text="{Binding IsCover, Converter={StaticResource PageState}, ConverterParameter=slotempty}" />
                                                                        <TextBlock Text="Перетащите сюда фото"
                                                                                   Classes="t10"
                                                                                   Foreground="{DynamicResource Slate400}"
                                                                                   HorizontalAlignment="Center"
                                                                                   Margin="0,2,0,0" />
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!--
                                                                    A photograph is in this slot but nothing could be
                                                                    read from disk. Shown instead of an empty grey
                                                                    frame, because an empty frame is
                                                                    indistinguishable from an empty slot - and that
                                                                    is how "the photographs fell off" went unnoticed
                                                                    for a day. The path is in the tooltip.
                                                                -->
                                                                <StackPanel VerticalAlignment="Center"
                                                                            HorizontalAlignment="Center" Margin="8"
                                                                            IsVisible="{Binding Converter={StaticResource PageState}, ConverterParameter=imageerror}"
                                                                            ToolTip.Tip="{Binding SourcePath}">
                                                                    <TextBlock Text="&#xE783;" FontFamily="Segoe MDL2 Assets"
                                                                               FontSize="18"
                                                                               Foreground="{DynamicResource Red500}"
                                                                               HorizontalAlignment="Center" />
                                                                    <TextBlock Text="Файл не читается"
                                                                               Classes="t10" FontWeight="Bold"
                                                                               Foreground="{DynamicResource Red600}"
                                                                               HorizontalAlignment="Center"
                                                                               Margin="0,6,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                                </Border>

                                                            <!--
                                                                Footer: what this slot is on the left, what you
                                                                can do with it on the right. The label and the
                                                                "to all books" word share ONE cell and replace
                                                                each other; side by side they needed about 150px
                                                                of footer, which is why the card could not shrink.
                                                            -->
                                                            <Border Grid.Row="1" BorderThickness="0,1,0,0"
                                                                    BorderBrush="{DynamicResource Slate100}"
                                                                    Padding="10,7,8,8">
                                                                <Grid ColumnDefinitions="*,Auto">
                                                                    <Grid Grid.Column="0" Margin="0,0,6,0">
                                                                        <TextBlock Name="SlotLabelText"
                                                                                   Classes="t11"
                                                                                   VerticalAlignment="Center"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip.Tip="{Binding SourcePath}"
                                                                                   Text="{Binding SlotLabel}"
                                                                                   Foreground="{Binding Converter={StaticResource PageCaption}, ConverterParameter=brush}" />

                                                                        <!-- A word, not an icon: putting a photograph
                                                                             into the whole run is the one action a
                                                                             photographer has to be sure about, so it
                                                                             says what it does. -->
                                                                        <TextBlock Name="ApplyToAllText" Text="Во все книги"
                                                                                   FontSize="11" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource Brand600}"
                                                                                   VerticalAlignment="Center"
                                                                                   Cursor="Hand"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   IsVisible="False"
                                                                                   ToolTip.Tip="Поставить это фото в ту же позицию всех книг"
                                                                                   PointerPressed="OnApplyToAllClick" />
                                                                    </Grid>

                                                                    <!-- clear the slot: always visible -->
                                                                    <Button Grid.Column="1" Classes="icon"
                                                                            Padding="0" Width="22" Height="22"
                                                                            AutomationProperties.Name="Очистить слот"
                                                                            ToolTip.Tip="Убрать фото из слота"
                                                                            Click="OnClearSlotClick"
                                                                            IsVisible="{Binding Converter={StaticResource PageState}, ConverterParameter=hasphoto}">
                                                                        <TextBlock Text="&#xE74D;"
                                                                                   FontFamily="Segoe MDL2 Assets"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource Red500}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
