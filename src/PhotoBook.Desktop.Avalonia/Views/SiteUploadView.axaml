<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotoBook.Shell.Views.SiteUploadView"
             FontFamily="Inter">

    <!--
        The upload screen is the only place in the program that writes to the site. It shows
        what is about to be sent, how far it got, and what the site holds afterwards; the button
        that starts the run is here and nowhere else.
    -->
    <Grid RowDefinitions="Auto,*" Margin="32,16">
        <Border Grid.Row="0" Classes="card" Padding="20,16" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="Отправка на сайт" Classes="t20Bold" />
                    <TextBlock Text="{Binding ProgressText}" Classes="t12"
                               Foreground="{DynamicResource Slate500}" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="2" HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding Uploaded}" Classes="t14SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="страниц отправлено" Classes="t11"
                               Foreground="{DynamicResource Slate500}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="outline" Padding="12,10"
                            IsEnabled="{Binding CanCancel}"
                            AutomationProperties.Name="Остановить"
                            Click="OnCancel">
                        <TextBlock Text="Остановить" VerticalAlignment="Center" />
                    </Button>

                    <!-- Opens the project the site now holds. The address comes from the site's
                         own read-back, so the button cannot point at another region. -->
                    <Button Classes="outline" Padding="12,10"
                            IsVisible="{Binding CanOpenSite}"
                            AutomationProperties.Name="Открыть на сайте"
                            Click="OnOpenSite">
                        <TextBlock Text="Открыть на сайте" VerticalAlignment="Center" />
                    </Button>

                    <Button Classes="outline" Padding="12,10"
                            IsEnabled="{Binding !IsBusy}"
                            AutomationProperties.Name="Вернуться к заказу"
                            Click="OnBack">
                        <TextBlock Text="Вернуться к заказу" VerticalAlignment="Center" />
                    </Button>

                    <!-- One button, and it is the only thing that starts a write. -->
                    <Button Classes="primary" Padding="16,10"
                            IsEnabled="{Binding CanUpload}"
                            AutomationProperties.Name="Загрузить на сайт"
                            Click="OnUpload">
                        <TextBlock Text="{Binding ButtonText}" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Classes="contentScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,24,0,0">
            <StackPanel Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
                <Border Classes="card" Padding="20,16" IsVisible="{Binding HasMessage}">
                    <TextBlock Text="{Binding Message}" Classes="t12"
                               Foreground="{DynamicResource Slate600}" TextWrapping="Wrap" />
                </Border>

                <!-- What the check found, before anything is sent. The files are read as the
                     screen opens, so there is no button here: a book carries its own word, opens
                     itself when something is wrong, and lists the spreads it would send. -->
                <Border Classes="card" Padding="20,16">
                    <StackPanel Spacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Книги и файлы" Classes="t14SemiBold" />
                            <TextBlock Text="{Binding FilesText}" Classes="t12"
                                       Foreground="{DynamicResource Slate500}" TextWrapping="Wrap"
                                       IsVisible="{Binding HasFilesText}" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding BookRows}" IsVisible="{Binding HasBookRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                        <Expander.Header>
                                            <Grid ColumnDefinitions="40,*,140" VerticalAlignment="Center">
                                                <TextBlock Grid.Column="0" Text="{Binding NumberText}"
                                                           Classes="t11"
                                                           Foreground="{DynamicResource Slate500}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                           Classes="t12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- A book that needs attention is red and says why
                                                     inside; a clean book is one quiet word. -->
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                           Classes="t11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Red600}"
                                                           IsVisible="{Binding IsFailed}" />
                                                <TextBlock Grid.Column="2" Text="{Binding StatusText}"
                                                           Classes="t11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Slate600}"
                                                           IsVisible="{Binding !IsFailed}" />
                                            </Grid>
                                        </Expander.Header>

                                        <StackPanel Spacing="6" Margin="40,4,0,6">
                                            <TextBlock Text="{Binding ReasonsText}" Classes="t11"
                                                       Foreground="{DynamicResource Red700}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasReasons}" />

                                            <ItemsControl ItemsSource="{Binding Files}"
                                                          IsVisible="{Binding HasFiles}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid ColumnDefinitions="140,*,Auto"
                                                              Margin="0,0,0,2">
                                                            <TextBlock Grid.Column="0" Text="{Binding Title}"
                                                                       Classes="t11"
                                                                       Foreground="{DynamicResource Slate500}" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FileName}"
                                                                       Classes="t11"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Grid.Column="2" Text="{Binding Problem}"
                                                                       Classes="t11" Margin="12,0,0,0"
                                                                       Foreground="{DynamicResource Red600}"
                                                                       TextWrapping="Wrap"
                                                                       IsVisible="{Binding HasProblem}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding OrderAlertLines}"
                                      IsVisible="{Binding HasOrderAlerts}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Classes="t11"
                                               Foreground="{DynamicResource Red600}"
                                               TextWrapping="Wrap" Margin="0,0,0,4" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <CheckBox IsVisible="{Binding NeedsConfirmation}"
                                  IsChecked="{Binding ConfirmationsAccepted, Mode=TwoWay}"
                                  AutomationProperties.Name="Подтвердить файлы">
                            <TextBlock Text="Да, отправить эти файлы — край сайт может обрезать."
                                       Classes="t12" TextWrapping="Wrap" />
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Classes="card" Padding="20,16" IsVisible="{Binding HasResult}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Итог" Classes="t14SemiBold" />
                        <TextBlock Text="{Binding ResultText}" Classes="t12" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Url}" Classes="t12"
                                   Foreground="{DynamicResource Slate500}" TextWrapping="Wrap"
                                   IsVisible="{Binding HasUrl}" />
                    </StackPanel>
                </Border>

                <!-- One line per project the run touched: what exists, how many pages arrived,
                     and what does not match. -->
                <Border Classes="card" Padding="20,16" IsVisible="{Binding HasResults}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Проекты" Classes="t14SemiBold" />
                        <ItemsControl ItemsSource="{Binding Results}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding ProjectText}" Classes="t12"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PagesText}" Classes="t11"
                                                   Foreground="{DynamicResource Slate500}" />
                                        <TextBlock Text="{Binding ProblemsText}" Classes="t11"
                                                   Foreground="{DynamicResource Slate600}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding HasProblems}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
