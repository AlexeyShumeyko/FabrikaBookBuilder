<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PhotoBook.Shell.Views.SiteOrderView">

    <!--
        The order page is reached from the project's own panel, beside export, and it is the
        page the order is assembled and sent from: there is no second page behind it.

        The prototype's #upload is the shape of it: a head panel that says what the run is worth
        before it says anything else, a warm plate for the books that need an answer, and one
        card per group with its books and its format beside them.

        Numbers, from the prototype:

            control panel   24/22/24/0, a 52 gold tile and the name at 25 extra bold
            strip           a line across the panel's foot, then «К отправке», the count,
                            its word, files, price, and the two tags on the right
            alert           warm wash, a mark, a title and a sentence, one button «Показать»
            group head      18/15, a 30 number, the name at 14 extra bold, the composition
                            under it, the state in a pill, the sum, «В загрузке», the chevron
            book table      38 / 1fr / 72 / 68 / 112 / 88 and two 26 tools; a book that failed
                            sits on the danger wash
            format panel    352 wide, its own head with a mark and the group's tag, its body of
                            questions, and the group's total in the foot

        A group is one project on the site, so the page holds as many groups as the project has
        formats - by default one, and two when a project was assembled from books of two page
        sizes. The project's name is in the sentence under the title rather than as the title:
        a page opened by the project's name read as the project's page, and this page is about
        sending it.
    -->
    <UserControl.Styles>
        <!--
            The chosen group: the card takes a line and a lift, and the number turns into the
            chosen cap. The line is the theme's own chosen colour - the light caramel on paper,
            where every chosen thing in this theme is caramel, and the gold at night. The quiet
            state is the same wash the prototype gives a number at rest, not a filled slate tile.
        -->
        <Style Selector="Border.card.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource GroupCardSelectedBorder}" />
            <Setter Property="BoxShadow" Value="{DynamicResource GroupCardSelectedShadow}" />
        </Style>

        <Style Selector="Border.groupNo">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Background" Value="{DynamicResource GroupNoFill}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GroupNoBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Border.groupNo TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GroupNoInk}" />
        </Style>

        <Style Selector="Border.groupNo.selected">
            <Setter Property="Background" Value="{DynamicResource GroupNoOnFill}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style Selector="Border.groupNo.selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource GroupNoOnInk}" />
        </Style>

        <!--
            «Показать» is the prototype's ghost button, small: words in the muted ink and no box
            at rest. The wash appears only under the pointer, at four and a half percent, and the
            words take the page's ink.
        -->
        <Style Selector="Button.pageGhost">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.pageGhost:pointerover">
            <Setter Property="Background" Value="{DynamicResource GhostHoverWash}" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
        </Style>

        <!-- Pressed keeps the pointer's wash: the prototype paints no third state for it. -->
        <Style Selector="Button.pageGhost:pressed">
            <Setter Property="Background" Value="{DynamicResource GhostHoverWash}" />
        </Style>

        <!--
            The state pill is the prototype's own tag: twenty-six high, eleven and a half bold,
            a six-pixel dot and eleven of air on either side. It used to be a smaller, tighter
            pill, which read as a note beside the name rather than as the card's verdict.
        -->
        <Style Selector="Border.stateTag">
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>

        <!--
            The words sit in the middle of the pill, not at the top of it. A horizontal stack
            stretches its children to the pill's twenty-six pixels, and a stretched TextBlock
            draws its one line at the top of that box - which is what put «Требует внимания»
            against the pill's upper edge with the dot centred beside it.
        -->
        <Style Selector="Border.stateTag TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- The table's headings: the prototype's 9.5 bold capitals with a tenth of an em. -->
        <Style Selector="TextBlock.columnHead">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.95" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
        </Style>

        <!--
            The menu a book's three dots open, transcribed from the prototype's .row-menu: a
            344-wide card of one-pixel line at the theme's strong border, radius thirteen, and
            a shadow deep enough to lift it off the page. Its lines are the prototype's too -
            a mark, a name, and the format or the consequence under it in smaller faint ink.
        -->
        <Style Selector="Border.rowMenu">
            <Setter Property="Width" Value="344" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{DynamicResource SurfaceModal}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BoxShadow" Value="{DynamicResource RowMenuShadow}" />
        </Style>

        <Style Selector="TextBlock.rowMenuLabel">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.95" />
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}" />
            <Setter Property="Margin" Value="10,8,10,5" />
        </Style>

        <Style Selector="Border.rowMenuSeparator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Slate200}" />
            <Setter Property="Margin" Value="4,5" />
        </Style>

        <Style Selector="Button.rowMenuItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="9,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextDefault}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Stretch" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <Style Selector="Button.rowMenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource GhostHoverWash}" />
            <Setter Property="Foreground" Value="{DynamicResource TextStrong}" />
        </Style>

        <Style Selector="Button.rowMenuItem.danger">
            <Setter Property="Foreground" Value="{DynamicResource DangerInk}" />
        </Style>

        <Style Selector="Button.rowMenuItem.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerWash}" />
        </Style>

        <!-- The prototype paints the menu's marks a step quieter than its words. -->
        <Style Selector="Button.rowMenuItem Path">
            <Setter Property="Stroke" Value="{DynamicResource TextFaint}" />
        </Style>

        <Style Selector="Button.rowMenuItem.danger Path">
            <Setter Property="Stroke" Value="{DynamicResource DangerInk}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" MaxWidth="1600" Margin="32,24" HorizontalAlignment="Stretch">

        <!-- ============================ control panel ========================== -->
        <Border Grid.Row="0" Classes="card" Padding="24,22,24,0"
                HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Spacing="0">

                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center"
                      Margin="0,0,0,20">

                    <!-- The prototype's own tile: a gold plate, the hairline it draws four
                         pixels inside, and the upload mark. Not the avatar's gold - by day the
                         tile is a pale wash with deep-gold ink, and the avatar stays gold. -->
                    <Border Grid.Column="0" Width="52" Height="52" CornerRadius="15"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ModePlateFill}"
                            BorderBrush="{DynamicResource ModePlateRing}" BorderThickness="1"
                            BoxShadow="{DynamicResource ModePlateShadow}">
                        <Panel>
                            <Border Margin="4" CornerRadius="11" BorderThickness="1"
                                    IsHitTestVisible="False"
                                    BorderBrush="{DynamicResource ModePlateInnerRing}" />
                            <!-- The upload mark from the prototype's sprite, point for point:
                                 the shaft, the two strokes of the head and the tray's box, at the
                                 size the sprite draws them - 16.2 of its 24-pixel grid, not
                                 stretched to the tile. -->
                            <Path Width="18" Height="17.4" Stretch="Uniform"
                                  Stroke="{DynamicResource ModePlateInk}" StrokeThickness="1.8"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M12 15.2V4.2 M7.9 8.3 L12 4.2 L15.8 8.3 M3.9 14.2v3a2.6 2.6 0 0 0 2.6 2.6h11a2.6 2.6 0 0 0 2.6-2.6v-3" />
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,24,0" VerticalAlignment="Center" Spacing="3">
                        <TextBlock Text="Загрузка на сайт" Classes="t25ExtraBold" />
                        <!-- «Проект «выпуск» · 4 группы · 13 книг · 65 файлов»: one sentence
                             in three runs, because only the project's name is bold. -->
                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextMuted}"
                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasGroups}">
                            <TextBlock.Inlines>
                                <Run Text="Проект " />
                                <Run Text="{Binding ProjectNameText}" FontWeight="Bold"
                                     Foreground="{DynamicResource TextDefault}" />
                                <Run Text="{Binding HeaderSummary}" />
                            </TextBlock.Inlines>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                                VerticalAlignment="Center">
                        <Button Classes="soft" Padding="14,10"
                                AutomationProperties.Name="Вернуться к проекту"
                                Click="OnBack">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="14" Height="14" Stretch="Uniform" StrokeThickness="1.8"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center"
                                      Stroke="{Binding $parent[Button].Foreground}"
                                      Data="M19 12H5M11.4 5.6 5 12l6.4 6.4" />
                                <TextBlock Text="Вернуться к проекту" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- The one write in the program: this opens the confirmation panel, and
                             nothing is sent until its own «Отправить» is pressed. -->
                        <Button Classes="primary" Padding="16,10"
                                IsEnabled="{Binding CanUpload}"
                                AutomationProperties.Name="Загрузить на сайт"
                                Click="OnUpload">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Width="15" Height="15" Stretch="Uniform" StrokeThickness="1.8"
                                      StrokeLineCap="Round" StrokeJoin="Round"
                                      VerticalAlignment="Center"
                                      Stroke="{DynamicResource ActionInk}"
                                      Data="M 12 14.8 V 3.6 M 8.2 7.4 L 12 3.6 L 15.8 7.4 M 4 17.2 V 19.4 A 1.5 1.5 0 0 0 5.5 20.9 H 18.5 A 1.5 1.5 0 0 0 20 19.4 V 17.2" />
                                <TextBlock Text="Загрузить на сайт"
                                           Foreground="{DynamicResource ActionInk}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- What the run is worth, before what is wrong with it. The prototype closes
                     the panel with a line across its foot and a row of numbers under it: not a
                     tray inside a tray, which read as a second, smaller card. -->
                <Border BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,1,0,0"
                        Padding="0,13,0,15"
                        IsVisible="{Binding HasGroups}">
                    <Grid ColumnDefinitions="*,Auto">

                        <!-- The count at 15 extra bold, its word at 11.5 in the muted ink and
                             the label at 11.5 in wide capitals - the size the prototype's own
                             cascade gives it, not the 10 in its rule: a line of type sitting
                             on one baseline, not a row of chips. -->
                        <StackPanel Orientation="Horizontal" Spacing="7"
                                    VerticalAlignment="Bottom">
                            <TextBlock Text="К ОТПРАВКЕ" FontSize="11.5" FontWeight="Bold"
                                       LetterSpacing="1.61"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Bottom" Margin="0,0,4,1" />

                            <TextBlock Text="{Binding GoingBookCount}" FontSize="15"
                                       FontWeight="ExtraBold" LetterSpacing="-0.3"
                                       Foreground="{DynamicResource TextStrong}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding GoingBooksUnit}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,1" />

                            <Border Width="1" Height="14" VerticalAlignment="Center"
                                    Margin="3,0"
                                    Background="{DynamicResource BorderStrong}" />

                            <TextBlock Text="{Binding GoingFileCount}" FontSize="15"
                                       FontWeight="ExtraBold" LetterSpacing="-0.3"
                                       Foreground="{DynamicResource TextStrong}"
                                       VerticalAlignment="Bottom" />
                            <TextBlock Text="{Binding GoingFilesUnit}" FontSize="11.5"
                                       Foreground="{DynamicResource TextMuted}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,1" />

                            <Border Width="1" Height="14" VerticalAlignment="Center"
                                    Margin="3,0"
                                    Background="{DynamicResource BorderStrong}"
                                    IsVisible="{Binding HasTotal}" />

                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        VerticalAlignment="Bottom"
                                        IsVisible="{Binding HasTotal}">
                                <TextBlock Text="{Binding TotalText}" FontSize="15"
                                           FontWeight="ExtraBold" LetterSpacing="-0.3"
                                           Foreground="{DynamicResource TextStrong}"
                                           VerticalAlignment="Bottom" />
                                <TextBlock Text="без доставки" FontSize="10.5"
                                           Foreground="{DynamicResource TextFaint}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,1.3" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    VerticalAlignment="Center" Margin="16,0,0,0">
                            <Border Background="{DynamicResource StatusWarnFill}"
                                    BorderBrush="{DynamicResource StatusWarnBorder}"
                                    BorderThickness="1" CornerRadius="999" Height="26"
                                    Padding="11,0"
                                    IsVisible="{Binding HasAttentionTag}">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <Border Width="6" Height="6" CornerRadius="3"
                                            Background="{DynamicResource StatusWarnInk}"
                                            VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AttentionTagText}" FontSize="11.5"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource StatusWarnInk}" />
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource StatusMutedFill}"
                                    BorderBrush="{DynamicResource StatusMutedBorder}"
                                    BorderThickness="1" CornerRadius="999" Height="26"
                                    Padding="11,0"
                                    IsVisible="{Binding HasExcludedTag}">
                                <TextBlock Text="{Binding ExcludedTagText}" FontSize="11.5"
                                           FontWeight="Bold" VerticalAlignment="Center"
                                           Foreground="{DynamicResource StatusMutedInk}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- ================================ body ==============================
             The bar hangs in the window's margin and handed back by the padding, the same way
             the unique-folder mode does it: nothing is lost, and the scroll no longer lies over
             the parameter card's own edge. -->
        <ScrollViewer Grid.Row="1" Classes="contentScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Margin="0,18,-20,0">
            <Border Padding="0,0,20,0">
                <StackPanel Spacing="14" HorizontalAlignment="Stretch">

                    <!-- The books that will not go, said once over the page. A group card can
                         only say what is wrong with its own books, and a customer reading four
                         cards would have to find them; the plate names them and its button goes
                         to the group. -->
                    <Border CornerRadius="14" Padding="16,12"
                            Background="{DynamicResource StatusWarnFill}"
                            BorderBrush="{DynamicResource StatusWarnBorder}" BorderThickness="1"
                            IsVisible="{Binding HasProblemAlert}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- The mark is centred on the plate, as the prototype's flex row
                                 centres it; it sat two pixels down when it was top-aligned. -->
                            <Path Width="18" Height="18" Stretch="Uniform" StrokeThickness="1.6"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  VerticalAlignment="Center" Margin="0,0,12,0"
                                  Stroke="{DynamicResource StatusWarnInk}"
                                  Data="M12 3.4 21 19.6H3zM12 9.6v4.2M12 16.9v.1" />

                            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AlertTitle}" FontSize="12.5"
                                           FontWeight="ExtraBold"
                                           Foreground="{DynamicResource StatusWarnInk}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding AlertText}" FontSize="11.5"
                                           Margin="0,2,0,0" LineHeight="17"
                                           Foreground="{DynamicResource TextMuted}"
                                           TextWrapping="Wrap" />
                            </StackPanel>

                            <Button Grid.Column="2" Classes="pageGhost"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Показать проблемные книги"
                                    Click="OnShowProblem">
                                <TextBlock Text="Показать" VerticalAlignment="Center"
                                           LetterSpacing="-0.13"
                                           Foreground="{Binding $parent[Button].Foreground}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- What the page itself has to say: a save that failed, or the site's own
                         words about the catalog. Never a group's sentence - every group says
                         those on its own card. -->
                    <Border CornerRadius="14" Padding="16,13"
                            Background="{DynamicResource StatusMutedFill}"
                            BorderBrush="{DynamicResource StatusMutedBorder}" BorderThickness="1"
                            IsVisible="{Binding HasMessage}">
                        <TextBlock Text="{Binding Message}" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" />
                    </Border>

                    <!-- One card per group, one after another down the page. Inside a group the
                         two panels stand side by side, the books and the format: the books are
                         rows, the format is a handful of questions. -->
                    <ItemsControl x:Name="GroupsList" ItemsSource="{Binding Groups}"
                                  HorizontalAlignment="Stretch">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,18,352" VerticalAlignment="Top"
                                      Margin="0,0,0,14">

                                    <!-- ===================== the group of books ================== -->
                                    <Border Grid.Column="0" Name="BooksCard" Classes="card" Padding="0"
                                            Classes.selected="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            Opacity="{Binding CardOpacity}"
                                            PointerPressed="OnSelectGroup">
                                        <Grid RowDefinitions="Auto,Auto,Auto">

                                            <!-- the head: which group, how big, in what state, and
                                                 the one switch that takes it out of the run -->
                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto"
                                                  Margin="18,15,18,14"
                                                  Background="Transparent" Cursor="Hand">

                                                <!-- The group's number in its own square, as the
                                                     mockup marks a card's place in the order: two
                                                     digits, 01 and 02, not 1 and 2. -->
                                                <Border Classes="groupNo"
                                                        Classes.selected="{Binding IsSelected}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NumberText}"
                                                               FontSize="11.5" FontWeight="ExtraBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="11,0,12,0"
                                                            VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Title}" Classes="t14ExtraBold" />
                                                    <TextBlock Text="{Binding CompositionText}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextFaint}" />
                                                </StackPanel>

                                                <!-- The state in a pill: one word, because the
                                                     reason is the line under the head. -->
                                                <Border Grid.Column="2" Classes="stateTag"
                                                        Background="{DynamicResource StatusTealFill}"
                                                        BorderBrush="{DynamicResource StatusTealBorder}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding StatusIsReady}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Border Width="6" Height="6" CornerRadius="3"
                                                                Background="{DynamicResource StatusTealInk}"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusTagText}"
                                                                   Foreground="{DynamicResource StatusTealInk}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Classes="stateTag"
                                                        Background="{DynamicResource StatusWarnFill}"
                                                        BorderBrush="{DynamicResource StatusWarnBorder}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding StatusIsProblem}">
                                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                                        <Border Width="6" Height="6" CornerRadius="3"
                                                                Background="{DynamicResource StatusWarnInk}"
                                                                VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding StatusTagText}"
                                                                   Foreground="{DynamicResource StatusWarnInk}" />
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="2" Classes="stateTag"
                                                        Background="{DynamicResource StatusMutedFill}"
                                                        BorderBrush="{DynamicResource StatusMutedBorder}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding StatusIsMuted}">
                                                    <TextBlock Text="{Binding StatusTagText}"
                                                               Foreground="{DynamicResource StatusMutedInk}" />
                                                </Border>

                                                <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                            Spacing="14" VerticalAlignment="Center">

                                                    <!-- The group's price, or the note that there is
                                                         none yet: the same place, so the eye can
                                                         compare one card with another. -->
                                                    <TextBlock Text="{Binding SumText}" FontSize="13.5"
                                                               FontWeight="ExtraBold"
                                                               Foreground="{DynamicResource TextStrong}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding HasSum}" />
                                                    <TextBlock Text="{Binding SumText}" FontSize="11.5"
                                                               Foreground="{DynamicResource TextFaint}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasSum}" />

                                                    <!-- A group that was uploaded before is left
                                                         out of the coming run by default, and the
                                                         customer can put it back with this
                                                         switch. Every group has it, so excluding
                                                         one is the same single click. -->
                                                    <CheckBox Classes="switch"
                                                              IsChecked="{Binding IsIncluded, Mode=TwoWay}"
                                                              AutomationProperties.Name="Участвует в загрузке"
                                                              VerticalAlignment="Center">
                                                        <TextBlock Text="В загрузке" />
                                                    </CheckBox>

                                                    <Button Classes="ghostClear" Padding="4"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Свернуть группу"
                                                            IsVisible="{Binding IsExpanded}"
                                                            Click="OnToggleGroup">
                                                        <TextBlock Text="&#xE70E;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Slate500}" />
                                                    </Button>
                                                    <Button Classes="ghostClear" Padding="4"
                                                            VerticalAlignment="Center"
                                                            AutomationProperties.Name="Развернуть группу"
                                                            IsVisible="{Binding IsCollapsed}"
                                                            Click="OnToggleGroup">
                                                        <TextBlock Text="&#xE70D;"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource Slate500}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- What the group has to say about itself: why it
                                                 cannot go, that its books stay behind, or that it
                                                 was uploaded before. A reason is an error and
                                                 is painted like one - the same warm danger wash
                                                 and ink the prototype gives a book that failed,
                                                 a mark, and the next step in the sentence. Only
                                                 the two quiet notes - a group taken out of the
                                                 run, and one still reading - stay grey. -->
                                            <Grid Grid.Row="1" Margin="18,0,18,12"
                                                  IsVisible="{Binding HasNote}">

                                                <Border Padding="12,10" CornerRadius="10"
                                                        Background="{DynamicResource SunkenFaint}"
                                                        BorderBrush="{DynamicResource BorderDefault}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding NoteIsInfo}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Path Width="14" Height="14" Stretch="Uniform"
                                                              StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round"
                                                              VerticalAlignment="Top" Margin="0,2,0,0"
                                                              Stroke="{DynamicResource TextFaint}"
                                                              Data="M12 10.6v5M12 7.4v.1M12 21a9 9 0 1 1 0-18a9 9 0 1 1 0 18" />

                                                        <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                                   Text="{Binding NoteText}" FontSize="11.5"
                                                                   LineHeight="18" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextMuted}" />
                                                    </Grid>
                                                </Border>

                                                <Border Padding="12,10" CornerRadius="10"
                                                        Background="{DynamicResource DangerWash}"
                                                        BorderBrush="{DynamicResource DangerPaperRing}"
                                                        BorderThickness="1"
                                                        IsVisible="{Binding NoteIsAlert}">
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <Path Width="14" Height="14" Stretch="Uniform"
                                                              StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round"
                                                              VerticalAlignment="Top" Margin="0,2,0,0"
                                                              Stroke="{DynamicResource DangerInk}"
                                                              Data="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0M12 9v4M12 17v.1" />

                                                        <TextBlock Grid.Column="1" Margin="10,0,0,0"
                                                                   Text="{Binding NoteText}" FontSize="11.5"
                                                                   FontWeight="SemiBold"
                                                                   LineHeight="18" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource DangerInk}" />
                                                    </Grid>
                                                </Border>
                                            </Grid>

                                            <!-- the books, folded away by the chevron in the head -->
                                            <Grid Grid.Row="2" RowDefinitions="Auto,Auto"
                                                  IsVisible="{Binding IsExpanded}">

                                                <!-- the column headings, once -->
                                                <!-- The prototype's table has eight of air between its columns; the
                                                     fixed ones here are wider than their longest word so the
                                                     headings and the values beside them stop touching. -->
                                                <Grid Grid.Row="0" ColumnDefinitions="38,*,92,88,146,112,26,26"
                                                      Margin="18,8,18,9">
                                                    <TextBlock Grid.Column="0" Text="№"
                                                               Classes="columnHead" />
                                                    <TextBlock Grid.Column="1" Text="КНИГА"
                                                               Classes="columnHead" />
                                                    <TextBlock Grid.Column="2" Text="РАЗВОРОТЫ"
                                                               Classes="columnHead" />
                                                    <TextBlock Grid.Column="3" Text="ФОТО"
                                                               Classes="columnHead" />
                                                    <TextBlock Grid.Column="4" Text="СОСТОЯНИЕ"
                                                               Classes="columnHead" />
                                                    <TextBlock Grid.Column="5" Text="ЦЕНА"
                                                               Classes="columnHead" />
                                                </Grid>

                                                <Border Grid.Row="0" Height="1"
                                                        Background="{DynamicResource Slate200}"
                                                        VerticalAlignment="Bottom" Margin="18,0" />

                                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Books}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <!-- A book that needs an answer
                                                                     sits on the danger wash, so the
                                                                     row is found before it is read. -->
                                                                <Border CornerRadius="10" Margin="8,0"
                                                                        Background="{DynamicResource DangerWash}"
                                                                        IsVisible="{Binding IsFailed}" />

                                                                <StackPanel Opacity="{Binding RowOpacity}">

                                                                    <!-- One book as a row of the
                                                                         table. The chevron opens
                                                                         what the check found: the
                                                                         cover, the spreads, and the
                                                                         file the site refused. -->
                                                                    <Grid ColumnDefinitions="38,*,92,88,146,112,26,26"
                                                                          Margin="18,9">
                                                                        <TextBlock Grid.Column="0"
                                                                                   Text="{Binding Number}"
                                                                                   FontSize="11"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource TextFaint}" />

                                                                        <Grid Grid.Column="1"
                                                                              ColumnDefinitions="Auto,*"
                                                                              Margin="0,0,10,0">
                                                                            <!-- The book's own cover,
                                                                                 the size the
                                                                                 prototype draws it:
                                                                                 a folder of photographs
                                                                                 should look like
                                                                                 something. -->
                                                                            <Border Width="38" Height="26"
                                                                                    CornerRadius="6"
                                                                                    ClipToBounds="True"
                                                                                    VerticalAlignment="Center"
                                                                                    Background="{DynamicResource Sunken}"
                                                                                    BorderBrush="{DynamicResource BorderDefault}"
                                                                                    BorderThickness="1"
                                                                                    IsVisible="{Binding HasThumbnail}">
                                                                                <Image Source="{Binding ThumbnailPath, Converter={StaticResource FilePathToBitmap}, ConverterParameter=38}"
                                                                                       Stretch="UniformToFill" />
                                                                            </Border>

                                                                            <!-- The name in the prototype's semibold, and
                                                                                 the reason under it in the danger ink: a
                                                                                 book with a bad cover is found by reading
                                                                                 the row, not by opening it. -->
                                                                            <StackPanel Grid.Column="1"
                                                                                        Margin="10,0,0,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Spacing="2">
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           Classes="t12Semi"
                                                                                           Foreground="{DynamicResource TextDefault}"
                                                                                           TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{Binding ProblemText}"
                                                                                           FontSize="10.5" LineHeight="14"
                                                                                           Foreground="{DynamicResource DangerInk}"
                                                                                           TextWrapping="Wrap"
                                                                                           IsVisible="{Binding HasProblem}" />
                                                                            </StackPanel>
                                                                        </Grid>

                                                                        <TextBlock Grid.Column="2"
                                                                                   Text="{Binding Spreads}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextMuted}"
                                                                                   VerticalAlignment="Center" />
                                                                        <TextBlock Grid.Column="3"
                                                                                   Text="{Binding Photos}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextMuted}"
                                                                                   VerticalAlignment="Center" />

                                                                        <StackPanel Grid.Column="4"
                                                                                    Orientation="Horizontal"
                                                                                    Spacing="6"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding IsFailed}">
                                                                            <Border Width="6" Height="6"
                                                                                    CornerRadius="3"
                                                                                    Background="{DynamicResource DangerInk}"
                                                                                    VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ConditionText}"
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource DangerInk}" />
                                                                        </StackPanel>
                                                                        <!-- A book that went through says so in the prototype's .state-ok green,
                                                                             which is a shade brighter than the pill's own: the row is a fact,
                                                                             the pill above it is a label. -->
                                                                        <StackPanel Grid.Column="4"
                                                                                    Orientation="Horizontal"
                                                                                    Spacing="6"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding IsFine}">
                                                                            <Border Width="6" Height="6"
                                                                                    CornerRadius="3"
                                                                                    Background="{DynamicResource StateOkInk}"
                                                                                    VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ConditionText}"
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource StateOkInk}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4"
                                                                                    Orientation="Horizontal"
                                                                                    Spacing="6"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding ShowsGroupUnconfigured}">
                                                                            <Border Width="6" Height="6"
                                                                                    CornerRadius="3"
                                                                                    Background="{DynamicResource StatusWarnInk}"
                                                                                    VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ConditionText}"
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource StatusWarnInk}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4"
                                                                                    Orientation="Horizontal"
                                                                                    Spacing="6"
                                                                                    VerticalAlignment="Center"
                                                                                    IsVisible="{Binding IsExcluded}">
                                                                            <Border Width="6" Height="6"
                                                                                    CornerRadius="3"
                                                                                    Background="{DynamicResource TextFaint}"
                                                                                    VerticalAlignment="Center" />
                                                                            <TextBlock Text="{Binding ConditionText}"
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="{DynamicResource TextFaint}" />
                                                                        </StackPanel>

                                                                        <TextBlock Grid.Column="5"
                                                                                   Text="{Binding PriceText}"
                                                                                   FontSize="12" FontWeight="Bold"
                                                                                   Foreground="{DynamicResource TextDefault}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding !IsPriceEmpty}" />
                                                                        <TextBlock Grid.Column="5"
                                                                                   Text="{Binding PriceText}"
                                                                                   FontSize="12"
                                                                                   Foreground="{DynamicResource TextFaint}"
                                                                                   VerticalAlignment="Center"
                                                                                   IsVisible="{Binding IsPriceEmpty}" />

                                                                        <!-- A book can be moved when
                                                                             the page's own split put
                                                                             it beside books it does
                                                                             not share parameters
                                                                             with. -->
                                                                        <!-- The prototype's three dots, then the chevron: a 26 square of air
                                                                             around a mark that is smaller than the words beside it, so the
                                                                             two tools read as controls of the row rather than as glyphs
                                                                             competing with it. Both are centred on the row's own height. -->
                                                                        <Button Grid.Column="6"
                                                                                x:Name="RowMenuButton"
                                                                                Classes="ghostClear"
                                                                                Width="26" Height="26" Padding="0"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                AutomationProperties.Name="Действия с книгой"
                                                                                Click="OnMoveBook">
                                                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                                                  Fill="{DynamicResource Slate500}"
                                                                                  Data="M5 10.8a1.2 1.2 0 1 0 0 2.4a1.2 1.2 0 1 0 0-2.4M12 10.8a1.2 1.2 0 1 0 0 2.4a1.2 1.2 0 1 0 0-2.4M19 10.8a1.2 1.2 0 1 0 0 2.4a1.2 1.2 0 1 0 0-2.4" />
                                                                        </Button>
                                                                        <Button Grid.Column="7"
                                                                                Classes="ghostClear"
                                                                                Width="26" Height="26" Padding="0"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                AutomationProperties.Name="Файлы книги"
                                                                                IsVisible="{Binding !IsExpanded}"
                                                                                Click="OnToggleBook">
                                                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                                                  Stroke="{DynamicResource Slate500}"
                                                                                  StrokeThickness="2.1"
                                                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                                                  Data="M6 9l6 6 6-6" />
                                                                        </Button>
                                                                        <Button Grid.Column="7"
                                                                                Classes="ghostClear"
                                                                                Width="26" Height="26" Padding="0"
                                                                                HorizontalAlignment="Center"
                                                                                VerticalAlignment="Center"
                                                                                AutomationProperties.Name="Свернуть книгу"
                                                                                IsVisible="{Binding IsExpanded}"
                                                                                Click="OnToggleBook">
                                                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                                                  Stroke="{DynamicResource Slate500}"
                                                                                  StrokeThickness="2.1"
                                                                                  StrokeLineCap="Round" StrokeJoin="Round"
                                                                                  Data="M6 15l6-6 6 6" />
                                                                        </Button>

                                                                        <!-- The prototype's .row-menu: a 344-wide card under the dots, a
                                                                             heading, the other groups by name with their formats, a group of
                                                                             the book's own, and the red line that takes it out of the run. -->
                                                                        <Popup x:Name="RowMenuPopup"
                                                                               Grid.Column="7"
                                                                               IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                                                                               PlacementTarget="{Binding $parent[Grid]}"
                                                                               Placement="BottomEdgeAlignedRight"
                                                                               HorizontalOffset="-14"
                                                                               VerticalOffset="-2"
                                                                               IsLightDismissEnabled="True">
                                                                            <Border Classes="rowMenu">
                                                                                <StackPanel>
                                                                                    <TextBlock Text="ПЕРЕМЕСТИТЬ В ГРУППУ"
                                                                                               Classes="rowMenuLabel" />

                                                                                    <ItemsControl ItemsSource="{Binding MenuEntries}">
                                                                                        <ItemsControl.ItemTemplate>
                                                                                            <DataTemplate>
                                                                                                <Panel>
                                                                                                    <Border Classes="rowMenuSeparator"
                                                                                                            IsVisible="{Binding IsSeparator}" />
                                                                                                    <Button Classes="rowMenuItem"
                                                                                                            Classes.danger="{Binding IsDanger}"
                                                                                                            IsVisible="{Binding !IsSeparator}"
                                                                                                            AutomationProperties.Name="{Binding Title}"
                                                                                                            Click="OnMenuEntry">
                                                                                                        <Grid ColumnDefinitions="Auto,*">
                                                                                                            <Path Width="15" Height="15"
                                                                                                                  Stretch="Uniform"
                                                                                                                  VerticalAlignment="Center"
                                                                                                                  StrokeThickness="1.6"
                                                                                                                  StrokeLineCap="Round"
                                                                                                                  StrokeJoin="Round"
                                                                                                                  Data="{Binding Icon}" />
                                                                                                            <StackPanel Grid.Column="1"
                                                                                                                        Margin="9,0,0,0"
                                                                                                                        Spacing="1">
                                                                                                                <TextBlock Text="{Binding Title}"
                                                                                                                           FontSize="11.5"
                                                                                                                           FontWeight="SemiBold"
                                                                                                                           Foreground="{Binding $parent[Button].Foreground}"
                                                                                                                           TextWrapping="Wrap" />
                                                                                                                <TextBlock Text="{Binding Subtitle}"
                                                                                                                           FontSize="10.5"
                                                                                                                           Foreground="{DynamicResource TextFaint}"
                                                                                                                           TextWrapping="Wrap" />
                                                                                                            </StackPanel>
                                                                                                        </Grid>
                                                                                                    </Button>
                                                                                                </Panel>
                                                                                            </DataTemplate>
                                                                                        </ItemsControl.ItemTemplate>
                                                                                    </ItemsControl>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </Popup>
                                                                    </Grid>

                                                                    <StackPanel Spacing="6" Margin="76,0,24,12"
                                                                                IsVisible="{Binding IsExpanded}">
                                                                        <!-- Only what is about the book
                                                                             itself - no cover, or too
                                                                             few spreads. What the site
                                                                             said about one file is in
                                                                             that file's own row below. -->
                                                                        <TextBlock Text="{Binding ReasonsText}"
                                                                                   Classes="t11"
                                                                                   Foreground="{DynamicResource Red700}"
                                                                                   TextWrapping="Wrap"
                                                                                   IsVisible="{Binding HasReasons}" />

                                                                        <ItemsControl ItemsSource="{Binding FileRows}"
                                                                                      IsVisible="{Binding HasFileRows}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid ColumnDefinitions="140,*,Auto"
                                                                                          Margin="0,0,0,2">
                                                                                        <TextBlock Grid.Column="0"
                                                                                                   Text="{Binding Title}"
                                                                                                   Classes="t11"
                                                                                                   Foreground="{DynamicResource Slate500}" />
                                                                                        <TextBlock Grid.Column="1"
                                                                                                   Text="{Binding FileName}"
                                                                                                   Classes="t11"
                                                                                                   TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="2"
                                                                                                   Text="{Binding Problem}"
                                                                                                   Classes="t11"
                                                                                                   Margin="12,0,0,0"
                                                                                                   Foreground="{DynamicResource Red600}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   IsVisible="{Binding IsProblem}" />
                                                                                        <TextBlock Grid.Column="2"
                                                                                                   Text="{Binding Problem}"
                                                                                                   Classes="t11"
                                                                                                   Margin="12,0,0,0"
                                                                                                   Foreground="{DynamicResource Slate500}"
                                                                                                   TextWrapping="Wrap"
                                                                                                   IsVisible="{Binding IsRemark}" />
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>

                                                                    <Border Height="1"
                                                                            Background="{DynamicResource Slate100}" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>

                                            <!-- What belongs to the group rather than to one book.
                                                 There is no box to tick here: a group either goes
                                                 with files the site can print, or says which file
                                                 to replace and which format to check. -->
                                            <Border Grid.Row="2" Padding="20,12"
                                                    IsVisible="{Binding HasFileLines}">
                                                <ItemsControl ItemsSource="{Binding FileLines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" FontSize="11.5"
                                                                       Foreground="{DynamicResource DangerInk}"
                                                                       TextWrapping="Wrap" Margin="0,0,0,4" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <!-- ===================== the format panel ==================== -->
                                    <Border Grid.Column="2" Classes="card" Padding="0"
                                            HorizontalAlignment="Stretch">
                                        <Grid RowDefinitions="Auto,*,Auto">

                                            <!-- A head of its own, as the prototype's settings
                                                 panel has: a mark, the panel's name, and which
                                                 group it answers for. -->
                                            <Border Padding="18,15,18,14"
                                                    BorderBrush="{DynamicResource BorderDefault}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <Border Width="34" Height="34" CornerRadius="10"
                                                            Background="{DynamicResource SunkenFaint}"
                                                            BorderBrush="{DynamicResource BorderDefault}"
                                                            BorderThickness="1"
                                                            VerticalAlignment="Center">
                                                        <Path Width="17" Height="17" Stretch="Uniform"
                                                              StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              Stroke="{DynamicResource TextMuted}"
                                                              Data="M3 7.6h5.4M15.6 7.6H21M12 5.9a1.7 1.7 0 1 1 0 3.4a1.7 1.7 0 1 1 0-3.4M3 16.4h1.6M11.4 16.4H21M8 14.7a1.7 1.7 0 1 1 0 3.4a1.7 1.7 0 1 1 0-3.4" />
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Margin="11,0,8,0"
                                                               Text="Формат и параметры"
                                                               Classes="t14ExtraBold"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" />

                                                    <Border Grid.Column="2" CornerRadius="999"
                                                            Padding="8,3" VerticalAlignment="Center"
                                                            Background="{DynamicResource StatusMutedFill}"
                                                            BorderBrush="{DynamicResource StatusMutedBorder}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="10"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource StatusMutedInk}" />
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="18,16,18,0" Spacing="6">
                                                <TextBlock Text="Формат группы" Classes="t11"
                                                           Foreground="{DynamicResource Slate500}" />
                                                <ComboBox HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="Формат группы"
                                                          ItemsSource="{Binding Formats}"
                                                          SelectedItem="{Binding SelectedFormat, Mode=TwoWay}"
                                                          DisplayMemberBinding="{Binding DisplayText}"
                                                          PlaceholderText="Выберите формат" />
                                                <TextBlock Text="Формат и параметры выбираются один раз — для всех книг группы."
                                                           Classes="t11" Foreground="{DynamicResource Slate400}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding FormatNote}" Classes="t11"
                                                           Foreground="{DynamicResource Red600}"
                                                           TextWrapping="Wrap"
                                                           IsVisible="{Binding HasFormatNote}" />

                                                <ScrollViewer Margin="0,10,0,0"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled"
                                                              IsVisible="{Binding HasParameters}">
                                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Spacing="4" Margin="0,0,0,8">
                                                                    <!-- The block says what is still
                                                                         open, in red: "не выбрано: 1"
                                                                         left the customer to look for
                                                                         which one. -->
                                                                    <TextBlock Text="{Binding StateText}" Classes="t11"
                                                                               Foreground="{DynamicResource Red600}"
                                                                               TextWrapping="Wrap"
                                                                               IsVisible="{Binding HasMissing}" />
                                                                    <TextBlock Text="{Binding StateText}" Classes="t11"
                                                                               Foreground="{DynamicResource Slate500}"
                                                                               TextWrapping="Wrap"
                                                                               IsVisible="{Binding !HasMissing}" />

                                                                    <ItemsControl ItemsSource="{Binding Parameters}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <StackPanel Spacing="4" Margin="0,8,0,0">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                        <TextBlock Text="{Binding Title}" Classes="t11"
                                                                                                   Foreground="{DynamicResource Slate500}" />
                                                                                        <TextBlock Text="*" Classes="t11"
                                                                                                   Foreground="{DynamicResource Red600}"
                                                                                                   IsVisible="{Binding IsMissing}" />
                                                                                    </StackPanel>
                                                                                    <ComboBox HorizontalAlignment="Stretch"
                                                                                              AutomationProperties.Name="{Binding Title}"
                                                                                              ItemsSource="{Binding Elements}"
                                                                                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                                                                                              DisplayMemberBinding="{Binding Title}"
                                                                                              PlaceholderText="Выберите вариант" />
                                                                                </StackPanel>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>

                                            <!-- What this group costs, and how much of it is
                                                 answered. The sum of the whole order is in the
                                                 strip, which is where it is decided. -->
                                            <Border Grid.Row="2" Padding="18,12"
                                                    Background="{DynamicResource ModalFootFill}"
                                                    BorderBrush="{DynamicResource BorderDefault}"
                                                    BorderThickness="0,1,0,0">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="Итого по группе" Classes="t11"
                                                                   Foreground="{DynamicResource Slate500}" />
                                                        <TextBlock Text="{Binding ReadyBooksText}" FontSize="11"
                                                                   Foreground="{DynamicResource TextFaint}" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding SumText}"
                                                               FontSize="16" FontWeight="ExtraBold"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding HasSum}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding SumText}"
                                                               FontSize="11.5"
                                                               Foreground="{DynamicResource TextFaint}"
                                                               MaxWidth="150" TextWrapping="Wrap"
                                                               TextAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding !HasSum}" />
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
