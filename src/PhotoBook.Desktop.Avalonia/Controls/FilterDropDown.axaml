<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:PhotoBook.Shell.Controls"
             x:Class="PhotoBook.Shell.Controls.FilterDropDown"
             Width="168">

    <!--
        A filter, written out rather than borrowed.

        This was a ComboBox with its template replaced, and it did not work: the list opened
        and nothing in it could be chosen, because the list sits in a popup - a window of
        its own - and the binding that would have carried the choice back could not be
        written across that boundary. So the choice never reached the program and the popup
        had nothing to close it.

        A control of its own does not have that problem, because there is no boundary to
        cross: the code that owns the button and owns the list is in the same class, and
        closing the list on a choice is two lines rather than an arrangement of bindings.

        Closing on a click outside is not here because it does not need to be: a popup
        dismisses itself when light dismiss is on, which is the default, and it is left on
        deliberately.

        Nothing here decides how a filter looks beyond its own box - the chip is a Button
        carrying the filterChip class, and the rows are the program's own list rows. What
        is here is the behaviour a list of choices owes the person using it.
    -->
    <Grid>
        <Button Name="PART_Button"
                Classes="filterChip"
                AutomationProperties.Name="{Binding AutomationName, RelativeSource={RelativeSource AncestorType={x:Type controls:FilterDropDown}}}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource AncestorType={x:Type controls:FilterDropDown}}}" />
                <Path Grid.Column="1"
                      Margin="12,0,0,0"
                      Width="10" Height="6"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 5 6 L 10 0"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" />
            </Grid>
        </Button>

        <Popup Name="PART_Popup"
               Placement="Bottom"
               VerticalOffset="6"
               IsLightDismissEnabled="True">
            <Border Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Slate200}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6"
                    Width="{Binding Bounds.Width, RelativeSource={RelativeSource AncestorType={x:Type controls:FilterDropDown}}}"
                    BoxShadow="{DynamicResource ShadowCard}">
                <ListBox Name="PART_List"
                         Classes="filterList"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MaxHeight="280"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ItemsSource="{Binding Items, RelativeSource={RelativeSource AncestorType={x:Type controls:FilterDropDown}}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
