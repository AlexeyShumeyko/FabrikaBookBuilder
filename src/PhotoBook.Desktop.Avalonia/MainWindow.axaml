<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhotoBook.Shell.MainWindow"
        Title="Fabrika BookBuilder Studio"
        Width="1200" Height="680"
        WindowState="Maximized"
        Background="{DynamicResource AppBackground}"
        PointerPressed="OnWindowPointerPressed"
        WindowStartupLocation="CenterScreen">

    <!--
        Opens maximised, always, and that is a rule rather than a preference.

        It used to open at a fixed 1520x800, centred. On a second monitor smaller than that,
        the window was wider than the screen and the minimise, maximise and close buttons sat
        past its right edge - with the person looking at a window they could not move, resize
        or close, because every control that would do it was off the screen. It was "fixed"
        once before by sizing to a share of the working area, then the size came back as a
        constant and so did the report.

        A person who wants a window can restore it themselves; that is their decision, and the
        width and height above are the size it goes back to when they do. 1200x680 fits inside
        the smallest screen the program supports, so restoring cannot put the buttons off the
        edge either.
    -->
    <!--
        The shell is a tinted page with white cards on it, and that is the decision this file
        encodes. It used to be a white page with a full-width bar across the top and a
        hairline under it - which is a different design, not a different way of drawing the
        same one, and it is why every screen looked like it belonged to another program.

        The header is a card like any other: inset thirty-two from the sides and twenty-four
        from the top, sixteen round the corners, one hairline of border, the same shadow as
        every other card. Nothing about it runs to the edge of the window, which is the whole
        of the difference.
    -->
    <!--
        Two layers. The page, and above it a sheet that dims it.

        A dialog used to be a second window: a white rectangle with no border of its own,
        floating on a page that is also white. There was nothing to say which one was on top,
        and nothing about it belonging to this program - it read as another program's window
        that happened to be in front. Dimming the page behind a panel that has its own surface,
        its own border and its own shadow says all of that without a word.

        The layer sits over the whole window, header included, so the page behind is plainly
        the same page and not a different one.
    -->
    <Grid Background="{DynamicResource PageBackdrop}">

    <!--
        The light the page stands in: the prototype's sun over its top edge, and the shade
        its lower corner sits in. Two layers, because a brush carries one gradient and the
        page needs both. They are behind everything and take no input: a background is not
        a control.
    -->
    <Border Background="{DynamicResource PageGlow}" IsHitTestVisible="False" />
    <Border Background="{DynamicResource PageGlowCorner}" IsHitTestVisible="False" />

    <DockPanel x:Name="PageLayer" LastChildFill="True">

    <Border DockPanel.Dock="Top" Height="76"
            Background="{DynamicResource TopBarGlass}"
            BoxShadow="{DynamicResource TopBarShadow}">
        <Grid>
            <!-- The gold line along the top edge, and the hairline under the bar. Neither
                 takes input: a line is not a control. -->
            <Border Height="1" VerticalAlignment="Top" IsHitTestVisible="False"
                    Background="{DynamicResource TopBarEdge}" />
            <Border BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0,0,0,1"
                    IsHitTestVisible="False" />

            <Border HorizontalAlignment="Stretch" Padding="32,0">
                <Grid ColumnDefinitions="Auto,*,Auto">

                    <!-- left: the artwork, then the product name over the open project.
                         The logo is the company's own picture - a yellow disc on
                         transparency - lifted off the page by a gold glow. It is not a glyph
                         on a coloured plate: there is no plate.
                         The second word of the name is cut out of the gold gradient, which is
                         the one place in the program the product signs itself. -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12"
                                Margin="0,0,26,0" VerticalAlignment="Center">

                        <Image Source="avares://PhotoBookRenamer/Assets/logo.png"
                               Width="44" Height="44" Stretch="Uniform"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Фабрика Фотокниги">
                            <Image.Effect>
                                <DropShadowEffect Color="{DynamicResource LogoGlowColor}"
                                                  OffsetX="0" OffsetY="6" BlurRadius="16" />
                            </Image.Effect>
                        </Image>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Фабрика " Classes="t16ExtraBold" />
                                <TextBlock Text="Фотокниги" Classes="t16ExtraBold"
                                           Foreground="{DynamicResource BrandNameTail}" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <TextBlock Text="Проект:" Classes="t11Half"
                                           Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Classes="t11Half" MaxWidth="240"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextDefault}"
                                           Text="{Binding ProjectTitle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- centre: the four screens, as one grouped control. The two editor tabs
                         are greyed until a project of that mode is open, because a mode is
                         reached through a project and not by choosing a tab.

                         Which tab is current cannot be asked of :checked - the platform
                         theme's rule for a checked toggle button wins over this file's - so it
                         is bound from the view model instead: a card standing above the tray,
                         with the tray's own hairline and a gold mark. -->
                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{DynamicResource TabTray}"
                            BorderBrush="{DynamicResource TabTrayBorder}" BorderThickness="1"
                            CornerRadius="999" Padding="4">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <ToggleButton Classes="tab" Classes.selected="{Binding IsProjectsSelected}" AutomationProperties.Name="Мои проекты"
                                          Foreground="{Binding IsProjectsSelected, Converter={StaticResource SelectedTab}, ConverterParameter=fg}"
                                          Command="{Binding GoToProjectsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Width="12.5" Height="12.5" Stretch="Uniform" StrokeThickness="1.4"
                                               StrokeLineCap="Round" StrokeJoin="Round"
                                               Data="M4 6.5h16M4 12h16M4 17.5h9"
                                               VerticalAlignment="Center"
                                               Stroke="{Binding IsProjectsSelected, Converter={StaticResource SelectedTab}, ConverterParameter=icon}" />
                                    <TextBlock Text="Мои проекты" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="tab" Classes.selected="{Binding IsStartSelected}" AutomationProperties.Name="Выбор режима"
                                          Foreground="{Binding IsStartSelected, Converter={StaticResource SelectedTab}, ConverterParameter=fg}"
                                          Command="{Binding GoToModeSelectCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Width="12.5" Height="12.5" Stretch="Uniform" StrokeThickness="1.4"
                                               StrokeLineCap="Round" StrokeJoin="Round"
                                               Data="M4 7h8M16.5 7H20M4 17h3.5M12 17h8M16.4 7a2.2 2.2 0 1 1-4.4 0a2.2 2.2 0 1 1 4.4 0ZM11.6 17a2.2 2.2 0 1 1-4.4 0a2.2 2.2 0 1 1 4.4 0Z"
                                               VerticalAlignment="Center"
                                               Stroke="{Binding IsStartSelected, Converter={StaticResource SelectedTab}, ConverterParameter=icon}" />
                                    <TextBlock Text="Выбор режима" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="tab" Classes.selected="{Binding IsUniqueFoldersSelected}" AutomationProperties.Name="Уникальные папки"
                                          IsEnabled="{Binding CanOpenUniqueFoldersTab}"
                                          ToolTip.Tip="Открывается только внутри проекта"
                                          Foreground="{Binding IsUniqueFoldersSelected, Converter={StaticResource SelectedTab}, ConverterParameter=fg}"
                                          Command="{Binding GoToUniqueFoldersCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Width="12.5" Height="12.5" Stretch="Uniform" StrokeThickness="1.4"
                                               StrokeLineCap="Round" StrokeJoin="Round"
                                               Data="M3.5 8A2.5 2.5 0 0 1 6 5.5h3.6l1.8 2.2H18a2.5 2.5 0 0 1 2.5 2.5v7A2.5 2.5 0 0 1 18 19.7H6A2.5 2.5 0 0 1 3.5 17.2z"
                                               VerticalAlignment="Center"
                                               Stroke="{Binding IsUniqueFoldersSelected, Converter={StaticResource SelectedTab}, ConverterParameter=icon}" />
                                    <TextBlock Text="Уникальные папки" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Classes="tab" Classes.selected="{Binding IsCombinedSelected}" AutomationProperties.Name="Комбинированный"
                                          IsEnabled="{Binding CanOpenCombinedTab}"
                                          ToolTip.Tip="Открывается только внутри проекта"
                                          Foreground="{Binding IsCombinedSelected, Converter={StaticResource SelectedTab}, ConverterParameter=fg}"
                                          Command="{Binding GoToCombinedCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Path Width="12.5" Height="12.5" Stretch="Uniform" StrokeThickness="1.4"
                                               StrokeLineCap="Round" StrokeJoin="Round"
                                               Data="M5.3 3.5h3.4a1.8 1.8 0 0 1 1.8 1.8v3.4a1.8 1.8 0 0 1-1.8 1.8H5.3a1.8 1.8 0 0 1-1.8-1.8V5.3a1.8 1.8 0 0 1 1.8-1.8zM15.3 3.5h3.4a1.8 1.8 0 0 1 1.8 1.8v3.4a1.8 1.8 0 0 1-1.8 1.8h-3.4a1.8 1.8 0 0 1-1.8-1.8V5.3a1.8 1.8 0 0 1 1.8-1.8zM5.3 13.5h3.4a1.8 1.8 0 0 1 1.8 1.8v3.4a1.8 1.8 0 0 1-1.8 1.8H5.3a1.8 1.8 0 0 1-1.8-1.8v-3.4a1.8 1.8 0 0 1 1.8-1.8zM15.3 13.5h3.4a1.8 1.8 0 0 1 1.8 1.8v3.4a1.8 1.8 0 0 1-1.8 1.8h-3.4a1.8 1.8 0 0 1-1.8-1.8v-3.4a1.8 1.8 0 0 1 1.8-1.8z"
                                               VerticalAlignment="Center"
                                               Stroke="{Binding IsCombinedSelected, Converter={StaticResource SelectedTab}, ConverterParameter=icon}" />
                                    <TextBlock Text="Комбинированный" VerticalAlignment="Center" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                    </Border>

                    <!-- right: two zones, and the divider is what says so.

                           [ theme, help, contacts ] | [ account ]

                         One divider, between the utilities and the account: the bar reads left
                         to right as navigation, then utilities, then who you are. -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                Margin="26,0,0,0" VerticalAlignment="Center">

                        <!--
                            The theme switch. Light is the product's own face, and dark is
                            there for the evening; whichever is chosen stays chosen, across
                            runs and across updates, until it is chosen again.

                            The mark says what pressing it gives you rather than what is on
                            screen: a sun while the light theme is up, a moon while the dark
                            one is. A control that shows its current state in its own icon is a
                            control whose label has to be read twice.
                        -->
                        <Button Classes="utility" Click="OnThemeClick" ToolTip.Tip="Светлая или тёмная тема"
                                AutomationProperties.Name="Тема оформления">
                            <Panel>
                                <Path x:Name="ThemeSunPath" Width="16" Height="16" Stretch="Uniform"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Stroke="{DynamicResource TextMuted}"
                                      Data="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.2 5.2l1.4 1.4M17.4 17.4l1.4 1.4M18.8 5.2l-1.4 1.4M6.6 17.4l-1.4 1.4M16 12a4 4 0 1 1-8 0a4 4 0 1 1 8 0Z" />
                                <Path x:Name="ThemeMoonPath" Width="16" Height="16" Stretch="Uniform"
                                      StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round"
                                      Stroke="{DynamicResource TextMuted}"
                                      Data="M20.2 14.6A8.6 8.6 0 0 1 9.4 3.8 8.6 8.6 0 1 0 20.2 14.6z" />
                            </Panel>
                        </Button>
                        <Button Classes="utility" Command="{Binding GoToHelpCommand}"
                                ToolTip.Tip="Помощь и журнал работы программы"
                                AutomationProperties.Name="Помощь">
                            <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Stroke="{DynamicResource TextMuted}"
                                  Data="M21 12a9 9 0 1 1-18 0a9 9 0 1 1 18 0ZM9.4 9.2a2.7 2.7 0 1 1 3.8 2.5c-.7.35-1.2.85-1.2 1.65v.35M12 17.2h.01" />
                        </Button>
                        <Button Classes="utility" Command="{Binding GoToSupportCommand}" ToolTip.Tip="Поддержка: часы и каналы связи"
                                AutomationProperties.Name="Контакты">
                            <Path Width="16" Height="16" Stretch="Uniform" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round"
                                  Stroke="{DynamicResource TextMuted}"
                                  Data="M20 12.4c0 3.6-3.6 6.5-8 6.5-1 0-2-.15-2.9-.45L4.6 20l1.2-3.3C4.6 15.4 4 14 4 12.4 4 8.8 7.6 5.9 12 5.9s8 2.9 8 6.5zM8.6 12.3h.01M12 12.3h.01M15.4 12.3h.01" />
                        </Button>

                        <Border Width="1" Height="24" Background="{DynamicResource BorderStrong}"
                                Margin="8,0" VerticalAlignment="Center" />

                        <!--
                            The one control in this bar that leads somewhere rather than being
                            a seat: it opens the sign-in window, and after a successful sign-in
                            it shows the account's address instead of the invitation.

                            The avatar is the gold disc with a person on it. It is not the
                            account's initial, because the address arrives after the header is
                            drawn and a disc that changes what it shows is worse than one that
                            does not.

                            No glyph in front of the word: the person mark is already on screen
                            a few pixels to the left as "contacts", and two identical marks in
                            one bar is worse than one mark fewer.
                        -->
                        <Button Classes="account" Click="OnAccountClick"
                                ToolTip.Tip="Аккаунт на сайте"
                                AutomationProperties.Name="Вход">
                            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <Border Width="30" Height="30" CornerRadius="15"
                                        Background="{DynamicResource AvatarFill}"
                                        BorderBrush="{DynamicResource AvatarRing}" BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{DynamicResource AvatarInk}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock x:Name="AccountLabel" Text="Войти" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>

        <!-- ================================ body =================================
             Whatever screen is current. The host is deliberately dumb: it holds an object
             and puts it on the window, and which screen that is was decided before this
             window existed. A ContentControl is enough for one screen, and the day it is
             not, that is when it earns a navigation stack.
        -->
        <!--
             No field under the page, and that is a rule rather than a leftover.

             This border used to carry 56 of bottom padding. A padding is not a decoration
             here: it takes height out of the screen above it, so the list stopped 56 pixels
             short of the bottom of the window and the page showed through in one unbroken
             band across the whole width. That band reads as a footer bar the program does
             not have, and it stole that height on every screen at once. The screen's own
             margin is the page's field; a second one under it is a band.
        -->
        <Border HorizontalAlignment="Stretch">
            <ContentControl x:Name="ScreenHost" />
        </Border>
    </DockPanel>

    <!-- ================================ sheet ================================
         The dimming layer and nothing else. What is in it is put there by code and taken
         out again when it has answered; the layer itself knows no more than that.
    -->
    <Border x:Name="SheetLayer" IsVisible="False" Background="{DynamicResource Backdrop}">
        <Grid Margin="28">
            <ContentControl x:Name="SheetHost"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            MaxWidth="1120" MaxHeight="760" />
        </Grid>
    </Border>
    </Grid>
</Window>
