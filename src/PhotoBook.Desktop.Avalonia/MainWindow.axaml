<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhotoBook.Shell.MainWindow"
        Title="Probe"
        Width="760" Height="640"
        FontFamily="Inter" Opened="OnOpened">

    <!-- The probe shows four numbers and nothing else: can a window come up, does the
         typeface load, how long a photograph takes to become a tile, and what it costs. -->
    <Grid Margin="20" RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" FontSize="20" FontWeight="SemiBold"
                   Text="Wave 3.0 - can this engine do the work the product needs" />

        <TextBlock Grid.Row="1" Margin="0,6,0,14" Foreground="#64748B"
                   Text="Inter 9/12/14/16/20/24. If these sizes look right, the typeface loaded." />

        <ScrollViewer Grid.Row="2">
            <StackPanel>
                <TextBlock FontSize="9"  Text="9 px" />
                <TextBlock FontSize="10" Text="10 px" />
                <TextBlock FontSize="11" Text="11 px" />
                <TextBlock FontSize="12" Text="12 px" />
                <TextBlock FontSize="14" Text="14 px" />
                <TextBlock FontSize="16" Text="16 px" />
                <TextBlock FontSize="20" Text="20 px" />
                <TextBlock FontSize="24" Text="24 px" />
                <TextBlock Margin="0,16,0,0" FontSize="14"
                           Foreground="#0F172A" Text="The quick brown fox jumps over the lazy dog" />
                <Border Height="1" Background="#E2E8F0" Margin="0,14" />
                <TextBlock x:Name="Report" FontFamily="Consolas" FontSize="12" Text="measuring..." />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>