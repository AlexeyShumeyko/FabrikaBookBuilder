<Window x:Class="PhotoBookRenamer.Presentation.Dialogs.PageNumberDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Назначить разворот"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{StaticResource Surface}" CornerRadius="16"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="12" Direction="270"
                              Opacity="0.25" RenderingBias="Quality" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brand50}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource Brand600}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Назначить разворот" Style="{StaticResource TextH3}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Text="Введите номер, на который нужно переместить этот разворот."
                       Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,12" />

            <TextBox x:Name="PageNumberTextBox" FontSize="14" Margin="0,0,0,18"
                     ToolTip="От 1 до максимального количества разворотов" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="Отмена" Content="Отмена"
                        IsCancel="True" Margin="0,0,8,0" Click="CancelButton_Click" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Переместить" IsDefault="True"
                        Click="OkButton_Click">
                    <TextBlock Text="Переместить" Foreground="White" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
