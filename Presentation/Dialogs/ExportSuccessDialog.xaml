<Window x:Class="PhotoBookRenamer.Presentation.Dialogs.ExportSuccessDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт завершён"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{StaticResource Surface}" CornerRadius="24"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="12" Direction="270"
                              Opacity="0.25" RenderingBias="Quality" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="28">
            <!-- Success mark -->
            <Border Width="56" Height="56" CornerRadius="999" HorizontalAlignment="Center"
                    Background="{StaticResource Emerald100}">
                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                           Foreground="{StaticResource Emerald600}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Экспорт завершён!" Style="{StaticResource TextH3}"
                       HorizontalAlignment="Center" Margin="0,18,0,0" TextAlignment="Center" />
            <TextBlock x:Name="SummaryText" Style="{StaticResource TextCaption}"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Margin="0,8,0,0" MaxWidth="340" />

            <!-- Destination -->
            <Border Background="{StaticResource Slate50}" BorderBrush="{StaticResource Slate200}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Файлы сохранены в:" Style="{StaticResource TextMicro}"
                               Foreground="{StaticResource TextFaint}" Margin="0,0,0,4" />
                    <TextBlock x:Name="PathTextBlock" Style="{StaticResource TextMono}"
                               TextWrapping="Wrap" Foreground="{StaticResource TextDefault}" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PrimaryButton}" Click="OnGoToFolderClick"
                    AutomationProperties.Name="Перейти к файлам" Margin="0,18,0,0" IsDefault="True">
                <TextBlock Text="Перейти к файлам" Foreground="White" />
            </Button>
            <Button Style="{StaticResource GhostButton}" Click="OnContinueClick"
                    AutomationProperties.Name="Вернуться к редактированию" Margin="0,8,0,0"
                    Foreground="{StaticResource TextMuted}" Content="Вернуться к редактированию" />
        </StackPanel>
    </Border>
</Window>
