<Window x:Class="PhotoBookRenamer.Presentation.Dialogs.MultiFolderBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:utils="clr-namespace:PhotoBookRenamer.Presentation.Converters"
        Title="Проводник папок проекта"
        Width="820" Height="620"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <!-- The three error converters are declared locally on purpose: they shadow the
         global ones for this window so the selected-folder error tint stays red. -->
    <Window.Resources>
        <utils:ErrorToBackgroundConverter x:Key="ErrorToBackgroundConverter" />
        <utils:ErrorToForegroundConverter x:Key="ErrorToForegroundConverter" />
        <utils:ErrorToFontWeightConverter x:Key="ErrorToFontWeightConverter" />

        <Style x:Key="NavRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Slate50}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brand50}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FolderRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource Surface}"
                                BorderBrush="{StaticResource Slate200}" BorderThickness="1"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand400}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Slate50}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand500}" />
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brand50}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource Surface}" CornerRadius="16"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="12" Direction="270"
                              Opacity="0.25" RenderingBias="Quality" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============================================================== -->
            <!--  Header                                                       -->
            <!-- ============================================================== -->
            <Grid Grid.Row="0" Margin="20,18,20,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10"
                        Background="{StaticResource Brand50}" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                               Foreground="{StaticResource Brand600}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="Проводник папок проекта" Style="{StaticResource TextH3}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="CancelButton_Click"
                        AutomationProperties.Name="Закрыть" ToolTip="Закрыть"
                        Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
            </Grid>

            <!-- ============================================================== -->
            <!--  Error banner                                                 -->
            <!-- ============================================================== -->
            <Border x:Name="ErrorBorder" Grid.Row="1" Visibility="Collapsed" Margin="20,0,20,12"
                    Background="{StaticResource Red50}" BorderBrush="{StaticResource Red200}"
                    BorderThickness="1" CornerRadius="12" Padding="14">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{StaticResource Red600}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ErrorTextBlock" Style="{StaticResource TextBody}"
                               Foreground="{StaticResource Red700}" TextWrapping="Wrap"
                               Margin="10,0,0,0" MaxWidth="660" />
                </StackPanel>
            </Border>

            <!-- ============================================================== -->
            <!--  Body: places tree | folders | selection                      -->
            <!-- ============================================================== -->
            <Grid Grid.Row="2" Margin="20,0,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" MinWidth="170" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" MinWidth="240" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="230" MinWidth="200" />
                </Grid.ColumnDefinitions>

                <!-- Places -->
                <Border Grid.Column="0" Background="{StaticResource SurfaceMuted}" CornerRadius="12"
                        BorderBrush="{StaticResource Slate200}" BorderThickness="1" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Места" Style="{StaticResource TextMicro}"
                                   Foreground="{StaticResource TextFaint}" Margin="6,0,0,6" />
                        <ListBox x:Name="NavigationTree" Grid.Row="1"
                                 ItemContainerStyle="{StaticResource NavRow}"
                                 Background="Transparent" BorderThickness="0"
                                 SelectionChanged="NavigationTree_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource Amber500}"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}"
                                                   Margin="8,0,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Folders -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Current path + back -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource SecondaryButton}"
                                Click="BackButton_Click" Padding="10,6" Margin="0,0,8,0"
                                AutomationProperties.Name="Назад" ToolTip="Вернуться в предыдущую папку">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                <TextBlock Text="Назад" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="CurrentPathTextBlock" Grid.Column="1"
                                   Style="{StaticResource TextMono}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource Slate600}" />
                    </Grid>

                    <ListBox x:Name="FoldersListBox" Grid.Row="1"
                             ItemContainerStyle="{StaticResource FolderRow}"
                             Background="Transparent" BorderThickness="0"
                             SelectionMode="Extended"
                             MouseDoubleClick="FoldersListBox_MouseDoubleClick"
                             SelectionChanged="FoldersListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="{StaticResource Amber500}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource Slate700}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource TextMicro}" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextFaint}"
                                               Text="{Binding FileCount, StringFormat='{}{0} файлов'}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Selection tray -->
                <Border Grid.Column="4" Background="{StaticResource SurfaceMuted}" CornerRadius="12"
                        BorderBrush="{StaticResource Slate200}" BorderThickness="1" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBlock Text="Выбрано папок" Style="{StaticResource TextMicro}"
                                       Foreground="{StaticResource TextFaint}" />
                            <TextBlock Style="{StaticResource TextMicro}" HorizontalAlignment="Right"
                                       Foreground="{StaticResource Brand600}" FontWeight="Bold"
                                       Text="{Binding Items.Count, ElementName=SelectedFoldersListBox}" />
                        </Grid>

                        <ListBox x:Name="SelectedFoldersListBox" Grid.Row="1"
                                 Background="Transparent" BorderThickness="0" FontSize="11"
                                 SelectionChanged="SelectedFoldersListBox_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="6,4" Margin="0,0,0,2"
                                            Background="{Binding HasError, Converter={StaticResource ErrorToBackgroundConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Path}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding ErrorMessage}"
                                                       Foreground="{Binding HasError, Converter={StaticResource ErrorToForegroundConverter}}"
                                                       FontWeight="{Binding HasError, Converter={StaticResource ErrorToFontWeightConverter}}" />
                                            <TextBlock Grid.Column="1" Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="10" VerticalAlignment="Center" Margin="4,0,0,0"
                                                       Foreground="{StaticResource Red500}"
                                                       Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="RemoveSelectedButton" Grid.Column="0"
                                    Style="{StaticResource SecondaryButton}" Padding="8,5"
                                    Click="RemoveSelectedButton_Click"
                                    AutomationProperties.Name="Убрать выбранные" Content="Убрать" />
                            <Button x:Name="AddSelectedButton" Grid.Column="2"
                                    Style="{StaticResource PrimaryButton}" Padding="8,5"
                                    Click="AddSelectedButton_Click"
                                    AutomationProperties.Name="Добавить выбранные" Content="Добавить" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================================== -->
            <!--  Footer                                                       -->
            <!-- ============================================================== -->
            <Grid Grid.Row="3" Margin="20,14,20,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource TextCaption}"
                               Text="{Binding Items.Count, ElementName=FoldersListBox, StringFormat='Найдено подпапок: {0}'}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource SecondaryButton}" Click="CancelButton_Click"
                            AutomationProperties.Name="Отмена" Content="Отмена" Margin="0,0,8,0" />
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Click="OkButton_Click"
                            AutomationProperties.Name="Загрузить структуру" IsDefault="True" IsCancel="False">
                        <TextBlock Text="Загрузить структуру" Foreground="White" />
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
