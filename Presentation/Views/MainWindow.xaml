<Window x:Class="PhotoBookRenamer.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fabrika BookBuilder Studio"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackground}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        MinWidth="1100" MinHeight="680"
        Width="1400" Height="900"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        SizeChanged="MainWindow_SizeChanged">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToUniqueFoldersCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToCombinedModeCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource AppBackground}">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!--  Persistent top bar                                           -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderDefault}" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270"
                                  Opacity="0.06" RenderingBias="Quality" Color="#0F172A" />
            </Border.Effect>

            <Grid Margin="32,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="250" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + project name -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="12" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0" />
                                <GradientStop Color="#818CF8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Фабрика Фотокниги" FontFamily="{StaticResource UiFont}"
                                       FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextStrong}"
                                       VerticalAlignment="Center" />
                            <Border Background="{StaticResource Brand50}" BorderBrush="{StaticResource Brand100}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="PRO" FontFamily="{StaticResource UiFont}" FontSize="10"
                                           FontWeight="SemiBold" Foreground="{StaticResource Brand600}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Проект:" FontFamily="{StaticResource UiFont}" FontSize="12"
                                       FontWeight="Medium" Foreground="{StaticResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProjectTitle}" FontFamily="{StaticResource UiFont}"
                                       FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Slate700}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Screen tabs -->
                <Border Grid.Column="1" Background="#E7EAEF" CornerRadius="12"
                        BorderBrush="#D7DBE2" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Мои проекты"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=ProjectList}"
                                     ToolTip="Список проектов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Мои проекты" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Выбор режима"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=StartScreen}"
                                     ToolTip="Выбор режима вёрстки">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Выбор режима" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Уникальные папки"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=UniqueFolders}"
                                     ToolTip="Каждая папка — отдельная книга">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Уникальные папки" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Комбинированный"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=Combined}"
                                     ToolTip="Ручная сборка книг из общего пула">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Комбинированный" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Quick actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Undo / Redo (Unique Folders only) -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                                Visibility="{Binding ShowUndoRedo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ActiveEditor.UndoCommand}"
                                AutomationProperties.Name="Отменить" ToolTip="Отменить (Ctrl+Z)" Content="&#xE7A7;" />
                        <Button Style="{StaticResource IconButton}" Command="{Binding ActiveEditor.RedoCommand}"
                                AutomationProperties.Name="Вернуть" ToolTip="Вернуть (Ctrl+Y)" Content="&#xE72A;" Margin="4,0,0,0" />
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButton}" Click="OnChooseSourceClick"
                            AutomationProperties.Name="Выбрать источник"
                            Visibility="{Binding ShowSourcePicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="Выбрать папки с фотографиями">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Slate400}" />
                            <TextBlock Text="{Binding SourcePickerLabel}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Click="OnSaveClick"
                            AutomationProperties.Name="Сохранить"
                            IsEnabled="{Binding CanSave}" ToolTip="Сохранить проект (Ctrl+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Slate400}" />
                            <TextBlock Text="Сохранить" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" Click="OnExportClick"
                            AutomationProperties.Name="Экспорт"
                            IsEnabled="{Binding CanExport}" ToolTip="Экспорт готовых файлов"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" />
                            <TextBlock Text="Экспорт" Margin="6,0,0,0" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!--  Active screen                                                -->
        <!-- ============================================================== -->
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
