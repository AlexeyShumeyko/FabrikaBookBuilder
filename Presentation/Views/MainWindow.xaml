<Window x:Class="PhotoBookRenamer.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fabrika BookBuilder Studio"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{StaticResource AppBackground}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False"
        ResizeMode="CanResize"
        SizeToContent="Manual"
        MinWidth="1100" MinHeight="680"
        Width="1400" Height="900"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="{StaticResource UiFont}"
        SizeChanged="MainWindow_SizeChanged">

    <Window.InputBindings>
        <KeyBinding Key="F1" Command="{Binding OpenHelpCommand}" />
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToUniqueFoldersCommand}" />
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToCombinedModeCommand}" />
    </Window.InputBindings>

    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!--  Header: px-8 py-3, bottom border slate-200/80, shadow-subtle -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Slate200}" BorderThickness="0,0,0,1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="0" Direction="270"
                                  Opacity="0.08" RenderingBias="Quality" Color="#0F172A" />
            </Border.Effect>

            <Grid Margin="32,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="240" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ============ Logo + project name ============ -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="36" Height="36" CornerRadius="12" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4F46E5" Offset="0" />
                                <GradientStop Color="#818CF8" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                              Opacity="0.05" RenderingBias="Quality" Color="#0F172A" />
                        </Border.Effect>
                        <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource IconFont}" FontSize="16"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Фабрика Фотокниги" Style="{StaticResource TextSmBold}"
                                       FontSize="14" />
                            <Border Background="{StaticResource Brand50}" BorderBrush="{StaticResource Brand100}"
                                    BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="PRO" Style="{StaticResource TextBadge}" FontSize="10"
                                           Foreground="{StaticResource Brand600}" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="Проект:" Style="{StaticResource TextXsMedium}"
                                       Foreground="{StaticResource Slate500}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ProjectTitle}" Style="{StaticResource TextXsSemibold}"
                                       Foreground="{StaticResource Slate700}" Margin="4,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="180" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Screen tabs: bg-slate-200/70 p-1 rounded-xl ============ -->
                <Border Grid.Column="1" Background="#EBEDF0" CornerRadius="12"
                        BorderBrush="#DDE1E6" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="4">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Мои проекты"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=ProjectList}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C0;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Opacity="0.8" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Мои проекты" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Выбор режима"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=StartScreen}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Opacity="0.8" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Выбор режима" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Уникальные папки"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=UniqueFolders}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Opacity="0.8" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Уникальные папки" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Style="{StaticResource TabButton}" GroupName="ScreenTabs"
                                     AutomationProperties.Name="Комбинированный"
                                     IsChecked="{Binding CurrentMode, Mode=TwoWay, Converter={StaticResource AppModeEqualsConverter}, ConverterParameter=Combined}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Opacity="0.8" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                <TextBlock Text="Комбинированный" Margin="6,0,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- ============ Quick actions: px-3 py-2 / px-3.5 py-2, gap 8 ============ -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal" Margin="0,0,8,0"
                                Visibility="{Binding ShowUndoRedo, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ActiveEditor.UndoCommand}"
                                AutomationProperties.Name="Отменить" ToolTip="Отменить (Ctrl+Z)">
                            <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding ActiveEditor.RedoCommand}"
                                AutomationProperties.Name="Вернуть" ToolTip="Вернуть (Ctrl+Y)" Margin="8,0,0,0">
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                        </Button>
                    </StackPanel>

                    <Button Style="{StaticResource SecondaryButton}" Click="OnChooseSourceClick"
                            AutomationProperties.Name="Выбрать источник"
                            Visibility="{Binding ShowSourcePicker, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Slate400}" />
                            <TextBlock Text="{Binding SourcePickerLabel}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource SecondaryButton}" Click="OnSaveClick"
                            AutomationProperties.Name="Сохранить" Margin="0,0,8,0"
                            IsEnabled="{Binding CanSave}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Slate400}" />
                            <TextBlock Text="Сохранить" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource PrimaryButton}" Click="OnExportClick"
                            AutomationProperties.Name="Экспорт" IsEnabled="{Binding CanExport}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                            <TextBlock Text="Экспорт" Margin="6,0,0,0" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
</Window>
