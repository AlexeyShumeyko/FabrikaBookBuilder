<UserControl x:Class="PhotoBookRenamer.Presentation.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PhotoBookRenamer.Domain"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             FontFamily="{StaticResource UiFont}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="ProjectCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Effect" Value="{StaticResource ShadowSubtle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- py-2 px-3 rounded-xl bg-slate-100, hover -> brand-50/brand-600 -->
        <Style x:Key="OpenProjectButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{StaticResource Slate100}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              TextElement.FontWeight="{TemplateBinding FontWeight}"
                                              TextElement.FontSize="{TemplateBinding FontSize}"
                                              TextElement.FontFamily="{TemplateBinding FontFamily}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brand50}" />
                                <Setter Property="Foreground" Value="{StaticResource Brand600}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1600" Margin="32,24,32,24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!--  Section header: p-6 (24), rounded-2xl, title text-xl (20)   -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="24" Effect="{StaticResource ShadowSubtle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="Проекты фотокниг" Style="{StaticResource TextXlBold}" />
                    <TextBlock Text="Управляйте подготовленными макетами и запускайте их в автоматический экспорт"
                               Style="{StaticResource TextXs}" Foreground="{StaticResource Slate500}" Margin="0,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Padding="16,10"
                        AutomationProperties.Name="Создать проект"
                        Command="{Binding CreateProjectCommand}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                        <TextBlock Text="Создать проект" Margin="6,0,0,0" Foreground="White" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!--  Grid: max 3 columns, gap-6 (24)                               -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Border Style="{StaticResource LoadingVeil}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource LoadingVeilCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Brand600}" VerticalAlignment="Center" />
                        <TextBlock Text="Загрузка проектов..." Style="{StaticResource TextXsMedium}"
                                   Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

            <Border Background="{StaticResource Red50}" BorderBrush="{StaticResource Red200}" BorderThickness="1"
                    CornerRadius="12" Padding="16" VerticalAlignment="Top" Margin="0,0,0,20"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextXs}"
                           Foreground="{StaticResource Red700}" TextWrapping="Wrap" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" Padding="24" MaxWidth="520" HorizontalAlignment="Center"
                            Margin="0,40,0,0" Effect="{StaticResource ShadowSubtle}"
                            Visibility="{Binding ProjectsCount, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                                    Background="{StaticResource Brand50}">
                                <TextBlock Text="&#xE8C0;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                           Foreground="{StaticResource Brand600}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Проектов пока нет" Style="{StaticResource TextLgBold}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0" />
                            <TextBlock Text="Создайте первый проект, выберите режим вёрстки и загрузите фотографии."
                                       Style="{StaticResource TextXs}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource Slate500}"
                                       Margin="0,8,0,20" MaxWidth="380" HorizontalAlignment="Center" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="16,10"
                                    Command="{Binding CreateProjectCommand}" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                                    <TextBlock Text="Создать проект" Margin="6,0,0,0" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--
                        UniformGrid Columns="3" reproduces md:grid-cols-2 lg:grid-cols-3.
                        A WrapPanel with fixed widths was what made the first pass look wrong.
                    -->
                    <ItemsControl ItemsSource="{Binding Projects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ProjectInfo}">
                                <Border Style="{StaticResource ProjectCard}" Margin="0,0,24,24">
                                    <StackPanel>

                                        <!-- Status pill px-2.5 py-1 rounded-full + 11px timestamp -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--
                                                Status chip. The mockup's markup says
                                                rounded-full, but the requested look is a
                                                rounded rectangle, so this is rounded-md (6)
                                                with the 1px border the mockup also has.
                                                Colours come from StatusToBrushConverter by role.
                                            -->
                                            <Border Grid.Column="0" CornerRadius="6" Padding="10,4"
                                                    BorderThickness="1"
                                                    Background="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=bg}"
                                                    BorderBrush="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=border}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                                                             Fill="{Binding Status, Converter={StaticResource StatusToLabelConverter}, ConverterParameter=dot}" />
                                                    <TextBlock Text="{Binding Status, Converter={StaticResource StatusToLabelConverter}}"
                                                               Style="{StaticResource TextXsSemibold}" Margin="6,0,0,0"
                                                               Foreground="{Binding Status, Converter={StaticResource StatusToBrushConverter}, ConverterParameter=text}" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Grid.Column="1" Style="{StaticResource TextTiny}"
                                                       Foreground="{StaticResource Slate400}" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Text="{Binding LastModified, Converter={StaticResource LastModifiedTextConverter}, ConverterParameter=prefix}" />
                                        </Grid>

                                        <!--
                                            Title + mode chip. The chip is not decoration:
                                            a saved project is only reachable through its
                                            mode, so the user has to be able to see which
                                            mode it belongs to before opening it.
                                        -->
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                       Style="{StaticResource TextBaseBold}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />

                                            <Border Grid.Column="1" Margin="8,0,0,0"
                                                    CornerRadius="6" Padding="8,3"
                                                    Background="{StaticResource Slate50}"
                                                    BorderBrush="{StaticResource Slate200}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Mode, Converter={StaticResource AppModeToLabelConverter}, ConverterParameter=visibility}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Mode, Converter={StaticResource AppModeToLabelConverter}, ConverterParameter=icon}"
                                                               FontFamily="{StaticResource IconFont}" FontSize="11"
                                                               Foreground="{StaticResource Slate400}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Mode, Converter={StaticResource AppModeToLabelConverter}}"
                                                               Style="{StaticResource TextTiny}"
                                                               Foreground="{StaticResource Slate500}"
                                                               VerticalAlignment="Center" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!--
                                            Preview Photos Mini Strip. Three 48x48 tiles
                                            (w-12 h-12 rounded-lg, 1px slate-200 border) plus a
                                            "+N" tile for the remainder. Hidden entirely for a
                                            project with no photos.
                                        -->
                                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0"
                                                    Visibility="{Binding HasPreviewPhotos, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl ItemsSource="{Binding PreviewPhotos}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="48" Height="48" CornerRadius="8"
                                                                Margin="0,0,8,0" ClipToBounds="True"
                                                                BorderBrush="{StaticResource Slate200}"
                                                                BorderThickness="1"
                                                                Background="{StaticResource Slate100}"
                                                                ToolTip="{Binding}">
                                                            <Image Source="{Binding Converter={StaticResource FilePathToThumbnailConverter}, ConverterParameter=96}"
                                                                   Stretch="UniformToFill" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- +N: only when photos are actually left over -->
                                            <Border Width="48" Height="48" CornerRadius="8"
                                                    BorderBrush="{StaticResource Slate200}" BorderThickness="1"
                                                    Background="{StaticResource Slate100}"
                                                    Visibility="{Binding RemainingPhotoCount, Converter={StaticResource CountToBoolConverter}}">
                                                <TextBlock Text="{Binding RemainingPhotoCount, StringFormat='+{0}'}"
                                                           Style="{StaticResource TextXsSemibold}"
                                                           Foreground="{StaticResource Slate500}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Stats: mt-4 pt-3 (16/12), border-t spans the full card -->
                                        <Border Height="1" Background="{StaticResource Slate100}" Margin="0,16,0,0" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!--
                                                Stats. The mockup bolds only the number
                                                ("Книг: <strong>28 шт.</strong>"), so the label
                                                and the value are separate Runs.
                                                fa-book is E82D - a book. E8D7 was used before
                                                and is a KEY.
                                            -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="&#xE82D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="{StaticResource Slate400}" VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource TextXs}"
                                                           Foreground="{StaticResource Slate600}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="Книг: " />
                                                    <Run Text="{Binding BookCount, Mode=OneWay}" FontWeight="Bold"
                                                         Foreground="{StaticResource Slate800}" />
                                                    <Run Text=" шт." />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                           Foreground="{StaticResource Slate400}" VerticalAlignment="Center" />
                                                <TextBlock Style="{StaticResource TextXs}"
                                                           Foreground="{StaticResource Slate600}"
                                                           Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Run Text="Разворотов: " />
                                                    <Run Text="{Binding PageCount, Mode=OneWay}" FontWeight="Bold"
                                                         Foreground="{StaticResource Slate800}" />
                                                    <Run Text=" стр." />
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Footer: mt-5 pt-3, border-t, gap-2 -->
                                        <Border Height="1" Background="{StaticResource Slate100}" Margin="0,16,0,0" />
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Style="{StaticResource OpenProjectButton}"
                                                    Command="{Binding DataContext.OpenProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="Открыть проект" />
                                            </Button>

                                            <Button Grid.Column="1" Style="{StaticResource DangerGhostButton}"
                                                    Margin="8,0,0,0" ToolTip="Удалить проект"
                                                    Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
