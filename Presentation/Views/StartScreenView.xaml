<UserControl x:Class="PhotoBookRenamer.Presentation.Views.StartScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Big selectable mode card, as in the design. -->
        <Style x:Key="ModeCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,20,0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brand500}" />
                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModeIconBox" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="ModeIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FeatureRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  Padding="0,0,0,0">
        <StackPanel MaxWidth="900" Margin="32,24,32,32" HorizontalAlignment="Center">

            <!-- Heading -->
            <StackPanel Margin="0,24,0,40">
                <Border Background="{StaticResource Brand50}" BorderBrush="{StaticResource Brand100}"
                        BorderThickness="1" CornerRadius="999" Padding="12,4"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Выберите алгоритм вёрстки" Style="{StaticResource TextMicro}"
                               Foreground="{StaticResource Brand600}" />
                </Border>
                <TextBlock Text="Как распределить фотографии?" Style="{StaticResource TextH1}"
                           FontSize="26" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Выберите наиболее удобный формат организации фотокниг под ваш текущий проект"
                           Style="{StaticResource TextCaption}" HorizontalAlignment="Center"
                           TextAlignment="Center" MaxWidth="520" Margin="0,8,0,0" />
            </StackPanel>

            <!-- Mode cards -->
            <UniformGrid Columns="2" Rows="1">

                <!-- Unique folders -->
                <Border Style="{StaticResource ModeCard}" MouseLeftButtonDown="OnUniqueFoldersClick">
                    <StackPanel>
                        <Border Style="{StaticResource ModeIconBox}" Background="{StaticResource Brand50}">
                            <TextBlock Style="{StaticResource ModeIcon}" Text="&#xE8B7;"
                                       Foreground="{StaticResource Brand600}" />
                        </Border>

                        <TextBlock Text="Режим «Уникальные папки»" Style="{StaticResource TextH2}" />
                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMuted}" LineHeight="18"
                                   Text="Идеально для школьных альбомов и групповых заказов. Каждая папка на диске автоматически становится отдельной фотокнигой со своей обложкой и разворотами." />

                        <StackPanel Margin="0,20,0,0">
                            <StackPanel Style="{StaticResource FeatureRow}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Emerald500}" VerticalAlignment="Center" />
                                <TextBlock Text="Автоматическое определение обложек" Style="{StaticResource TextBody}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FeatureRow}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Emerald500}" VerticalAlignment="Center" />
                                <TextBlock Text="Порядковая нумерация файлов (01-000, 01-001)" Style="{StaticResource TextBody}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FeatureRow}" Margin="0">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Emerald500}" VerticalAlignment="Center" />
                                <TextBlock Text="Пакетная обработка десятков книг в 1 клик" Style="{StaticResource TextBody}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Выбрать данный режим" Style="{StaticResource TextBody}"
                                       FontWeight="SemiBold" Foreground="{StaticResource Brand600}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Brand600}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Combined -->
                <Border Style="{StaticResource ModeCard}" MouseLeftButtonDown="OnCombinedModeClick" Margin="0">
                    <StackPanel>
                        <Border Style="{StaticResource ModeIconBox}" Background="{StaticResource Brand50}">
                            <TextBlock Style="{StaticResource ModeIcon}" Text="&#xE8F1;"
                                       Foreground="{StaticResource Brand600}" />
                        </Border>

                        <TextBlock Text="Комбинированный режим" Style="{StaticResource TextH2}" />
                        <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Foreground="{StaticResource TextMuted}" LineHeight="18"
                                   Text="Гибкий визуальный конструктор. Загружайте общий массив снимков и распределяйте фотографии по слотам вручную или через Drag-and-Drop." />

                        <StackPanel Margin="0,20,0,0">
                            <StackPanel Style="{StaticResource FeatureRow}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Brand500}" VerticalAlignment="Center" />
                                <TextBlock Text="Общий бассейн исходных снимков" Style="{StaticResource TextBody}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FeatureRow}">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Brand500}" VerticalAlignment="Center" />
                                <TextBlock Text="Ручная перетаскиваемая сетка разворотов" Style="{StaticResource TextBody}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource FeatureRow}" Margin="0">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Brand500}" VerticalAlignment="Center" />
                                <TextBlock Text="Контроль дубликатов и неиспользованных фото" Style="{StaticResource TextBody}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,24,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Выбрать данный режим" Style="{StaticResource TextBody}"
                                       FontWeight="SemiBold" Foreground="{StaticResource Brand600}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{StaticResource Brand600}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Hint: switching tabs directly is also possible -->
            <TextBlock Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,20,0,0"
                       TextAlignment="Center"
                       Text="Можно также переключиться на нужный режим прямо на вкладках вверху." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
