<UserControl x:Class="PhotoBookRenamer.Presentation.Views.StartScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource UiFont}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- p-6 (24) rounded-2xl (16) border-2 border-slate-200 -> brand-500 on hover -->
        <Style x:Key="ModeCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Slate200}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource ShadowSubtle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brand500}" />
                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- w-12 h-12 (48) rounded-2xl (16), icon text-xl (20) -->
        <Style x:Key="ModeIconBox" TargetType="Border">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <Style x:Key="ModeIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- li: flex items-center gap-2 (8) -->
        <Style x:Key="FeatureRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="CheckIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- mt-8 pt-4 border-t border-slate-100 flex justify-between text-xs font-semibold -->
        <Style x:Key="ModeFooter" TargetType="Grid">
            <Setter Property="Margin" Value="0,32,0,0" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <!-- max-w-4xl (896), py-4 (16), space-y-8 (32) -->
        <StackPanel MaxWidth="896" Margin="32,16,32,32" HorizontalAlignment="Center">

            <!-- Heading: text-center, space-y-2 (8) -->
            <StackPanel>
                <!-- px-3 py-1 (12/4) rounded-full text-xs font-semibold -->
                <Border Background="{StaticResource Brand50}" BorderBrush="{StaticResource Brand100}"
                        BorderThickness="1" CornerRadius="999" Padding="12,4"
                        HorizontalAlignment="Center">
                    <TextBlock Text="Выберите алгоритм верстки" Style="{StaticResource TextXsSemibold}"
                               Foreground="{StaticResource Brand600}" />
                </Border>
                <!-- text-2xl (24) font-bold -->
                <TextBlock Text="Как распределить фотографии?" Style="{StaticResource Text2xlBold}"
                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                <!-- text-xs slate-500 max-w-lg (512) -->
                <TextBlock Text="Выберите наиболее удобный формат организации фотокниг под ваш текущий проект"
                           Style="{StaticResource TextXs}" HorizontalAlignment="Center"
                           TextAlignment="Center" MaxWidth="512" Margin="0,8,0,0"
                           Foreground="{StaticResource Slate500}" />
            </StackPanel>

            <!-- grid-cols-2 gap-6 (24) -->
            <UniformGrid Columns="2" Margin="0,32,0,0">

                <!-- ============ Уникальные папки ============ -->
                <Border Style="{StaticResource ModeCard}" MouseLeftButtonDown="OnUniqueFoldersClick">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <Border Style="{StaticResource ModeIconBox}" Background="{StaticResource Brand50}">
                                <TextBlock Style="{StaticResource ModeIcon}" Text="&#xE8C0;"
                                           Foreground="{StaticResource Brand600}" />
                            </Border>

                            <TextBlock x:Name="UniqueTitleTextBlock" Text="Режим «Уникальные папки»"
                                       Style="{StaticResource TextLgBold}" />
                            <TextBlock Style="{StaticResource TextXs}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource Slate500}" LineHeight="18"
                                       Text="Идеально для школьных альбомов и групповых заказов. Каждая папка на диске автоматически становится отдельной фотокнигой со своей обложкой и разворотами." />

                            <!-- ul mt-5 (20) space-y-2 (8) -->
                            <StackPanel Margin="0,20,0,0">
                                <StackPanel Style="{StaticResource FeatureRow}">
                                    <TextBlock Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Emerald500}" />
                                    <TextBlock Text="Автоматическое определение обложек" Style="{StaticResource TextXs}"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FeatureRow}">
                                    <TextBlock Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Emerald500}" />
                                    <TextBlock Text="Порядковая нумерация файлов (01-000, 01-001)" Style="{StaticResource TextXs}"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FeatureRow}" Margin="0">
                                    <TextBlock Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Emerald500}" />
                                    <TextBlock Text="Пакетная обработка десятков книг в 1 клик" Style="{StaticResource TextXs}"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- footer: border-t, mt-8 pt-4 (32/16) -->
                        <Grid Grid.Row="1" Style="{StaticResource ModeFooter}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="1" Background="{StaticResource Slate100}"
                                    VerticalAlignment="Top" Margin="0,0,0,16" />
                            <TextBlock Grid.Row="0" Margin="0,16,0,0" Text="Выбрать данный режим"
                                       Style="{StaticResource TextXsSemibold}"
                                       Foreground="{StaticResource Brand600}" />
                            <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="&#xE72A;"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Brand600}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- ============ Комбинированный ============ -->
                <Border Style="{StaticResource ModeCard}" MouseLeftButtonDown="OnCombinedModeClick" Margin="24,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <!-- indigo-50 / indigo-600 (same values as brand) -->
                            <Border Style="{StaticResource ModeIconBox}" Background="{StaticResource Indigo50}">
                                <TextBlock Style="{StaticResource ModeIcon}" Text="&#xE71D;"
                                           Foreground="{StaticResource Indigo600}" />
                            </Border>

                            <TextBlock x:Name="CombinedTitleTextBlock" Text="Комбинированный режим"
                                       Style="{StaticResource TextLgBold}" />
                            <TextBlock Style="{StaticResource TextXs}" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Foreground="{StaticResource Slate500}" LineHeight="18"
                                       Text="Гибкий визуальный конструктор. Загружайте общий массив снимков и распределяйте фотографии по слотам вручную или через Drag-and-Drop." />

                            <StackPanel Margin="0,20,0,0">
                                <StackPanel Style="{StaticResource FeatureRow}">
                                    <TextBlock Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Brand500}" />
                                    <TextBlock Text="Общий бассейн исходных снимков" Style="{StaticResource TextXs}"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FeatureRow}">
                                    <TextBlock Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Brand500}" />
                                    <TextBlock Text="Ручная перетаскиваемая сетка разворотов" Style="{StaticResource TextXs}"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Style="{StaticResource FeatureRow}" Margin="0">
                                    <TextBlock Style="{StaticResource CheckIcon}" Text="&#xE73E;"
                                               Foreground="{StaticResource Brand500}" />
                                    <TextBlock Text="Контроль дубликатов и неиспользованных фото" Style="{StaticResource TextXs}"
                                               Foreground="{StaticResource Slate600}" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Row="1" Style="{StaticResource ModeFooter}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Height="1" Background="{StaticResource Slate100}"
                                    VerticalAlignment="Top" Margin="0,0,0,16" />
                            <TextBlock Grid.Row="0" Margin="0,16,0,0" Text="Выбрать данный режим"
                                       Style="{StaticResource TextXsSemibold}"
                                       Foreground="{StaticResource Brand600}" />
                            <TextBlock Grid.Row="0" HorizontalAlignment="Right" Text="&#xE72A;"
                                       FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Brand600}" />
                        </Grid>
                    </Grid>
                </Border>
            </UniformGrid>

            <TextBlock Style="{StaticResource TextXs}" HorizontalAlignment="Center" Margin="0,32,0,0"
                       TextAlignment="Center" Foreground="{StaticResource Slate500}"
                       Text="Можно также переключиться на нужный режим прямо на вкладках вверху." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
