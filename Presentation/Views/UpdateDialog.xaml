<Window x:Class="PhotoBookRenamer.Presentation.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обновление доступно"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">

    <Border Background="{StaticResource Surface}" CornerRadius="16"
            BorderBrush="{StaticResource BorderDefault}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="50" ShadowDepth="12" Direction="270"
                              Opacity="0.25" RenderingBias="Quality" Color="#000000" />
        </Border.Effect>

        <StackPanel Margin="24">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource Brand50}"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE8A7;" FontFamily="{StaticResource IconFont}" FontSize="15"
                               Foreground="{StaticResource Brand600}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Доступно обновление" Style="{StaticResource TextH3}"
                           Margin="12,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <!-- Versions -->
            <Border Background="{StaticResource Slate50}" BorderBrush="{StaticResource Slate200}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{Binding CurrentVersionText}" Style="{StaticResource TextCaption}" />
                    <TextBlock Text="{Binding LatestVersionText}" Style="{StaticResource TextBodyStrong}"
                               Foreground="{StaticResource Brand600}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <!-- Release notes -->
            <Border Background="{StaticResource Slate50}" BorderBrush="{StaticResource Slate200}"
                    BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,12">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding ReleaseNotes}" Style="{StaticResource TextCaption}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </Border>

            <!-- Progress -->
            <StackPanel Margin="0,0,0,4"
                        Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid Margin="0,0,0,6">
                    <TextBlock Text="Загрузка обновления" Style="{StaticResource TextCaption}" />
                    <TextBlock Text="{Binding DownloadProgressText}" Style="{StaticResource TextCaption}"
                               Foreground="{StaticResource Brand600}" HorizontalAlignment="Right" />
                </Grid>
                <!-- Mode=OneWay: ProgressBar.Value is TwoWay by default. -->
                <ProgressBar Value="{Binding DownloadProgress, Mode=OneWay}" Maximum="100" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Style="{StaticResource SecondaryButton}"
                        AutomationProperties.Name="Отложить"
                        Content="Отложить" Margin="0,0,8,0"
                        Command="{Binding PostponeCommand}" />
                <Button Style="{StaticResource PrimaryButton}"
                        AutomationProperties.Name="Обновить"
                        IsDefault="True" IsEnabled="{Binding CanUpdate}"
                        Command="{Binding UpdateCommand}"
                        Visibility="{Binding IsDownloading, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="Обновить" Foreground="White" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
