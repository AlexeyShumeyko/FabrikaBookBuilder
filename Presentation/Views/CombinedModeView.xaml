<UserControl x:Class="PhotoBookRenamer.Presentation.Views.CombinedModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PhotoBookRenamer.Domain"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewMouseLeftButtonDown="OnGridPreviewMouseDown">

    <UserControl.Resources>
        <!-- Book chip: brand fill when selected, as in the reference -->
        <Style x:Key="BookChip" TargetType="ListBoxItem">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Slate700}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="{StaticResource Slate100}"
                                BorderBrush="{StaticResource Slate200}" BorderThickness="1"
                                CornerRadius="12" Padding="12,6" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Slate200}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource Brand600}" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Brand600}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Pool tile -->
        <Style x:Key="PoolTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Slate100}" />
            <Setter Property="BorderBrush" Value="{StaticResource Slate200}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brand500}" />
                    <Setter Property="Effect" Value="{StaticResource ShadowSubtle}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slot: filled vs empty -->
        <Style x:Key="Slot" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Slate200}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCover}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Emerald500}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SourcePath, Converter={StaticResource HasValueConverter}}" Value="False">
                    <Setter Property="Background" Value="{StaticResource Slate50}" />
                    <Setter Property="BorderBrush" Value="{StaticResource Slate300}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1600" Margin="32,24,32,32" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Error banner -->
        <Border Grid.Row="0" Background="{StaticResource Red50}" BorderBrush="{StaticResource Red200}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextBody}"
                       Foreground="{StaticResource Red700}" TextWrapping="Wrap" />
        </Border>

        <!-- ============================================================== -->
        <!--  Book chips + structure controls                              -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,20">
            <StackPanel>

                <!-- Project name (click to rename) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Проект:" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProjectNameTextBlock" Text="{Binding DisplayProjectName}"
                               Style="{StaticResource TextH4}" Margin="6,0,0,0" VerticalAlignment="Center"
                               MaxWidth="360" TextTrimming="CharacterEllipsis" Cursor="Hand"
                               MouseLeftButtonDown="OnProjectNameClick" />
                    <TextBox x:Name="ProjectNameTextBox" Visibility="Collapsed" Width="300"
                             Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                             LostFocus="OnProjectNameLostFocus" KeyDown="OnProjectNameKeyDown" />
                </StackPanel>

                <!-- Book selection strip -->
                <Grid Visibility="{Binding HasStructure, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                        <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource Brand50}"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       Foreground="{StaticResource Brand600}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Выбор книги в тираже" Style="{StaticResource TextH4}" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0">
                                <Run Text="Всего в тираже: " />
                                <Run Text="{Binding BooksCount, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource Slate700}" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <ListBox ItemsSource="{Binding Books}"
                                     SelectedItem="{Binding SelectedBook, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource BookChip}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <!-- Without this the chips render Book.ToString(). -->
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Book}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE82D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                       Margin="0,0,6,0"
                                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                            <TextBlock FontSize="12" FontWeight="SemiBold"
                                                       Text="{Binding BookIndex, StringFormat='{}{0:00}'}" />
                                            <TextBlock FontSize="12" Margin="6,0,0,0" Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Button Style="{StaticResource SecondaryButton}"
                                    AutomationProperties.Name="Добавить книгу"
                                    Command="{Binding AddBookCommand}"
                                    VerticalAlignment="Center" BorderBrush="{StaticResource Brand200}"
                                    BorderThickness="1" Background="{StaticResource Brand50}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource Brand600}" />
                                    <TextBlock Text="Добавить книгу" Margin="6,0,0,0" Foreground="{StaticResource Brand600}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Structure setup: shown until books exist -->
                <StackPanel Visibility="{Binding HasStructure, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                    <TextBlock Text="Структура тиража" Style="{StaticResource TextH4}" />
                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,3,0,0"
                               Text="Сколько книг и разворотов в каждой. Потом можно будет добавлять и удалять." />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Книг" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding NumberOfBooks, UpdateSourceTrigger=LostFocus}"
                                     PreviewTextInput="NumberValidationTextBox" />
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Разворотов в книге" Style="{StaticResource TextCaption}" Margin="0,0,0,4" />
                            <TextBox Width="90" Text="{Binding SpreadsPerBook, UpdateSourceTrigger=LostFocus}"
                                     PreviewTextInput="NumberValidationTextBox" />
                        </StackPanel>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmStructureCommand}"
                                AutomationProperties.Name="Создать структуру" VerticalAlignment="Bottom" Padding="14,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" />
                                <TextBlock Text="Создать" Margin="6,0,0,0" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ============================================================== -->
        <!--  Pool + canvas                                                -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="260" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Loading -->
            <Border Grid.ColumnSpan="3" Background="#CC0F172A"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Обработка фотографий..." Style="{StaticResource TextBody}"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- ============ Source pool ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Загруженные фото" Style="{StaticResource TextH4}" />
                            <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,0">
                                <Run Text="Доступно: " />
                                <Run Text="{Binding AvailableFilesCount, Mode=OneWay}" FontWeight="SemiBold"
                                     Foreground="{StaticResource Slate700}" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                Command="{Binding LoadFilesCommand}"
                                AutomationProperties.Name="Загрузить фото" Padding="10,6" VerticalAlignment="Top">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                           Foreground="{StaticResource Slate400}" />
                                <TextBlock Text="Загрузить" Margin="5,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Height="1" Grid.Row="0" VerticalAlignment="Bottom" Background="{StaticResource Slate100}" />

                    <!-- Dropzone -->
                    <Border Grid.Row="1" Margin="0,14,0,0" Padding="20" Cursor="Hand"
                            Background="{StaticResource Slate50}"
                            BorderBrush="{StaticResource Slate300}" BorderThickness="2"
                            CornerRadius="12" MouseLeftButtonDown="OnUploadAreaClick"
                            AllowDrop="True" Drop="OnUploadAreaDrop">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{StaticResource Slate300}" />
                                <Setter Property="Background" Value="{StaticResource Slate50}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="BorderBrush" Value="{StaticResource Brand400}" />
                                        <Setter Property="Background" Value="{StaticResource Brand50}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                       Foreground="{StaticResource Brand500}" HorizontalAlignment="Center" />
                            <TextBlock Text="Перетащите снимки сюда" Style="{StaticResource TextBodyStrong}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="JPG, JPEG до 50 МБ" Style="{StaticResource TextMicro}"
                                       Foreground="{StaticResource TextFaint}" HorizontalAlignment="Center"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tiles -->
                    <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableFiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource PoolTile}" Width="86" Height="86" Margin="0,0,8,8"
                                            PreviewMouseLeftButtonDown="OnFileItemMouseDown"
                                            ToolTip="{Binding}">
                                        <Grid>
                                            <Image Source="{Binding Converter={StaticResource FilePathToThumbnailConverter}}"
                                                   Stretch="UniformToFill" />
                                            <!-- "In use" badge: driven by a MultiBinding because the
                                                 converter needs both the ViewModel and this
                                                 tile's own file path. A nested {Binding} as
                                                 ConverterParameter is not legal XAML. -->
                                            <Border Background="{StaticResource Emerald500}" CornerRadius="4"
                                                    Padding="4,2" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    Margin="4">
                                                <Border.Visibility>
                                                    <MultiBinding Converter="{StaticResource PoolItemUsageConverter}">
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                        <Binding />
                                                    </MultiBinding>
                                                </Border.Visibility>
                                                <TextBlock Text="Занято" Style="{StaticResource TextMicro}" Foreground="White" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" ShowsPreview="True" />

            <!-- ============ Book assembly canvas ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Canvas header -->
                    <Grid Grid.Row="0" Visibility="{Binding HasStructure, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource TextH3}">
                                <Run Text="Макет книги: " Foreground="{StaticResource TextStrong}" />
                                <Run Text="{Binding SelectedBook.Name, Mode=OneWay}" Foreground="{StaticResource Brand600}" />
                            </TextBlock>
                            <TextBlock Text="Назначьте обложку и развороты для каждой фоторамки"
                                       Style="{StaticResource TextCaption}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="{StaticResource Emerald50}" BorderBrush="{StaticResource Emerald200}"
                                    BorderThickness="1" CornerRadius="12" Padding="10,5" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                               Foreground="{StaticResource Emerald500}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding SelectedBookProgress}" Style="{StaticResource TextMicro}"
                                               Foreground="{StaticResource Emerald700}" Margin="5,0,0,0" />
                                </StackPanel>
                            </Border>

                            <Button Style="{StaticResource IconButton}" Margin="8,0,0,0"
                                    Command="{Binding DuplicateBookCommand}"
                                    CommandParameter="{Binding SelectedBook}"
                                    ToolTip="Дублировать книгу">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                            <Button Style="{StaticResource DangerGhostButton}" Margin="4,0,0,0"
                                    Command="{Binding DeleteBookCommand}"
                                    CommandParameter="{Binding SelectedBook}"
                                    ToolTip="Удалить книгу">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Empty state: no structure yet -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasStructure, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                                Background="{StaticResource Brand50}">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                       Foreground="{StaticResource Brand600}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Создайте структуру тиража" Style="{StaticResource TextH3}"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource TextCaption}" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="420" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Text="Укажите количество книг и разворотов выше, затем загрузите фотографии и перетащите их в слоты." />
                    </StackPanel>

                    <!-- Slots -->
                    <ScrollViewer Grid.Row="1" Margin="0,16,0,0" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasStructure, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding SelectedBook.AllSlotsPages}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Page}">
                                    <Border Width="196" AllowDrop="True"
                                            Tag="{Binding}"
                                            Drop="OnSlotDrop" DragOver="OnSlotDragOver"
                                            MouseLeftButtonDown="OnSlotClick">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Slot}" />
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Header: export name + role -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="{StaticResource Slate200}"
                                                        CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding ExportFileName}" FontSize="10"
                                                               FontFamily="{StaticResource MonoFont}" FontWeight="Bold"
                                                               Foreground="{StaticResource Slate700}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Style="{StaticResource TextMicro}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                                           Foreground="{StaticResource Slate500}"
                                                           Text="{Binding IsCover, Converter={StaticResource SlotRoleConverter}}" />
                                            </Grid>

                                            <!-- Preview or empty prompt -->
                                            <Border Grid.Row="1" Height="104" Margin="0,10,0,0" CornerRadius="10"
                                                    Background="{StaticResource Slate100}"
                                                    BorderBrush="{StaticResource Slate200}" BorderThickness="1"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Image Source="{Binding Converter={StaticResource PageSourceConverter}}"
                                                           Stretch="UniformToFill" Tag="{Binding}"
                                                           MouseLeftButtonDown="OnImageDoubleClick"
                                                           Visibility="{Binding SourcePath, Converter={StaticResource HasValueConverter}}" />

                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                Visibility="{Binding SourcePath, Converter={StaticResource InverseHasValueConverter}}">
                                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="20" Foreground="{StaticResource Slate300}"
                                                                   HorizontalAlignment="Center" />
                                                        <TextBlock Text="Перетащите фото" Style="{StaticResource TextCaption}"
                                                                   Foreground="{StaticResource Slate400}"
                                                                   HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Footer -->
                                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                           Style="{StaticResource TextMicro}"
                                                           Foreground="{StaticResource Slate500}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SourcePath}" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                            Tag="{Binding}" Click="OnMovePageLeftClick"
                                                            ToolTip="Левее">
                                                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                            Tag="{Binding}" Click="OnMovePageRightClick"
                                                            ToolTip="Правее" Margin="2,0,0,0">
                                                        <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                            Tag="{Binding}" Click="OnDuplicateToAllClick"
                                                            ToolTip="Применить ко всем книгам" Margin="6,0,0,0">
                                                        <TextBlock Text="&#xE8AB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                                                    </Button>
                                                    <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                                                            Tag="{Binding}" Click="OnDeletePageClick"
                                                            ToolTip="Очистить слот" Margin="2,0,0,0">
                                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                                   Foreground="{StaticResource Red500}" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
