<UserControl x:Class="PhotoBookRenamer.Presentation.Views.CombinedModeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PhotoBookRenamer.Domain"
             FontFamily="{StaticResource UiFont}"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             PreviewMouseLeftButtonDown="OnGridPreviewMouseDown">

    <UserControl.Resources>
        <!--
          Slot card. rounded-xl (12) with a 1px slate-200 border; the cover gets a 2px
          emerald border, as in the mockup. The corner radius is applied to the CONTENT
          through a rounded Clip, not just to the Border: ClipToBounds clips to the
          bounding rectangle, so a photo flush with the card would paint its square
          corners straight over the rounding.
        -->
        <Style x:Key="Slot" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource Slate200}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCover}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brand500}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
          The action buttons sit ON the photo rather than in a header row, because the
          frame is as narrow as 120px for a very portrait book and a header with a file
          name plus buttons would not fit at any width.
        -->
        <Style x:Key="SlotAction" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Slate600}" />
        </Style>

        <!-- One row of the file list: small thumb, name, pixel size, status -->
        <Style x:Key="FileRow" TargetType="Border">
            <Setter Property="Padding" Value="8" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Slate50}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1600" Margin="32,24,32,24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Error banner -->
        <Border Grid.Row="0" Background="{StaticResource Red50}" BorderBrush="{StaticResource Red200}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextXs}"
                       Foreground="{StaticResource Red700}" TextWrapping="Wrap" />
        </Border>

        <!-- ============================================================== -->
        <!--  Control panel. A deliberate copy of the unique mode's one:  -->
        <!--  Card + Padding 20, a 48x48 mode badge, "Проект:" + name +    -->
        <!--  pencil, one grey summary line, the same button styles.       -->
        <!--  The run fields sit in the CENTRE, held between two star      -->
        <!--  columns so they stay in the middle whatever the window does.  -->
        <!-- ============================================================== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,24"
                Effect="{StaticResource ShadowSubtle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- Left: mode badge, project name, one summary line -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- p-3 indigo-50 rounded-xl border indigo-100, glyph 20 -->
                    <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center"
                            Background="{StaticResource Indigo50}" BorderBrush="{StaticResource Indigo100}"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                              Opacity="0.05" RenderingBias="Quality" Color="#0F172A" />
                        </Border.Effect>
                        <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   Foreground="{StaticResource Indigo600}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Проект:" Style="{StaticResource TextSmBold}" VerticalAlignment="Center" />
                            <TextBlock x:Name="ProjectNameTextBlock" Text="{Binding DisplayProjectName}"
                                       Style="{StaticResource TextSmBold}" Margin="6,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       MaxWidth="420" Cursor="Hand"
                                       MouseLeftButtonDown="OnProjectNameClick" />
                            <Button Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                    Click="OnProjectNamePencilClick"
                                    ToolTip="Переименовать проект"
                                    AutomationProperties.Name="Переименовать проект">
                                <TextBlock Text="&#xE70F;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                            </Button>
                            <TextBox x:Name="ProjectNameTextBox" Visibility="Collapsed" Width="360"
                                     Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                     LostFocus="OnProjectNameLostFocus" KeyDown="OnProjectNameKeyDown" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding StructureProgress}" Style="{StaticResource TextXs}"
                                       Foreground="{StaticResource Slate500}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Centre: the run. Star columns on both sides hold it in the middle. -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="24,0">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Книг" Style="{StaticResource TextMicro}"
                                   Foreground="{StaticResource Slate500}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource NumberField}"
                                 Text="{Binding NumberOfBooks, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Количество книг"
                                 PreviewTextInput="NumberValidationTextBox" />
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Разворотов" Style="{StaticResource TextMicro}"
                                   Foreground="{StaticResource Slate500}" Margin="0,0,0,4" />
                        <TextBox Style="{StaticResource NumberField}"
                                 Text="{Binding SpreadsPerBook, UpdateSourceTrigger=LostFocus}"
                                 AutomationProperties.Name="Разворотов в книге"
                                 PreviewTextInput="NumberValidationTextBox" />
                    </StackPanel>
                    <!-- One button, two labels. A second button that appears with the
                         first book is exactly what used to reshape this panel. -->
                    <Button Style="{StaticResource PrimaryButton}" Padding="16,8" VerticalAlignment="Bottom"
                            Command="{Binding ConfirmStructureCommand}"
                            AutomationProperties.Name="Добавить структуру">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                            <TextBlock Text="{Binding StructureButtonText}" Margin="6,0,0,0" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Right: what you do with the project. Same buttons as the unique mode. -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <Button Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"
                            Command="{Binding SaveProjectCommand}"
                            AutomationProperties.Name="Сохранить проект"
                            ToolTip="Сохранить проект и вернуться к списку проектов">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Slate400}" />
                            <TextBlock Text="Сохранить проект" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <Border Width="1" Height="20" Background="{StaticResource Slate200}" Margin="0,0,8,0" />

                    <Button Style="{StaticResource PrimaryButton}" Padding="16,8"
                            Command="{Binding ExportCommand}"
                            AutomationProperties.Name="Экспортировать все книги"
                            ToolTip="Выгрузка всех книг проекта в одну папку">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                            <TextBlock Text="Экспортировать все книги" Margin="6,0,0,0" Foreground="White" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================== -->
        <!--  Two areas of equal height: a narrow file list and the books.  -->
        <!-- ============================================================== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="280" MaxWidth="360" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- Loading -->
            <Border Grid.ColumnSpan="3" Style="{StaticResource LoadingVeil}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border Style="{StaticResource LoadingVeilCard}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                   Foreground="{StaticResource Brand600}" VerticalAlignment="Center" />
                        <TextBlock Text="Обработка фотографий..." Style="{StaticResource TextXsMedium}"
                                   Foreground="{StaticResource Slate600}" Margin="8,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Border>

            <!-- ============ The file list ============ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16"
                    Effect="{StaticResource ShadowSubtle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header: title, count, load button -->
                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Загруженные фото" Style="{StaticResource TextSmBold}" />
                        <TextBlock Style="{StaticResource TextXs}" Margin="0,2,0,0"
                                   Foreground="{StaticResource Slate500}">
                            <Run Text="Доступно: " />
                            <Run Text="{Binding AvailableFilesCount, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{StaticResource Slate700}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- Load button, full width of the narrow column -->
                    <Button Grid.Row="1" Margin="0,12,0,0"
                            Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="Загрузить фото"
                            Command="{Binding LoadFilesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                       Foreground="{StaticResource Slate400}" />
                            <TextBlock Text="Загрузить фото" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>

                    <!-- Compact dropzone: one line, the list is the main event here -->
                    <Border x:Name="DropZone" Grid.Row="2" Margin="0,8,0,0" Cursor="Hand"
                            Background="{StaticResource Slate50}"
                            AllowDrop="True" Drop="OnUploadAreaDrop"
                            MouseLeftButtonDown="OnUploadAreaClick">
                        <Grid>
                            <Rectangle>
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle" BasedOn="{StaticResource DashedFrameInset}">
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                         Binding="{Binding IsMouseOver, ElementName=DropZone}">
                                                <Setter Property="Stroke" Value="{StaticResource Brand400}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                            </Rectangle>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="10">
                                <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" FontSize="14"
                                           Foreground="{StaticResource Brand500}" VerticalAlignment="Center" />
                                <TextBlock Text="Перетащите фото" Style="{StaticResource TextXsSemibold}"
                                           Foreground="{StaticResource Slate700}"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Search, then the rows -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Search. The hint is a TextBlock behind the box rather than a
                             watermark property, because the project has no such style and
                             this is the only field that needs one. -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <TextBox Padding="8,6"
                                     Text="{Binding PhotoSearch, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Поиск по имени файла" />
                            <TextBlock Text="Поиск по имени файла" IsHitTestVisible="False"
                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource TextXs}"
                                       Foreground="{StaticResource Slate400}"
                                       Visibility="{Binding PhotoSearch, Converter={StaticResource InverseStringToVisibilityConverter}}" />
                        </Grid>

                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding FilteredPhotoFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PhotoFileInfo}">
                                        <Border Style="{StaticResource FileRow}" Margin="0,0,0,2"
                                                PreviewMouseLeftButtonDown="OnFileItemMouseDown"
                                                ToolTip="{Binding Path}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Small square thumb -->
                                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                                        Background="{StaticResource Slate100}" ClipToBounds="True">
                                                    <Image Source="{Binding Path, Converter={StaticResource FilePathToThumbnailConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource TextXsMedium}"
                                                               Foreground="{StaticResource Slate700}"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding DimensionsText}"
                                                               Style="{StaticResource TextTiny}"
                                                               Foreground="{StaticResource Slate400}" />
                                                </StackPanel>

                                                <!-- Free / assigned / shared -->
                                                <Border Grid.Column="1" HorizontalAlignment="Right"
                                                        VerticalAlignment="Center" CornerRadius="6" Padding="6,2"
                                                        Background="{Binding Usage, Converter={StaticResource PhotoUsageToBrushConverter}}">
                                                    <TextBlock Text="{Binding UsageText}" FontSize="10" FontWeight="Bold"
                                                               Foreground="{Binding Usage, Converter={StaticResource PhotoUsageToBrushConverter}, ConverterParameter=text}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ The books, one after another ============ -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"
                    Effect="{StaticResource ShadowSubtle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12"
                                Visibility="{Binding HasStructure, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Style="{StaticResource TextBaseBold}">
                            <Run Text="Книги тиража" Foreground="{StaticResource TextStrong}" />
                        </TextBlock>
                        <TextBlock Text="Каждая книга идёт следующей. Обложка и развороты — перетащите фото из списка."
                                   Style="{StaticResource TextXs}" Margin="0,3,0,0"
                                   Foreground="{StaticResource Slate500}" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Empty state: no structure yet -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding HasStructure, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                                Background="{StaticResource Brand50}">
                            <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                       Foreground="{StaticResource Brand600}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Создайте структуру тиража" Style="{StaticResource TextBaseBold}"
                                   HorizontalAlignment="Center" Margin="0,18,0,0" />
                        <TextBlock Style="{StaticResource TextXs}" TextAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="420" HorizontalAlignment="Center" Margin="0,8,0,0"
                                   Foreground="{StaticResource Slate500}"
                                   Text="Укажите количество книг и разворотов в панели выше, затем загрузите фотографии и перетащите их в слоты." />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasStructure, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl ItemsSource="{Binding Books}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:Book}">
                                    <!--
                                      Each book is its own white card. Without the card the
                                      books ran together into one field and there was no
                                      way to tell where one book ended and the next began.
                                    -->
                                    <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"
                                            Effect="{StaticResource ShadowSubtle}">
                                    <StackPanel>
                                        <!-- Book header: number, name, readiness, whole-book actions -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- The number IS the name. It used to be "01" in
                                                     the tile and "Книга 1" next to it, which said
                                                     the same thing twice. -->
                                                <Border Background="{StaticResource Brand600}" CornerRadius="8"
                                                        Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="White">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="{Binding BookIndex, StringFormat='Книга {0:D2}'}" />
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                                <TextBlock Text="{Binding ProgressText}"
                                                           Style="{StaticResource TextXs}"
                                                           Foreground="{StaticResource Slate500}"
                                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Style="{StaticResource IconButton}"
                                                        Command="{Binding DataContext.DuplicateBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Дублировать книгу"
                                                        ToolTip="Дублировать книгу">
                                                    <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </Button>
                                                <Button Style="{StaticResource DangerGhostButton}" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="Удалить книгу"
                                                        ToolTip="Удалить книгу">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Slots: adaptive width, so a WrapPanel, not columns -->
                                        <ItemsControl ItemsSource="{Binding AllSlotsPages}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type models:Page}">
                                                    <Border Style="{StaticResource Slot}"
                                                            x:Name="SlotCard"
                                                            Tag="{Binding}"
                                                            AllowDrop="True" Drop="OnSlotDrop" DragOver="OnSlotDragOver"
                                                            MouseLeftButtonDown="OnSlotClick">
                                                        <Grid>
                                                            <Grid.Clip>
                                                                <!-- Rounded, so the photo cannot paint
                                                                     square corners over the border. -->
                                                                <MultiBinding Converter="{StaticResource RoundedClipGeometryConverter}" ConverterParameter="12">
                                                                    <Binding Path="ActualWidth" ElementName="SlotContent" />
                                                                    <Binding Path="ActualHeight" ElementName="SlotContent" />
                                                                </MultiBinding>
                                                            </Grid.Clip>

                                                            <Grid x:Name="SlotContent">
                                                                <!--
                                                                    Pinned to the frame's own width. Without this the
                                                                    card is only as wide as its widest child, so
                                                                    revealing "Во все книги" on hover PUSHED the card
                                                                    wider and the row reflowed. The frame below is
                                                                    the sizing authority; nothing may outvote it.
                                                                -->
                                                                <Grid.Width>
                                                                    <MultiBinding Converter="{StaticResource AdaptiveCardSizeConverter}" ConverterParameter="width">
                                                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=ItemsControl}" />
                                                                        <Binding />
                                                                    </MultiBinding>
                                                                </Grid.Width>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto" />
                                                                    <RowDefinition Height="Auto" />
                                                                </Grid.RowDefinitions>

                                                                <!-- The frame: natural 190px tall by the
                                                                     book's own format, both sides scaled
                                                                     together when a whole extra card per row
                                                                     is within reach. -->
                                                                <Grid Grid.Row="0" Background="{StaticResource Slate100}">
                                                                    <Grid.Width>
                                                                        <MultiBinding Converter="{StaticResource AdaptiveCardSizeConverter}" ConverterParameter="width">
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=ItemsControl}" />
                                                                            <Binding />
                                                                        </MultiBinding>
                                                                    </Grid.Width>
                                                                    <Grid.Height>
                                                                        <MultiBinding Converter="{StaticResource AdaptiveCardSizeConverter}" ConverterParameter="height">
                                                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource FindAncestor, AncestorType=ItemsControl}" />
                                                                            <Binding />
                                                                        </MultiBinding>
                                                                    </Grid.Height>

                                                                    <Image Source="{Binding Converter={StaticResource PageSourceConverter}}"
                                                                           Stretch="UniformToFill" Tag="{Binding}"
                                                                           MouseLeftButtonDown="OnImageDoubleClick"
                                                                           Visibility="{Binding SourcePath, Converter={StaticResource HasValueConverter}}">
                                                                        <Image.RenderTransform>
                                                                            <ScaleTransform x:Name="PhotoZoom" CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                                                        </Image.RenderTransform>
                                                                    </Image>

                                                                    <!-- Empty: dashed frame, a plus in a circle and
                                                                         what this slot is waiting for -->
                                                                    <Rectangle Style="{StaticResource DashedFrame}" RadiusX="7" RadiusY="7"
                                                                               Visibility="{Binding SourcePath, Converter={StaticResource InverseHasValueConverter}}" />
                                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                                Visibility="{Binding SourcePath, Converter={StaticResource InverseHasValueConverter}}">
                                                                        <Border Width="28" Height="28" CornerRadius="14"
                                                                                Background="{StaticResource Slate100}"
                                                                                HorizontalAlignment="Center">
                                                                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}"
                                                                                       FontSize="12" Foreground="{StaticResource Slate400}"
                                                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock Foreground="{StaticResource Slate600}"
                                                                                   TextAlignment="Center" Margin="0,8,0,0">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextTiny}">
                                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                                    <Setter Property="Text" Value="Слот пуст" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsCover}" Value="True">
                                                                                            <Setter Property="Text" Value="Обложка" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>
                                                                        <TextBlock Text="Перетащите сюда фото" Style="{StaticResource TextMicro}"
                                                                                   Foreground="{StaticResource Slate400}"
                                                                                   HorizontalAlignment="Center" Margin="0,2,0,0" />
                                                                    </StackPanel>

                                                                    <!-- Triggers -->
                                                                    <Grid.Triggers>
                                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="PhotoZoom"
                                                                                                     Storyboard.TargetProperty="ScaleX" To="1.04" Duration="0:0:0" />
                                                                                    <DoubleAnimation Storyboard.TargetName="PhotoZoom"
                                                                                                     Storyboard.TargetProperty="ScaleY" To="1.04" Duration="0:0:0" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                                            <BeginStoryboard>
                                                                                <Storyboard>
                                                                                    <DoubleAnimation Storyboard.TargetName="PhotoZoom"
                                                                                                     Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0" />
                                                                                    <DoubleAnimation Storyboard.TargetName="PhotoZoom"
                                                                                                     Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0" />
                                                                                </Storyboard>
                                                                            </BeginStoryboard>
                                                                        </EventTrigger>
                                                                    </Grid.Triggers>
                                                                </Grid>

                                                                <!--
                                                                  Footer: what this slot is on the left, what you
                                                                  can do with it on the right. "Заменить" is
                                                                  deliberately NOT here - the owner never asked for
                                                                  it, and clearing the slot covers the same need.
                                                                -->
                                                                <Border Grid.Row="1" BorderThickness="0,1,0,0"
                                                                        BorderBrush="{StaticResource Slate100}"
                                                                        Padding="10,7,8,8"
                                                                        AllowDrop="True" Drop="OnSlotDrop" DragOver="OnSlotDragOver">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Background" Value="Transparent" />
                                                                            <Style.Triggers>
                                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                                    <Setter Property="Background" Value="{StaticResource Slate50}" />
                                                                                </Trigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>

                                                                        <!-- "Обложка" / "Разворот 2 (Сквозной)" / "Пустой слот" -->
                                                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                                                   Text="{Binding SlotLabel}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding SourcePath}">
                                                                            <TextBlock.Style>
                                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TextTiny}">
                                                                                    <Setter Property="Foreground" Value="{StaticResource Slate500}" />
                                                                                    <Style.Triggers>
                                                                                        <DataTrigger Binding="{Binding IsSlotLabelAccent}" Value="True">
                                                                                            <Setter Property="Foreground" Value="{StaticResource Brand600}" />
                                                                                            <Setter Property="FontWeight" Value="Bold" />
                                                                                        </DataTrigger>
                                                                                    </Style.Triggers>
                                                                                </Style>
                                                                            </TextBlock.Style>
                                                                        </TextBlock>

                                                                        <!-- Apply to every book (a word, on hover) and
                                                                             clear the slot (always visible) -->
                                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                            <!--
                                                                              A word, not an icon: applying a
                                                                              photo to the whole run is the one
                                                                              action a photographer has to be
                                                                              sure about, so it says what it does.
                                                                            -->
                                                                            <TextBlock Text="Во все книги"
                                                                                       FontSize="11" FontWeight="Bold"
                                                                                       Foreground="{StaticResource Brand600}"
                                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="Поставить это фото в ту же позицию всех книг"
                                                                                       Tag="{Binding}" MouseLeftButtonDown="OnDuplicateToAllClick">
                                                                                <TextBlock.Style>
                                                                                    <Style TargetType="TextBlock">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                        <Style.Triggers>
                                                                                            <!-- MultiDataTrigger, NOT MultiTrigger: a
                                                                                                 MultiTrigger condition takes a
                                                                                                 literal property, never a
                                                                                                 binding, and throws at seal
                                                                                                 time when given one. -->
                                                                                            <MultiDataTrigger>
                                                                                                <MultiDataTrigger.Conditions>
                                                                                                    <Condition Binding="{Binding IsMouseOver, ElementName=SlotCard}" Value="True" />
                                                                                                    <Condition Binding="{Binding SourcePath, Converter={StaticResource HasValueConverter}}" Value="True" />
                                                                                                    <!-- Already run-wide: there is nothing left to
                                                                                                         apply, so the action is hidden. -->
                                                                                                    <Condition Binding="{Binding IsShared}" Value="False" />
                                                                                                </MultiDataTrigger.Conditions>
                                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                            </MultiDataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </TextBlock.Style>
                                                                            </TextBlock>

                                                                            <Button Style="{StaticResource SlotAction}" Tag="{Binding}"
                                                                                    Click="OnDeletePageClick"
                                                                                    AutomationProperties.Name="Очистить слот"
                                                                                    ToolTip="Убрать фото из слота"
                                                                                    Visibility="{Binding SourcePath, Converter={StaticResource HasValueConverter}}">
                                                                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                                                           Foreground="{StaticResource Red500}" />
                                                                            </Button>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
