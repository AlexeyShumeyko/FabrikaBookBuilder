<UserControl x:Class="PhotoBookRenamer.Presentation.Views.UniqueFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PhotoBookRenamer.Domain"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- Контейнер книги: белый блок с рамкой, внутри шапка и ряд разворотов -->
        <Style x:Key="BookBlock" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,0,24" />
            <Setter Property="Effect" Value="{StaticResource ShadowSubtle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Номер книги: 28x28 rounded-lg indigo-50 / indigo-600 -->
        <Style x:Key="BookIndexBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Indigo50}" />
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!-- Карточка разворота: фото прижато к краям, скругление режет фото -->
        <Style x:Key="SpreadCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Effect" Value="{StaticResource ShadowSubtle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Плашка имени файла поверх фото: slate-900, rounded-md, mono -->
        <Style x:Key="PhotoNameBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Slate900}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
        </Style>

        <!-- Пилюля со стрелками в подвале карточки -->
        <Style x:Key="ArrowPill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Slate100}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="2" />
        </Style>

        <!-- p-1 arrows in the card footer -->
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource Slate400}" />
        </Style>

        <Style x:Key="LinkText" TargetType="TextBlock" BasedOn="{StaticResource TextXs}">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1600" Margin="32,24,32,24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Error banner -->
        <Border Grid.Row="0" Background="{StaticResource Red50}" BorderBrush="{StaticResource Red200}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextXs}"
                       Foreground="{StaticResource Red700}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,24"
              Visibility="{Binding ErrorMessage, Converter={StaticResource InverseStringToVisibilityConverter}}">
            <!-- ============================================================== -->
            <!--  Toolbar: p-5 (20), gap-4 (16)                               -->
            <!-- ============================================================== -->
            <Border Style="{StaticResource Card}" Padding="20" Effect="{StaticResource ShadowSubtle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- p-3 emerald-50 rounded-xl border emerald-100 -->
                        <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center"
                                Background="{StaticResource Emerald50}" BorderBrush="{StaticResource Emerald100}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                                  Opacity="0.05" RenderingBias="Quality" Color="#0F172A" />
                            </Border.Effect>
                            <TextBlock Text="&#xE8C0;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{StaticResource Emerald600}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Папка:" Style="{StaticResource TextSmBold}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProjectNameTextBlock" Text="{Binding DisplayProjectName}"
                                           Style="{StaticResource TextSmBold}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="420" Cursor="Hand"
                                           MouseLeftButtonDown="OnProjectNameClick" />
                                <TextBox x:Name="ProjectNameTextBox" Visibility="Collapsed" Width="360"
                                         Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                         LostFocus="OnProjectNameLostFocus" KeyDown="OnProjectNameKeyDown" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding BooksSummary}" Style="{StaticResource TextXs}"
                                           Foreground="{StaticResource Slate500}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding LoadFoldersCommand}"
                                AutomationProperties.Name="Выбрать папки" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Slate400}" />
                                <TextBlock Text="Сменить папку" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetOrderCommand}"
                                AutomationProperties.Name="Сбросить порядок" Margin="0,0,8,0"
                                ToolTip="Вернуть развороты в исходный порядок по именам файлов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Slate400}" />
                                <TextBlock Text="Сбросить порядок" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- h-5 w-px divider -->
                        <Border Width="1" Height="20" Background="{StaticResource Slate200}" Margin="0,0,8,0" />

                        <Button Style="{StaticResource PrimaryButton}" Padding="16,8"
                                Command="{Binding ExportCommand}"
                                AutomationProperties.Name="Экспортировать" IsEnabled="{Binding CanExport}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                                <TextBlock Text="Экспортировать эту книгу" Margin="6,0,0,0" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!--  Content                                                       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Border Background="#CC0F172A" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Обработка папок..." Style="{StaticResource TextXs}"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" Padding="24" MaxWidth="560" HorizontalAlignment="Center"
                            Margin="0,40,0,0" Effect="{StaticResource ShadowSubtle}"
                            Visibility="{Binding BooksCount, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                                    Background="{StaticResource Emerald50}">
                                <TextBlock Text="&#xE8C0;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                           Foreground="{StaticResource Emerald600}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Выберите папки с фотографиями" Style="{StaticResource TextLgBold}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0" TextAlignment="Center" />
                            <TextBlock Style="{StaticResource TextXs}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource Slate500}"
                                       MaxWidth="420" HorizontalAlignment="Center" Margin="0,8,0,20"
                                       Text="Каждая папка станет отдельной книгой. Самое большое фото в папке определится как обложка, остальные — как развороты." />
                            <Button Style="{StaticResource PrimaryButton}" Padding="16,10"
                                    Command="{Binding LoadFoldersCommand}"
                                    HorizontalAlignment="Center" AutomationProperties.Name="Выбрать папки">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                                    <TextBlock Text="Выбрать папки" Margin="6,0,0,0" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--
                        UniformGrid Columns="4" keeps md:2 lg:3 xl:4 from the mockup.
                        The gap is now 16 (card Margin), see doc/DESIGN_SPEC.md 5.2.
                    -->
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Book}">
                                <Border Style="{StaticResource BookBlock}">
                                    <StackPanel>

                                        <!-- Book header -->
                                        <Grid Margin="0,0,0,16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Style="{StaticResource BookIndexBadge}">
                                                    <TextBlock Text="{Binding BookIndex, StringFormat={}{0:D2}}"
                                                               Style="{StaticResource TextXsBold}"
                                                               Foreground="{StaticResource Indigo600}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource TextSmBold}"
                                                           Foreground="{StaticResource TextStrong}"
                                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                                           MaxWidth="460" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <TextBlock Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"
                                                       HorizontalAlignment="Left" TextAlignment="Left"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="460"
                                                       ToolTip="{Binding FolderPath}"
                                                       Visibility="{Binding FolderPath, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Run Text="(Папка: " Foreground="{StaticResource Slate400}" FontSize="12" />
                                                <Run Text="{Binding FolderPath}" Foreground="{StaticResource Slate400}" FontSize="12" />
                                            </TextBlock>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <!-- fa-circle-check: every slot is filled -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsValid, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" Foreground="{StaticResource Emerald600}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Структура корректна"
                                                               Style="{StaticResource TextXsSemibold}"
                                                               Foreground="{StaticResource Emerald600}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding IsValid, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}"
                                                               FontSize="12" Foreground="{StaticResource Amber600}"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Text="Структура неполная"
                                                               Style="{StaticResource TextXsSemibold}"
                                                               Foreground="{StaticResource Amber600}"
                                                               VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>

                                                <Button Margin="12,0,0,0" Style="{StaticResource DangerGhostButton}"
                                                        ToolTip="Удалить книгу"
                                                        AutomationProperties.Name="Удалить книгу"
                                                        Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                    <ItemsControl ItemsSource="{Binding AllSlotsPages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:Page}">
                                                <Border x:Name="CardRoot">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource SpreadCard}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCover}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Brand500}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <!-- Photo: 16/10, clipped by the card's own corner radius -->
                                                        <Grid Grid.Row="0" x:Name="FrameHost"
                                                              Background="{StaticResource Slate100}">
                                                            <Grid.Height>
                                                                <MultiBinding Converter="{StaticResource AspectHeightConverter}">
                                                                    <Binding Path="ActualWidth" ElementName="FrameHost" />
                                                                    <Binding />
                                                                </MultiBinding>
                                                            </Grid.Height>

                                                            <Image Source="{Binding Converter={StaticResource PageSourceConverter}}"
                                                                   Stretch="UniformToFill" Tag="{Binding}"
                                                                   MouseLeftButtonDown="OnPageImageDoubleClick">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                                                                        <Setter Property="RenderTransform">
                                                                            <Setter.Value>
                                                                                <ScaleTransform ScaleX="1" ScaleY="1" />
                                                                            </Setter.Value>
                                                                        </Setter>
                                                                        <Style.Triggers>
                                                                            <!-- No overlay on hover: the photo just grows a little.
                                                                                 The card's ClipToBounds trims what leaves the frame.
                                                                                 The transform is swapped rather than animated on purpose:
                                                                                 Storyboard.TargetName does not compile inside a
                                                                                 DataTemplate trigger (MC4011). -->
                                                                            <DataTrigger Value="True" Binding="{Binding IsMouseOver, ElementName=CardRoot}">
                                                                                <Setter Property="RenderTransform">
                                                                                    <Setter.Value>
                                                                                        <ScaleTransform ScaleX="1.04" ScaleY="1.04" />
                                                                                    </Setter.Value>
                                                                                </Setter>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>

                                                            <!-- export file name on the photo; star + (Обложка) on the cover -->
                                                            <Border Style="{StaticResource PhotoNameBadge}"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Top"
                                                                    Margin="10">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                                                               FontSize="10" Foreground="White"
                                                                               VerticalAlignment="Center" Margin="0,0,6,0"
                                                                               Visibility="{Binding IsCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                    <TextBlock Text="{Binding ExportFileName}"
                                                                               Style="{StaticResource TextMono}"
                                                                               FontSize="12" Foreground="White"
                                                                               VerticalAlignment="Center" />
                                                                    <TextBlock Text="(Обложка)"
                                                                               Style="{StaticResource TextXsSemibold}"
                                                                               Foreground="White" VerticalAlignment="Center"
                                                                               Margin="6,0,0,0"
                                                                               Visibility="{Binding IsCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Footer: caption / on-hover action + arrow pill -->
                                                        <Grid Grid.Row="1" Margin="10,8,10,10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <Grid Grid.Column="0">
                                                                <!-- One element, four states. It was four overlapping TextBlocks before, and
                                                                     the caption could not be hidden on hover, so the link was drawn on top of
                                                                     "Разворот N". A single TextBlock cannot overlap itself. -->
                                                                <TextBlock VerticalAlignment="Center" Tag="{Binding}"
                                                                           MouseLeftButtonDown="OnFooterActionClick">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock" BasedOn="{StaticResource TextXsSemibold}">
                                                                            <Setter Property="Foreground" Value="{StaticResource Slate500}" />
                                                                            <Setter Property="Text">
                                                                                <Setter.Value>
                                                                                    <Binding Path="Index" StringFormat="Разворот {0}" />
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Setter Property="AutomationProperties.Name" Value="Действие с разворотом" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCover}" Value="True">
                                                                                    <Setter Property="Text" Value="Обложка" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource Brand600}" />
                                                                                </DataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsCover}" Value="True" />
                                                                                        <Condition Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Text" Value="Заменить" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource Brand600}" />
                                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                                    <Setter Property="AutomationProperties.Name" Value="Заменить обложку" />
                                                                                </MultiDataTrigger>
                                                                                <MultiDataTrigger>
                                                                                    <MultiDataTrigger.Conditions>
                                                                                        <Condition Binding="{Binding IsCover}" Value="False" />
                                                                                        <Condition Binding="{Binding IsMouseOver, ElementName=CardRoot}" Value="True" />
                                                                                    </MultiDataTrigger.Conditions>
                                                                                    <Setter Property="Text" Value="Назначить обложкой" />
                                                                                    <Setter Property="Foreground" Value="{StaticResource Emerald600}" />
                                                                                    <Setter Property="Cursor" Value="Hand" />
                                                                                    <Setter Property="AutomationProperties.Name" Value="Назначить обложкой" />
                                                                                </MultiDataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Grid>

                                                            <Border Grid.Column="1" Style="{StaticResource ArrowPill}"
                                                                    VerticalAlignment="Center"
                                                                    Visibility="{Binding IsCover, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Button Style="{StaticResource ArrowButton}" Tag="{Binding}"
                                                                            Click="OnMovePageLeftClick" ToolTip="Переместить левее"
                                                                            AutomationProperties.Name="Переместить левее">
                                                                        <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                                                    </Button>
                                                                    <Border Width="1" Margin="2,0" Background="{StaticResource Slate200}" />
                                                                    <Button Style="{StaticResource ArrowButton}" Tag="{Binding}"
                                                                            Click="OnMovePageRightClick" ToolTip="Переместить правее"
                                                                            AutomationProperties.Name="Переместить правее">
                                                                        <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Border>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
