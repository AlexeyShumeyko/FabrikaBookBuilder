<UserControl x:Class="PhotoBookRenamer.Presentation.Views.UniqueFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PhotoBookRenamer.Domain"
             FontFamily="{StaticResource UiFont}"
             UseLayoutRounding="True" SnapsToDevicePixels="True"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

    <UserControl.Resources>
        <!-- p-4 rounded-2xl, 1px border; hover shadow-card -->
        <Style x:Key="SpreadCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,24,24" />
            <Setter Property="Effect" Value="{StaticResource ShadowSubtle}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ОБЛОЖКА badge: px-2.5 py-1 rounded-md text-xs font-bold bg-emerald-500 -->
        <Style x:Key="CoverBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Emerald500}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Effect" Value="{StaticResource ShadowSm}" />
        </Style>

        <!-- Разворот N badge: px-2.5 py-1 rounded-md text-xs font-semibold slate -->
        <Style x:Key="SpreadBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Slate100}" />
            <Setter Property="BorderBrush" Value="{StaticResource Slate200}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- Filename chip: px-2 py-0.5 rounded text-xs font-mono font-bold -->
        <Style x:Key="FileChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Slate100}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2" />
        </Style>

        <!-- p-1 arrows in the card footer -->
        <Style x:Key="ArrowButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Padding" Value="4" />
            <Setter Property="Foreground" Value="{StaticResource Slate400}" />
        </Style>

        <Style x:Key="LinkText" TargetType="TextBlock" BasedOn="{StaticResource TextXs}">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1600" Margin="32,24,32,24" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Error banner -->
        <Border Grid.Row="0" Background="{StaticResource Red50}" BorderBrush="{StaticResource Red200}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextXs}"
                       Foreground="{StaticResource Red700}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,24"
              Visibility="{Binding ErrorMessage, Converter={StaticResource InverseStringToVisibilityConverter}}">
            <!-- ============================================================== -->
            <!--  Toolbar: p-5 (20), gap-4 (16)                               -->
            <!-- ============================================================== -->
            <Border Style="{StaticResource Card}" Padding="20" Effect="{StaticResource ShadowSubtle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- p-3 emerald-50 rounded-xl border emerald-100 -->
                        <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center"
                                Background="{StaticResource Emerald50}" BorderBrush="{StaticResource Emerald100}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                                  Opacity="0.05" RenderingBias="Quality" Color="#0F172A" />
                            </Border.Effect>
                            <TextBlock Text="&#xE8C0;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                       Foreground="{StaticResource Emerald600}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Папка:" Style="{StaticResource TextSmBold}" VerticalAlignment="Center" />
                                <TextBlock x:Name="ProjectNameTextBlock" Text="{Binding DisplayProjectName}"
                                           Style="{StaticResource TextSmBold}" Margin="6,0,0,0"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           MaxWidth="420" Cursor="Hand"
                                           MouseLeftButtonDown="OnProjectNameClick" />
                                <TextBox x:Name="ProjectNameTextBox" Visibility="Collapsed" Width="360"
                                         Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                         LostFocus="OnProjectNameLostFocus" KeyDown="OnProjectNameKeyDown" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock Text="{Binding BooksSummary}" Style="{StaticResource TextXs}"
                                           Foreground="{StaticResource Slate500}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding LoadFoldersCommand}"
                                AutomationProperties.Name="Выбрать папки" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Slate400}" />
                                <TextBlock Text="Сменить папку" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetOrderCommand}"
                                AutomationProperties.Name="Сбросить порядок" Margin="0,0,8,0"
                                ToolTip="Вернуть развороты в исходный порядок по именам файлов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                           Foreground="{StaticResource Slate400}" />
                                <TextBlock Text="Сбросить порядок" Margin="6,0,0,0" />
                            </StackPanel>
                        </Button>

                        <!-- h-5 w-px divider -->
                        <Border Width="1" Height="20" Background="{StaticResource Slate200}" Margin="0,0,8,0" />

                        <Button Style="{StaticResource PrimaryButton}" Padding="16,8"
                                Command="{Binding ExportCommand}"
                                AutomationProperties.Name="Экспортировать" IsEnabled="{Binding CanExport}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                                <TextBlock Text="Экспортировать эту книгу" Margin="6,0,0,0" Foreground="White" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============================================================== -->
        <!--  Content                                                       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <Border Background="#CC0F172A" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Обработка папок..." Style="{StaticResource TextXs}"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                <StackPanel>

                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" Padding="24" MaxWidth="560" HorizontalAlignment="Center"
                            Margin="0,40,0,0" Effect="{StaticResource ShadowSubtle}"
                            Visibility="{Binding BooksCount, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                                    Background="{StaticResource Emerald50}">
                                <TextBlock Text="&#xE8C0;" FontFamily="{StaticResource IconFont}" FontSize="24"
                                           Foreground="{StaticResource Emerald600}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Выберите папки с фотографиями" Style="{StaticResource TextLgBold}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0" TextAlignment="Center" />
                            <TextBlock Style="{StaticResource TextXs}" TextWrapping="Wrap" TextAlignment="Center"
                                       Foreground="{StaticResource Slate500}"
                                       MaxWidth="420" HorizontalAlignment="Center" Margin="0,8,0,20"
                                       Text="Каждая папка станет отдельной книгой. Самое большое фото в папке определится как обложка, остальные — как развороты." />
                            <Button Style="{StaticResource PrimaryButton}" Padding="16,10"
                                    Command="{Binding LoadFoldersCommand}"
                                    HorizontalAlignment="Center" AutomationProperties.Name="Выбрать папки">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8E9;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="White" />
                                    <TextBlock Text="Выбрать папки" Margin="6,0,0,0" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!--
                        UniformGrid Columns="4" reproduces md:2 lg:3 xl:4 from the mockup.
                        gap-6 (24) comes from the card Margin.
                    -->
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Book}">
                                <StackPanel Margin="0,0,0,8">
                                    <!-- Book header -->
                                    <Grid Margin="0,0,0,16">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Background="{StaticResource Brand50}" CornerRadius="4"
                                                    Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BookIndex, StringFormat='Книга {0}'}"
                                                           Style="{StaticResource TextBadge}" FontSize="10"
                                                           Foreground="{StaticResource Brand600}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextSmBold}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       MaxWidth="520" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Converter={StaticResource BookSummaryConverter}}"
                                                       Style="{StaticResource TextXs}" Margin="10,0,0,0"
                                                       Foreground="{StaticResource Slate400}" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Button HorizontalAlignment="Right" Style="{StaticResource DangerGhostButton}"
                                                ToolTip="Удалить книгу"
                                                Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding AllSlotsPages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:Page}">
                                                <Border x:Name="CardRoot">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource SpreadCard}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCover}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Emerald500}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>

                                                        <!-- Row 1: role badge + export filename -->
                                                        <Grid>
                                                            <Border Style="{StaticResource CoverBadge}"
                                                                    HorizontalAlignment="Left"
                                                                    Visibility="{Binding IsCover, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="&#xE735;" FontFamily="{StaticResource IconFont}"
                                                                               FontSize="10" Foreground="White" VerticalAlignment="Center" />
                                                                    <TextBlock Text="ОБЛОЖКА" Style="{StaticResource TextXsBold}"
                                                                               Foreground="White" Margin="4,0,0,0" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Style="{StaticResource SpreadBadge}"
                                                                    HorizontalAlignment="Right"
                                                                    Visibility="{Binding IsCover, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding Index, StringFormat='Разворот {0}'}"
                                                                           Style="{StaticResource TextXsSemibold}"
                                                                           Foreground="{StaticResource Slate700}" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 2: filename chip, mt-2 -->
                                                        <Border HorizontalAlignment="Left" Margin="0,8,0,0">
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource FileChip}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsCover}" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource Emerald50}" />
                                                                            <Setter Property="BorderBrush" Value="{StaticResource Emerald200}" />
                                                                            <Setter Property="BorderThickness" Value="1" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding ExportFileName}" Style="{StaticResource TextMono}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource Slate600}" />
                                                        </Border>

                                                        <!-- Row 3: 16/10 photo frame, mt-2 -->
                                                        <Grid x:Name="FrameHost" Margin="0,8,0,0">
                                                            <Grid.Height>
                                                                <MultiBinding Converter="{StaticResource AspectHeightConverter}">
                                                                    <Binding Path="ActualWidth" ElementName="FrameHost" />
                                                                    <Binding />
                                                                </MultiBinding>
                                                            </Grid.Height>

                                                            <Border Style="{StaticResource PhotoFrame}" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding Converter={StaticResource PageSourceConverter}}"
                                                                           Stretch="UniformToFill" Tag="{Binding}"
                                                                           MouseLeftButtonDown="OnPageImageDoubleClick" />

                                                                    <!-- bg-slate-900/40, group-hover -> 1 -->
                                                                    <Border Background="#66000000" Opacity="0"
                                                                            MouseLeftButtonDown="OnPageImageDoubleClick"
                                                                            Cursor="Hand">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Opacity" Value="0" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Value="True"
                                                                                                 Binding="{Binding IsMouseOver, ElementName=FrameHost}">
                                                                                        <Setter Property="Opacity" Value="1" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <Button Style="{StaticResource GhostButton}"
                                                                                Background="{StaticResource Surface}"
                                                                                Foreground="{StaticResource Slate800}"
                                                                                FontWeight="Medium" Padding="8"
                                                                                IsHitTestVisible="False">
                                                                                <StackPanel Orientation="Horizontal">
                                                                                    <TextBlock Text="&#xE71E;" FontFamily="{StaticResource IconFont}"
                                                                                               FontSize="12" Foreground="{StaticResource Slate800}" />
                                                                                    <TextBlock Text="Просмотр" Style="{StaticResource TextXsMedium}"
                                                                                               Foreground="{StaticResource Slate800}" Margin="6,0,0,0" />
                                                                                </StackPanel>
                                                                        </Button>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 4: footer, mt-4 pt-3 border-t -->
                                                        <Border Height="1" Background="{StaticResource Slate100}" Margin="0,16,0,0" />
                                                        <Grid Margin="0,12,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <!-- fa-regular fa-image + filename, max-w-[140px] -->
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="&#xE8B9;" FontFamily="{StaticResource IconFont}"
                                                                           FontSize="12" Foreground="{StaticResource Slate400}"
                                                                           VerticalAlignment="Center" />
                                                                <TextBlock Text="{Binding FileName}"
                                                                           Style="{StaticResource LinkText}"
                                                                           Foreground="{StaticResource Slate500}"
                                                                           VerticalAlignment="Center" Margin="6,0,0,0"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           MaxWidth="140" ToolTip="{Binding SourcePath}" />
                                                            </StackPanel>

                                                            <!-- p-1 arrows, spreads only -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        HorizontalAlignment="Center"
                                                                        Visibility="{Binding IsCover, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                <Button Style="{StaticResource ArrowButton}" Tag="{Binding}"
                                                                        Click="OnMovePageLeftClick" ToolTip="Переместить левее">
                                                                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                                                </Button>
                                                                <Button Style="{StaticResource ArrowButton}" Tag="{Binding}"
                                                                        Click="OnMovePageRightClick" ToolTip="Переместить правее" Margin="4,0,0,0">
                                                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="12" />
                                                                </Button>
                                                            </StackPanel>

                                                            <!-- "Назначить обложкой" (spread) / "Заменить" (cover) -->
                                                            <TextBlock Grid.Column="2" Text="Назначить обложкой"
                                                                       Style="{StaticResource LinkText}"
                                                                       Foreground="{StaticResource Emerald600}"
                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                       Tag="{Binding}" MouseLeftButtonDown="OnSetCoverClick"
                                                                       Visibility="{Binding IsCover, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />

                                                            <TextBlock Grid.Column="2" Text="Заменить"
                                                                       Style="{StaticResource TextXsSemibold}"
                                                                       Foreground="{StaticResource Brand600}"
                                                                       VerticalAlignment="Center" Cursor="Hand"
                                                                       Tag="{Binding}" MouseLeftButtonDown="OnReplaceClick"
                                                                       Visibility="{Binding IsCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
