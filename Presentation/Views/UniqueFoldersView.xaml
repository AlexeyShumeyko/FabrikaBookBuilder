<UserControl x:Class="PhotoBookRenamer.Presentation.Views.UniqueFoldersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:PhotoBookRenamer.Domain"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
             UseLayoutRounding="True" SnapsToDevicePixels="True">

    <UserControl.Resources>
        <!-- Spread / cover card -->
        <Style x:Key="SpreadCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect" Value="{StaticResource ShadowCard}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- The cover gets an emerald outline so it is obvious at a glance -->
        <Style x:Key="CoverCard" TargetType="Border" BasedOn="{StaticResource SpreadCard}">
            <Setter Property="BorderBrush" Value="{StaticResource Emerald500}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>

        <!-- 16:10 preview area -->
        <Style x:Key="PreviewFrame" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Slate100}" />
            <Setter Property="BorderBrush" Value="{StaticResource Slate200}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="150" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style x:Key="RoleBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{StaticResource Slate100}" />
            <Setter Property="BorderBrush" Value="{StaticResource Slate200}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </UserControl.Resources>

    <Grid MaxWidth="1600" Margin="32,24,32,32" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============================================================== -->
        <!--  Error banner                                                  -->
        <!-- ============================================================== -->
        <Border Grid.Row="0" Background="{StaticResource Red50}" BorderBrush="{StaticResource Red200}"
                BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16"
                VerticalAlignment="Top"
                Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource TextBody}"
                       Foreground="{StaticResource Red700}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid Visibility="{Binding ErrorMessage, Converter={StaticResource InverseStringToVisibilityConverter}}">

                <!-- ========================================================== -->
                <!--  Mode toolbar card                                        -->
                <!-- ========================================================== -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Folder identity -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="48" Height="48" CornerRadius="12" VerticalAlignment="Center"
                                    Background="{StaticResource Emerald50}">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                           Foreground="{StaticResource Emerald600}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" MaxWidth="640">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Проект:" Style="{StaticResource TextCaption}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="ProjectNameTextBlock" Text="{Binding DisplayProjectName}"
                                               Style="{StaticResource TextH4}" Margin="6,0,0,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               MaxWidth="420"
                                               MouseLeftButtonDown="OnProjectNameClick" Cursor="Hand" />
                                    <TextBox x:Name="ProjectNameTextBox" Visibility="Collapsed" Width="360"
                                             Margin="6,0,0,0" VerticalAlignment="Center" FontSize="13"
                                             LostFocus="OnProjectNameLostFocus" KeyDown="OnProjectNameKeyDown" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="Книг: " Style="{StaticResource TextCaption}" />
                                    <TextBlock Text="{Binding BooksCount}" Style="{StaticResource TextBodyStrong}" />
                                    <TextBlock Text="  ·  " Style="{StaticResource TextCaption}" />
                                    <TextBlock Text="{Binding BooksSummary}" Style="{StaticResource TextBodyStrong}" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <!-- Actions -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding LoadFoldersCommand}"
                                    AutomationProperties.Name="Выбрать папки" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource Slate400}" />
                                    <TextBlock Text="Сменить папку" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding ResetOrderCommand}"
                                    AutomationProperties.Name="Сбросить порядок" Margin="0,0,8,0"
                                    ToolTip="Вернуть развороты в исходный порядок по именам файлов">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                               Foreground="{StaticResource Slate400}" />
                                    <TextBlock Text="Сбросить порядок" Margin="6,0,0,0" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ExportCommand}"
                                    AutomationProperties.Name="Экспортировать" IsEnabled="{Binding CanExport}"
                                    ToolTip="Экспортировать готовые файлы">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" />
                                    <TextBlock Text="Экспортировать" Margin="6,0,0,0" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ============================================================== -->
        <!--  Content                                                       -->
        <!-- ============================================================== -->
        <Grid Grid.Row="1">
            <!-- Loading -->
            <Border Background="#CC0F172A" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                <TextBlock Text="Обработка папок..." Style="{StaticResource TextBody}"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <StackPanel>
                    <!-- Empty state -->
                    <Border Style="{StaticResource Card}" MaxWidth="560" HorizontalAlignment="Center"
                            Margin="0,60,0,0"
                            Visibility="{Binding BooksCount, Converter={StaticResource CountToBoolConverter}, ConverterParameter=invert}">
                        <StackPanel>
                            <Border Width="56" Height="56" CornerRadius="16" HorizontalAlignment="Center"
                                    Background="{StaticResource Emerald50}">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="24"
                                           Foreground="{StaticResource Emerald600}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Выберите папки с фотографиями" Style="{StaticResource TextH2}"
                                       HorizontalAlignment="Center" Margin="0,20,0,0" TextAlignment="Center" />
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" TextAlignment="Center"
                                       MaxWidth="420" HorizontalAlignment="Center" Margin="0,8,0,20"
                                       Text="Каждая папка станет отдельной книгой. Самое большое фото в папке определится как обложка, остальные — как развороты." />
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding LoadFoldersCommand}"
                                    HorizontalAlignment="Center" AutomationProperties.Name="Выбрать папки">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="White" />
                                    <TextBlock Text="Выбрать папки" Margin="6,0,0,0" Foreground="White" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Books -->
                    <ItemsControl ItemsSource="{Binding Books}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Book}">
                                <StackPanel Margin="0,0,0,20">

                                    <!-- Book header -->
                                    <Grid Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Background="{StaticResource Brand50}" CornerRadius="6"
                                                    Padding="8,3" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding BookIndex, StringFormat='Книга {0}'}"
                                                           Style="{StaticResource TextMicro}"
                                                           Foreground="{StaticResource Brand600}" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextH4}"
                                                       Margin="10,0,0,0" VerticalAlignment="Center"
                                                       MaxWidth="520" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Converter={StaticResource BookSummaryConverter}}"
                                                       Style="{StaticResource TextCaption}" Margin="10,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>

                                        <Button HorizontalAlignment="Right" Style="{StaticResource DangerGhostButton}"
                                                ToolTip="Удалить книгу"
                                                Command="{Binding DataContext.DeleteBookCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" />
                                        </Button>
                                    </Grid>

                                    <!-- Slots: AllSlotsPages = [cover, spread1, spread2...] -->
                                    <ItemsControl ItemsSource="{Binding AllSlotsPages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type models:Page}">
                                                <Border Width="340">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource SpreadCard}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCover}" Value="True">
                                                                    <Setter Property="BorderBrush" Value="{StaticResource Emerald500}" />
                                                                    <Setter Property="BorderThickness" Value="2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <StackPanel>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal"
                                                                Visibility="{Binding IsCover, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                <Border Background="{StaticResource Emerald500}" CornerRadius="6"
                                                                        Padding="8,3">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="&#xE735;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="10" Foreground="White" VerticalAlignment="Center" />
                                                                        <TextBlock Text="ОБЛОЖКА" Style="{StaticResource TextMicro}"
                                                           Foreground="White" Margin="4,0,0,0" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <Border Background="{StaticResource Slate100}" CornerRadius="6"
                                                                    Padding="8,3" HorizontalAlignment="Right"
                                                                    Visibility="{Binding IsCover, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                <TextBlock Text="{Binding Index, StringFormat='Разворот {0}'}"
                                                   Style="{StaticResource TextMicro}"
                                                   Foreground="{StaticResource Slate600}" />
                                                            </Border>
                                                        </Grid>

                                                        <!-- Target export filename -->
                                                        <Border Background="{StaticResource Slate50}" CornerRadius="6"
                                                                Padding="8,3" Margin="0,8,0,0"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding ExportFileName}"
                                                                       Style="{StaticResource TextMono}"
                                                                       Foreground="{StaticResource Slate600}" />
                                                        </Border>

                                                        <!-- Preview -->
                                                        <Border Style="{StaticResource PreviewFrame}" Margin="0,10,0,0">
                                                            <Grid x:Name="PreviewHost">
                                                                <Image Source="{Binding Converter={StaticResource PageSourceConverter}}"
                                                                       Stretch="UniformToFill" Tag="{Binding}"
                                                                       MouseLeftButtonDown="OnPageImageDoubleClick" />
                                                                <Border Background="#99000000" MouseLeftButtonDown="OnPageImageDoubleClick"
                                                                        Cursor="Hand">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Opacity" Value="0" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Value="True"
                                                                                             Binding="{Binding IsMouseOver, ElementName=PreviewHost}">
                                                                                    <Setter Property="Opacity" Value="1" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="Просмотр" Style="{StaticResource TextBody}"
                                                                               Foreground="White" FontWeight="SemiBold"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                            </Grid>
                                                        </Border>

                                                        <!-- Footer -->
                                                        <Border Height="1" Background="{StaticResource Slate100}" Margin="0,12,0,0" />
                                                        <Grid Margin="0,10,0,0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0" Text="{Binding FileName}"
                                                                       Style="{StaticResource TextCaption}"
                                                                       VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding SourcePath}" />

                                                            <!-- Reorder (spreads only) -->
                                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                                        Visibility="{Binding IsCover, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                                                        Tag="{Binding}" Click="OnMovePageLeftClick"
                                                                        ToolTip="Переместить левее">
                                                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                                                </Button>
                                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                                                        Tag="{Binding}" Click="OnAssignPageNumberClick"
                                                                        ToolTip="Назначить номер разворота" Margin="4,0,0,0">
                                                                    <TextBlock Text="№" FontSize="11" FontWeight="Bold" />
                                                                </Button>
                                                                <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                                                        Tag="{Binding}" Click="OnMovePageRightClick"
                                                                        ToolTip="Переместить правее" Margin="4,0,0,0">
                                                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>

                                                        <!-- Cover-only / promote actions -->
                                                        <Button Click="OnSetCoverClick" Tag="{Binding}" Margin="0,8,0,0"
                                                                HorizontalAlignment="Stretch"
                                                                Visibility="{Binding IsCover, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Emerald600}" />
                                                                    <Setter Property="Padding" Value="8,5" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource Emerald50}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="Назначить обложкой" Style="{StaticResource TextCaption}"
                                                                       Foreground="{StaticResource Emerald600}"
                                                                       HorizontalAlignment="Center" />
                                                        </Button>

                                                        <Button Click="OnReplaceClick" Tag="{Binding}" Margin="0,8,0,0"
                                                                HorizontalAlignment="Stretch"
                                                                Visibility="{Binding IsCover, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brand600}" />
                                                                    <Setter Property="Padding" Value="8,5" />
                                                                    <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter Property="Background" Value="{StaticResource Brand50}" />
                                                                        </Trigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Button.Style>
                                                            <TextBlock Text="Заменить обложку" Style="{StaticResource TextCaption}"
                                                                       Foreground="{StaticResource Brand600}"
                                                                       HorizontalAlignment="Center" />
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
