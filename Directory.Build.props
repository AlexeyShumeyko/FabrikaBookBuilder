<!--
  Build settings shared by every project in the repository.

  They live here rather than in the individual project files so that a new project starts
  from the same rules as the existing ones instead of from whatever was in its template.

  Two of them are not cosmetic:

  LangVersion    pinned, so the compiler does not change behaviour when a machine installs
                 a different SDK. The SDK itself is pinned in global.json.
  Nullable       the code is already annotated; this keeps it on for anything added later.
-->
<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>ru-RU</NeutralLanguage>
    <Company>Фотопринт</Company>
    <Product>Fabrika BookBuilder Studio</Product>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      .NET analyzers are on by default for net8.0 and currently report nothing: all 95
      warnings in the solution are compiler warnings about nullability and async
      discipline (CS8602, CS8603, CS8604, CS4014, CS1998, CS0168, CS0169, CS8618, CS8625).

      TreatWarningsAsErrors stays off until that list is empty. Turning it on first would
      mean either ignoring the new warnings - which makes the setting a lie - or stopping
      work on the 95. It is switched on as the warnings are fixed, one area at a time, and
      the roadmap carries it as its own step.
    -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <!--
      CS0649 is the first class switched on, and it qualifies for that on its own: the
      solution currently produces none, so switching it on cannot stop today's work, and
      when one appears it always means a bug rather than a style question - a field that is
      declared and never assigned, which is null at every use.

      That is not hypothetical. A dependency was added to a view model, the field and the
      call site were patched and the constructor was not; the build stayed green, the button
      the field fed did nothing, and the exception went into the task nobody observes. The
      compiler had been saying "this field is never assigned" the whole time, as a warning,
      in a build whose gate watches for errors.

      Suppress it locally with #pragma warning disable CS0649 if a field is ever assigned
      by something the compiler cannot see. Do not widen this to a list - each addition has
      to come with the measurement that says it is clean today.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS0649</WarningsAsErrors>
  </PropertyGroup>

</Project>